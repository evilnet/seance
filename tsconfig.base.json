{
  "compilerOptions": {
    // Type checking only: Vite (esbuild) builds client/, tsx runs the tests
    // and tools, and nothing reads tsc's output.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    // TODO: Remove eventually
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
