{
  "name": "seance-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for the Seance IRC client",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "pack": "electron-builder --dir -c electron-builder.cjs",
    "dist": "electron-builder -c electron-builder.cjs"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "chat.seance.app",
    "productName": "Seance",
    "copyright": "MIT",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../public",
        "to": "public"
      }
    ],
    "icon": "../../public/img/logo-grey-bg-512x512px.png",
    "protocols": [
      {
        "name": "IRC over WebSocket",
        "schemes": [
          "web+irc"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "seance",
      "executableName": "seance"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
