// Release counterpart of debug.xcconfig. Both exist so the signing identity
// can come from an untracked file: see signing.xcconfig below.
#include? "signing.xcconfig"

// The version, from git (tools/stamp-version.mjs, run by `yarn sync`) through
// an untracked file, so a sync never leaves the project changed. Without one
// (a checkout that has not synced) the build still says something.
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
#include? "version.xcconfig"
