{
  "name": "seance-capacitor",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor shell that wraps the Seance web build (../../public) as an iOS / Android app",
  "license": "MIT",
  "scripts": {
    "presync": "node tools/stamp-version.mjs",
    "sync": "cap sync",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#0D0E14' --iconBackgroundColorDark '#0D0E14' --splashBackgroundColor '#0D0E14' --splashBackgroundColorDark '#0D0E14' && node tools/adaptive-icon-background.mjs '#0D0E14'",
    "assets:sources": "tools/make-assets.sh",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "doctor": "cap doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-badge": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.20.5",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@12.16.1"
}
