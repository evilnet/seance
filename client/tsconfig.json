{
  "extends": "../tsconfig.base.json",
  "include": ["./**/*", "../shared"],
  // The translation worker's entry and the three modules that wire its
  // libraries are checked by tsconfig.worker.json instead.
  "exclude": ["./js/translate/worker-entry.ts", "./js/translate/engines/*.real.ts"],
  "compilerOptions": {
    // Vuex 4's `exports` has no `types` condition, so `bundler` cannot find
    // its types and the store silently becomes `any`. Not in the base: tsx
    // reads the root tsconfig's `paths` and would load this .d.ts at runtime.
    // fasttext.wasm.js ships a .d.ts tsc rejects; fasttext.d.ts is its stand-in.
    "paths": {
      "vuex": ["../node_modules/vuex/types/index.d.ts"],
      "fasttext.wasm.js/common": ["./fasttext.d.ts"]
    },
    // For Volar in editors; tsc checks no .vue files.
    "jsx": "preserve"
  }
}
