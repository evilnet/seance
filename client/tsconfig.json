{
  "extends": "../tsconfig.base.json",
  "include": ["./**/*", "../shared"],
  "files": [
    "../package.json",
    "./js/helpers/emoji-catalog.json",
    "./js/helpers/fullnamemap.json",
    "./js/helpers/simplemap.json",
    "./js/helpers/themePairs.json",
    "./js/helpers/ircmessageparser/shortcodes.json"
  ],
  "compilerOptions": {
    // Vuex 4's `exports` has no `types` condition, so `bundler` cannot find
    // its types and the store silently becomes `any`. Not in the base: tsx
    // reads the root tsconfig's `paths` and would load this .d.ts at runtime.
    "paths": {"vuex": ["../node_modules/vuex/types/index.d.ts"]},
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    // Only for `process.env.*`, which vite.config.mts replaces at build time
    // (scripts/build-info.mts `defines`); vite-env.d.ts brings vite/client.
    "types": ["node"]
  }
}
