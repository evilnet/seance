{
  "extends": "../tsconfig.base.json",
  "include": ["./**/*", "../shared"],
  "compilerOptions": {
    // Vuex 4's `exports` has no `types` condition, so `bundler` cannot find
    // its types and the store silently becomes `any`. Not in the base: tsx
    // reads the root tsconfig's `paths` and would load this .d.ts at runtime.
    "paths": {"vuex": ["../node_modules/vuex/types/index.d.ts"]},
    // For Volar in editors; tsc checks no .vue files.
    "jsx": "preserve"
  }
}
