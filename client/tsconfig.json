{
  "extends": "../tsconfig.base.json",
  "include": ["./**/*", "../shared"],
  // tsc checks .vue files through this, which is why it runs with --runExternalCode.
  "contentMappers": [
    {
      "package": "@vue/content-mapper",
      "extensions": [".vue"],
      "options": {"target": 3.5, "languageFeatures": false, "dataAttributes": ["data-*"]}
    }
  ],
  "compilerOptions": {
    // Vuex 4's `exports` has no `types` condition, so `bundler` cannot find
    // its types and the store silently becomes `any`. Not in the base: tsx
    // reads the root tsconfig's `paths` and would load this .d.ts at runtime.
    "paths": {"vuex": ["../node_modules/vuex/types/index.d.ts"]},
    "jsx": "preserve"
  }
}
