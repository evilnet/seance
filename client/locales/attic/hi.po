#: client/js/irc/commands/alias.ts
#. Confirmation after /alias <name> <commands> created a new alias. {name} is the alias name as typed, verbatim.
msgctxt "cmd.alias.added"
msgid "Alias /{name} added."
msgstr ""

#: client/js/irc/commands/alias.ts
#. Error when an /alias name is invalid. {max} is the length limit, a number.
msgctxt "cmd.alias.badName"
msgid "Alias names are letters, digits, _ and - (up to {max} characters)."
msgstr ""

#: client/js/irc/commands/alias.ts
#. Reply to /alias <name> when that alias does not exist. {name} is the name as typed, user input, verbatim; the second '/alias …' part is command syntax.
msgctxt "cmd.alias.missing"
msgid "No alias /{name}. /alias {name} <commands> creates it."
msgstr ""

