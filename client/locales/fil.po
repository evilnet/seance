#: client/js/irc/client.ts
msgctxt "connect.connectingToAttempt"
msgid "Connecting to {host}:{port}… (attempt {attempt})"
msgstr "Kumokonekta sa {host}:{port}… (pagsubok {attempt})"

#. Lobby status line when the user's own /quit closed the connection on purpose.
#: client/js/irc/client.ts
msgctxt "connect.disconnected"
msgid "Disconnected."
msgstr "Nadiskonekta."

#. Lobby status line after registration naming the IRCv3 capabilities the server enabled; {caps} is a comma-separated list of protocol tokens, never translated.
#: client/js/irc/client.ts
msgctxt "connect.enabledCaps"
msgid "Enabled capabilities: {caps}"
msgstr "Naka-enable na mga kakayahan: {caps}"

#. Notice on the connect form when it was opened by a link to a saved network whose password was not remembered; {account} is the services account name.
#: client/components/Windows/Connect.vue:572
msgctxt "connect.enterPassword"
msgid "Enter the password for {account} to connect."
msgstr "Ilagay ang password ng {account} para kumonekta."

#. Error notice shown under the guest sign-in form when the guest nick field was left empty or invalid.
#: client/components/Windows/Connect.vue:672
msgctxt "connect.guestNickRequired"
msgid "Choose a nick to connect as a guest."
msgstr "Pumili ng nick para kumonekta bilang bisita."

#. Button that connects with just a nick instead of an account.
#: client/js/branding.ts
msgctxt "connect.guestSubmit"
msgid "Connect as guest"
msgstr "Kumonekta bilang bisita"

#. Heading of the guest half of the sign-in form (features.guestAccess on).
#: client/js/branding.ts
msgctxt "connect.guestTitle"
msgid "No account?"
msgstr "Walang account?"

#. Notice at the top of the connect form when a web+irc:// link named a server the deploy does not allow; {network} is this deploy's network name, {host} the refused server.
#: client/components/Windows/Connect.vue:608
msgctxt "connect.linkIgnored"
msgid "This app only connects to {network}. The link to {host} was ignored."
msgstr "Sa {network} lang kumokonekta ang app na ito. Binalewala ang link sa {host}."

#. Notice on the connect approval dialog opened from a web+irc:// link without channels; {host}:{port} is the proposed server.
#: client/components/Windows/Connect.vue:610
msgctxt "connect.linkSuggest"
msgid "This link suggests connecting to {host}:{port}. Nothing is saved until you choose to connect."
msgstr "Iminumungkahi ng link na ito na kumonekta sa {host}:{port}. Walang nase-save hangga't hindi ka pumipiling kumonekta."

#. Notice on the connect approval dialog opened from a web+irc:// link that also names channels to join; {channels} is the comma-separated channel list.
#: client/components/Windows/Connect.vue:611
msgctxt "connect.linkSuggestJoin"
msgid "This link suggests connecting to {host}:{port} and joining {channels}. Nothing is saved until you choose to connect."
msgstr "Iminumungkahi ng link na ito na kumonekta sa {host}:{port} at sumali sa {channels}. Walang nase-save hangga't hindi ka pumipiling kumonekta."

#. Read-only row label on the connect/sign-in form, above the name of the network being connected to (shown instead of an editable server field).
#: client/components/Windows/Connect.vue:28
#: client/components/Windows/Connect.vue:126
msgctxt "connect.network"
msgid "Network"
msgstr ""

#. Heading of the connect form when it opened from a web+irc:// link that proposes a server the user has not approved yet.
#: client/components/Windows/Connect.vue:118
msgctxt "connect.newServerTitle"
msgid "Connect to a new server?"
msgstr "Kumonekta sa bagong server?"

#. Label of the nickname text field: on the connect form and in the guest half of the sign-in panel.
#: client/components/Windows/Connect.vue:101
#: client/components/Windows/Connect.vue:173
msgctxt "connect.nick"
msgid "Nick"
msgstr ""

#. Dismiss button on the connect screen shown as a dialog when the user followed a web+irc:// link; declines the connection without disconnecting the app.
#: client/components/Windows/Connect.vue:91
#: client/components/Windows/Connect.vue:315
msgctxt "connect.notNow"
msgid "Not now"
msgstr "Hindi ngayon"

#. Label of the account password field on the connect form, sign-in panel and network edit form; the field has a show/hide eye toggle.
#: client/components/Windows/Connect.vue:46
#: client/components/Windows/Connect.vue:228
msgctxt "connect.password"
msgid "Password"
msgstr "Password ng account"

#. Checkbox in the authentication section of the connect form: register this device for push notifications once the IRC server supports it.
#: client/components/Windows/Connect.vue:251
msgctxt "connect.pushNotifications"
msgid "Push notifications (registers when the server supports them)"
msgstr "Mga push notification (nagre-register kapag sinusuportahan ng server)"

#. Lobby status line when the network was disconnected while an automatic reconnect was still scheduled.
#: client/js/irc/client.ts
msgctxt "connect.reconnectCancelled"
msgid "Reconnect cancelled."
msgstr "Kinansela ang muling pagkonekta."

#. Lobby status line while an automatic retry waits out its backoff before dialling the chat network again. {seconds} is the whole number of seconds until it dials; {attempt} counts the retries this connection has seen.
#: client/js/irc/client.ts
msgctxt "connect.reconnectIn"
msgid "Reconnecting in {seconds}s (attempt {attempt})…"
msgstr "Muling kokonekta sa loob ng {seconds}s (pagsubok {attempt})…"

#. Lobby status line when a connection that had been stable dropped and is retried at once. {attempt} counts the retries this connection has seen.
#: client/js/irc/client.ts
msgctxt "connect.reconnectNow"
msgid "Reconnecting now (attempt {attempt})…"
msgstr "Muling kumokonekta ngayon (pagsubok {attempt})…"

#. Lobby status line while the client waits out the chat server's connection throttle before an automatic retry (irc/dialLedger.ts): dialling sooner would be refused and prolong the wait. {seconds} is the whole number of seconds to wait; {attempt} counts the retries this connection has seen.
#: client/js/irc/client.ts
msgctxt "connect.reconnectWaitThrottled"
msgid "Waiting {seconds}s: the server limits how often a device can reconnect (attempt {attempt})…"
msgstr "Naghihintay ng {seconds}s: nililimitahan ng server kung gaano kadalas makakakonekta muli ang isang device (pagsubok {attempt})…"

#. Checkbox on the sign-in form: remember the account and reconnect on the next load.
#: client/js/branding.ts
msgctxt "connect.rememberMe"
msgid "Stay signed in on this device"
msgstr "Manatiling naka-sign in sa device na ito"

#. Checkbox under the SASL password field on the connect form: keep the password in this browser's storage so reconnects need no typing.
#: client/components/Windows/Connect.vue:264
msgctxt "connect.rememberPassword"
msgid "Remember password on this device"
msgstr "Tandaan ang password sa device na ito"

#. Lobby error when the login the deploy asked for did not go through; {reason} is one of the connect.saslReason* copies (or, for a few server-side rejections, a technical phrase left verbatim).
#: client/js/irc/client.ts
msgctxt "connect.saslFailed"
msgid "SASL authentication failed: {reason}"
msgstr "Nabigo ang SASL authentication: {reason}"

#. Lobby status line listing the SASL mechanisms the server offers (902-adjacent RPL_SASLMECHS). {mechanisms} is the server's comma-separated token list, verbatim.
#: client/js/irc/sasl.ts
msgctxt "connect.saslMechanisms"
msgid "Available SASL mechanisms: {mechanisms}"
msgstr "Mga available na SASL mechanism: {mechanisms}"

#. Lobby error after a failed required SASL login: the network was dropped instead of registering unauthenticated. {host} is the chat network's configured host name.
#: client/js/irc/client.ts
msgctxt "connect.saslQuitHint"
msgid "Not connecting to {host} without the login you asked for."
msgstr "Hindi kokonekta sa {host} nang wala ang login na hiniling mo."

#. Lobby error after a required SASL login that merely timed out (a slow login service, not a wrong password): the connection is redialled on the usual schedule. {host} is the configured host name.
#: client/js/irc/client.ts
msgctxt "connect.saslQuitHintRetry"
msgid "Not connecting to {host} without the login you asked for; trying again."
msgstr "Hindi kokonekta sa {host} nang wala ang login na hiniling mo; susubukan ulit."

#. Reason fragment of 'SASL authentication failed: {reason}' when the server's AUTHENTICATE challenge is not the empty one PLAIN and EXTERNAL expect. {mechanism} is the mechanism token, verbatim. Lowercase mid-sentence by position.
#: client/js/irc/sasl.ts
msgctxt "connect.saslReason.badChallenge"
msgid "unexpected challenge for {mechanism}"
msgstr "hindi inaasahang challenge para sa {mechanism}"

#. Reason fragment of 'SASL authentication failed: {reason}' when the server rejected the client's request for the sasl capability (CAP NAK). Lowercase mid-sentence by position.
#: client/js/irc/handlers/cap.ts
msgctxt "connect.saslReason.capRefused"
msgid "the server refused the sasl capability"
msgstr "tinanggihan ng server ang sasl capability"

#. Reason fragment of 'SASL authentication failed: {reason}' when the saved network has no login credentials. Lowercase mid-sentence by position.
#: client/js/irc/client.ts
msgctxt "connect.saslReason.noCredentials"
msgid "no account name or password is configured"
msgstr "walang naka-configure na pangalan ng account o password"

#. Reason fragment of 'SASL authentication failed: {reason}' when a SASL failure numeric carries no text of its own. {code} is the numeric, verbatim. Lowercase mid-sentence by position.
#: client/js/irc/sasl.ts
msgctxt "connect.saslReason.numeric"
msgid "numeric {code}"
msgstr "numeric na {code}"

#. Reason fragment of 'SASL authentication failed: {reason}' when the server took too long to answer the login. Lowercase mid-sentence by position.
#: client/js/irc/client.ts
msgctxt "connect.saslReason.timeout"
msgid "timed out waiting for the server"
msgstr "nag-time out sa paghihintay sa server"

#. Reason fragment of 'SASL authentication failed: {reason}' when the server announced no usable sasl capability. Lowercase mid-sentence by position.
#: client/js/irc/client.ts
msgctxt "connect.saslReason.unavailable"
msgid "the server does not offer SASL"
msgstr "hindi nag-aalok ng SASL ang server"

#. Reason fragment of 'SASL authentication failed: {reason}' when the server's rejection named no cause. Lowercase mid-sentence by position.
#: client/js/irc/client.ts
msgctxt "connect.saslReason.unknown"
msgid "unknown error"
msgstr "hindi kilalang error"

#. Reason fragment of 'SASL authentication failed: {reason}' when the server's SASL mechanisms do not include the saved network's. {offered} and {mechanism} are protocol mechanism tokens, never translated.
#: client/js/irc/client.ts
msgctxt "connect.saslReason.wrongMechanism"
msgid "the server offers SASL {offered}, not {mechanism}"
msgstr "nag-aalok ang server ng SASL {offered}, hindi {mechanism}"

#. Follow-up to a failed required SASL login, telling the reader where to fix or drop the credentials.
#: client/js/irc/client.ts
msgctxt "connect.saslRequiredHint"
msgid "Check the account name and password in this network's settings, or pick \"No authentication\" there to connect without logging in."
msgstr "Suriin ang pangalan ng account at password sa mga setting ng network na ito, o piliin doon ang \"Walang authentication\" para kumonekta nang hindi nagla-login."

#. Checkbox on the connect form: reveals the account name and password fields used to authenticate with network services (SASL).
#: client/components/Windows/Connect.vue:207
msgctxt "connect.saslToggle"
msgid "I have a services account (SASL)"
msgstr "Mayroon akong services account (SASL)"

#. The IRC server section of the connect form: heading above the server fields, and the label of the server host field.
#: client/components/Windows/Connect.vue:124
#: client/components/Windows/Connect.vue:132
msgctxt "connect.server"
msgid "Server"
msgstr ""

#. aria-label of the server host text input (e.g. irc.example.org) on the connect form; the visible label is on the row.
#: client/components/Windows/Connect.vue:139
msgctxt "connect.serverAddress"
msgid "Server address"
msgstr "Address ng server"

#. aria-label of the numeric port input next to the server host field on the connect form.
#: client/components/Windows/Connect.vue:156
msgctxt "connect.serverPort"
msgid "Server port"
msgstr "Port ng server"

#. Intro line above the sign-in form; intentionally empty by default, fill only if the deploy wants one.
#: client/js/branding.ts
msgctxt "connect.signInIntro"
msgid ""
msgstr ""

#. Button that submits the sign-in form.
#: client/js/branding.ts
msgctxt "connect.signInSubmit"
msgid "Sign in"
msgstr "Mag-sign in"

#. Heading of the sign-in panel (features.signIn on).
#: client/js/branding.ts
msgctxt "connect.signInTitle"
msgid "Sign in"
msgstr "Mag-sign in"

#. Lobby status line when the connection is dropped to be redialled over TLS. {port} is the secure port the server's policy named.
#: client/js/irc/client.ts
msgctxt "connect.stsReconnect"
msgid "Server requires a secure connection (STS): reconnecting on port {port}…"
msgstr "Kailangan ng server ng secure na koneksyon (STS): muling kumokonekta sa port {port}…"

#. Lobby status line when the server's strict-transport-security policy upgrades a plain connection to TLS. {port} is the new TLS port.
#: client/js/irc/client.ts
msgctxt "connect.stsUpgrade"
msgid "Upgrading to TLS on port {port} (STS policy)"
msgstr "Lumilipat sa TLS sa port {port} (STS policy)"

#. Button on the connect form: submits it and dials the server.
#: client/js/branding.ts
msgctxt "connect.submit"
msgid "Connect"
msgstr "Kumonekta"

#. Heading of the connect form (features.signIn off).
#: client/js/branding.ts
msgctxt "connect.title"
msgid "Connect to IRC"
msgstr "Kumonekta sa IRC"

#. Checkbox under the server fields on the connect form: connect over TLS instead of a plain connection.
#: client/components/Windows/Connect.vue:166
msgctxt "connect.useTls"
msgid "Use secure connection (TLS)"
msgstr "Gumamit ng secure na koneksyon (TLS)"

#. Heading of the user section of the connect form (nick, channels, authentication follow below it).
#: client/components/Windows/Connect.vue:171
msgctxt "connect.user"
msgid "User"
msgstr "Gumagamit"

#. Error line the app shows when the connection to the chat server failed (also flashed on the loading splash). {message} is the verbatim technical message from the server or browser — never translate or reword its content.
#: client/js/socket-events/connection.ts
msgctxt "connection.error"
msgid "Connection error: {message}"
msgstr "Error sa koneksyon: {message}"

#. Label of a date marker between message groups in the scrollback: tooltip of the divider between the messages sent today.
#: client/components/DateMarker.vue:4
msgctxt "dates.today"
msgid "Today"
msgstr "Ngayon"

#. Label of a date marker between message groups in the scrollback: tooltip of the divider between the messages sent the day before; older groups show the date itself.
#: client/components/DateMarker.vue:4
msgctxt "dates.yesterday"
msgid "Yesterday"
msgstr "Kahapon"

#. Name of WebSocket close code 1001 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1001"
msgid "server going away"
msgstr "umaalis ang server"

#. Name of WebSocket close code 1002 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1002"
msgid "WebSocket protocol error"
msgstr "error sa protocol ng WebSocket"

#. Name of WebSocket close code 1006 (abnormal closure: refused, unreachable, TLS failure — the browser never says which) in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1006"
msgid "connection lost"
msgstr "nawala ang koneksyon"

#. Name of WebSocket close code 1008 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1008"
msgid "policy violation"
msgstr "paglabag sa patakaran"

#. Name of WebSocket close code 1009 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1009"
msgid "message too large"
msgstr "masyadong malaki ang mensahe"

#. Name of WebSocket close code 1011 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1011"
msgid "server error"
msgstr "error sa server"

#. Name of WebSocket close code 1012 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1012"
msgid "server restarting"
msgstr "nagre-restart ang server"

#. Name of WebSocket close code 1013 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1013"
msgid "server asked to try again later"
msgstr "hiniling ng server na subukan ulit mamaya"

#. Name of WebSocket close code 1015 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1015"
msgid "TLS handshake failed"
msgstr "nabigo ang TLS handshake"

#. Detail of a connection-failure report when the WebSocket closed with a code the app has no name for. {code} is the numeric close code, verbatim.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.codeUnknown"
msgid "code {code}"
msgstr "code na {code}"

#. Connection-failure report when the WebSocket never opened. {url} is the address that was dialled, verbatim. {error} is ' (<the browser's error text>)' or empty — the browser hides why a dial failed, so the slot often stays empty.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.couldNotConnect"
msgid "Could not connect to {url}{error}."
msgstr "Hindi makakonekta sa {url}{error}."

#. Headline when a network the client is dialling never opened and the retry schedule is standing down (the browser refused or could not reach the address). {url} is the WebSocket URL that was dialled; {error} is the browser's error text in parentheses, or empty.
#: client/js/irc/disconnect.ts:78
msgctxt "disconnect.couldNotConnectNotReconnecting"
msgid "Could not connect to {url}{error}. Not reconnecting."
msgstr "Hindi makakonekta sa {url}{error}. Hindi na susubukang kumonekta ulit."

#. Connection-failure report once the network was registered. {host} is the network's configured host name, verbatim. {detail} is ' (<server close reason>)', ' (<close-code name>)' or empty.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.disconnected"
msgid "Disconnected from {host}{detail}."
msgstr "Nadiskonekta sa {host}{detail}."

#. Headline when a registered connection closed and the retry schedule is standing down. {host} is the host as the user typed it; {detail} is the close detail in parentheses, or empty.
#: client/js/irc/disconnect.ts:127
msgctxt "disconnect.disconnectedNotReconnecting"
msgid "Disconnected from {host}{detail}. Not reconnecting."
msgstr "Nadiskonekta sa {host}{detail}. Hindi na susubukang kumonekta ulit."

#. Follow-up hint under a failed connection dialled with ws:// from an https:// page: the browser blocks mixed content, so the fix is on the network's settings.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.hint.httpsBlocked"
msgid "This page was loaded over HTTPS, so the browser blocks plain ws:// connections. Enable TLS for this network, or open the app over http://."
msgstr "Na-load ang page na ito sa HTTPS, kaya bina-block ng browser ang mga plain na ws:// na koneksyon. I-enable ang TLS para sa network na ito, o buksan ang app sa http://."

#. Follow-up hint under a failed plain (ws://) dial from a non-secure page.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.hint.plainCauses"
msgid "The browser does not reveal why. Likely causes: the server is down, the port is wrong, or it does not accept WebSocket connections on that port."
msgstr "Hindi sinasabi ng browser kung bakit. Mga posibleng dahilan: down ang server, mali ang port, o hindi ito tumatanggap ng WebSocket na koneksyon sa port na iyon."

#. Follow-up hint under a connection the server dropped during IRC registration, when the close reason named no live session.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.hint.registration"
msgid "The WebSocket opened but the server dropped it before registration finished - check that this port really speaks IRC over WebSocket, and look for a server notice above for the reason."
msgstr "Nabuksan ang WebSocket pero pinutol ito ng server bago natapos ang registration - tiyaking IRC over WebSocket talaga ang port na ito, at hanapin sa itaas ang notice ng server para sa dahilan."

#. Follow-up hint when the server's close reason names a live session: retrying alone cannot fix it, the other client has to go.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.hint.sessionConflict"
msgid "This account is already connected on this network - another tab, window or device is using it. Close that client; this tab then connects on its next retry (a dead connection is reclaimed within about a minute)."
msgstr "Nakakonekta na ang account na ito sa network na ito - may ibang tab, window o device na gumagamit nito. Isara ang client na iyon; kokonekta ang tab na ito sa susunod nitong pagsubok (nababawi ang patay na koneksyon sa loob ng mga isang minuto)."

#. Follow-up hint under a failed secure (wss://) dial. {url} is the network's address with https: in place of wss:, for accepting a self-signed certificate once.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.hint.wssCauses"
msgid "The browser does not reveal why. Likely causes: the server is down, the port is wrong, or its TLS certificate is not trusted — for a self-signed certificate, open {url} in a new tab, accept the warning, then reconnect."
msgstr "Hindi sinasabi ng browser kung bakit. Mga posibleng dahilan: down ang server, mali ang port, o hindi pinagkakatiwalaan ang TLS certificate nito — para sa self-signed certificate, buksan ang {url} sa bagong tab, tanggapin ang babala, saka muling kumonekta."

#. Connection-failure report when the server dropped the socket before registration finished. {host} is the network's configured host name, verbatim. {detail} is ' (<server close reason>)', ' (<close-code name>)' or empty.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.registeringClosed"
msgid "Connection to {host} closed during IRC registration{detail}."
msgstr "Nagsara ang koneksyon sa {host} habang nagre-register sa IRC{detail}."

#. Headline when the connection was closed between connecting and completing IRC registration and the retry schedule is standing down. {host} is the host as the user typed it; {detail} is the close detail in parentheses (a server reason, a connection-lost note or the close code), or empty.
#: client/js/irc/disconnect.ts:112
msgctxt "disconnect.registeringClosedNotReconnecting"
msgid "Connection to {host} closed during IRC registration{detail}. Not reconnecting."
msgstr "Nagsara ang koneksyon sa {host} habang nagre-register sa IRC{detail}. Hindi na susubukang kumonekta ulit."

#. Item of the presence menu under the logo (a list of choices). Opens the notification settings where the do-not-disturb schedule is set.
#: client/components/PresencePill.vue
msgctxt "dnd.editSchedule"
msgid "Edit schedule…"
msgstr "I-edit ang iskedyul…"

#. Item of the presence menu under the logo (a list of choices). A checkable item: follow the daily do-not-disturb schedule; {range} is its time window, like 22:00–07:00.
#: client/components/PresencePill.vue
msgctxt "dnd.followSchedule"
msgid "Follow schedule ({range})"
msgstr "Sundin ang iskedyul ({range})"

#. Item of the presence menu under the logo (a list of choices). Turns do not disturb on for one hour.
#: client/components/PresencePill.vue
msgctxt "dnd.for1h"
msgid "Do not disturb for 1 hour"
msgstr "Huwag istorbohin nang 1 oras"

#. Item of the presence menu under the logo (a list of choices). The same choice while it is running: {until} is the clock time it ends.
#: client/components/PresencePill.vue
msgctxt "dnd.for1hUntil"
msgid "Do not disturb for 1 hour (until {until})"
msgstr "Huwag istorbohin nang 1 oras (hanggang {until})"

#. Item of the presence menu under the logo (a list of choices). Turns do not disturb on for eight hours.
#: client/components/PresencePill.vue
msgctxt "dnd.for8h"
msgid "Do not disturb for 8 hours"
msgstr "Huwag istorbohin nang 8 oras"

#. Item of the presence menu under the logo (a list of choices). The same choice while it is running: {until} is the clock time it ends.
#: client/components/PresencePill.vue
msgctxt "dnd.for8hUntil"
msgid "Do not disturb for 8 hours (until {until})"
msgstr "Huwag istorbohin nang 8 oras (hanggang {until})"

#. Item of the presence menu under the logo (a list of choices). Turns do not disturb on with no end time.
#: client/components/PresencePill.vue
msgctxt "dnd.indefinite"
msgid "Do not disturb until I turn it off"
msgstr "Huwag istorbohin hanggang i-off ko ito"

#. What the presence pill under the logo says while do not disturb is on. Short; may be followed by 'until …' on a second line.
#: client/js/helpers/dnd.ts
msgctxt "dnd.label"
msgid "Do not disturb"
msgstr "Huwag istorbohin"

#. Screen-reader label of the group of weekday checkboxes of the do-not-disturb schedule.
#: client/components/Settings/Notifications.vue
msgctxt "dnd.scheduleDaysAria"
msgid "Days"
msgstr "Mga araw"

#. Screen-reader label of the do-not-disturb schedule's end time field.
#: client/components/Settings/Notifications.vue
msgctxt "dnd.scheduleEndAria"
msgid "Do not disturb until"
msgstr "Huwag istorbohin hanggang"

#. Help paragraph under the do-not-disturb schedule in Settings → Notifications. {appName} is the app's name. 'push' means push notifications.
#: client/components/Settings/Notifications.vue
msgctxt "dnd.scheduleHint"
msgid "While do not disturb is on, you show as away and nothing alerts you here or through push. Push stops on all your devices signed in to the same account. If no {appName} is open when a scheduled window starts, push stops once one opens. Same start and end: all day."
msgstr "Habang naka-on ang Huwag istorbohin, lalabas kang wala at walang mag-aalerto sa iyo rito o sa push. Hihinto ang push sa lahat ng device mo na naka-sign in sa parehong account. Kung walang nakabukas na {appName} kapag nagsimula ang naka-iskedyul na oras, hihinto ang push kapag may nabuksan na isa. Parehong simula at wakas: buong araw."

#. Screen-reader label of the do-not-disturb schedule's start time field.
#: client/components/Settings/Notifications.vue
msgctxt "dnd.scheduleStartAria"
msgid "Do not disturb from"
msgstr "Huwag istorbohin mula"

#. Switch label in Settings → Notifications: turns the daily do-not-disturb time window on or off.
#: client/components/Settings/Notifications.vue
msgctxt "dnd.scheduleToggle"
msgid "Do not disturb on a schedule"
msgstr "Huwag istorbohin ayon sa iskedyul"

#. Settings → Notifications, the do-not-disturb schedule: one sentence around two time fields; {start} and {end} are where the time inputs appear. Keep both placeholders; the words before each become that field's label.
#: client/components/Settings/Notifications.vue
msgctxt "dnd.scheduleWindow"
msgid "From {start} until {end}"
msgstr "Mula {start} hanggang {end}"

#. Second part of the presence pill while do not disturb is on, shown after 'Do not disturb' (possibly on its own line): when it ends today. {time} is a clock time like 23:00 or 11:00 PM.
#: client/js/helpers/dnd.ts
msgctxt "dnd.until"
msgid "until {time}"
msgstr "hanggang {time}"

#. Second part of the presence pill while do not disturb is on: when it ends on another day. {day} is a short weekday name (Sat), {time} a clock time like 07:00.
#: client/js/helpers/dnd.ts
msgctxt "dnd.untilDay"
msgid "until {day} {time}"
msgstr "hanggang {day} {time}"

#. Join refusal (475) phrased by the client. {channel} is the refused channel name, user data, never translated; the '- <cause>.' layout follows the server's cause ordering.
#: client/components/MessageTypes/error.vue
msgctxt "error.badChannelKey"
msgid "Cannot join {channel} - Bad channel key."
msgstr "Hindi makasali sa {channel} - Maling key ng channel."

#. Join refusal (474) phrased by the client; {channel} is the refused channel name.
#: client/components/MessageTypes/error.vue
msgctxt "error.bannedFromChannel"
msgid "Cannot join {channel} - You have been banned from the channel."
msgstr "Hindi makasali sa {channel} - Naka-ban ka sa channel."

#. Send refusal (404) phrased by the client; {channel} is the refused channel name.
#: client/components/MessageTypes/error.vue
msgctxt "error.cannotSendToChannel"
msgid "Cannot send to channel {channel}"
msgstr "Hindi makapagpadala sa channel na {channel}"

#. Join refusal (471) phrased by the client; {channel} is the refused channel name.
#: client/components/MessageTypes/error.vue
msgctxt "error.channelIsFull"
msgid "Cannot join {channel} - Channel is full."
msgstr "Hindi makasali sa {channel} - Puno na ang channel."

#. Refusal (482) phrased by the client, e.g. a mode change without operator status.
#: client/components/MessageTypes/error.vue
msgctxt "error.chanopPrivsNeeded"
msgid "Cannot perform action: You're not a channel operator."
msgstr "Hindi magawa ang aksyon: Hindi ka operator ng channel."

#. Join refusal (473) phrased by the client; {channel} is the refused channel name.
#: client/components/MessageTypes/error.vue
msgctxt "error.inviteOnlyChannel"
msgid "Cannot join {channel} - Channel is invite only."
msgstr "Hindi makasali sa {channel} - Para lang sa mga inimbita ang channel."

#. Error shown in a network's own window when the chat server does not offer a protocol capability the client requires. {caps} is the server's own list of capability names, space separated and never translated.
#: client/js/irc/handlers/cap.ts
msgctxt "error.missingCaps"
msgid "Missing required capabilities: {caps}"
msgstr "Kulang ang mga kinakailangang capability: {caps}"

#. Send refusal (401) phrased by the client; {nick} is the addressed nick, user data.
#: client/components/MessageTypes/error.vue
msgctxt "error.noSuchNick"
msgid "User {nick} hasn't logged in or does not exist."
msgstr "Hindi naka-log in o hindi umiiral ang user na {nick}."

#. Refusal (442) phrased by the client, e.g. a topic change from outside.
#: client/components/MessageTypes/error.vue
msgctxt "error.notOnChannel"
msgid "Cannot perform action: You're not on the channel."
msgstr "Hindi magawa ang aksyon: Wala ka sa channel."

#. Login refusal (464) phrased by the client.
#: client/components/MessageTypes/error.vue
msgctxt "error.passwordMismatch"
msgid "Password mismatch."
msgstr "Hindi tugma ang password."

#. Join refusal (405) phrased by the client; {channel} is the refused channel name.
#: client/components/MessageTypes/error.vue
msgctxt "error.tooManyChannels"
msgid "Cannot join {channel} - You've already reached the maximum number of channels allowed."
msgstr "Hindi makasali sa {channel} - Naabot mo na ang maximum na bilang ng channel na pinapayagan."

#. Server rejection (421) phrased by the client; {command} is the unknown slash command as typed, user input.
#: client/components/MessageTypes/error.vue
msgctxt "error.unknownCommand"
msgid "Unknown command: {command}"
msgstr "Hindi kilalang command: {command}"

#. Refusal (441) phrased by the client, e.g. a kick of a user who has left; {nick} is user data.
#: client/components/MessageTypes/error.vue
msgctxt "error.userNotInChannel"
msgid "User {nick} is not on the channel."
msgstr "Wala sa channel ang user na {nick}."

#. Refusal (443) phrased by the client; {nick} is user data.
#: client/components/MessageTypes/error.vue
msgctxt "error.userOnChannel"
msgid "User {nick} is already on the channel."
msgstr "Nasa channel na ang user na {nick}."

