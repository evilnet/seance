msgid "Do not disturb"
msgstr "Ne zavarjanak"

#. Presence mode name, a word or two (menu item, select option and status text). Presence modes: Online (never away), Auto (away when the user is not looking at the app), Away (always away), Do not disturb (away and silenced), Same as global (a network follows the global mode set from the pill under the logo). This one: the network follows the global mode.
#: client/js/helpers/dnd.ts
msgctxt "presence.mode.global"
msgid "Same as global"
msgstr "Ugyanaz, mint a globális"

#. Presence mode name, a word or two (menu item, select option and status text). Presence modes: Online (never away), Auto (away when the user is not looking at the app), Away (always away), Do not disturb (away and silenced), Same as global (a network follows the global mode set from the pill under the logo). This one: never shown as away.
#: client/js/helpers/dnd.ts
msgctxt "presence.mode.online"
msgid "Online"
msgstr "Elérhető"

#. Screen-reader label of the presence dot button in the sidebar. {network} is the network's name, {state} its presence text (e.g. 'Auto · global'). Opens a menu of presence modes.
#: client/components/NetworkLobby.vue
msgctxt "presence.networkAria"
msgid "Presence on {network}: {state}"
msgstr "Jelenlét itt: {network}: {state}"

#. Tooltip and screen-reader text of the presence dot by a network's name in the sidebar. {mode} is a presence mode name (Online, Auto, Away). The ' · ' separator joins short qualifiers; keep it. The network is not connected.
#: client/components/NetworkLobby.vue
msgctxt "presence.offline"
msgid "{mode} · not connected"
msgstr "{mode} · nincs csatlakozva"

#. Screen-reader label of the presence pill under the logo, a button that opens the presence menu. {state} is what the pill says (e.g. 'Online', 'Do not disturb · until 23:00').
#: client/components/PresencePill.vue
msgctxt "presence.pillAria"
msgid "Presence: {state}"
msgstr "Jelenlét: {state}"

#. Menu item of a network's presence menu: follow the global mode; {mode} is what the global mode is right now (Online, Auto or Away).
#: client/components/NetworkLobby.vue
msgctxt "presence.sameAsGlobalNow"
msgid "Same as global ({mode})"
msgstr "Ugyanaz, mint a globális ({mode})"

#. Body of the push opt-in prompt; explains what allowing push does and that it is chosen per network.
#: client/components/PushPrompt.vue
msgctxt "push.enableBody"
msgid "This server can wake this app when it has messages for you while it is closed. You can change this per network, in each network's settings."
msgstr "Ez a szerver fel tudja ébreszteni az alkalmazást, ha üzenete van számodra, miközben az alkalmazás zárva van. Ezt hálózatonként, az egyes hálózatok beállításaiban módosíthatod."

#. Title of the prompt shown at connect time asking whether to enable web push notifications for that chat network.
#: client/components/PushPrompt.vue
msgctxt "push.enableTitle"
msgid "Enable push notifications?"
msgstr "Engedélyezed a push-értesítéseket?"

#. Fallback for the network name in the push prompt's target line when no name is known for the chat network being asked about.
#: client/components/PushPrompt.vue
msgctxt "push.fallbackNetwork"
msgid "this network"
msgstr "ez a hálózat"

#. Button of the push opt-in prompt; declines and stops the app from ever asking again for that network.
#: client/components/PushPrompt.vue
msgctxt "push.never"
msgid "Never"
msgstr "Soha"

#. Button of the push opt-in prompt; declines for now without disabling future prompts.
#: client/components/PushPrompt.vue
msgctxt "push.no"
msgid "No"
msgstr "Nem"

#. Body of the push-renewal prompt; explains why the subscription broke and that re-subscribing can be done later from that network's settings.
#: client/components/PushPrompt.vue
msgctxt "push.renewBody"
msgid "This server's push key changed, so this device's push subscription for it no longer works. Subscribe again to keep being notified while the app is closed. You can also do this later from this network's settings."
msgstr "A szerver push-kulcsa megváltozott, ezért ennek az eszköznek a push-feliratkozása nem működik tovább. Iratkozz fel újra, hogy továbbra is kapj értesítéseket, amikor az alkalmazás zárva van. Ezt később a hálózat beállításaiban is megteheted."

#. Title of the prompt shown at connect time when a chat server's push identity (its key) changed and the device's subscription must be renewed.
#: client/components/PushPrompt.vue
msgctxt "push.renewTitle"
msgid "Renew push notifications?"
msgstr "Megújítod a push-értesítéseket?"

#. Button of the push opt-in prompt; allows web push (the click doubles as the browser's permission gesture).
#: client/components/PushPrompt.vue
msgctxt "push.yes"
msgid "Yes"
msgstr "Igen"

#. Tooltip and aria-label of the ➕ button at the end of a message's reaction row; clicking opens the emoji picker.
#: client/components/MessageReactions.vue
msgctxt "reactions.add"
msgid "Add a reaction"
msgstr "Reakció hozzáadása"

#. Preview-bar hint in the emoji picker while a reaction is being composed; shift-clicking an emoji appends it instead of sending.
#: client/components/ReactionPicker.vue
msgctxt "reactions.buildingHint"
msgid "Shift-click to add more emoji"
msgstr "Shift+kattintással több emojit adhatsz hozzá"

#. Preview-bar title in the emoji picker while the user is composing a reaction out of several emoji or typing one.
#: client/components/ReactionPicker.vue
msgctxt "reactions.buildingName"
msgid "Building a reaction"
msgstr "Reakció készítése"

#. aria-label of a reaction badge under a chat message. {reaction} is the emoji or word reaction, {users} the comma-joined names of who sent it.
#: client/components/MessageReactions.vue
msgctxt "reactions.by"
msgid "{reaction} by {users}"
msgstr "{reaction}: {users}"

#. Tooltip and aria-label of the ✕ button in the emoji picker's search field; clicking empties the field.
#: client/components/ReactionPicker.vue
msgctxt "reactions.clearSearch"
msgid "Clear search"
msgstr "Keresés törlése"

#. Suffix appended to a reaction badge's aria-label when you took part in it, saying that clicking removes your reaction. Parenthesized.
#: client/components/MessageReactions.vue
msgctxt "reactions.clickToRemoveSuffix"
msgid "(click to remove yours)"
msgstr "(kattints a saját reakciód eltávolításához)"

#. aria-label of the emoji picker popup that opens from a chat message to add a reaction to it.
#: client/components/ReactionPicker.vue
msgctxt "reactions.dialogAria"
msgid "Add a reaction"
msgstr "Reakció hozzáadása"

#. Preview-bar hint of the emoji picker when nothing is highlighted or being composed; sums up the three ways to react.
#: client/components/ReactionPicker.vue
msgctxt "reactions.emptyHint"
msgid "Pick an emoji, type a word, or shift-click to combine several."
msgstr "Válassz egy emojit, írj be egy szót, vagy Shift+kattintással kombinálj többet."

#. Label shown before the typed text on the emoji picker's free-text row, which sends what was typed as the reaction; the typed text follows it. Mid-sentence by position.
#: client/components/ReactionPicker.vue
msgctxt "reactions.freePrefix"
msgid "React with"
msgstr "Reagálás ezzel:"

#. aria-label of the row of reaction badges under a chat message, listing who reacted with what.
#: client/components/MessageReactions.vue
msgctxt "reactions.groupAria"
msgid "Reactions"
msgstr "Reakciók"

#. Preview-bar hint in the emoji picker for a single emoji; shift-clicking another appends it to the reaction instead of sending. Keep the shift symbol.
#: client/components/ReactionPicker.vue
msgctxt "reactions.hintCombine"
msgid "⇧ to combine"
msgstr "⇧ a kombináláshoz"

#. Preview-bar hint in the emoji picker when the highlighted emoji is already on the message; clicking it takes the reaction back off.
#: client/components/ReactionPicker.vue
msgctxt "reactions.hintRemove"
msgid "Remove"
msgstr "Eltávolítás"

#. Preview-bar hint in the emoji picker for a typed reaction (a word or several emoji): pressing Enter sends it.
#: client/components/ReactionPicker.vue
msgctxt "reactions.hintSend"
msgid "Enter to send"
msgstr "Enter a küldéshez"

#. aria-label of the emoji picker's scrollable grid of emoji to pick from.
#: client/components/ReactionPicker.vue
msgctxt "reactions.listAria"
msgid "Emoji"
msgstr "Emojik"

#. Error note shown inside the emoji picker when the emoji catalog failed to download; the search field above still accepts any reaction as text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.loadFailed"
msgid "The emoji list could not be loaded. You can still type a reaction above."
msgstr "Az emojilista nem tölthető be. Fent továbbra is beírhatsz egy reakciót."

#. Note shown inside the emoji picker while its catalog is being fetched. Ellipsis is part of the copy.
#: client/components/ReactionPicker.vue
msgctxt "reactions.loading"
msgid "Loading emoji…"
msgstr "Emojik betöltése…"

#. Heading of the emoji picker's list while a search matched nothing (what was typed can still be sent as a reaction).
#: client/components/ReactionPicker.vue
msgctxt "reactions.noMatch"
msgid "No emoji match"
msgstr "Nincs illeszkedő emoji"

#. Heading of the emoji picker's section of suggested starter reactions, shown when nothing has been used recently, and the label of its tab.
#: client/components/ReactionPicker.vue
msgctxt "reactions.quickReactions"
msgid "Quick reactions"
msgstr "Gyors reakciók"

#. Heading of the emoji picker's section of recently sent reactions, and the label of its tab.
#: client/components/ReactionPicker.vue
msgctxt "reactions.recentlyUsed"
msgid "Recently used"
msgstr "Nemrég használt"

#. Placeholder and aria-label of the emoji picker's search field; the same field doubles as the entry for a custom reaction (any text or emoji).
#: client/components/ReactionPicker.vue
msgctxt "reactions.searchPlaceholder"
msgid "Search emoji, or type any reaction"
msgstr "Keress emojit, vagy írj be bármilyen reakciót"

#. Heading of the emoji picker's list while a search is showing matches.
#: client/components/ReactionPicker.vue
msgctxt "reactions.searchResults"
msgid "Search results"
msgstr "Keresési eredmények"

#. Button in the emoji picker's preview bar; clicking sends the reaction being composed.
#: client/components/ReactionPicker.vue
msgctxt "reactions.send"
msgid "Send"
msgstr "Küldés"

#. Preview-bar note in the emoji picker for a remembered reaction that is not an emoji, saying it will be sent as words. Starts lowercase because it follows other text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.sentAsText"
msgid "sent as text"
msgstr "szövegként küldve"

#. aria-label of the row of tab buttons in the emoji picker that jumps to a group of emoji (smileys, animals, food…).
#: client/components/ReactionPicker.vue
msgctxt "reactions.tabsAria"
msgid "Emoji groups"
msgstr "Emojicsoportok"

#. Tooltip of the emoji picker's free-text row and its spoken form, offering to send what was typed as the reaction. {reaction} is that text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.titleTemplate"
msgid "React with {reaction}"
msgstr "Reagálás ezzel: {reaction}"

#. aria-label of the magnifier button in a chat window's header; clicking it opens the message-search field for the conversation.
#: client/components/MessageSearchForm.vue:19
msgctxt "search.openForm"
msgid "Search messages in this channel"
msgstr "Üzenetek keresése ebben a csatornában"

#. Placeholder of the message-search field that opens from the magnifier in a chat window's header; it filters this conversation's history.
#: client/components/MessageSearchForm.vue:10
msgctxt "search.placeholder"
msgid "Search messages…"
msgstr "Üzenetek keresése…"

#. aria-label of the search-results view of the chat window, which lists the messages matching a search.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.aria"
msgid "Search results"
msgstr "Keresési eredmények"

#. Tooltip and aria-label of the ✕ button in the search-results header; clicking closes the search and returns to the conversation.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.close"
msgid "Close search window"
msgstr "Keresési ablak bezárása"

#. Shown in the search-results view when the search matched no messages.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.none"
msgid "No results found."
msgstr "Nincs találat."

#. Note under the search results, explaining that the search covers only the messages currently loaded in the app, not the full history on the server. Em dash is part of the copy.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.scopeNote"
msgid "Only messages loaded in this session are searched — older history is not searched."
msgstr "Csak az ebben a munkamenetben betöltött üzenetekben keres — a régebbi előzményekben nem."

#. Header of the search-results window. {channel} is the channel or conversation name (VERBATIM, a styled element); the search term itself is shown right after this text, in its own element, so the phrase ends where the term begins.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.searchingIn"
msgid "Searching in {channel} for"
msgstr "Keresés itt: {channel}, kifejezés:"

#. Button at the top of the search results list that fetches more matches. {count} is how many further matches are available.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.showOlder"
msgid "Show older results ({count} more)"
msgstr "Régebbi találatok megjelenítése (még {count})"

#. Shown in the search-results view when the search field is empty; invites typing a query.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.typePrompt"
msgid "Type something to search for."
msgstr "Írj valamit a kereséshez."

#. Lobby error when the server never answered the redaction an edit depends on.
#: client/js/irc/client.ts
msgctxt "send.editNoReply"
msgid "Edit not sent: no reply from the server."
msgstr "A szerkesztés nem ment el: nem érkezett válasz a szervertől."

#. Lobby error when a second edit of the same message was sent before the first one settled.
#: client/js/irc/client.ts
msgctxt "send.editWaiting"
msgid "Edit not sent: an edit of that message is already waiting for the server."
msgstr "A szerkesztés nem ment el: ennek az üzenetnek egy szerkesztése már a szerverre vár."

#. Lobby error when a command or message was typed while the network is down; nothing was sent.
#: client/js/irc/client.ts
#: client/js/irc/commands/index.ts:215
#: client/js/irc/commands/index.ts:224
msgctxt "send.notConnected"
msgid "You are not connected to the IRC network, unable to send your command."
msgstr "Nem kapcsolódsz az IRC-hálózathoz, a parancs nem küldhető el."

#. Lobby error when an IRC line could not be written to the socket. {message} is a technical transport error, left verbatim.
#: client/js/irc/client.ts
msgctxt "send.notSent"
msgid "Not sent: {message}"
msgstr "Nem küldve: {message}"

#. Lobby error when the server's push-subscription registration line exceeds the IRC line limit; nothing was sent.
#: client/js/irc/client.ts
msgctxt "send.pushTooLong"
msgid "Not sent: the push subscription does not fit on one line"
msgstr "Nem ment el: a push-feliratkozás nem fér el egy sorban"

#. Lobby error when a reaction was sent on a server without message-tags.
#: client/js/irc/client.ts
msgctxt "send.reactNeedsTags"
msgid "Reactions need the message-tags capability, which this server did not enable."
msgstr "A reakciókhoz a message-tags képesség kell, amelyet ez a szerver nem engedélyezett."

#. Lobby error when a reaction was sent in a window that carries no messages.
#: client/js/irc/client.ts
msgctxt "send.reactTargets"
msgid "Reactions can only be sent in channels and queries."
msgstr "Reakciót csak csatornákban és privát beszélgetésekben lehet küldeni."

#. Lobby error when deletion was tried outside a channel.
#: client/js/irc/client.ts
msgctxt "send.redactChannels"
msgid "Messages can only be deleted in channels."
msgstr "Az üzenetek csak a csatornákban törölhetők."

#. Lobby error when deletion was tried on a server without the redaction capability.
#: client/js/irc/client.ts
msgctxt "send.redactUnavailable"
msgid "Deleting messages is not available: the server did not enable draft/message-redaction."
msgstr "Az üzenetek törlése nem elérhető: a szerver nem engedélyezte a draft/message-redaction képességet."

#. Lobby error when a message's client tags exceed the IRC line limit; nothing was sent.
#: client/js/irc/client.ts
msgctxt "send.tagsTooLong"
msgid "Not sent: the tags do not fit on one line"
msgstr "Nem ment el: a címkék nem férnek el egy sorban"

#. Button under the alias table: appends a new, empty alias row to edit.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.add"
msgid "Add alias"
msgstr "Alias hozzáadása"

#. aria-label of an alias row's commands (body) input. {name} is the alias's name — or, while the name is empty, the row's number; verbatim user content either way, never translated.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.bodyAria"
msgid "Commands for alias {name}"
msgstr "Parancsok ehhez az aliashoz: {name}"

#. Example body shown in the alias-body input: an IRC action waving at the first argument. Keep the /me command and the $1 token verbatim; the action wording is an example and may be adapted.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.bodyPlaceholder"
msgid "/me waves at $1"
msgstr "/me integet neki: $1"

#. Shown in place of the alias table when no aliases are defined.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.empty"
msgid "No aliases yet."
msgstr "Még nincs alias."

#. Row error: the alias has a name but no commands.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorBody"
msgid "Say what the alias runs."
msgstr "Add meg, mit futtasson az alias."

#. Row error: another row already defines this alias. {name} is the other alias's name, verbatim user content; the slash before it is the command prefix.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorDuplicate"
msgid "There is already a /{name}."
msgstr "Már létezik /{name}."

#. Row error under an alias row: the alias has no name.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorName"
msgid "Give the alias a name."
msgstr "Adj nevet az aliasnak."

#. Row error: the alias name contains characters other than letters, digits, hyphen and underscore. The - and _ are literal characters, keep them.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorNameChars"
msgid "Names are letters, digits, - and _ — no spaces or slashes."
msgstr "A nevek betűkből, számjegyekből, - és _ jelekből állhatnak — szóköz és perjel nélkül."

#. Row error: the body exceeds the length limit. {limit} is the maximum number of characters (a number).
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorTooLong"
msgid "The body is too long (over {limit} characters)."
msgstr "A törzs túl hosszú (több mint {limit} karakter)."

#. Column heading of the alias editor table: the name of the slash command being defined. The header row is aria-hidden; each input's own aria-label carries this meaning to screen readers.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.headName"
msgid "Alias"
msgstr "Aliasnév"

#. Column heading of the alias editor table: the command lines the alias runs (its body). The header row is aria-hidden; the body input's own aria-label carries this meaning to screen readers.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.headRuns"
msgid "Runs"
msgstr "Futtatás"

#. Intro paragraph of Settings → Aliases. {example} is an example alias invocation such as /wave (a code element); {first}, {rest} and {all} are the argument tokens $1, $2- and $*, each a code element.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.intro"
msgid "An alias is a slash command of your own. Typing {example} runs what you define here — one command per line, with the arguments filled in where the body says {first}, {rest} or {all}."
msgstr "Az alias egy saját perjeles parancs. A(z) {example} begépelése lefuttatja, amit itt megadsz — soronként egy parancsot, az argumentumokat oda behelyettesítve, ahol a törzsben {first}, {rest} vagy {all} áll."

#. aria-label of an alias row's name input. {number} is the row's position, counting from 1.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nameAria"
msgid "Alias name {number}"
msgstr "{number}. aliasnév"

#. Placeholder of the alias-name input: the alias's name goes here.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.namePlaceholder"
msgid "name"
msgstr "név"

#. Paragraph of Settings → Aliases on nested aliases. {command} is the example /join and {expansion} the example /join #lobby $*, each a code element: an alias named join can expand to the built-in /join without calling itself again.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nested"
msgid "A body line can invoke another alias, and an alias named after a built-in command replaces it — {command} can become {expansion} without looping."
msgstr "Egy sor meghívhat egy másik aliast, és a beépített parancsról elnevezett alias felülírja azt — a(z) {command} ebből lehet: {expansion}, végtelen ciklus nélkül."

#. aria-label of the whole aliases pane (a role=group in Settings); heard by screen readers when they enter the pane.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.paneAria"
msgid "Command aliases"
msgstr "Parancsaliasok"

#. Live preview: the typed text matched no alias, so it would go to the server exactly as typed.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.previewMiss"
msgid "Not an alias — this would be sent as typed."
msgstr "Nem alias — ez úgy menne el, ahogy beírtad."

#. aria-label of an alias row's remove button (trash icon; no visible text). {name} is the alias's name — or the row's number while the name is empty; verbatim user content.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.removeAria"
msgid "Remove alias {name}"
msgstr "Alias eltávolítása: {name}"

#. Status line when some rows have errors and are not saved yet. {count} is the number of saved aliases; gettext plural, English index 0 is the singular.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.statusBroken"
msgid "{count} alias saved — rows with errors are not saved."
msgid_plural "{count} aliases saved — rows with errors are not saved."
msgstr[0] "{count} alias mentve — a hibás sorok nincsenek mentve."
msgstr[1] "{count} alias mentve — a hibás sorok nincsenek mentve."

#. Status line under the alias table: how many aliases are saved. {count} is the number; gettext plural, English index 0 is the singular.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.statusSaved"
msgid "{count} alias saved."
msgid_plural "{count} aliases saved."
msgstr[0] "{count} alias mentve."
msgstr[1] "{count} alias mentve."

#. Heading of the command-aliases pane in Settings, where the user defines their own slash commands.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.titleHeading"
msgid "Command aliases"
msgstr "Parancsaliasok"

#. aria-label of the try-it input: type an alias invocation to preview its expansion.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryAria"
msgid "Try an alias"
msgstr "Alias kipróbálása"

#. Try-it placeholder when at least one valid alias exists: an example invocation of that alias. {name} is the alias's name, verbatim; the rest is example prose.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryExample"
msgid "/{name} some arguments"
msgstr "/{name} néhány argumentum"

#. Heading of the live preview: type an alias invocation and see the commands it expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryHeading"
msgid "Try it"
msgstr "Próbáld ki"

#. Variable reference: what $chan expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varChan"
msgid "the current channel or query"
msgstr "az aktuális csatorna vagy beszélgetés"

#. Settings > Aliases variable reference, describing the $$ escape: it expands to a single dollar sign. {character} is that dollar sign, shown in code style.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varLiteral"
msgid "a literal {character}"
msgstr "egy szó szerinti {character}"

#. Variable reference: what $me expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varMe"
msgid "your nick on that network"
msgstr "a beceneved azon a hálózaton"

#. Variable reference: what $1 expands to in an alias body.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varOne"
msgid "one argument (empty when not given)"
msgstr "egy argumentum (üres, ha nincs megadva)"

#. Variable reference: what $2- expands to (everything from the second argument on).
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varRest"
msgid "arguments from the 2nd to the last"
msgstr "a 2.-tól az utolsóig terjedő argumentumok"

#. Variable reference: what $* expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varStar"
msgid "everything after the alias name"
msgstr "minden az alias neve után"

#. Heading of the variables reference: the dollar placeholders an alias body can use.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.variablesHeading"
msgid "Variables"
msgstr "Változók"

#. Checkbox in Settings > Appearance; when ticked, typing in the message input suggests completions for names, emoji and commands.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.autocomplete"
msgid "Enable autocomplete"
msgstr "Automatikus kiegészítés engedélyezése"

#. Checkbox in Settings > Appearance; when ticked, each user's name in chat is drawn in its own consistent color.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.coloredNicks"
msgid "Enable colored nicknames"
msgstr "Színes becenevek engedélyezése"

#. Heading of the section in Settings > Appearance holding the user's own CSS. Keep the capitalization style of the source if possible.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheet"
msgid "Custom Stylesheet"
msgstr "Egyedi stíluslap"

#. Visually hidden label of the custom stylesheet text area in Settings > Appearance, where CSS rules overriding the app's own styles can be entered.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheetHelp"
msgid "Custom stylesheet. You can override any style with CSS here."
msgstr "Egyedi stíluslap. Itt felülbírálható bármely stílus a CSS segítségével."

#. Placeholder of the custom stylesheet text area in Settings > Appearance, written as a CSS comment. Keep the /* */ comment markers.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheetPlaceholder"
msgid "/* You can override any style with CSS here */"
msgstr "/* Itt felülbírálható bármely stílus a CSS segítségével */"

#. aria-label of the slider in Settings > Appearance that changes the size of chat text and the interface with it.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.fontSizeAria"
msgid "Message font size"
msgstr "Üzenetek betűmérete"

#. Heading of the text size control in Settings > Appearance; a slider that scales the whole interface.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.fontSizeHeading"
msgid "Font size"
msgstr "Betűméret"

#. Label of the largest step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:458
msgctxt "settings.appearance.fontSizeHuge"
msgid "Huge"
msgstr "Óriási"

#. Label of the default step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:456
msgctxt "settings.appearance.fontSizeLarge"
msgid "Large"
msgstr "Nagy"

#. Label of the middle step of the font-size slider in Settings → Appearance: the browser's default size. One word.
#: client/components/Settings/Appearance.vue:455
msgctxt "settings.appearance.fontSizeMedium"
msgid "Medium"
msgstr "Közepes"

#. Label of the second step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:454
msgctxt "settings.appearance.fontSizeSmall"
msgid "Small"
msgstr "Kicsi"

#. Label of the smallest step of the font-size slider in Settings → Appearance: the datalist stop and the value shown while dragging. One word.
#: client/components/Settings/Appearance.vue:453
msgctxt "settings.appearance.fontSizeTiny"
msgid "Tiny"
msgstr "Apró"

#. Label of the second-largest step of the font-size slider in Settings → Appearance.
#: client/components/Settings/Appearance.vue:457
msgctxt "settings.appearance.fontSizeXlarge"
msgid "Extra large"
msgstr "Extra nagy"

#. Checkbox in Settings > Appearance; when ticked, chat messages are rendered with Markdown styling such as bold text, code blocks and spoiler marks. Ellipsis is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.markdown"
msgid "Render Markdown formatting (bold, code, spoilers…)"
msgstr "Markdown-formázás megjelenítése (félkövér, kód, spoilerek…)"

#. Settings → Appearance, switch above the theme picker: when on, a theme that has a light and a dark version shows the one matching the device's light or dark mode.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.matchSystemAppearance"
msgid "Match the system's light or dark mode"
msgstr "A rendszer világos vagy sötét módjának követése"

#. Settings → Appearance, switch under the Font size heading, in the native apps only: when on, the app's text size follows the phone's own text-size setting and the slider is hidden.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.matchSystemTextSize"
msgid "Match the system text size"
msgstr "A rendszer szövegméretének követése"

#. Checkbox in Settings > Appearance; when ticked, links to media are shown as an inline playable preview inside the chat instead of a plain link.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.media"
msgid "Preview images, video and audio links inline"
msgstr "Kép-, videó- és hanglinkek előnézete a szövegben"

#. Radio option in Settings > Appearance; media previews load on their own as soon as a message contains one, which exposes your address to the media site. Em dash is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaAlways"
msgid "Show automatically — the media site sees your address as soon as a link appears"
msgstr "Automatikus megjelenítés — a médiaoldal azonnal látja a címedet, amint megjelenik egy link"

#. Radio option in Settings > Appearance; media previews stay behind a placeholder until you click them, so nothing is loaded from the media site before that. Em dash is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaClick"
msgid "Click to reveal — nothing is fetched from the media site until you ask to see it"
msgstr "Kattintásra megjelenítés — semmi sem töltődik le a médiaoldalról, amíg meg nem nézed"

#. Heading of the media preview section in Settings > Appearance, which controls how links to images, video and audio are shown in chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaHeading"
msgid "Media previews"
msgstr "Médiaelőnézetek"

#. Visually hidden group label of the two radio choices in Settings > Appearance that decide when media previews are fetched from their site.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaRevealGroup"
msgid "When to load previews"
msgstr "Mikor töltődjenek be az előnézetek"

#. Heading of the message display section in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.messagesHeading"
msgid "Messages"
msgstr "Üzenetek"

#. Expansion of the acronym MOTD, shown as the abbreviation's hover tooltip on the Message Of The Day checkbox in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.motdTitle"
msgid "Message Of The Day"
msgstr "Napi üzenet"

#. Label of the text field in Settings > Appearance that sets the character(s) inserted after a completed user's name, for example a comma.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfix"
msgid "Nick autocomplete postfix"
msgstr "Becenév automatikus kiegészítésének utótagja"

#. Tooltip on the nick autocomplete postfix field in Settings > Appearance; explains what the field sets.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfixHelp"
msgid "Nick autocomplete postfix (for example a comma)"
msgstr "Becenév automatikus kiegészítésének utótagja (például vessző)"

#. Placeholder of the nick autocomplete postfix field in Settings > Appearance; keep the example punctuation (the quoted comma) as it shows what would be typed.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfixPlaceholder"
msgid "Nick autocomplete postfix (e.g. ', ')"
msgstr "Becenév automatikus kiegészítésének utótagja (pl. ', ')"

#. Settings → Appearance → Your own messages, radio option: your own messages sit on a lighter or darker background band.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesBand"
msgid "Highlighted row"
msgstr "Kiemelt sor"

#. Settings → Appearance → Your own messages, lowercase hint after the 'Highlighted row' option (a dash is drawn before it).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesBandHint"
msgid "the row on a lighter or darker band, the text like everyone else's"
msgstr "a sor világosabb vagy sötétebb sávon, a szöveg olyan, mint bárki másé"

#. Settings → Appearance, heading of the radio group choosing how the user's own chat messages are told apart from everyone else's.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesHeading"
msgid "Your own messages"
msgstr "Saját üzeneteid"

#. Settings → Appearance → Your own messages, radio option: your own messages' text is drawn in the muted grey colour.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesMuted"
msgid "Greyed text"
msgstr "Szürkített szöveg"

#. Settings → Appearance → Your own messages, lowercase hint after the 'Greyed text' option (a dash is drawn before it). 'as before' = this is how the app always looked.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesMutedHint"
msgid "the text in the muted colour, as before"
msgstr "a szöveg halvány színnel, mint korábban"

#. Settings → Appearance → Your own messages, radio option: your own messages look exactly like other people's.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesPlain"
msgid "Same as everyone else's"
msgstr "Ugyanolyan, mint bárki másé"

#. Settings → Appearance → Your own messages, lowercase hint after the 'Same as everyone else's' option (a dash is drawn before it); 'them' = your own messages.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesPlainHint"
msgid "nothing marks them"
msgstr "semmi sem jelöli őket"

#. Heading in Settings > Appearance, shown only under the ps theme: how much the live landscape behind the chat (sky, clouds, birds, rain) moves.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psAnimationHeading"
msgid "Scene animation"
msgstr "Jelenet animációja"

#. Checkbox under Message layout (ps theme): consecutive messages from one sender share one name and time.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psGroupMessages"
msgid "Combine messages from the same person"
msgstr "Ugyanattól a személytől érkező üzenetek összevonása"

#. Hint after the Combine messages checkbox (ps theme).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psGroupMessagesHint"
msgid "their name and time once, for lines sent within ten minutes of each other"
msgstr "a név és az idő csak egyszer, az egymástól tíz percen belül küldött soroknál"

#. Heading in Settings > Appearance, shown only under the ps theme: how chat messages are laid out.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psLayoutHeading"
msgid "Message layout"
msgstr "Üzenetelrendezés"

#. Radio option under Scene animation (ps theme): the scene's motion follows the device.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionAuto"
msgid "Auto"
msgstr "Automatikus"

#. Hint after the Auto option under Scene animation (ps theme); lowercase, it continues the option's label.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionAutoHint"
msgid "follows your device: Full on a computer or tablet, Calm on a phone, one step less on low power"
msgstr "az eszközödet követi: Teljes számítógépen vagy táblagépen, Nyugodt telefonon, energiatakarékos módban egy fokkal kevesebb"

#. Radio option under Scene animation (ps theme): only the clouds move.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionCalm"
msgid "Calm"
msgstr "Nyugodt"

#. Hint after the Calm option under Scene animation (ps theme); lowercase, it continues the option's label.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionCalmHint"
msgid "the clouds drift; the rest holds still"
msgstr "a felhők sodródnak; a többi mozdulatlan"

#. Radio option under Scene animation (ps theme): everything in the landscape moves.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionFull"
msgid "Full"
msgstr "Teljes"

#. Hint after the Full option under Scene animation (ps theme); lowercase, it continues the option's label.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionFullHint"
msgid "everything moves, at your screen's rate"
msgstr "minden mozog, a képernyőd frissítési ütemében"

#. Radio option under Scene animation (ps theme): the landscape does not move.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionStill"
msgid "Still"
msgstr "Álló"

#. Hint after the Still option under Scene animation (ps theme); lowercase, it continues the option's label.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionStillHint"
msgid "a still picture; the sky still follows the time of day"
msgstr "állókép; az ég továbbra is követi a napszakot"

#. Checkbox under Scene animation (ps theme): stop the landscape moving when the user is not looking at the app.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psPauseWhenAway"
msgid "Pause the scene when the window isn't in use"
msgstr "A jelenet szüneteltetése, amikor az ablak nincs használatban"

#. Hint after the Pause the scene checkbox (ps theme); a hidden browser tab stops the landscape whatever this says.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psPauseWhenAwayHint"
msgid "after 15 seconds without the focus, or 2 minutes without input; a hidden tab never moves it"
msgstr "15 másodperc fókusz nélkül vagy 2 perc bevitel nélkül; egy rejtett lapon sosem mozog"

#. Radio label under Words over the plains (ps theme): every message on a translucent card.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsBubbles"
msgid "Bubbles"
msgstr "Buborékok"

#. Hint after the Bubbles radio (ps theme).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsBubblesHint"
msgid "each message on a translucent card: paper by day, dark at night"
msgstr "minden üzenet áttetsző kártyán: nappal papír, éjjel sötét"

#. Radio label under Words over the plains (ps theme): the whole message column on frosted glass.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsGlass"
msgid "Glass"
msgstr "Üveg"

#. Hint after the Glass radio (ps theme).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsGlassHint"
msgid "the whole column on frosted glass, the plains a wash behind it"
msgstr "az egész oszlop matt üvegen, mögötte halványan a síkság"

#. Radio label under Words over the plains (ps theme): a soft dark glow and no outline.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsGlow"
msgid "Soft glow"
msgstr "Lágy ragyogás"

#. Hint after the Soft glow radio (ps theme); 'floor' is the theme's legibility floor (a contrast ratio).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsGlowHint"
msgid "a soft dark glow and nothing else; by day it reads well under the usual floor"
msgstr "lágy sötét ragyogás, semmi más; nappal jóval a szokásos küszöb alatt olvasható"

#. Heading in Settings > Appearance, shown only under the ps theme: how the chat text is drawn over the live scene (six treatments).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsHeading"
msgid "Words over the plains"
msgstr "Szavak a síkság felett"

#. Radio label under Words over the plains (ps theme): white words in a dark outline, the look before the setting existed.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsOutline"
msgid "Outline"
msgstr "Körvonal"

#. Hint after the Outline radio (ps theme).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsOutlineHint"
msgid "white words in a dark outline; ink on snowy days"
msgstr "fehér szavak sötét körvonallal; havas napokon tinta"

#. Radio label under Words over the plains (ps theme): a thinner outline in the sky's colour.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsRim"
msgid "Tinted rim"
msgstr "Színezett perem"

#. Hint after the Tinted rim radio (ps theme); 'floor' is the theme's legibility floor (a contrast ratio).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsRimHint"
msgid "a thinner rim in the sky's own colour; by day it reads under the usual floor"
msgstr "vékonyabb perem az ég saját színében; nappal a szokásos küszöb alatt olvasható"

#. Radio label under Words over the plains (ps theme): a graded wash across the column.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsScrim"
msgid "Scrim"
msgstr "Fátyol"

#. Hint after the Scrim radio (ps theme).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsScrimHint"
msgid "a soft wash across the column, stronger near the edge, no blur"
msgstr "lágy fátyol az oszlopon, a szélén erősebb, elmosás nélkül"

#. Third line of the sample chat under the font-size slider in Settings → Appearance: the extreme steps are intentionally unusable.
#: client/components/Settings/Appearance.vue:486
msgctxt "settings.appearance.sampleEnds"
msgid "The ends are meant to be too small and too big."
msgstr "A két véglet szándékosan túl kicsi és túl nagy."

#. First line of the sample chat under the font-size slider in Settings → Appearance, written by the sample nick grandma: it asks whether the text is comfortable to read.
#: client/components/Settings/Appearance.vue:474
msgctxt "settings.appearance.sampleGlasses"
msgid "Can you read this without your glasses?"
msgstr "El tudod olvasni ezt szemüveg nélkül?"

#. Second line of the sample chat under the font-size slider in Settings → Appearance, the reply telling the reader to drag the slider until the text is comfortable.
#: client/components/Settings/Appearance.vue:480
msgctxt "settings.appearance.sampleSlide"
msgid "Yes! Slide it until this is comfortable."
msgstr "Igen! Húzd addig, amíg kényelmes."

#. Checkbox label in Settings > Appearance that displays the server's Message Of The Day when connecting. {motd} is the untranslated acronym 'MOTD', rendered as a marked abbreviation with a tooltip: put it where your grammar needs the object (for example 'MOTD anzeigen', 'MOTD を表示').
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.showMotd"
msgid "Show {motd}"
msgstr "{motd} megjelenítése"

#. Checkbox in Settings > Appearance; when ticked, message timestamps include the seconds as well as hours and minutes.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.showSeconds"
msgid "Include seconds in timestamp"
msgstr "Másodpercek megjelenítése az időbélyegben"

#. Radio option in Settings > Appearance; joins and parts are compressed into one summary line to keep the chat short.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusCondensed"
msgid "Condense status messages together"
msgstr "Állapotüzenetek összevonása"

#. Heading of the section in Settings > Appearance that controls how join, part and similar service notices are shown in chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHeading"
msgid "Status messages"
msgstr "Állapotüzenetek"

#. Tooltip on the status messages heading in Settings > Appearance; lists the kinds of notices meant (people joining or leaving, being removed, renaming, and permission changes).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHelp"
msgid "Joins, parts, quits, kicks, nick changes, and mode changes"
msgstr "Belépések, távozások, kilépések, kirúgások, becenév-változások és módváltozások"

#. Radio option in Settings > Appearance; joins, parts and similar service notices are not shown at all.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHidden"
msgid "Hide all status messages"
msgstr "Összes állapotüzenet elrejtése"

#. Radio option in Settings > Appearance; every join, part or similar notice appears as its own line in the chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusShown"
msgid "Show all status messages individually"
msgstr "Összes állapotüzenet megjelenítése egyenként"

#. Hint in Settings → Appearance (Android app) while the text size follows the system: where Android sets it. Use the names Android's own Settings app shows in this language.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.systemTextSizeAndroid"
msgid "Set it in Android Settings → Display → Display size and text."
msgstr "Az Android Beállítások → Kijelző → Megjelenítési méret és szöveg menüpontjában állíthatod be."

#. Hint in Settings → Appearance (iOS app) while the text size follows the system: where iOS sets it. Use the names iOS's own Settings app shows in this language.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.systemTextSizeIos"
msgid "Set it in iOS Settings → Display & Brightness → Text Size, or Accessibility → Display & Text Size for larger sizes."
msgstr "Az iOS Beállítások → Kijelző és fényerő → Szövegméret menüpontjában állíthatod be, nagyobb méretekhez pedig a Kisegítő lehetőségek → Kijelző és szövegméret alatt."

#. Heading of the theme section in Settings > Appearance, and the visually hidden label of the theme dropdown beneath it; picks the color scheme of the app.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.theme"
msgid "Theme"
msgstr "Téma"

#. Hint under the theme picker in Settings → Appearance, about the 'match the system's light/dark mode' switch. Theme names stay as they are. {dark} and {light} are the names of the pair's two themes.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.themePairHalves"
msgid "{dark} in dark mode, {light} in light mode."
msgstr "{dark} sötét módban, {light} világos módban."

#. Hint under the theme picker in Settings → Appearance, about the 'match the system's light/dark mode' switch. Theme names stay as they are. The chosen theme has no light/dark partner: {theme} is its name, {pairs} a list of the paired themes ('Coffee / Creama, Cobalt / Frost, and Morning / Day').
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.themePairNone"
msgid "{theme} looks the same in light and dark mode; {pairs} follow the system."
msgstr "{theme} világos és sötét módban is ugyanúgy néz ki; a rendszert követő párok: {pairs}."

#. Hint under the theme picker in Settings → Appearance, about the 'match the system's light/dark mode' switch. Theme names stay as they are. Shown while the switch is off.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.themePairOff"
msgid "When on, each light/dark pair is one entry that shows the half matching the system."
msgstr "Bekapcsolva minden világos/sötét pár egyetlen bejegyzés, amely a rendszerhez illő felét mutatja."

#. The name of the button on a media preview that marks its site, sender or channel as always allowed to load; the words appear quoted inside the always-shown list's help sentence in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedButtonName"
msgid "Always show"
msgstr "Mindig mutasd"

#. Subheading in the always-shown media list of Settings > Appearance above the chat channel entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedChannels"
msgid "Channels"
msgstr "Csatornák"

#. Button in Settings > Appearance beside the always-shown list heading; clicking removes every entry from that list.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedClear"
msgid "Clear all"
msgstr "Összes törlése"

#. Shown under the always-shown media list in Settings > Appearance when it has no entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedEmpty"
msgid "Nothing yet."
msgstr "Még semmi."

#. Heading of the list in Settings > Appearance of sites, people and channels whose media always loads without asking.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedHeading"
msgid "Always shown"
msgstr "Mindig látható"

#. Help line under the always-shown list in Settings > Appearance. {button} is the name of the preview button (settings.appearance.trustedButtonName, 'Always show'), rendered emphasized where the placeholder stands.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedHelp"
msgid "Media in these scopes loads without asking. Add one with {button} on any preview."
msgstr "Az ezekből a forrásokból származó média kérdés nélkül betöltődik. Újat a(z) {button} gombbal adhatsz hozzá bármelyik előnézetnél."

#. Subheading in the always-shown media list of Settings > Appearance above the user account entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedPeople"
msgid "People"
msgstr "Személyek"

#. Subheading in the always-shown media list of Settings > Appearance above the website entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedSites"
msgid "Sites"
msgstr "Webhelyek"

#. Tooltip and aria-label of the remove button on an entry of the always-shown media list in Settings > Appearance, for a website or a person. {name} is that site's host or the person's name. Clicking stops their media from loading automatically.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.untrustFrom"
msgid "Stop always showing from {name}"
msgstr "Ne mutasd mindig innen: {name}"

#. Tooltip and aria-label of the remove button on an entry of the always-shown media list in Settings > Appearance, for a chat channel. {name} is that channel's name.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.untrustIn"
msgid "Stop always showing in {name}"
msgstr "Ne mutasd mindig itt: {name}"

#. Checkbox in Settings > Appearance; when ticked, message timestamps use a 12-hour clock (am/pm) instead of a 24-hour clock.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.use12hClock"
msgid "Use 12-hour timestamps"
msgstr "12 órás időbélyegek használata"

#. Heading of the section in Settings > Appearance holding readability helpers such as nickname colors and autocomplete. Keep the capitalization style of the source if possible.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.visualAids"
msgid "Visual Aids"
msgstr "Vizuális segédletek"

#. Heading of the away section in Settings > General, and the visually hidden label of the away-message input beneath it; names the setting that marks you away with a message when the app is closed.
#: client/components/Settings/General.vue
msgctxt "settings.general.awayHeading"
msgid "Automatic away message"
msgstr "Automatikus távolléti üzenet"

#. Placeholder of the away-message field in Settings > General; shows the message that is sent automatically while the app is not open. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.awayPlaceholder"
msgid "Away message if {appName} is not open"
msgstr "Távolléti üzenet, ha {appName} nincs megnyitva"

#. Sentence shown in the restore-confirmation dialog in Settings > General, saying when the backup file was made. {date} is that day written out in the reader's language (e.g. 9 September 2026). A whole sentence: the dialog puts the separating space in.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupExported"
msgid "Exported {date}."
msgstr "Exportálva: {date}."

#. Body of the confirmation dialog before restoring a settings backup in Settings > General. {parts} is a comma-joined list ('your settings, 1 network, mutes and ignore lists'), {file} the chosen backup file's name.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupFrame"
msgid "This replaces {parts} with the contents of {file}, then reloads."
msgstr "A(z) {file} fájl tartalma lecseréli a következőket: {parts}; utána az oldal újratöltődik."

#. Heading of the settings backup section in Settings > General, which exports preferences to a file and restores them.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupHeading"
msgid "Backup and restore"
msgstr "Biztonsági mentés és visszaállítás"

#. Intro line under the Backup and restore heading in Settings > General; says what exporting does.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupIntro"
msgid "Save your settings to a file. You can restore here or on another device."
msgstr "Mentsd a beállításaidat egy fájlba. Visszaállíthatod itt vagy egy másik eszközön."

#. Part of the restore-confirmation sentence in Settings > General: fills the list of what the file replaces for muted users and ignored users. Comma-joined by position.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupMutes"
msgid "mutes and ignore lists"
msgstr "némítások és mellőzési listák"

#. Part of the settings-restore confirmation in Settings > General; fills the list of what a restore replaces with how many saved chat networks the file carries. The singular shows with exactly one network, the plural otherwise.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupNetworks"
msgid "{count} network"
msgid_plural "{count} networks"
msgstr[0] "{count} hálózat"
msgstr[1] "{count} hálózat"

#. Part of the restore-confirmation sentence in Settings > General: fills the list of what the file replaces for the app's own preferences. Comma-joined with the other parts by position.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupPartSettings"
msgid "your settings"
msgstr "a beállításaid"

#. Sentence shown in the restore-confirmation dialog in Settings > General when the backup file contains saved network passwords. It is a whole sentence: the dialog puts the separating space in, so the translation needs no padding of its own.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupPasswords"
msgid "The file includes network passwords."
msgstr "A fájl tartalmazza a hálózati jelszavakat."

#. Button in Settings > General; downloads the settings backup file to the device. Ellipsis is part of the copy.
#: client/components/Settings/General.vue
msgctxt "settings.general.export"
msgid "Export settings…"
msgstr "Beállítások exportálása…"

#. Error message in Settings > General shown when exporting the settings backup failed and no file was produced.
#: client/components/Settings/General.vue
msgctxt "settings.general.exportFailed"
msgid "Couldn't create the file."
msgstr "Nem sikerült létrehozni a fájlt."

#. Visually hidden but screen-reader-spoken label of the hidden file picker behind the Import settings button; it accepts a previously exported settings file.
#: client/components/Settings/General.vue
msgctxt "settings.general.fileAria"
msgid "Settings file to restore"
msgstr "Visszaállítandó beállításfájl"

#. Button in Settings > General; opens a file picker to restore a previously exported settings backup file. Ellipsis is part of the copy.
#: client/components/Settings/General.vue
msgctxt "settings.general.import"
msgid "Import settings…"
msgstr "Beállítások importálása…"

#. Confirmation button of the settings-restore dialog in Settings > General; clicking restores the file and reloads the app.
#: client/components/Settings/General.vue
msgctxt "settings.general.importButton"
msgid "Import and reload"
msgstr "Importálás és újratöltés"

#. Error notice under the import control in Settings → General when the backup file is corrupt or truncated. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importDamaged"
msgid "This file is damaged."
msgstr "Ez a fájl sérült."

#. Error message in Settings > General shown when the chosen file could not be read as a settings backup.
#: client/components/Settings/General.vue
msgctxt "settings.general.importFailed"
msgid "Couldn't read the file."
msgstr "Nem sikerült beolvasni a fájlt."

#. Error notice under the import control in Settings → General when the backup was written by a newer build of the app that this one cannot read. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNewer"
msgid "This file was made by a newer version."
msgstr "Ezt a fájlt egy újabb verzió készítette."

#. Error notice under the import control in Settings → General when the browser lacks the DecompressionStream API the compressed backup needs. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNoDecompression"
msgid "This browser can't read compressed files."
msgstr "Ez a böngésző nem tud tömörített fájlokat olvasni."

#. Settings → General → Backup and restore: the error shown when restoring a settings file fails because the device's storage is full; the restore was undone, so the device keeps its old settings.
#: client/components/Settings/General.vue
msgctxt "settings.general.importNoRoom"
msgid "There isn't room on this device to import that file. Nothing was changed."
msgstr "Nincs elég hely ezen az eszközön a fájl importálásához. Semmi sem változott."

#. Error notice under the import control in Settings → General when the chosen file is not a settings backup (wrong shape, unparseable). Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNotSettings"
msgid "This isn't a settings file."
msgstr "Ez nem beállításfájl."

#. Title of the confirmation dialog shown before a settings backup file is restored from Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.importTitle"
msgid "Import settings?"
msgstr "Importálod a beállításokat?"

#. Checkbox in Settings > General's backup section; when ticked, the exported settings file also contains the saved chat network passwords.
#: client/components/Settings/General.vue
msgctxt "settings.general.includePasswords"
msgid "Include network passwords"
msgstr "Hálózati jelszavak belefoglalása"

#. Tooltip on the include-network-passwords checkbox in Settings > General; warns that the export keeps passwords in plain text.
#: client/components/Settings/General.vue
msgctxt "settings.general.includePasswordsHelp"
msgid "Passwords are stored in the file unencrypted."
msgstr "A jelszavak titkosítatlanul kerülnek a fájlba."

#. Button in Settings > General; clicking shows the browser's prompt that installs this web app to the device's home screen or app list. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.installApp"
msgid "Install {appName} as an app"
msgstr "{appName} telepítése alkalmazásként"

#. Button in Settings → General: reopens the step-by-step guide to installing the app on this device. {appName} is the app's name.
#: client/components/Settings/General.vue
msgctxt "settings.general.installGuide"
msgid "How to install {appName}"
msgstr "{appName} telepítése – útmutató"

#. Switch label in Settings → General (Android app only).
#: client/components/Settings/General.vue
msgctxt "settings.general.keepAlive"
msgid "Stay connected in the background"
msgstr "Kapcsolat fenntartása a háttérben"

#. Heading in Settings → General (Android app only): keeping the connections open while the app is in the background.
#: client/components/Settings/General.vue
msgctxt "settings.general.keepAliveHeading"
msgid "Background connection"
msgstr "Háttérkapcsolat"

#. Tooltip help of the 'Stay connected in the background' switch (Android app).
#: client/components/Settings/General.vue
msgctxt "settings.general.keepAliveHelp"
msgid "Keeps your connections open while the app is not on screen, with a notification Android shows the whole time. Uses more battery."
msgstr "Nyitva tartja a kapcsolataidat, amíg az alkalmazás nincs a képernyőn; közben az Android folyamatosan egy értesítést mutat. Több akkumulátort használ."

#. Hint under the 'Stay connected in the background' switch when Android notifications are off for the app. {appName} is the app's name.
#: client/components/Settings/General.vue
msgctxt "settings.general.keepAliveNotificationsOff"
msgid "Notifications are off for {appName} in Android's settings, so the connection notification is hidden. Android may still stop the app."
msgstr "Az Android beállításaiban ki vannak kapcsolva az értesítések ehhez: {appName}, így a kapcsolat értesítése rejtve marad. Az Android ettől még leállíthatja az alkalmazást."

#. Checkbox in Settings > General; when ticked, the recent lines of private (one-to-one) conversations are stored in this browser so they come back after the page is reloaded.
#: client/components/Settings/General.vue
msgctxt "settings.general.keepPrivate"
msgid "Keep private conversations on this device"
msgstr "Privát beszélgetések megőrzése ezen az eszközön"

#. Tooltip on the keep-private-conversations checkbox in Settings > General. {lines} and {queries} are numbers (200 and 30 today). Make clear that turning the setting off deletes what is stored.
#: client/components/Settings/General.vue
msgctxt "settings.general.keepPrivateHelp"
msgid "Private conversations come back after a reload: the newest {lines} lines of your {queries} most recent ones, stored in this browser. Turning this off deletes them from this device."
msgstr "A privát beszélgetések újratöltés után visszatérnek: a {queries} legutóbbi beszélgetésed legújabb {lines} sora, ebben a böngészőben tárolva. Ha kikapcsolod, törlődnek erről az eszközről."

#. Heading of the Native app section in Settings > General; groups the install and link-handler options for using the chat app as an installed application.
#: client/components/Settings/General.vue
msgctxt "settings.general.nativeApp"
msgid "Native app"
msgstr "Natív alkalmazás"

#. Button in Settings > General; registers this web app as the handler for web+irc:// chat links so clicking one anywhere opens it in the app. Keep the web+irc:// scheme verbatim. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.openLinks"
msgid "Open web+irc:// links with {appName}"
msgstr "web+irc:// linkek megnyitása ezzel: {appName}"

#. Section heading in Settings > General for whether private (one-to-one) conversations are kept in this browser between visits.
#: client/components/Settings/General.vue
msgctxt "settings.general.privateHeading"
msgid "Private conversations"
msgstr "Privát beszélgetések"

#. Checkbox in Settings > General; when ticked, other people in the channel are told while you are typing a message.
#: client/components/Settings/General.vue
msgctxt "settings.general.sendTyping"
msgid "Send typing notifications"
msgstr "Gépelésjelzés küldése"

#. Tooltip on the send-typing-notifications checkbox in Settings > General; mentions the IRCv3 +typing tag in parentheses.
#: client/components/Settings/General.vue
msgctxt "settings.general.sendTypingHelp"
msgid "Lets people in the channel see when you are typing (IRCv3 +typing)."
msgstr "Lehetővé teszi, hogy a csatornában lévők lássák, amikor gépelsz (IRCv3 +typing)."

#. Heading of the typing indicator section in Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.typingHeading"
msgid "Typing notifications"
msgstr "Gépelésjelzések"

#. Checkbox in Settings > General. When ticked, images are re-drawn through a canvas before they are sent to the chat server, which strips photo metadata such as camera model and GPS location. Affects image uploads only.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadCanvas"
msgid "Attempt to remove metadata from images before uploading"
msgstr "Metaadatok eltávolításának megkísérlése a képekről feltöltés előtt"

#. Tooltip on the metadata-removal upload checkbox in Settings > General; explains how the option works and that it can mis-rotate photos in browsers without canvas orientation support.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadCanvasHelp"
msgid "This option renders the image into a canvas element to remove metadata from the image. This may break orientation if your browser does not support that."
msgstr "Ez a beállítás a képet egy canvas elemre rajzolja ki, hogy eltávolítsa belőle a metaadatokat. Ez elronthatja a tájolást, ha a böngésződ nem támogatja."

#. Heading of the file upload options section in Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadsHeading"
msgid "File uploads"
msgstr "Fájlfeltöltések"

#. The first option of the interface-language picker: the language the browser asks for is used. {language} is that language's name, written in itself.
#: client/components/LanguageSelect.vue
msgctxt "settings.locale.auto"
msgid "System default ({language})"
msgstr "Rendszer alapértelmezése ({language})"

#. Button on the networks settings page; opens the connect form to set up a new chat network connection.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.add"
msgid "Add network"
msgstr "Hálózat hozzáadása"

#. Button on a saved network row in the networks settings page while that network is offline; clicking dials the chat network again.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connect"
msgid "Connect"
msgstr "Kapcsolódás"

#. Status label on a saved network row in the networks settings page; the connection to that chat network is up.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connected"
msgid "Connected"
msgstr "Kapcsolódva"

#. Status label on a saved network row in the networks settings page, and the caption of the same row's button, while the connection to that chat network is being established. Ellipsis is part of the copy.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connecting"
msgid "Connecting…"
msgstr "Kapcsolódás…"

#. Button on a saved network row in the networks settings page; opens a confirmation before the saved network is removed.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.delete"
msgid "Delete"
msgstr "Törlés"

#. Confirmation button of the dialog that removes a saved chat network.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteButton"
msgid "Delete network"
msgstr "Hálózat törlése"

#. Body of the confirmation dialog before removing a saved chat network; explains what the deletion does.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteText"
msgid "This removes the saved network and disconnects it if it is running."
msgstr "Ez törli a mentett hálózatot, és bontja a kapcsolatot, ha fut."

#. Title of the confirmation dialog before removing a saved chat network. {name} is the network's display name.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteTitle"
msgid "Delete {name}?"
msgstr "{name} törlése?"

#. Status label on a saved network row in the networks settings page; the connection to that chat network is down.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.disconnected"
msgid "Disconnected"
msgstr "Kapcsolat bontva"

#. Button on a saved network row in the networks settings page; opens the form where that network's address and credentials are changed.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.edit"
msgid "Edit"
msgstr "Szerkesztés"

#. Empty state of the networks settings page, shown when no chat network has been saved in this browser.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.empty"
msgid "No networks saved yet."
msgstr "Még nincs mentett hálózat."

#. Heading of the networks page in the chat app's settings, which lists the IRC network connections saved in this browser.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.heading"
msgid "Networks"
msgstr "Hálózatok"

#. Line under the Networks heading in the settings, saying what the page is for.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.intro"
msgid "Manage the IRC networks saved in this browser."
msgstr "Az ebben a böngészőben mentett IRC-hálózatok kezelése."

#. Button on a saved network row in the networks settings page while that network is connected; clicking opens the network's chat view.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.open"
msgid "Open"
msgstr "Megnyitás"

#. Warning line in Settings > Notifications when notification permission has been denied in the browser.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserBlocked"
msgid "Notifications are blocked by your browser."
msgstr "A böngésző letiltotta az értesítéseket."

#. Heading of the section in Settings > Notifications about the browser's own notifications while the app is open.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserHeading"
msgid "Browser Notifications"
msgstr "Böngészőértesítések"

#. Intro line of the browser notifications section in Settings > Notifications; the quoted phrase names the toggle in each network's edit form. Keep the curly quotes.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserPerNetwork"
msgid "Browser notifications are also per network — enabled by default, toggled in each network's settings (Edit network → “Browser notifications for this network”)."
msgstr "A böngészőértesítések is hálózatonként működnek — alapértelmezés szerint be vannak kapcsolva, és minden hálózat beállításaiban kapcsolhatók (Hálózat szerkesztése → „Böngészőértesítések ehhez a hálózathoz”)."

#. Warning line in Settings > Notifications when the browser cannot show notifications at all.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserUnsupported"
msgid "Notifications are not supported by your browser."
msgstr "A böngésző nem támogatja az értesítéseket."

#. Placeholder of the custom-highlights and highlight-exceptions fields in Settings > Notifications; shows the expected input format.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.commaList"
msgid "Comma-separated, e.g.: word, some more words, anotherword"
msgstr "Vesszővel elválasztva, például: szó, néhány további szó, másikszó"

#. Checkbox in Settings > Notifications; when ticked, messages mentioning you are drawn with a colored background and can notify.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlight"
msgid "Highlight messages that mention you"
msgstr "A téged említő üzenetek kiemelése"

#. Label of the text field in Settings > Notifications for words that suppress highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightExceptions"
msgid "Highlight exceptions"
msgstr "Kiemelési kivételek"

#. Tooltip on the highlight-exceptions field in Settings > Notifications; explains that these words suppress highlight treatment.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightExceptionsHelp"
msgid "If a message contains any of these comma-separated expressions, it will not trigger a highlight even if it contains your nickname or expressions defined in custom highlights."
msgstr "Ha egy üzenet tartalmazza ezen vesszővel elválasztott kifejezések bármelyikét, nem vált ki kiemelést, még akkor sem, ha a beceneved vagy egyéni kiemelésben megadott kifejezés szerepel benne."

#. Tooltip on the highlight checkbox in Settings > Notifications; explains the visual effect of highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightHelp"
msgid "Messages that mention you or match a custom highlight get a colored background and border in the channel."
msgstr "A téged említő vagy egyéni kiemelésnek megfelelő üzenetek színes hátteret és keretet kapnak a csatornában."

#. Label of the text field in Settings > Notifications for extra words that count as mentions of you.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlights"
msgid "Custom highlights"
msgstr "Egyéni kiemelések"

#. Tooltip on the custom highlights field in Settings > Notifications; explains the field's comma-separated format.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightsHelp"
msgid "If a message contains any of these comma-separated expressions, it will trigger a highlight."
msgstr "Ha egy üzenet tartalmazza ezen vesszővel elválasztott kifejezések bármelyikét, kiemelést vált ki."

#. Warning line in Settings > Notifications, shown on an iPhone browsing the app without installing it; the parenthesized phrase is the iOS share menu's action.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.iosNotInstalled"
msgid "On iOS, push notifications are only available after installing the app to the Home Screen (Share → Add to Home Screen)."
msgstr "iOS-en a push-értesítések csak azután érhetők el, hogy az alkalmazást hozzáadtad a Főképernyőhöz (Megosztás → Főképernyőhöz adás)."

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: show a confirmation prompt before the device re-subscribes. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeAsk"
msgid "Wary — ask before renewing the subscription"
msgstr "Óvatos — kérdezzen a feliratkozás megújítása előtt"

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: do nothing, so push stays off for that server until renewed from its network settings. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeIgnore"
msgid "Suspicious — leave it alone; push from that server stays off until you renew from the network settings"
msgstr "Gyanakvó — hagyja békén; az adott szerver push-értesítései kikapcsolva maradnak, amíg meg nem újítod a hálózat beállításaiban"

#. Heading-like line in Settings > Notifications introducing the three radio choices for what to do when a chat server's push identity changes; the colon leads into the choices.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeIntro"
msgid "When a server's push identity (its key) changes, this device's subscription for it stops working. Then:"
msgstr "Amikor egy szerver push-azonosítója (kulcsa) megváltozik, ennek az eszköznek a feliratkozása nem működik tovább. Ilyenkor:"

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: re-subscribe immediately and silently. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeTrust"
msgid "Naive — renew it on the spot, without asking"
msgstr "Naiv — azonnal megújítja, kérdés nélkül"

#. Warning line in Settings > Notifications when the page is not served over a secure connection, which browsers require for notifications.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.noHttps"
msgid "Notifications are only supported over HTTPS connections."
msgstr "Az értesítések csak HTTPS-kapcsolaton működnek."

#. Checkbox in Settings > Notifications; when ticked, every chat message notifies, not only mentions and highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.notifyAll"
msgid "Enable notification for all messages"
msgstr "Értesítés minden üzenetről"

#. Button in Settings > Notifications beside the notification-sound checkbox; clicking plays the notification sound once as a preview.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.playSound"
msgid "Play sound"
msgstr "Hang lejátszása"

#. Warning line in Settings > Notifications when the chat server refused the push subscription; SASL (the IRC login mechanism) stays verbatim.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushBlocked"
msgid "The server refused the push subscription. It may require logging in (SASL) before subscribing."
msgstr "A szerver elutasította a push-feliratkozást. Lehet, hogy feliratkozás előtt be kell jelentkezni (SASL)."

#. Warning line in Settings > Notifications when notification permission was denied; points at the browser's site settings to re-enable.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushDenied"
msgid "Notifications are blocked by your browser. Allow them in the browser's site settings, then try again."
msgstr "A böngésző letiltotta az értesítéseket. Engedélyezd őket a böngésző webhelybeállításaiban, majd próbáld újra."

#. Settings → Notifications, after "Warning:", in the Android app when the system has notifications switched off for it. "Android's settings for the app" is the system's per-app settings page.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushDeniedAndroid"
msgid "Notifications are turned off for this app. Allow them in Android's settings for the app, then try again."
msgstr "Az értesítések ki vannak kapcsolva ennél az alkalmazásnál. Engedélyezd őket az alkalmazás Android-beállításaiban, majd próbáld újra."

#. Heading of the push notification section in Settings > Notifications; push wakes the app on new messages while it is closed.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushHeading"
msgid "Push Notifications"
msgstr "Push-értesítések"

#. Intro line of the push section in Settings > Notifications; explains that push is enabled per chat network from that network's edit form (the quoted phrase names that setting) and that each server decides whether to support it. Keep the curly quotes and the arrow.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushPerNetwork"
msgid "Push is set up per network — turn it on or off in each network's settings (Edit network → “Push notifications for this network”), where the enrollment status is also shown. The browser delivers the notifications; each push-capable server decides whether to wake this app."
msgstr "A push hálózatonként állítható be — kapcsold be vagy ki az egyes hálózatok beállításaiban (Hálózat szerkesztése → „Push-értesítések ehhez a hálózathoz”), ahol a feliratkozás állapota is látszik. Az értesítéseket a böngésző kézbesíti; minden push-képes szerver maga dönti el, hogy felébreszti-e az alkalmazást."

#. Warning line in Settings > Notifications when the chat server itself does not offer web push; names the IRCv3 draft/webpush capability, which stays verbatim.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.serverUnsupported"
msgid "Push notifications need a connected server that supports the draft/webpush capability and you to be logged in to an account."
msgstr "A push-értesítésekhez olyan csatlakoztatott szerver kell, amely támogatja a draft/webpush képességet, és be kell jelentkezned egy fiókba."

#. Checkbox in Settings > Notifications; when ticked, a sound plays alongside a notification.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.sound"
msgid "Enable notification sound"
msgstr "Értesítési hang engedélyezése"

#. Warning line in Settings > Notifications shown after a chat server changed its push identity; tells the reader to re-subscribe from that network's edit form, whose control is named in the quoted phrase.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.stale"
msgid "A server's push identity (its key) changed, so this device's push subscription for it no longer works. Renew it from that network's settings (Edit network → “Renew push notifications”) to keep being notified while the app is closed."
msgstr "Egy szerver push-azonosítója (kulcsa) megváltozott, ezért ennek az eszköznek a push-feliratkozása nem működik tovább. Újítsd meg a hálózat beállításaiban (Hálózat szerkesztése → „Push-értesítések megújítása”), hogy továbbra is kapj értesítéseket, amikor az alkalmazás zárva van."

#. Warning line in Settings > Notifications when the browser cannot do web push; the parentheses name the browser features push requires.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.unsupported"
msgid "Push notifications are not supported by this browser (they need the Push API, a service worker and a secure context)."
msgstr "Ez a böngésző nem támogatja a push-értesítéseket (ezekhez Push API, service worker és biztonságos környezet kell)."

#. Word rendered bold at the start of several warning lines in Settings > Notifications (push and browser notification problems); a colon follows it.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.warning"
msgid "Warning"
msgstr "Figyelmeztetés"

#. Label of the Settings modal's Aliases tab (tab strip); switching tabs navigates to the Aliases settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.aliases"
msgid "Aliases"
msgstr "Aliasok"

#. Label of the Settings modal's Appearance tab (tab strip); switching tabs navigates to the Appearance settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.appearance"
msgid "Appearance"
msgstr "Megjelenés"

#. aria-label of the row of tab buttons across the top of the settings window, used to switch between its pages.
#: client/components/Settings/Navigation.vue
msgctxt "settings.tabs.aria"
msgid "Settings tabs"
msgstr "Beállítások lapjai"

#. Label of the Settings modal's General tab (tab strip); switching tabs navigates to the General settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.general"
msgid "General"
msgstr "Általános"

#. Label of the Settings modal's Networks tab (tab strip); switching tabs navigates to the Networks settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.networks"
msgid "Networks"
msgstr "Hálózatok"

#. Label of the Settings modal's Notifications tab (tab strip); switching tabs navigates to the Notifications settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.notifications"
msgid "Notifications"
msgstr "Értesítések"

#. Name of the Translation tab in the Settings tab strip: on-device translation of messages.
#: client/components/Settings/Navigation.vue
msgctxt "settings.tabs.translation"
msgid "Translation"
msgstr "Fordítás"

#. Tooltip of the developer badge next to the sidebar logo, shown only in development builds; {app} is the app's display name.
#: client/components/Sidebar.vue:8
msgctxt "sidebar.devBuildTitle"
msgid "{app} has been built in development mode"
msgstr "{app} fejlesztői módban készült"

#. Small orange badge next to the sidebar logo, shown only in development builds so a dev build is never mistaken for a deploy.
#: client/components/Sidebar.vue:16
msgctxt "sidebar.developerBadge"
msgid "DEVELOPER"
msgstr "FEJLESZTŐ"

#. Message shown in the sidebar when there are no networks at all; the connect form is open beside it.
#: client/components/NetworkList.vue:8
msgctxt "sidebar.empty"
msgid "You are not connected to any networks yet."
msgstr "Még nem kapcsolódtál egyetlen hálózathoz sem."

#. aria-label of the question-mark button in the sidebar footer: opens the help window.
#: client/components/Sidebar.vue:51
msgctxt "sidebar.help"
msgid "Help"
msgstr "Segítség"

#. aria-label of the help button in the sidebar footer when a newer build is available; the parenthetical sits on its own line.
#: client/components/Sidebar.vue:50
msgctxt "sidebar.helpUpdate"
msgid "Help\n(update available)"
msgstr "Súgó\n(frissítés érhető el)"

#. Placeholder of the sidebar's jump-to search field that filters the channel list.
#: client/components/NetworkList.vue:17
msgctxt "sidebar.jumpTo"
msgid "Jump to..."
msgstr "Ugrás..."

#. Tooltip and screen-reader label of the globe button beside the sidebar logo, which opens the language panel (the same selector the connect form and Settings → Appearance carry).
#: client/components/Sidebar.vue:8
msgctxt "sidebar.language"
msgid "Display language"
msgstr "Megjelenítési nyelv"

#. Part of a sidebar channel row's aria-label and tooltip, after the channel name: how many messages highlight (mention) the user.
#: client/components/ChannelWrapper.vue:97
msgctxt "sidebar.mentions"
msgid "{count} mention"
msgid_plural "{count} mentions"
msgstr[0] "{count} említés"
msgstr[1] "{count} említés"

#. aria-label of the sidebar's navigation region (the network/channel list).
#: client/components/NetworkList.vue:6
#: client/components/NetworkList.vue:10
msgctxt "sidebar.networkList"
msgid "Network and Channel list"
msgstr "Hálózatok és csatornák listája"

#. Shown under the sidebar's jump-to search field when nothing matches.
#: client/components/NetworkList.vue:55
msgctxt "sidebar.noResults"
msgid "No results found."
msgstr "Nincs eredmény."

#. Screen-reader-only label of the sidebar's jump-to search input (visually hidden).
#: client/components/NetworkList.vue:12
msgctxt "sidebar.searchLabel"
msgid "Search among the channel list"
msgstr "Keresés a csatornalistában"

#. aria-label of the gear button in the sidebar footer: opens the settings window.
#: client/components/Sidebar.vue:32
msgctxt "sidebar.settings"
msgid "Settings"
msgstr "Beállítások"

#. aria-label of the hamburger button that opens and closes the sidebar (channel list) on narrow screens.
#: client/components/SidebarToggle.vue:2
msgctxt "sidebar.toggle"
msgid "Toggle channel list"
msgstr "Csatornalista be/ki"

#. Title and aria-label of the ladybird button in the sidebar, shown only in development builds: opens or closes the eruda in-page devtools.
#: client/components/Sidebar.vue:22
msgctxt "sidebar.toggleDevtools"
msgid "Toggle eruda devtools"
msgstr "Eruda fejlesztőeszközök be/ki"

#. Part of a sidebar channel row's aria-label and tooltip, after the channel name: how many unread messages it holds.
#: client/components/ChannelWrapper.vue:89
msgctxt "sidebar.unread"
msgid "{count} unread message"
msgid_plural "{count} unread messages"
msgstr[0] "{count} olvasatlan üzenet"
msgstr[1] "{count} olvasatlan üzenet"

#. Column header of the channel-ban list: the banned hostmask, verbatim server data.
#: client/components/Special/ListBans.vue
msgctxt "special.bans.banned"
msgid "Banned"
msgstr "Kitiltva"

#. Column header of the channel-ban list: when the ban was set, locale-formatted.
#: client/components/Special/ListBans.vue
msgctxt "special.bans.bannedAt"
msgid "Banned At"
msgstr "Kitiltás ideje"

#. Column header of the channel-ban list: the operator who set the ban, verbatim.
#: client/components/Special/ListBans.vue
msgctxt "special.bans.bannedBy"
msgid "Banned By"
msgstr "Kitiltotta"

#. Column header of the channel list: the channel name, verbatim server data.
#: client/components/Special/ListChannels.vue
msgctxt "special.channels.channel"
msgid "Channel"
msgstr "Csatorna"

#. Column header of the channel list: the channel's topic, verbatim server data.
#: client/components/Special/ListChannels.vue
msgctxt "special.channels.topic"
msgid "Topic"
msgstr "Téma"

#. Column header of the channel list: how many visible users the channel has.
#: client/components/Special/ListChannels.vue
msgctxt "special.channels.users"
msgid "Users"
msgstr "Felhasználók"

#. Column header of the ban-exception list: the exempted hostmask, verbatim server data.
#: client/components/Special/ListExcepts.vue
msgctxt "special.excepts.exempted"
msgid "Exempted"
msgstr "Kivétel"

#. Column header of the ban-exception list: when the exception was set, locale-formatted.
#: client/components/Special/ListExcepts.vue
msgctxt "special.excepts.exemptedAt"
msgid "Exempted At"
msgstr "Kivétel ideje"

#. Column header of the ban-exception list: who set the exception, verbatim.
#: client/components/Special/ListExcepts.vue
msgctxt "special.excepts.exemptedBy"
msgid "Exempted By"
msgstr "Kivételt beállította"

#. Column header of the ignore list: the ignored hostmask, verbatim server data.
#: client/components/Special/ListIgnored.vue
msgctxt "special.ignored.hostmask"
msgid "Hostmask"
msgstr "Hosztmaszk"

#. Column header of the ignore list: when the ignore was set, locale-formatted.
#: client/components/Special/ListIgnored.vue
msgctxt "special.ignored.ignoredAt"
msgid "Ignored At"
msgstr "Mellőzés ideje"

#. Column header of the channel-invite list: the invited hostmask, verbatim server data.
#: client/components/Special/ListInvites.vue
msgctxt "special.invites.invited"
msgid "Invited"
msgstr "Meghívva"

#. Column header of the channel-invite list: when the invite was set, locale-formatted.
#: client/components/Special/ListInvites.vue
msgctxt "special.invites.invitedAt"
msgid "Invited At"
msgstr "Meghívás ideje"

#. Column header of the channel-invite list: who set the invite, verbatim.
#: client/components/Special/ListInvites.vue
msgctxt "special.invites.invitedBy"
msgid "Invited By"
msgstr "Meghívta"

#. Why fragment of 'Message not sent: {why}' (FAIL BATCH MULTILINE_INVALID_TARGET). Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.invalidTarget"
msgid "its lines did not all go to the same target."
msgstr "a sorai nem mind ugyanarra a célra mentek."

#. Why fragment of 'Message not sent: {why}' (FAIL BATCH MULTILINE_MAX_BYTES without a limit named). Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxBytes"
msgid "it was too long for one multi-line message."
msgstr "túl hosszú volt egyetlen többsoros üzenethez."

#. Why fragment of 'Message not sent: {why}'; {limit} is the byte limit the server named.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxBytesLimit"
msgid "it was too long for one multi-line message (the server's limit is {limit} bytes)."
msgstr "túl hosszú volt egyetlen többsoros üzenethez (a szerver korlátja {limit} bájt)."

#. Why fragment of 'Message not sent: {why}' (FAIL BATCH MULTILINE_MAX_LINES without a limit named). Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxLines"
msgid "it had too many lines for one multi-line message."
msgstr "túl sok sora volt egyetlen többsoros üzenethez."

#. Why fragment of 'Message not sent: {why}'; {limit} is the line limit the server named.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxLinesLimit"
msgid "it had too many lines for one multi-line message (the server's limit is {limit})."
msgstr "túl sok sora volt egyetlen többsoros üzenethez (a szerver korlátja {limit})."

#. Why fragment of 'Message not sent: {why}' when the server's rejection named no cause. Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.rejected"
msgid "the server rejected the multi-line batch."
msgstr "a szerver elutasította a többsoros csomagot."

#. Channel error when the server threw away a whole multi-line message; {why} is one of the sr.multiline* copies or the server's own description, left verbatim.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multilineNotSent"
msgid "Message not sent: {why}"
msgstr "Az üzenet nem ment el: {why}"

#. Channel error for a refused deletion (FAIL REDACT DISABLED); the server's own copy is replaced with this phrasing.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactDisabled"
msgid "Deleting messages is disabled on this server."
msgstr "Az üzenetek törlése le van tiltva ezen a szerveren."

#. Channel error when a message edit was dropped because its redaction was refused; {why} is one of the sr.redact* copies or the server's own description, left verbatim.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactEditPrefix"
msgid "Edit not sent: {why}"
msgstr "A szerkesztés nem ment el: {why}"

#. Channel error for a refused deletion (FAIL REDACT REDACT_FORBIDDEN).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactForbidden"
msgid "You are not allowed to delete that message."
msgstr "Nincs jogod törölni ezt az üzenetet."

#. Channel error for a refused deletion aimed at a non-channel (FAIL REDACT INVALID_TARGET).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactInvalidTarget"
msgid "Messages can only be deleted in channels."
msgstr "Üzeneteket csak csatornákban lehet törölni."

#. Channel error for a refused deletion; {why} is one of the sr.redact* copies or the server's own description, left verbatim.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactPrefix"
msgid "Could not delete message: {why}"
msgstr "Nem sikerült törölni az üzenetet: {why}"

#. Channel error for a deletion naming a message the server has forgotten (FAIL REDACT UNKNOWN_MSGID).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactUnknownMsgid"
msgid "The server no longer has that message."
msgstr "A szerveren már nincs meg ez az üzenet."

#. Channel error for a deletion past the server's edit window (FAIL REDACT REDACT_WINDOW_EXPIRED).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactWindowExpired"
msgid "That message is too old to delete."
msgstr "Ez az üzenet túl régi ahhoz, hogy törölni lehessen."

#. Title of the left action button on a push notification (shown on every platform): marks the conversation read on the server at this notification's newest message, which also closes the notification on the reader's other devices.
#: client/service-worker.js:1146
msgctxt "sw.markRead"
msgid "Mark read"
msgstr "Megjelölés olvasottként"

#. Body of the silent stub notification the worker shows under WebKit (an iPhone's Home Screen web app) when another device, or this one, read a pushed conversation: it replaces that conversation's notification for about 30 seconds, because WebKit counts a push that shows nothing toward unsubscribing the app. The title is the conversation's name.
#: client/service-worker.js:1416
msgctxt "sw.markedRead"
msgid "Marked as read"
msgstr "Olvasottnak jelölve"

#. Body of the fallback notification shown when a push payload cannot be parsed into a conversation message, or the worker hit an error: something happened, but there is nothing to show. The title is the app name and is never translated.
#: client/service-worker.js:1194
#: client/service-worker.js:1212
msgctxt "sw.newActivity"
msgid "New activity while you were away."
msgstr "Új tevékenység, amíg távol voltál."

#. Body of a notification for a push payload that named no message text (a degraded opt-down tier): the conversation saw activity whose content was not delivered.
#: client/service-worker.js:992
msgctxt "sw.newMessage"
msgid "New message"
msgstr "Új üzenet"

#. Title of the right action button on a push notification; where the platform has an inline reply field it opens that, else it opens the conversation. Kept last so a thumb lands on it.
#: client/service-worker.js:1150
msgctxt "sw.reply"
msgid "Reply"
msgstr "Válasz"

#. Placeholder of the notification's inline reply text field (platforms that show one, e.g. desktop Chrome); what the reader types goes to the conversation as one IRC message.
#: client/service-worker.js:1151
msgctxt "sw.replyPlaceholder"
msgid "Reply…"
msgstr "Válasz…"

#. Notification title for a message in a channel: {nick} is the sender's nickname, {target} the channel name. Translated as a whole so word order is free; the unread-count suffix is appended after it, never inside.
#: client/service-worker.js:1134
msgctxt "sw.titleChannel"
msgid "{nick} in {target}"
msgstr "{nick} itt: {target}"

#. Push-notification title for a channel conversation carrying more than one unread message. {nick} is the nick of the newest message's author and {target} is the channel name — both verbatim, never translate them; {count} is the number of unread messages the notification carries.
#: client/service-worker.js:1137
msgctxt "sw.titleChannelCount"
msgid "{nick} in {target} ({count})"
msgstr "{nick} itt: {target} ({count})"

#. Push-notification title for a query (direct-message) conversation carrying more than one unread message. {nick} is the other side's nick, verbatim — never translate it; {count} is the number of unread messages.
#: client/service-worker.js:1141
msgctxt "sw.titleNickCount"
msgid "{nick} ({count})"
msgstr "{nick} ({count})"

#. System line when a user is marked away. {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element. The away reason (user-set, verbatim) follows in parentheses.
#: client/components/MessageTypes/away.vue:10
msgctxt "system.away"
msgid "{nick} is away"
msgstr "{nick} távol van"

#. System line when a user returns from away. {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element.
#: client/components/MessageTypes/back.vue:10
msgctxt "system.back"
msgid "{nick} is back"
msgstr "{nick} visszatért"

#. System line tail case: a user's username/hostname changed but neither value arrived (degenerate). {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element.
#: client/components/MessageTypes/chghost.vue:4
msgctxt "system.chghost"
msgid "{nick} has changed"
msgstr "{nick} adatai megváltoztak"

#. System line when a user's username AND hostname change together. {nick} and {ident} are VERBATIM user content; {host} is a verbatim technical value; {nick} renders as the interactive username element.
#: client/components/MessageTypes/chghost.vue:12
msgctxt "system.chghostBoth"
msgid "{nick} has changed username to {ident} and hostname to {host}"
msgstr "{nick} felhasználóneve mostantól {ident}, gépneve {host}"

#. System line when a user's hostname changes. {nick} is the user's nick (VERBATIM, renders as the interactive username element) and {host} the new hostname (verbatim technical value).
#: client/components/MessageTypes/chghost.vue:9
msgctxt "system.chghostHost"
msgid "{nick} has changed hostname to {host}"
msgstr "{nick} gépneve mostantól {host}"

#. System line when a user's username (ident) changes. {nick} is the user's nick and {ident} the new username — both VERBATIM, never translate; {nick} renders as the interactive username element.
#: client/components/MessageTypes/chghost.vue:6
msgctxt "system.chghostIdent"
msgid "{nick} has changed username to {ident}"
msgstr "{nick} felhasználóneve mostantól {ident}"

#. System line for an incoming CTCP request. {nick} is the sender's nick (VERBATIM user content, renders as the interactive username element); {ctcp} is the fixed abbreviation CTCP (never translate); {message} is the verbatim CTCP payload.
#: client/components/MessageTypes/ctcp_request.vue:5
msgctxt "system.ctcpRequest"
msgid "{nick} sent a {ctcp} request: {message}"
msgstr "{nick} {ctcp}-kérést küldött: {message}"

#. System line when a user invites someone else. {nick} is the inviter's nick and {target} the invited user's nick — both VERBATIM user content, each rendering as an interactive username element where its placeholder stands; {channel} is the channel name (verbatim).
#: client/components/MessageTypes/invite.vue:9
msgctxt "system.inviteTarget"
msgid "{nick} has invited {target} to {channel}"
msgstr "{nick} meghívta {target} felhasználót ide: {channel}"

#. System line when the invite targets the reader. {nick} is the inviter's nick (VERBATIM user content, renders as the interactive username element) and {channel} the channel name (verbatim).
#: client/components/MessageTypes/invite.vue:7
msgctxt "system.inviteYou"
msgid "{nick} has invited you to {channel}"
msgstr "{nick} meghívott ide: {channel}"

#. System line when a user joins a channel. {nick} is the joining user's nick, VERBATIM user content — never translate or inflect it; it renders as the interactive username element inline where the placeholder stands, so word order around it is the translator's.
#: client/components/MessageTypes/join.vue:8
msgctxt "system.join"
msgid "{nick} has joined the channel"
msgstr "{nick} belépett a csatornába"

#. System line when a user is kicked from a channel. {nick} is the kicker's nick and {target} the kicked user's nick — both VERBATIM user content, each rendering as an interactive username element where its placeholder stands.
#: client/components/MessageTypes/kick.vue:6
msgctxt "system.kick"
msgid "{nick} has kicked {target}"
msgstr "{nick} kirúgta {target} felhasználót a csatornáról"

#. System line when a channel or user mode changes. {nick} is the nick that set the mode, VERBATIM user content; {modes} is the verbatim mode change (e.g. +o nick), rendered as-is.
#: client/components/MessageTypes/mode.vue:6
msgctxt "system.mode"
msgid "{nick} sets mode {modes}"
msgstr "{nick} beállította a módot: {modes}"

#. System line when a user changes nick. {nick} is the old nick and {newNick} the new one — both VERBATIM user content, each rendering as an interactive username element where its placeholder stands.
#: client/components/MessageTypes/nick.vue:6
msgctxt "system.nick"
msgid "{nick} is now known as {newNick}"
msgstr "{nick} új beceneve: {newNick}"

#. System line when a user parts a channel. {nick} is the parting user's nick, VERBATIM user content — never translate or inflect it; it renders as the interactive username element.
#: client/components/MessageTypes/part.vue:6
msgctxt "system.part"
msgid "{nick} has left the channel"
msgstr "{nick} elhagyta a csatornát"

#. System line when a user disconnects from the network. {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element. The quit reason (user-set, verbatim) follows the sentence in parentheses.
#: client/components/MessageTypes/quit.vue:6
msgctxt "system.quit"
msgid "{nick} has quit"
msgstr "{nick} kilépett"

#. Reason given when pending token requests (upload tokens) are dropped because the connection closed; shown inside the upload error notice.
#: client/js/irc/authtoken.ts
msgctxt "token.disconnected"
msgid "Disconnected"
msgstr "Kapcsolat bontva"

#. Reason given when the server answered a TOKEN GENERATE request with a FAIL that carried no text; shown inside the upload error notice. {code} is the server's error code, verbatim.
#: client/js/irc/authtoken.ts
msgctxt "token.failed"
msgid "Token request failed ({code})"
msgstr "A tokenkérés sikertelen ({code})"

#. Reason given when a TOKEN GENERATE request (an upload token from the network's own file host) got no answer in time; shown inside the upload error notice.
#: client/js/irc/authtoken.ts
msgctxt "token.timeout"
msgid "The server did not answer the token request"
msgstr "A szerver nem válaszolt a tokenkérésre"

#. Tooltip and aria-label of the translate button in a message's hover toolbar when the message's translation was hidden; it brings it back.
#: client/components/MessageActions.vue
msgctxt "translate.action.showTranslation"
msgid "Show translation"
msgstr "Fordítás megjelenítése"

#. Tooltip and aria-label of the translate button in a message's hover toolbar: it translates that one message.
#: client/components/MessageActions.vue
msgctxt "translate.action.translate"
msgid "Translate"
msgstr "Fordítás"

#. Line under the device verdict in Settings → Translation: the largest buffer this device's graphics processor can bind in one piece, measured by the browser. {size} is a size such as "512 MiB" (binary units, kept as they are). A language model loads only if its largest piece fits.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.bufferLimit"
msgid "Largest GPU buffer: {size}"
msgstr "Legnagyobb GPU-puffer: {size}"

#. Line at the top of the model list in Settings → Translation: the browser offers no graphics processor (GPU) at all here (no WebGPU, or no adapter), so the translation models can only run on the main processor (CPU). The reasons follow as their own list.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.cpu"
msgid "This device has a CPU only."
msgstr "Ezen az eszközön csak CPU van."

#. Line at the top of the model list in Settings → Translation: the browser offers a graphics processor (GPU, through WebGPU) as well as the main processor (CPU). It says only that the GPU is there, not that every model fits it: the largest buffer it binds, and anything it lacks, follow on lines of their own. GPU and CPU are the usual abbreviations.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.gpu"
msgid "This device has a GPU and a CPU."
msgstr "Ezen az eszközön van GPU és CPU."

#. Verdict of the device check in Settings → Translation: no model can run at all. Any reasons follow as their own list.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.none"
msgid "Translation cannot run on this device."
msgstr "A fordítás nem futtatható ezen az eszközön."

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the graphics hardware allows too few storage buffers per shader, or too little workgroup memory, for the translation library. Lowercase start, short phrase like the other reasons in the list.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.gpuLimits"
msgid "GPU shader limits too low"
msgstr "túl alacsony GPU-shaderkorlátok"

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the page is not served securely. WebGPU, HTTPS and localhost are technical names.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.insecureOrigin"
msgid "insecure origin: WebGPU needs HTTPS or localhost — serve the app over HTTPS"
msgstr "nem biztonságos forrás: a WebGPU-hoz HTTPS vagy localhost kell — szolgáld ki az alkalmazást HTTPS-en"

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the browser has WebGPU but gave out no device. WebGPU is a web standard's name.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noAdapter"
msgid "WebGPU adapter unavailable"
msgstr "a WebGPU-adapter nem érhető el"

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the graphics hardware lacks half-precision arithmetic.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noF16"
msgid "no 16-bit float shaders"
msgstr "nincsenek 16 bites float shaderek"

#. One reason, in a short list under the device verdict in Settings → Translation, that the language model cannot run on the main processor (CPU): the browser's WebAssembly has no 64-bit memory, which the language model needs because it is larger than 4 GB of address space. Keep 'WebAssembly'. Lowercase, a fragment like its siblings.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noMemory64"
msgid "no 64-bit WebAssembly memory"
msgstr "nincs 64 bites WebAssembly-memória"

#. One reason no model can run, listed under the device verdict in Settings → Translation: the browser lacks the WebAssembly SIMD instructions. Both are technical names.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noWasmSimd"
msgid "no WebAssembly SIMD"
msgstr "nincs WebAssembly SIMD"

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the browser offers no WebGPU. WebGPU is a web standard's name.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noWebgpu"
msgid "no WebGPU"
msgstr "nincs WebGPU"

#. One reason listed under the device verdict in Settings → Translation: the check of what the device can do threw an error, so nothing could be measured.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.probeFailed"
msgid "the device check itself failed"
msgstr "maga az eszközellenőrzés meghiúsult"

#. One reason the language model cannot run on the graphics processor, listed under the device verdict in Settings → Translation. {limit} is what this device's graphics processor can bind in one buffer, {needed} what the smallest build of the language model for the GPU needs (its largest piece); both are sizes such as "128 MiB" (binary units, kept as they are). GPU is the usual abbreviation for the graphics processor; the language model is a large AI model (Qwen3).
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.smallBuffer"
msgid "The GPU binds at most {limit} in one buffer; the smallest build of the language model for the GPU needs {needed}"
msgstr "A GPU legfeljebb {limit} méretet köt le egy pufferben; a nyelvi modell legkisebb, GPU-ra szánt változatának {needed} kell"

#. Settings → Translation, under the line that says how much the GPU can hold in one buffer. Shown only while a developer test setting pretends the graphics card is smaller than it is, to try what a phone gets. {size} is a data size with its unit, e.g. '128 MiB'. {key} is the name of the stored setting, e.g. 'thelounge.state.gpuTestLimitMiB' — never translate it. 'Storage' is the browser's local storage for this site.
#: client/components/Settings/Translation.vue:89
msgctxt "translate.capability.testLimit"
msgid "Limited to {size} for testing ({key} in this browser's storage). Delete that entry and reload to use the GPU's own limit."
msgstr "Teszteléshez {size} értékre korlátozva ({key} a böngésző tárhelyén). Törölje ezt a bejegyzést, és töltse újra az oldalt a GPU saját korlátjához."

#. Tooltip and aria-label of a translation line's chip, skipped because the line is already in the reading language. {language} is its name in the reading language.
#: client/components/TranslationLine.vue
msgctxt "translate.chip.alreadyIn"
msgid "Already in {language}, not translated. Translation options"
msgstr "Már a célnyelven van ({language}), nincs lefordítva. Fordítási beállítások"

#. Tooltip and aria-label of a translation line's chip: the languages it names, then the standard suffix.
#: client/components/TranslationLine.vue
msgctxt "translate.chip.options"
msgid "{languages}. Translation options"
msgstr "{languages}. Fordítási beállítások"

#. Tooltip and aria-label of a translation line's chip, skipped because the detector could not tell the language apart.
#: client/components/TranslationLine.vue
msgctxt "translate.chip.unsure"
msgid "Language not told apart, not translated. Translation options"
msgstr "A nyelv nem állapítható meg, nincs lefordítva. Fordítási beállítások"

#. Placeholder of the message composer in a channel or private conversation whose outgoing messages are translated. {name} is the channel or nickname; {language} is the language messages are sent in.
#: client/components/ChatInput.vue
msgctxt "translate.composer.placeholder"
msgid "Write to {name} · sent in {language}"
msgstr "Üzenet neki: {name} · küldés nyelve: {language}"

#. Placeholder of the message input when the channel's write target is the language the user reads: every line is corrected (spelling and grammar) before it is sent. {name} is the channel or user name, verbatim; the middle dot is part of the copy.
#: client/components/ChatInput.vue
msgctxt "translate.composer.placeholderCorrected"
msgid "Write to {name} · sent corrected"
msgstr "Üzenet neki: {name} · javítva küldve"

#. Tooltip and aria-label of the composer's translate button while the channel corrects every message (spelling and grammar) in {language}, the user's own language, before sending; a click turns that off. The middle dot is part of the copy.
#: client/components/ChatInput.vue
msgctxt "translate.composer.sendCorrectedOn"
msgid "Sending corrected in {language} · click to stop"
msgstr "Javított küldés, nyelv: {language} · kattints a leállításhoz"

#. Tooltip and aria-label of the composer's translate button (the language mark beside the attachment and send buttons) while no send target is set; a click opens a dialog to pick the language every message is sent in, or a correction pass. Ends with an ellipsis.
#: client/components/ChatInput.vue
msgctxt "translate.composer.sendOff"
msgid "Translate what I send…"
msgstr "Elküldött üzeneteim fordítása…"

#. Tooltip and aria-label of the composer's translate button while the channel sends every message translated into {language} (a language name in the interface language); a click turns that off. The middle dot is part of the copy.
#: client/components/ChatInput.vue
msgctxt "translate.composer.sendOn"
msgid "Sending in {language} · click to stop"
msgstr "Küldés ezen a nyelven: {language} · kattints a leállításhoz"

#. Extra line in the dialog asking before a translation model is downloaded, shown only when the browser reports a cellular connection or Data Saver: a warning that the download may cost data.
#: client/js/translate/index.ts
msgctxt "translate.consent.metered"
msgid "Your connection is metered or set to save data."
msgstr "A kapcsolatod forgalomkorlátos, vagy adattakarékos módban van."

#. Button in the dialog asking before a translation model is downloaded: declines the download for now. The translation then uses a model already on the device, or fails saying which model it needs. Keep it short (a button).
#: client/js/translate/index.ts
msgctxt "translate.consent.notNow"
msgid "Not now"
msgstr "Most nem"

#. Body of the dialog asking before a translation model is downloaded (title 'Download {model}?'). {model} is the model's name as Settings lists it; {size} its download size with its unit, e.g. '938.4 MiB' or '2.1 GiB'. The buttons are 'Not now' and 'Download'.
#: client/js/translate/index.ts
msgctxt "translate.consent.text"
msgid "Translating this needs {model}, a {size} download. It is kept on this device, so it is downloaded only once."
msgstr "Ehhez a fordításhoz szükség van erre: {model}, ami {size} letöltés. Ezen az eszközön marad, így csak egyszer kell letölteni."

#. Body of the dialog asking before the CPU copy of a translation model is downloaded (title 'Download {model} for the CPU?'). {model} is the model's name as Settings lists it; {size} its download size with its unit, e.g. '938.4 MiB' or '2.1 GiB'. CPU is the usual abbreviation for the main processor. The buttons are 'Not now' and 'Download'.
#: client/js/translate/index.ts
msgctxt "translate.consent.textCpu"
msgid "Translating this needs {model} on the CPU, a {size} download. It is kept on this device, so it is downloaded only once."
msgstr "Ehhez a fordításhoz szükség van erre a CPU-n: {model}, ami {size} letöltés. Ezen az eszközön marad, így csak egyszer kell letölteni."

#. Body of the dialog asking before the GPU copy of a translation model is downloaded (title 'Download {model} for the GPU?'). {model} is the model's name as Settings lists it; {size} its download size with its unit, e.g. '938.4 MiB' or '2.1 GiB'. GPU is the usual abbreviation for the graphics processor. The buttons are 'Not now' and 'Download'.
#: client/js/translate/index.ts
msgctxt "translate.consent.textGpu"
msgid "Translating this needs {model} on the GPU, a {size} download. It is kept on this device, so it is downloaded only once."
msgstr "Ehhez a fordításhoz szükség van erre a GPU-n: {model}, ami {size} letöltés. Ezen az eszközön marad, így csak egyszer kell letölteni."

#. Title of the dialog that asks before a translation model is downloaded for the first time, because a translation (reading a channel, the composer, a message's Translate) needs it and it is not on this device yet. {model} is the model's name as Settings lists it, e.g. 'Qwen3 1.7B (GPU, all languages)' or 'OPUS-MT German → English (CPU)'.
#: client/js/translate/index.ts
msgctxt "translate.consent.title"
msgid "Download {model}?"
msgstr "Letöltöd ezt: {model}?"

#. Title of the dialog that asks before the CPU copy of a translation model is downloaded, when the model's usual copy is the graphics processor's (the language model). {model} is the model's name as Settings lists it, e.g. 'Qwen3 1.7B'. CPU is the usual abbreviation for the main processor.
#: client/js/translate/index.ts
msgctxt "translate.consent.titleCpu"
msgid "Download {model} for the CPU?"
msgstr "Letöltöd a CPU-hoz ezt: {model}?"

#. Title of the dialog that asks before the GPU copy of a translation model is downloaded, when the model's usual copy is the main processor's (OPUS-MT, NLLB-200). {model} is the model's name as Settings lists it, e.g. 'NLLB-200 600M (200 languages)'. GPU is the usual abbreviation for the graphics processor.
#: client/js/translate/index.ts
msgctxt "translate.consent.titleGpu"
msgid "Download {model} for the GPU?"
msgstr "Letöltöd a GPU-hoz ezt: {model}?"

#. Settings → Translation: the main processor, as the choice after "Run on" and as the label in front of a model copy line ("CPU  Not downloaded · 1 GiB"). Use the usual abbreviation in your language (most keep CPU). Very short.
#: client/components/Settings/Translation.vue
msgctxt "translate.device.cpu"
msgid "CPU"
msgstr "CPU"

#. Settings → Translation: the graphics processor, as the choice after "Run on" and as the label in front of a model copy line ("GPU  Downloaded · 938 MiB"). Use the usual abbreviation in your language (most keep GPU). Very short.
#: client/components/Settings/Translation.vue
msgctxt "translate.device.gpu"
msgid "GPU"
msgstr "GPU"

#. Why a translation failed, shown after 'Couldn't translate': the request was cancelled before it finished. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.aborted"
msgid "aborted"
msgstr "megszakítva"

#. Why a translation failed, shown after 'Couldn't translate' (so it reads 'Couldn't translate: the GPU stopped (…): …'): the graphics processor the translation model was running on stopped working in the middle of the translation — on a phone usually because the system ran short of memory or the app went to the background. {reason} is the browser's own untranslated explanation of why the GPU stopped, {detail} the browser's own untranslated error from the step that failed. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.gpuLost"
msgid "the GPU stopped ({reason}): {detail}"
msgstr "a GPU leállt ({reason}): {detail}"

#. Why a translation failed, shown after 'Couldn't translate': the engine did not answer in time. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.timedOut"
msgid "timed out"
msgstr "időtúllépés"

#. Why a translation failed, shown after 'Couldn't translate:' (so it reads 'Couldn't translate: too long for this device'): the message, even with the surrounding conversation left out, is longer than the translation model loaded on this device can take in at once — a very long message, typically on a phone, where the model is given less room. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.tooLong"
msgid "too long for this device"
msgstr "túl hosszú ehhez az eszközhöz"

#. Why a translation failed, shown after 'Couldn't translate': no model on this device can handle that pair of languages. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.unavailable"
msgid "no translation engine can take this request"
msgstr "egyik fordítómotor sem tudja fogadni ezt a kérést"

#. Why a translation failed, shown after 'Couldn't translate': no model on this device can handle that pair of languages. {detail} is the library's own untranslated error text. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.unavailableDetail"
msgid "no translation engine can take this request: {detail}"
msgstr "egyik fordítómotor sem tudja fogadni ezt a kérést: {detail}"

#. Why a translation failed, shown after 'Couldn't translate': the background process doing the translating was shut down. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.workerDisposed"
msgid "translation worker disposed"
msgstr "a fordítási worker leállt"

#. Text in front of the failure reason on a message whose translation failed (with a retry button beside it).
#: client/components/TranslationLine.vue
msgctxt "translate.failed"
msgid "Couldn't translate"
msgstr "Nem sikerült lefordítani"

#. Choice for how formally a translation addresses people: keep whatever the original message did.
#: client/components/TranslationPanel.vue
#: client/components/Settings/Translation.vue
msgctxt "translate.formality.auto"
msgid "As the original does"
msgstr "Ahogy az eredeti"

#. The same choice as translate.formality.auto, shortened for the narrow segmented control on a phone: keep whatever the original message did.
#: client/components/TranslationPanel.vue
msgctxt "translate.formality.autoShort"
msgid "As written"
msgstr "Ahogy írták"

#. Choice for how formally a translation addresses people: always use the familiar form.
#: client/components/TranslationPanel.vue
#: client/components/Settings/Translation.vue
msgctxt "translate.formality.casual"
msgid "Casually"
msgstr "Tegezve"

#. Choice for how formally a translation addresses people: always use the polite form.
#: client/components/TranslationPanel.vue
#: client/components/Settings/Translation.vue
msgctxt "translate.formality.formal"
msgid "Formally"
msgstr "Magázva"

#. Label of the control that chooses how formally the translation addresses people, in the translation panel and in Settings.
#: client/components/TranslationPanel.vue
#: client/components/Settings/Translation.vue
msgctxt "translate.formality.label"
msgid "Address people"
msgstr "Megszólítás"

#. Tooltip of the translate button in a chat window's header while translation is off; clicking it turns reading on. {reading} is a language name.
#: client/components/Chat.vue
msgctxt "translate.header.off"
msgid "Translate messages into {reading}"
msgstr "Üzenetek fordítása (nyelv: {reading})"

#. Tooltip of the translate button in a chat window's header when translation is off and the engine has paused. {reading} is a language name; {reason} is the engine's own untranslated message.
#: client/components/Chat.vue
msgctxt "translate.header.offPaused"
msgid "Translate messages into {reading}, paused: {reason}"
msgstr "Üzenetek fordítása (nyelv: {reading}); szünetel: {reason}"

#. Tooltip of the translate button in a chat window's header while incoming messages are not translated but outgoing ones are. {reading} and {writing} are language names.
#: client/components/Chat.vue
msgctxt "translate.header.offWrite"
msgid "Translate messages into {reading}, sending in {writing}"
msgstr "Bejövő üzenetek fordítása (nyelv: {reading}), kimenők nyelve: {writing}"

#. Tooltip of the translate button in a chat window's header when only outgoing messages are translated and the engine has paused. {reading} and {writing} are language names; {reason} is the engine's own untranslated message.
#: client/components/Chat.vue
msgctxt "translate.header.offWritePaused"
msgid "Translate messages into {reading}, sending in {writing}, paused: {reason}"
msgstr "Bejövő üzenetek fordítása (nyelv: {reading}), kimenők nyelve: {writing}; szünetel: {reason}"

#. Tooltip of the translate button in a chat window's header while incoming messages are being translated. {reading} is a language name.
#: client/components/Chat.vue
msgctxt "translate.header.read"
msgid "Translating into {reading}"
msgstr "Fordítás (nyelv: {reading})"

#. Tooltip of the translate button in a chat window's header when translation is on but the engine has paused. {reading} is a language name; {reason} is the engine's own untranslated message.
#: client/components/Chat.vue
msgctxt "translate.header.readPaused"
msgid "Translating into {reading}, paused: {reason}"
msgstr "Fordítás (nyelv: {reading}); szünetel: {reason}"

#. Tooltip of the translate button in a chat window's header while incoming messages are translated and outgoing ones are too. {reading} and {writing} are language names.
#: client/components/Chat.vue
msgctxt "translate.header.readWrite"
msgid "Translating into {reading}, sending in {writing}"
msgstr "Bejövők fordítása (nyelv: {reading}), kimenők nyelve: {writing}"

#. Tooltip of the translate button in a chat window's header when reading and writing are both translated but the engine has paused. {reading} and {writing} are language names; {reason} is the engine's own untranslated message.
#: client/components/Chat.vue
msgctxt "translate.header.readWritePaused"
msgid "Translating into {reading}, sending in {writing}, paused: {reason}"
msgstr "Bejövők fordítása (nyelv: {reading}), kimenők nyelve: {writing}; szünetel: {reason}"

#. Tooltip and aria-label of the translate button in a chat window's header on a touch device, where tapping it opens the translation panel.
#: client/components/Chat.vue
msgctxt "translate.header.settings"
msgid "Translation settings"
msgstr "Fordítási beállítások"

#. Warning shown under a language choice, in the translation panel and in Settings, when the available models translate that language poorly.
#: client/components/TranslationPanel.vue
#: client/components/Settings/Translation.vue
msgctxt "translate.limitedLanguage"
msgid "Translations into and out of this language are often wrong."
msgstr "Az erre a nyelvre és erről a nyelvről készült fordítások gyakran hibásak."

#. Note shown in the composer's translation strip or under a message while the model it needs is being fetched for the first time. {model} is the model's name, {percent} a number from 0 to 100.
#: client/js/helpers/modelLabel.ts
msgctxt "translate.load.downloading"
msgid "Downloading {model}… {percent}%"
msgstr "{model} letöltése… {percent}%"

#. Note shown in the composer's translation strip or under a message while a model already on the device is being loaded back into memory. {model} is the model's name, {percent} a number from 0 to 100.
#: client/js/helpers/modelLabel.ts
msgctxt "translate.load.loading"
msgid "Loading {model} into memory… {percent}%"
msgstr "{model} betöltése a memóriába… {percent}%"

#. A translation chip's menu item.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.copy"
msgid "Copy translation"
msgstr "Fordítás másolása"

#. Item in a channel's context menu in the sidebar; it opens that channel's translation panel.
#: client/js/helpers/contextMenu.ts
msgctxt "translate.menu.panel"
msgid "Translation…"
msgstr "Fordítás…"

#. A translation chip's menu item.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.retranslate"
msgid "Retranslate"
msgstr "Újrafordítás"

#. A translation chip's menu item. {language} is the language's name in the reading language.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.retranslateFrom"
msgid "Retranslate from: {language}"
msgstr "Újrafordítás erről a nyelvről: {language}"

#. A translation chip's menu item.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.retranslateFromPicker"
msgid "Retranslate from…"
msgstr "Újrafordítás másik nyelvről…"

#. A translation chip's menu item.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.showOriginal"
msgid "Show original only"
msgstr "Csak az eredeti megjelenítése"

#. A translation chip's menu item.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.translateAnyway"
msgid "Translate anyway"
msgstr "Fordítás mégis"

#. Item of the menu the message toolbar's Translate action opens: pick the language this line is in before translating it. Ends in an ellipsis because a dialog follows.
#: client/components/MessageActions.vue
msgctxt "translate.menu.translateFromPicker"
msgid "Translate from another language…"
msgstr "Fordítás másik nyelvről…"

#. First item of the menu the message toolbar's Translate action opens: translate this one line, with its language left to the detector.
#: client/components/MessageActions.vue
msgctxt "translate.menu.translateNow"
msgid "Translate"
msgstr "Fordítás"

#. Read out by screen readers in Settings → Translation when a download of one copy of a model ends. {model} is the model name (e.g. "Qwen3 1.7B (all languages)"), {device} the processor its copy is for ("GPU" or "CPU"), {state} the copy's new state (e.g. "Downloaded · 938.4 MiB" or "Failed: …").
#: client/components/Settings/Translation.vue
msgctxt "translate.model.announce"
msgid "{model} ({device}): {state}"
msgstr ""

#. Settings → Translation, one copy of a translation model (the GPU one or the CPU one, named before it): its files are on this device. {size} is its download size with its unit, already formatted, e.g. "938.4 MiB". Keep the middle dot as a separator.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.copyDownloaded"
msgid "Downloaded · {size}"
msgstr "Letöltve · {size}"

#. Settings → Translation, one copy of a translation model (the GPU one or the CPU one, named before it): not on this device yet; a Download button follows. {size} is what downloading it costs, with its unit, already formatted, e.g. "1 GiB". Keep the middle dot as a separator.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.copyNotDownloaded"
msgid "Not downloaded · {size}"
msgstr "Nincs letöltve · {size}"

#. Button in Settings → Translation: delete one downloaded copy of a translation model (its GPU or its CPU copy) from this device, to free the space. Short, like a button. Screen readers hear it followed by the model and the processor.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.delete"
msgid "Remove"
msgstr "Eltávolítás"

#. Button on a model row in Settings → Translation that fetches the model onto this device.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.download"
msgid "Download"
msgstr "Letöltés"

#. State of a model row in Settings → Translation after a download failed. {error} is the library's own untranslated message.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.failed"
msgid "Failed: {error}"
msgstr "Hiba: {error}"

#. State of a model row in Settings → Translation after a download failed with no message of its own.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.failedUnknown"
msgid "Failed: unknown error"
msgstr "Hiba: ismeretlen hiba"

#. The name of a translation model in Settings → Translation: a large language model, which runs on the graphics processor or the main processor. {name} is the model's product name, never translated.
#: client/js/helpers/modelLabel.ts
msgctxt "translate.model.llm"
msgid "{name} (all languages)"
msgstr "{name} (minden nyelv)"

#. State of a model row in Settings → Translation: it is already on the device and is being loaded into memory. {percent} is a number from 0 to 100.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.loadingPercent"
msgid "Loading… {percent}%"
msgstr "Betöltés… {percent}%"

#. Reason a GPU translation model cannot load here: {needed} is the model's largest piece, {limit} what this device's graphics processor can bind in one buffer; both are sizes such as "186 MiB" (binary units, kept as they are). Shown under the model's row in Settings → Translation (its Download button greyed out) and, after a lead sentence such as 'Correcting a message needs the language model.', wherever an action needing that model is unavailable.
#: client/components/Settings/Translation.vue
#: client/js/helpers/translateWhy.ts
msgctxt "translate.model.needsBuffer"
msgid "Needs a GPU buffer of {needed}; this device binds at most {limit}"
msgstr "{needed} méretű GPU-puffer kell hozzá; ez az eszköz legfeljebb {limit} méretűt tud kötni"

#. The name of a translation model in Settings → Translation. NLLB-200 600M is a product name; it covers 200 languages.
#: client/js/helpers/modelLabel.ts
msgctxt "translate.model.nllb"
msgid "NLLB-200 600M (200 languages)"
msgstr "NLLB-200 600M (200 nyelv)"

#. The name of a translation model in Settings → Translation: an OPUS-MT pair. {from} and {to} are language names. OPUS-MT is a product name.
#: client/js/helpers/modelLabel.ts
msgctxt "translate.model.opus"
msgid "OPUS-MT {from} → {to}"
msgstr "OPUS-MT {from} → {to}"

#. State of a model row in Settings → Translation while it downloads: how far it has got. {percent} is a number from 0 to 100.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.percent"
msgid "{percent}%"
msgstr "{percent}%"

#. Settings → Translation, a line under the language model's row (Qwen3 1.7B) on a device whose graphics card cannot hold the model's largest piece in one buffer (most phones): the app then downloads and runs a special build of the same model whose pieces are smaller. {size} is a data size with its unit, already formatted, e.g. '74.2 MiB'. 'Buffer' is the graphics-card term (a block of GPU memory); 'build' means a compiled version of the same model.
#: client/components/Settings/Translation.vue:213
msgctxt "translate.model.smallBufferBuild"
msgid "This GPU gets a build of the model made for small graphics buffers: its largest buffer is {size}."
msgstr "Ez a GPU a modell kis grafikus pufferekhez készült változatát kapja: a legnagyobb puffere {size}."

#. Label of the compact equals-icon chip shown in place of a translation that failed because the engine returned the source line as its own answer. Also the chip's tooltip and aria-label; the reason text beside it only appears in development builds.
#: client/components/TranslationLine.vue
msgctxt "translate.notTranslated"
msgid "Not translated"
msgstr "Nem fordítva"

#. Lead sentence when a translation is unavailable for a language pair (the composer's translate dialog, the translation panel's 'Send my messages in'); the reason follows as a sentence of its own. {from} and {to} are language names, already in the interface language.
#: client/components/SourceLanguagePicker.vue
#: client/components/TranslationPanel.vue
msgctxt "translate.pair.unavailable"
msgid "Nothing on this device can translate {from} into {to}."
msgstr "Ezen az eszközön semmi sem tud fordítani: {from} → {to}."

#. Lead sentence in the composer's translate dialog when the source is 'Detect automatically' and no engine here translates into the chosen language; the reason follows as a sentence of its own. {to} is a language name, already in the interface language.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.pair.unavailableInto"
msgid "Nothing on this device can translate into {to}."
msgstr "Ezen az eszközön semmi sem tud fordítani erre a nyelvre: {to}."

#. The placeholder option of the picker that adds a language to the list of languages spoken in this conversation, in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.addLanguage"
msgid "Add a language…"
msgstr "Nyelv hozzáadása…"

#. Tooltip and aria-label of the ✕ button that closes the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.close"
msgid "Close"
msgstr "Bezárás"

#. Heading of the translation panel, a dialog of translation settings for one conversation; the conversation's name is shown next to it.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.heading"
msgid "Translation"
msgstr "Fordítás"

#. Explanatory note under the list of languages spoken in this conversation, in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.languagesHint"
msgid "Lines in these languages are recognised even when they are short or look alike."
msgstr "Az ezeken a nyelveken írt sorokat akkor is felismeri, ha rövidek vagy hasonlítanak egymásra."

#. The off choice: the segmented switch for translating incoming messages, and the first option of the 'send my messages in' picker, both in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.off"
msgid "Off"
msgstr "Ki"

#. The on choice of the segmented switch for translating incoming messages, in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.on"
msgid "On"
msgstr "Be"

#. Note under the 'Send my messages in' picker of the translation panel, on a device that cannot run the language model. {language} is the user's own language (the one they read), shown greyed in that picker: choosing it would mean correcting one's own messages, which only the language model (a large AI model) does. A reason sentence follows on its own line.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.ownLanguageNeedsGpu"
msgid "{language} is greyed out: correcting a message needs the language model."
msgstr "A(z) {language} nyelv szürke: az üzenet javításához a nyelvi modell szükséges."

#. Explanatory note under the reading switch in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.readHint"
msgid "Lines others send are shown with a translation underneath."
msgstr "A mások által küldött sorok alatt megjelenik a fordításuk."

#. Label of the on/off switch for translating incoming messages in the translation panel. {language} is the language name they would be translated into.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.readIn"
msgid "Read messages in {language}"
msgstr "Üzenetek olvasása ezen a nyelven: {language}"

#. Heading of the translation panel's section about incoming messages, and the label of the on/off control in it.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.reading"
msgid "Reading"
msgstr "Olvasás"

#. Link at the foot of the translation panel; it opens the application's Translation settings page.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.settingsLink"
msgid "Language and models in Settings"
msgstr "Nyelv és modellek a Beállításokban"

#. aria-label of the translation panel, a dialog of translation settings for one conversation. {channel} is the channel name or nickname.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.title"
msgid "Translation for {channel}"
msgstr "Fordítás itt: {channel}"

#. Label of the free-text field naming a regional variety of the target language, in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.variant"
msgid "Variant"
msgstr "Nyelvváltozat"

#. Explanatory note under the regional variety field in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.variantHint"
msgid "A regional flavour the model should aim for."
msgstr "Regionális változat, amelyre a modell törekedjen."

#. Placeholder of the free-text field naming a regional variety of the target language, in the translation panel. Replace the example with one that suits the target language.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.variantPlaceholder"
msgid "e.g. Brazilian Portuguese"
msgstr "pl. brazíliai portugál"

#. Explanatory note under the 'send my messages in' picker in the translation panel. Enter is the keyboard key of that name.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.writeHint"
msgid "Enter shows the translation first; Enter again sends it."
msgstr "Az Enter először a fordítást mutatja; újabb Enter elküldi."

#. Label of the picker that chooses the language the user's own messages are translated into before sending, in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.writeLabel"
msgid "Send my messages in"
msgstr "Üzeneteim küldése ezen a nyelven"

#. Heading of the translation panel's section about the messages the user sends.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.writing"
msgid "Writing"
msgstr "Írás"

#. Button that closes the retranslate-from dialog without doing anything.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.cancel"
msgid "Cancel"
msgstr "Mégse"

#. Button that translates the message again from the language picked in the retranslate-from dialog.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.confirm"
msgid "Translate"
msgstr "Fordítás"

#. aria-label of the small dialog that translates one message again from a language the user picks.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.dialog"
msgid "Retranslate from another language"
msgstr "Újrafordítás másik nyelvről"

#. First option of the source-language picker in the composer's translate-into dialog: the draft's language is detected rather than named.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.fromAuto"
msgid "Detect automatically"
msgstr "Automatikus felismerés"

#. Label of the source-language picker in the dialog the composer's translate button opens; preselected to the language the user reads.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.fromLabel"
msgid "Translate from"
msgstr "Forrásnyelv"

#. Label of the language picker in the dialog that translates one message again from a language the user picks.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.label"
msgid "Translate this line from"
msgstr "A sor fordítása erről a nyelvről"

#. Hint under the selects in the composer's translate-into dialog when the source and the target are the same language: the draft is corrected, not translated.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.sameLanguage"
msgid "Same language: spelling and grammar are corrected instead."
msgstr "Ugyanaz a nyelv: helyette a helyesírás és a nyelvtan javul."

#. Lead sentence in the composer's translate dialog and the translation panel when the same language is picked as source and target (a spelling and grammar cleanup pass), which only the language model (a large AI model) can do and which cannot run now; the reason (no WebGPU, buffer too small, switched off, …) follows as a sentence of its own.
#: client/components/SourceLanguagePicker.vue
#: client/components/TranslationPanel.vue
msgctxt "translate.picker.sameLanguageNeedsGpu"
msgid "Correcting a message needs the language model."
msgstr "Az üzenet javításához a nyelvi modell szükséges."

#. Button that translates the draft into the language picked in the composer's translate-into dialog.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.targetConfirm"
msgid "Translate"
msgstr "Fordítás"

#. Button of the composer's translate dialog when the source and the target are the same language: the draft is corrected in that language rather than translated. Imperative verb ('correct this draft'), not the adjective.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.targetConfirmCorrect"
msgid "Correct"
msgstr "Javítás"

#. aria-label of the small dialog the composer's translate button opens: pick the language the draft is translated into, this once.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.targetDialog"
msgid "Translate this message into a language"
msgstr "Üzenet fordítása egy nyelvre"

#. Label of the language picker in the dialog the composer's translate button opens; the draft is translated into the picked language.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.targetLabel"
msgid "Translate into"
msgstr "Célnyelv"

#. Checkbox in the composer's translate dialog: ticked, the picked language applies to the draft alone (a one-off) rather than becoming the channel's send target.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.thisMessageOnly"
msgid "This message only"
msgstr "Csak ez az üzenet"

#. Failure reason after 'Couldn't translate': the model replied to a question it found in the message rather than translating the message. Lowercase; reads as the tail of that sentence.
#: client/components/TranslationLine.vue
msgctxt "translate.reason.answered"
msgid "answered the question instead of translating it"
msgstr "válaszolt a kérdésre ahelyett, hogy lefordította volna"

#. Failure reason after 'Couldn't translate': the model returned runs of symbols or punctuation with no usable words. Lowercase; reads as the tail of that sentence.
#: client/components/TranslationLine.vue
msgctxt "translate.reason.degenerate"
msgid "the answer was symbol garbage"
msgstr "a válasz értelmetlen szimbólumhalmaz volt"

#. Failure reason after 'Couldn't translate': the model replied to the message's request (acknowledging it, describing what it would do) rather than translating the message. Lowercase; reads as the tail of that sentence.
#: client/components/TranslationLine.vue
msgctxt "translate.reason.narration"
msgid "talked about the request instead of translating"
msgstr "a kérésről beszélt ahelyett, hogy fordított volna"

#. Tooltip and aria-label of the circular-arrow button that retries a failed translation.
#: client/components/TranslationLine.vue
msgctxt "translate.retry"
msgid "Retry the translation"
msgstr "Fordítás újrapróbálása"

#. Settings → Translation, the line under "Run on" for OPUS-MT on a phone while Auto is chosen: the graphics processor (GPU) could run it, but the app runs it on the main processor (CPU) so that the GPU's memory stays free for the language model (the large AI model, e.g. Qwen3). "Auto" is the choice of that name; "here" means on this device. One sentence.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.autoPicksCpu"
msgid "Auto picks the CPU here, to keep the GPU's memory for the language model."
msgstr "Itt az Automatikus a CPU-t választja, hogy a GPU memóriája a nyelvi modellnek maradjon."

#. Settings → Translation, the line under "Run on" for NLLB-200 while Auto is chosen: the app runs it on the main processor (CPU) because this device's graphics processor (GPU) cannot run it; the GPU's reason is shown just above, next to the struck-through GPU choice. NLLB-200 is a product name, never translated. One sentence.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.autoPicksCpuNoGpuNllb"
msgid "Auto picks the CPU here, since the GPU can't run NLLB-200."
msgstr "Itt az Automatikus a CPU-t választja, mert a GPU nem tudja futtatni az NLLB-200-at."

#. Settings → Translation, the line under "Run on" for OPUS-MT while Auto is chosen: the app runs it on the main processor (CPU) because this device's graphics processor (GPU) cannot run it; the GPU's reason is shown just above, next to the struck-through GPU choice. OPUS-MT is a product name, never translated. One sentence.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.autoPicksCpuNoGpuOpus"
msgid "Auto picks the CPU here, since the GPU can't run OPUS-MT."
msgstr "Itt az Automatikus a CPU-t választja, mert a GPU nem tudja futtatni az OPUS-MT-t."

#. Settings → Translation, the line under "Run on" while Auto is chosen: on this device the app runs this translation model on the graphics processor (GPU), because it is the faster of the two processors. "Auto" is the choice of that name; "here" means on this device. One sentence.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.autoPicksGpu"
msgid "Auto picks the GPU here, the faster device."
msgstr "Itt az Automatikus a GPU-t választja, mert az a gyorsabb."

#. Settings → Translation, the line under "Run on" for the language model while Auto is chosen: on this device the app runs it on the graphics processor (GPU), using a special build of the same model whose pieces fit a GPU that can only hold small blocks of memory ("buffers", most phones). "Auto" is the choice of that name; "here" means on this device. One sentence.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.autoPicksGpuSmallBuild"
msgid "Auto picks the GPU here, with the build for small GPU buffers."
msgstr "Itt az Automatikus a GPU-t választja, a kis GPU-pufferekhez készült változattal."

#. Settings → Translation, the first of three choices after "Run on": let the app pick the best processor (GPU or CPU) for this translation model on this device. One short word, like a button in a segmented control.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.deviceAuto"
msgid "Auto"
msgstr "Automatikus"

#. Shown in place of the Translation settings when the site's operator has disabled the feature.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.disabled"
msgid "Translation is turned off in this deployment."
msgstr "A fordítás ki van kapcsolva ebben a telepítésben."

#. The first option of the language model picker in Settings → Translation: the client picks the largest model the device can run.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.gpuAutomatic"
msgid "Automatic — best for this device"
msgstr "Automatikus – a legjobb ehhez az eszközhöz"

#. Label of the language model picker in Settings → Translation: which large AI model (Qwen3 1.7B or 4B) the app uses to translate and to correct messages.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.gpuModel"
msgid "Language model"
msgstr "Nyelvi modell"

#. Explanatory note under the language model picker in Settings → Translation.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.gpuModelHint"
msgid "The larger model translates more naturally, needs about 3.4 GB of graphics memory and is slower."
msgstr "A nagyobb modell természetesebben fordít, körülbelül 3,4 GB grafikus memóriát igényel, és lassabb."

#. Line under the language model select in Settings → Translation, for a model that is greyed out in the select because this device's GPU cannot hold it. {model} is the model's name, e.g. 'Qwen3 4B'. Followed by a sentence of its own giving the reason, e.g. 'It needs a GPU that binds 185.5 MiB in one buffer; this one binds 160 MiB.'
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.gpuModelUnfit"
msgid "{model} can't run on this device."
msgstr "{model} nem futtatható ezen az eszközön."

#. Heading of the Translation tab in Settings.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.heading"
msgid "Translation"
msgstr "Fordítás"

#. Badge next to the model row in Settings → Translation that the language model picker currently selects.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.inUse"
msgid "In use"
msgstr "Használatban"

#. Label of the language select in Settings > Translation when the deployment has translation turned off: there it only chooses the language the interface is written in.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.interfaceLanguageLabel"
msgid "Interface language"
msgstr "A felület nyelve"

#. Introductory paragraph of the Translation tab in Settings, explaining that translation runs locally.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.intro"
msgid "Messages are translated on this device by a model it downloads once; nothing is sent to a translation service. Turn it on per channel from the translate button in the channel header."
msgstr "Az üzeneteket ezen az eszközön fordítja le egy modell, amelyet az eszköz egyszer tölt le; semmi sem kerül fordítószolgáltatáshoz. Csatornánként kapcsold be a csatorna fejlécében lévő fordítás gombbal."

#. Explanatory note under the language picker in Settings → Translation.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.languageHint"
msgid "The language the interface is written in and messages are translated into — one control. Automatic follows your browser's language."
msgstr "A felület nyelve és az üzenetek fordításának célnyelve — egyetlen beállítás. Az Automatikus a böngésződ nyelvét követi."

#. Label of the picker in Settings → Translation that chooses one language for both the interface and the translations of incoming messages.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.languageLabel"
msgid "Interface and reading language"
msgstr "A felület és az olvasás nyelve"

#. One option of the language model picker in Settings → Translation. {name} is the model's product name, {size} its download size.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.modelOption"
msgid "{name} · {size}"
msgstr "{name} · {size}"

#. Heading of the section of Settings → Translation that lists the translation models and lets them be downloaded or deleted.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.models"
msgid "Models"
msgstr "Modellek"

#. Line under the 'Use NLLB-200 …' switch in Settings → Translation, naming the model's licence, which is why the switch is off by default. NLLB-200 and CC BY-NC 4.0 are names, never translated.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.nllbLicence"
msgid "NLLB-200 is licensed CC BY-NC 4.0: for non-commercial use only."
msgstr "Az NLLB-200 licence CC BY-NC 4.0: csak nem kereskedelmi célra használható."

#. Settings → Translation, OPUS-MT, one line per processor (GPU or CPU, named before it): how many language-pair models are downloaded for it, and their size together. {count} is that number (1 or more), {size} a data size with its unit, already formatted, e.g. "215.5 MiB". Keep the middle dot as a separator.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.opusDownloaded"
msgid "{count} pair downloaded · {size}"
msgid_plural "{count} pairs downloaded · {size}"
msgstr[0] "{count} pár letöltve · {size}"
msgstr[1] "{count} pár letöltve · {size}"

#. Settings → Translation, OPUS-MT, one line per processor (GPU or CPU, named before it): no language-pair model is downloaded for it yet. {size} is what one pair costs to download, with its unit, already formatted, e.g. "107.8 MiB". Keep the middle dot as a separator.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.opusNone"
msgid "No pairs downloaded · about {size} a pair"
msgstr "Nincs letöltött pár · páronként kb. {size}"

#. Settings → Translation, under the OPUS-MT switch: how many language pairs (one small model per pair, e.g. English → German) the app offers. {count} is that number.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.opusPairs"
msgid "{count} language pair"
msgid_plural "{count} language pairs"
msgstr[0] "{count} nyelvpár"
msgstr[1] "{count} nyelvpár"

#. Settings → Translation, label before a three-way choice of where a translation model runs: Auto, GPU (the graphics processor) or CPU (the main processor). Short, like a form label.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.runOn"
msgid "Run on"
msgstr "Futtatás ezen"

#. Label of the checkbox in Settings → Translation that allows the small OPUS-MT translation models (one per language pair). OPUS-MT is a product name, never translated.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.useCpu"
msgid "Use OPUS-MT where it is the better choice"
msgstr "Az OPUS-MT használata, ahol az a jobb választás"

#. Label of the checkbox in Settings → Translation that allows the language model (a large AI model). {model} is its product name, e.g. 'Qwen3 1.7B', never translated.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.useGpu"
msgid "Use {model} where it is the better choice"
msgstr "A(z) {model} használata, ahol az a jobb választás"

#. Switch in Settings → Translation, under 'Use OPUS-MT where it is the better choice': lets the router use the NLLB-200 model (200 languages). Off by default; its own switch, independent of OPUS-MT's. NLLB-200 is a model name, never translated.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.useNllb"
msgid "Use NLLB-200 for languages the other models do not cover"
msgstr "Az NLLB-200 használata azokhoz a nyelvekhez, amelyeket a többi modell nem fed le"

#. Error shown in Settings → Translation when the background process that does the translating could not be reached. {error} is its own untranslated message.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.workerError"
msgid "Could not reach the translation worker: {error}"
msgstr "Nem sikerült elérni a fordítási workert: {error}"

#. Text of the second row of the composer's translation strip when translating the translation back into the user's own language failed.
#: client/components/ChatInput.vue
msgctxt "translate.strip.checkFailed"
msgid "couldn't check"
msgstr "nem sikerült ellenőrizni"

#. Tooltip and aria-label of the copy button in the composer's translation strip, for two seconds after the translation was put on the clipboard.
#: client/components/ChatInput.vue
msgctxt "translate.strip.copied"
msgid "Copied"
msgstr "Másolva"

#. Tooltip and aria-label of the copy button in the composer's translation strip; it puts the translated text on the clipboard.
#: client/components/ChatInput.vue
msgctxt "translate.strip.copy"
msgid "Copy the translation"
msgstr "Fordítás másolása"

#. Text of the strip above the message composer when the outgoing translation failed; the user can press Enter again to send the message as they wrote it.
#: client/components/ChatInput.vue
msgctxt "translate.strip.failed"
msgid "couldn't translate, send as written?"
msgstr "nem sikerült lefordítani, elküldöd így, ahogy írtad?"

#. Tooltip and aria-label of the button in the composer's translation strip that dismisses the translation and returns to the draft. Escape is the keyboard key of the same name.
#: client/components/ChatInput.vue
msgctxt "translate.strip.keepTyping"
msgid "Keep typing (Escape)"
msgstr "Gépelés folytatása (Escape)"

#. Chip at the start of the composer's translation strip when the draft was corrected in its own language rather than translated. {language} is that language's name, in the interface language.
#: client/components/ChatInput.vue
msgctxt "translate.strip.polishChip"
msgid "{language}, corrected"
msgstr "{language}, javítva"

#. Tooltip of the composer translation strip's direction chip, naming the route a translation took. {from} and {to} are language names (or the word from translate.strip.sourceAuto), {model} is the model's technical id. This one ran on the main processor.
#: client/components/ChatInput.vue
msgctxt "translate.strip.routeCpu"
msgid "{from} → {to} · {model} (CPU)"
msgstr "{from} → {to} · {model} (CPU)"

#. Tooltip of the composer translation strip's direction chip when the first attempt was tried again with no source language named. {from} and {to} are language names, {model} is the model's technical id. This one ran on the main processor.
#: client/components/ChatInput.vue
msgctxt "translate.strip.routeCpuRetried"
msgid "{from} → {to} · {model} (CPU) · retried without a source"
msgstr "{from} → {to} · {model} (CPU) · újrapróbálva forrásnyelv nélkül"

#. Tooltip of the composer translation strip's direction chip, naming the route a translation took. {from} and {to} are language names (or the word from translate.strip.sourceAuto), {model} is the model's technical id. This one ran on the graphics processor.
#: client/components/ChatInput.vue
msgctxt "translate.strip.routeGpu"
msgid "{from} → {to} · {model} (GPU)"
msgstr "{from} → {to} · {model} (GPU)"

#. Tooltip of the composer translation strip's direction chip when the first attempt was tried again with no source language named. {from} and {to} are language names, {model} is the model's technical id. This one ran on the graphics processor.
#: client/components/ChatInput.vue
msgctxt "translate.strip.routeGpuRetried"
msgid "{from} → {to} · {model} (GPU) · retried without a source"
msgstr "{from} → {to} · {model} (GPU) · újrapróbálva forrásnyelv nélkül"

#. Tooltip and aria-label of the send button in the composer's translation strip after the translation failed: the message goes out in the language the user typed it in.
#: client/components/ChatInput.vue
msgctxt "translate.strip.sendAsWritten"
msgid "Send as written"
msgstr "Küldés úgy, ahogy írtad"

#. Tooltip and aria-label of the send button in the composer's translation strip: the translated text is what gets sent.
#: client/components/ChatInput.vue
msgctxt "translate.strip.sendTranslation"
msgid "Send the translation"
msgstr "Fordítás elküldése"

#. Stands in for the source language in the composer translation strip's route tooltip when no source was named and the model was left to work it out. Substituted as {from} in translate.strip.routeGpu and its siblings.
#: client/components/ChatInput.vue
msgctxt "translate.strip.sourceAuto"
msgid "auto"
msgstr "automatikus"

#. Line under the CPU models in Settings → Translation: the language model would run on {count} processor threads (CPU) after the app is reloaded; this page cannot use more than one yet. {count} is that number, 2 or more in practice. A thread is a parallel strand of computation.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.threads.reload"
msgid "Reload the app to use {count} CPU thread."
msgid_plural "Reload the app to use {count} CPU threads."
msgstr[0] "Töltsd újra az alkalmazást, hogy {count} CPU-szálat használjon."
msgstr[1] "Töltsd újra az alkalmazást, hogy {count} CPU-szálat használjon."

#. Line under the CPU models in Settings → Translation: how many processor threads the language model uses on the main processor (CPU). {count} is that number, always 1 or more. A thread is a parallel strand of computation.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.threads.using"
msgid "Uses {count} CPU thread."
msgid_plural "Uses {count} CPU threads."
msgstr[0] "{count} CPU-szálat használ."
msgstr[1] "{count} CPU-szálat használ."

#. Tooltip and aria-label of the small button before a translated channel topic in the chat header; pressing it shows the topic as it was set.
#: client/components/Chat.vue
msgctxt "translate.topic.showOriginal"
msgid "Show the original topic"
msgstr "Eredeti téma megjelenítése"

#. Tooltip and aria-label of the small button before a channel topic in the chat header while the original is showing; pressing it shows the translation again.
#: client/components/Chat.vue
msgctxt "translate.topic.showTranslation"
msgid "Show the translated topic"
msgstr "Lefordított téma megjelenítése"

#. Lead sentence of the per-channel translation panel's notice, and the channel header translate button's label, when no translation engine can run (both switched off, or a device that runs neither); the reason follows as a sentence of its own.
#: client/components/TranslationPanel.vue
#: client/components/Chat.vue
msgctxt "translate.unavailable.lead"
msgid "Translation can't run here right now."
msgstr "A fordítás most itt nem futtatható."

#. Failure reason shown inside the Not-translated chip in development builds only: the model returned the source line as its own translation, so there is nothing to show. Lowercase; it reads as the reason the chip stands for.
#: client/components/TranslationLine.vue
msgctxt "translate.unchangedReason"
msgid "the line came back unchanged"
msgstr "a sor változatlanul jött vissza"

#. Reason nothing can translate: the user turned off the language model and OPUS-MT. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'. 'Settings → Translation' names the settings tab. OPUS-MT is a product name.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.allOff"
msgid "The language model and OPUS-MT are both switched off in Settings → Translation."
msgstr "A nyelvi modell és az OPUS-MT is ki van kapcsolva itt: Beállítások → Fordítás."

#. Reason a translation cannot run: the user turned off the OPUS-MT switch. OPUS-MT is a product name, never translated. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'. 'Settings → Translation' names the settings tab.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.cpuOff"
msgid "OPUS-MT is switched off in Settings → Translation."
msgstr "Az OPUS-MT ki van kapcsolva itt: Beállítások → Fordítás."

#. Reason a translation cannot run: the one model that serves it failed to load earlier in this session and is skipped until the page is reloaded. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.down"
msgid "The model for this failed to load earlier; reload the page to try it again."
msgstr "Az ehhez szükséges modell korábban nem töltődött be; töltsd újra az oldalt az újrapróbáláshoz."

#. Reason a translation cannot run: the user answered 'Not now' when asked to download the CPU copy of a model, and it is not on this device yet. Shown under a translated line that failed (cut at about 120 characters there, so keep it short), in the composer's translation strip and in the translation controls. {model} is the model's name as Settings lists it, e.g. 'Qwen3 1.7B'; {size} its download size with its unit, e.g. '938.4 MiB'. CPU is the usual abbreviation for the main processor. 'Settings → Translation' names the settings tab.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.downloadCpu"
msgid "Needs {model} for the CPU, a {size} download: get it in Settings → Translation."
msgstr "Ehhez kell a CPU-hoz: {model}, {size} letöltés – töltsd le itt: Beállítások → Fordítás."

#. Reason a translation cannot run: the user answered 'Not now' when asked to download the GPU copy of a model, and it is not on this device yet. Shown under a translated line that failed (cut at about 120 characters there, so keep it short), in the composer's translation strip and in the translation controls. {model} is the model's name as Settings lists it, e.g. 'Qwen3 1.7B'; {size} its download size with its unit, e.g. '938.4 MiB'. GPU is the usual abbreviation for the graphics processor. 'Settings → Translation' names the settings tab.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.downloadGpu"
msgid "Needs {model} for the GPU, a {size} download: get it in Settings → Translation."
msgstr "Ehhez kell a GPU-hoz: {model}, {size} letöltés – töltsd le itt: Beállítások → Fordítás."

#. Reason a translation model cannot run on the graphics processor: the graphics hardware allows too few storage buffers per shader, or too little workgroup memory, for the translation library. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'. 'Settings → Translation' names the settings tab. GPU is the usual abbreviation for the graphics processor.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.gpuLimits"
msgid "This GPU's shader limits are too low to run models on it."
msgstr "Ennek a GPU-nak a shader-korlátai túl alacsonyak ahhoz, hogy modelleket futtassunk rajta."

#. Reason a translation model cannot run on the graphics processor: the page is plain HTTP. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'. 'Settings → Translation' names the settings tab. Keep 'WebGPU', 'HTTPS' and 'localhost'; GPU is the usual abbreviation for the graphics processor.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.insecureOrigin"
msgid "WebGPU needs the app served over HTTPS (or from localhost), so models can't run on the GPU here."
msgstr "A WebGPU-hoz HTTPS-en (vagy localhostról) kell kiszolgálni az alkalmazást, ezért a modellek itt nem futhatnak a GPU-n."

#. Reason a translation cannot run: the user turned off the language model's switch. {model} is its product name, e.g. 'Qwen3 1.7B', never translated. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'. 'Settings → Translation' names the settings tab.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.llmOff"
msgid "{model} is switched off in Settings → Translation."
msgstr "A(z) {model} ki van kapcsolva itt: Beállítások → Fordítás."

#. Reason a translation cannot run: this language pair can be served by the language model or by NLLB-200 (no smaller OPUS-MT model covers it), and the user has switched both off — turning either one on in Settings → Translation would make it work. {model} is the language model's product name, e.g. 'Qwen3 1.7B'; NLLB-200 is a model's name; all never translated. Shown wherever a translation action is unavailable, as a sentence of its own.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.llmOrNllbOff"
msgid "This needs {model} or NLLB-200, and both are switched off in Settings → Translation."
msgstr "Ehhez a(z) {model} vagy az NLLB-200 kell, és mindkettő ki van kapcsolva itt: Beállítások → Fordítás."

#. Reason a translation did not run: the user answered 'Not now' when asked to download the model it needs, and it is not on this device yet. Shown under a translated line that failed (cut at about 120 characters there, so keep it short), in the composer's translation strip and in the translation controls. {model} is the model's name as Settings lists it, e.g. 'Qwen3 1.7B (GPU, all languages)'; {size} its download size with its unit, e.g. '938.4 MiB'. 'Settings → Translation' names the settings tab.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.needsDownload"
msgid "Needs {model}, a {size} download: get it in Settings → Translation."
msgstr "Ehhez kell: {model}, {size} letöltés – töltsd le itt: Beállítások → Fordítás."

#. Reason a translation cannot run: only the NLLB-200 model serves this language pair here, and the user has not switched it on (it is off by default because its licence is non-commercial). Shown wherever a translation action is unavailable, as a sentence of its own. NLLB-200 is a model name, never translated. 'Settings → Translation' names the settings tab.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.nllbOff"
msgid "This needs NLLB-200, which is switched off in Settings → Translation."
msgstr "Ehhez az NLLB-200 szükséges, amely ki van kapcsolva itt: Beállítások → Fordítás."

#. Reason a GPU translation model cannot run: WebGPU exists but returned no graphics adapter. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.noAdapter"
msgid "This browser has WebGPU but found no GPU it can use."
msgstr "Ebben a böngészőben van WebGPU, de nem talált használható GPU-t."

#. Reason a translation cannot run: the user pinned the language model to the CPU but chose a model (the larger Qwen3 4B) that has no CPU version. {model} is the chosen model's product name, {choice} the smaller model's ('Qwen3 1.7B'), which does have one; both never translated. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'. 'Settings → Translation' names the settings tab.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.noCpuCopy"
msgid "{model} can't run on the CPU. Choose {choice} to run it there."
msgstr "A(z) {model} nem futhat a CPU-n. Válaszd ezt: {choice}, hogy ott futhasson."

#. Reason a translation model cannot run on the graphics processor: the graphics card lacks half-precision (16-bit floating point) shader support. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'. 'Settings → Translation' names the settings tab.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.noF16"
msgid "This GPU has no 16-bit float shaders, which models need to run on the GPU."
msgstr "Ennek a GPU-nak nincsenek 16 bites lebegőpontos shaderei, amelyekre a modelleknek szükségük van a GPU-n való futáshoz."

#. Reason a translation model cannot run on the GPU: in this version of the app the translation models OPUS-MT and NLLB-200 have no GPU version, only a CPU one. Shown beside the struck-through 'GPU' choice of a model's 'Run on' setting in Settings → Translation, and wherever a translation action is unavailable because that model was set to run on the GPU (the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Translating this message needs a translation model.'. 'The app' is this IRC client; GPU and CPU are the usual abbreviations, keep them as the language normally writes them.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.noGpuCopy"
msgid "This model can't run on the GPU in this version of the app."
msgstr "Ez a modell az alkalmazás ezen verziójában nem futhat a GPU-n."

#. Reason the language model (a large AI model) cannot run on the main processor (CPU): the browser's WebAssembly has no 64-bit memory, which the model needs. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'. 'Settings → Translation' names the settings tab. Keep 'WebAssembly'.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.noMemory64"
msgid "This browser can't run the language model on the CPU (it has no 64-bit WebAssembly memory)."
msgstr "Ez a böngésző nem tudja a nyelvi modellt a CPU-n futtatni (nincs 64 bites WebAssembly-memóriája)."

#. Reason a translation model cannot run on the main processor (CPU). Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'. 'Settings → Translation' names the settings tab. Keep 'WebAssembly SIMD'.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.noWasmSimd"
msgid "This browser has no WebAssembly SIMD, which models need to run on the CPU."
msgstr "Ebben a böngészőben nincs WebAssembly SIMD, amelyre a modelleknek szükségük van a CPU-n való futáshoz."

#. Reason a translation model cannot run on the graphics processor. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'. 'Settings → Translation' names the settings tab. 'WebGPU' is a browser API name, keep it.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.noWebgpu"
msgid "This browser has no WebGPU, which models need to run on the GPU."
msgstr "Ebben a böngészőben nincs WebGPU, amelyre a modelleknek szükségük van a GPU-n való futáshoz."

#. Reason a GPU translation model cannot run on this phone or tablet: the model is too large for the memory a mobile browser gives one page, whatever the graphics processor. Shown under the model's row in Settings → Translation (after 'Can't run on this device', its Download button greyed out), under the language model select after '{model} can't run on this device.' (the select's own hint above it gives the model's memory size), and wherever an action needing that model is unavailable, as a sentence of its own after a lead sentence such as 'Correcting a message needs the language model.'.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.phoneMemory"
msgid "It needs more memory than a phone or tablet lets a web page use."
msgstr "Több memóriát igényel, mint amennyit egy telefon vagy táblagép egy weboldalnak enged."

#. Reason nothing can translate: the app's check of the device's GPU and CPU features threw an error. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.probeFailed"
msgid "Checking what this device can run failed, so translation is off."
msgstr "Nem sikerült megállapítani, mit tud futtatni ez az eszköz, ezért a fordítás ki van kapcsolva."

#. Shown while the app is still checking the device's GPU and CPU features, before any translation model can be judged; also the status line of each model row in Settings → Translation meanwhile.
#: client/js/helpers/translateWhy.ts
#: client/components/Settings/Translation.vue
msgctxt "translate.why.probing"
msgid "Still checking what this device can run…"
msgstr "Még folyik annak ellenőrzése, mit tud futtatni ez az eszköz…"

#. Reason a translation cannot run: no installed translation model translates between the two languages asked for. Shown wherever a translation action is unavailable (Settings → Translation's model rows, the composer's translate dialog, the per-channel translation panel, the message toolbar's tooltip), as a sentence of its own under a lead sentence such as 'Correcting a message needs the language model.'.
#: client/js/helpers/translateWhy.ts
msgctxt "translate.why.unserved"
msgid "No model on this device covers this pair of languages."
msgstr "Ezen az eszközön egyetlen modell sem fedi le ezt a nyelvpárt."

#. Translation panel, channel languages field. {channel} is the channel's name (#seance).
#: client/components/TranslationPanel.vue
msgctxt "translation.panel.languages"
msgid "Languages: {channel}"
msgstr "Nyelvek: {channel}"

#. Translation panel, a language chip's remove button. {language} is the language's name in the interface language.
#: client/components/TranslationPanel.vue
msgctxt "translation.panel.remove"
msgid "Remove {language}"
msgstr "Eltávolítás: {language}"

#. Line above the message input naming the two longest-typing users and summarizing everyone else. {nick1} and {nick2} are those users' names; {count} is how many further users are typing. The singular form shows when one further user is meant, the plural for any other number.
#: client/components/TypingIndicator.vue:31
msgctxt "typing.many"
msgid "{nick1}, {nick2} and {count} other is typing…"
msgid_plural "{nick1}, {nick2} and {count} others are typing…"
msgstr[0] "{nick1}, {nick2} és még {count} személy gépel…"
msgstr[1] "{nick1}, {nick2} és még {count} személy gépel…"

#. Line above the message input saying that one user is writing a message right now. {nick} is that user's name.
#: client/components/TypingIndicator.vue:31
msgctxt "typing.one"
msgid "{nick} is typing…"
msgstr "{nick} gépel…"

#. Line above the message input saying that three users are writing messages right now. {nick1}, {nick2} and {nick3} are their names, in the order they started typing.
#: client/components/TypingIndicator.vue:31
msgctxt "typing.three"
msgid "{nick1}, {nick2} and {nick3} are typing…"
msgstr "{nick1}, {nick2} és {nick3} gépelnek…"

#. Line above the message input saying that two users are writing messages right now. {nick1} and {nick2} are their names, in the order they started typing.
#: client/components/TypingIndicator.vue:31
msgctxt "typing.two"
msgid "{nick1} and {nick2} are typing…"
msgstr "{nick1} és {nick2} gépelnek…"

#. Error notice when the file's type is not on the uploader's accepted list. {file} is the file's name — user content, never translated; {types} is the accepted-type list from the deploy's config, kept verbatim.
#: client/js/upload.ts:788
msgctxt "upload.badType"
msgid "File {file} is not a type this uploader accepts ({types})"
msgstr "A(z) {file} fájl típusát ez a feltöltő nem fogadja el ({types})"

#. Button of the upload confirmation dialog; clicking cancels the whole upload and sends nothing.
#: client/components/UploadPreview.vue
msgctxt "upload.cancel"
msgid "Cancel"
msgstr "Mégse"

#. Notice when an upload in flight was cancelled before it finished.
#: client/js/upload.ts:460
msgctxt "upload.cancelled"
msgid "Upload cancelled"
msgstr "Feltöltés megszakítva"

#. Confirmation button of the upload dialog when several files are queued (so in practice the count is 2 or more); clicking sends them all to the chat server. {count} is the number of files.
#: client/components/UploadPreview.vue
msgctxt "upload.confirmCount"
msgid "Upload {count} file"
msgid_plural "Upload {count} files"
msgstr[0] "{count} fájl feltöltése"
msgstr[1] "{count} fájl feltöltése"

#. Intro line of the upload confirmation dialog; asks the user to check the files and warns that every uploaded file is reachable through its link.
#: client/components/UploadPreview.vue
msgctxt "upload.confirmHint"
msgid "Check that this is what you meant to share, then upload. Anyone who can open the link will be able to see it."
msgstr "Ellenőrizd, hogy ezt akartad-e megosztani, majd töltsd fel. Bárki, aki meg tudja nyitni a linket, látni fogja."

#. Confirmation button of the upload confirmation dialog when one file is queued; clicking sends it to the chat server.
#: client/components/UploadPreview.vue
msgctxt "upload.confirmOne"
msgid "Upload"
msgstr "Feltöltés"

#. Title of the confirmation dialog shown before files are uploaded to the chat server, when several files were chosen.
#: client/components/UploadPreview.vue
msgctxt "upload.confirmTitleMany"
msgid "Upload these files?"
msgstr "Feltöltöd ezeket a fájlokat?"

#. Title of the confirmation dialog shown before files are uploaded to the chat server, when one file was chosen.
#: client/components/UploadPreview.vue
msgctxt "upload.confirmTitleOne"
msgid "Upload this file?"
msgstr "Feltöltöd ezt a fájlt?"

#. Error notice when the user tries to send a file while the network is disconnected. Shown in the error strip above the message input.
#: client/js/upload.ts:765
msgctxt "upload.disconnected"
msgid "You are currently disconnected, unable to initiate upload process."
msgstr "Jelenleg nincs kapcsolat, a feltöltés nem indítható el."

#. Frame for a failed upload; the underlying reason follows the colon. {reason} is the browser's or endpoint's own message, kept verbatim — its content is not our copy.
#: client/js/upload.ts:464
msgctxt "upload.failed"
msgid "Upload failed: {reason}"
msgstr "A feltöltés sikertelen: {reason}"

#. Frame for a failed upload when the endpoint answered with an error status and no readable message. {status} is the numeric HTTP status code.
#: client/js/upload.ts:476
msgctxt "upload.failedHttp"
msgid "Upload failed: HTTP {status}"
msgstr "A feltöltés sikertelen: HTTP {status}"

#. Error notice when the upload endpoint answered but its reply lacks the expected URL field. {field} is the response path named in the deploy's config (technical, never translated).
#: client/js/upload.ts:353
msgctxt "upload.missingField"
msgid "Upload failed: the uploader did not return a \"{field}\" URL"
msgstr "A feltöltés sikertelen: a feltöltő nem adott vissza „{field}” URL-t"

#. Error notice when the browser offers no way to send a request, so the upload cannot even start.
#: client/js/upload.ts:447
msgctxt "upload.noFetch"
msgid "Upload failed: fetch is not available"
msgstr "A feltöltés sikertelen: a fetch nem érhető el"

#. Error notice when the upload endpoint's reply carries no usable link.
#: client/js/upload.ts:365
msgctxt "upload.noUrl"
msgid "Upload failed: the uploader did not return a URL"
msgstr "A feltöltés sikertelen: a feltöltő nem adott vissza URL-t"

#. Error notice when the user drops, pastes or picks a file but this deploy has no uploads endpoint configured, so no file can be sent. Shown in the error strip above the message input.
#: client/js/upload.ts:758
msgctxt "upload.notConfigured"
msgid "File uploads are not configured in this client."
msgstr "A fájlfeltöltés nincs beállítva ebben a kliensben."

#. Note under an animated image in the upload confirmation dialog; it is not re-drawn, so its animation survives. Em dash is part of the copy.
#: client/components/UploadPreview.vue
msgctxt "upload.noteAnimated"
msgid "Animated — sent as it is, so the animation is kept"
msgstr "Animált — változatlanul elküldve, így az animáció megmarad"

#. Note under a file in the upload confirmation dialog when it will be sent unchanged, with its metadata. Starts the note.
#: client/components/UploadPreview.vue
msgctxt "upload.noteOff"
msgid "Sent as it is, metadata included"
msgstr "Változatlanul elküldve, a metaadatokkal együtt"

#. Note under a file in the upload confirmation dialog when the remove-metadata setting is on and the image will be re-drawn to strip its EXIF metadata. Capitalized; starts the note.
#: client/components/UploadPreview.vue
msgctxt "upload.noteStrip"
msgid "Metadata (EXIF) will be removed before upload"
msgstr "A metaadatok (EXIF) feltöltés előtt eltávolításra kerülnek"

#. Note under a file in the upload confirmation dialog when the app cannot re-process it and it will be sent unchanged. Starts the note.
#: client/components/UploadPreview.vue
msgctxt "upload.noteUnsupported"
msgid "Sent as it is"
msgstr "Változatlanul elküldve"

#. Error notice when the network's own upload host (IRCv3 FILEHOST) would not issue an upload token. {reason} is the server's text or a client-side reason, verbatim.
#: client/js/upload.ts
msgctxt "upload.refused"
msgid "Upload refused by the network: {reason}"
msgstr "A hálózat nem engedte meg a feltöltést: {reason}"

#. aria-label of the ✕ button on a file in the upload confirmation dialog; clicking removes that file from the upload. {name} is the file's name.
#: client/components/UploadPreview.vue
msgctxt "upload.removeOne"
msgid "Don't upload {name}"
msgstr "Ne töltsd fel: {name}"

#. Tooltip of the ✕ button on a file in the upload confirmation dialog; clicking removes the file from the upload.
#: client/components/UploadPreview.vue
msgctxt "upload.removeTitle"
msgid "Don't upload this file"
msgstr "Ne töltsd fel ezt a fájlt"

#. Error notice when a file the user sent is larger than the uploader's size limit. {file} is the file's name — user content, never translated.
#: client/js/upload.ts:779
msgctxt "upload.tooLarge"
msgid "File {file} is over the maximum allowed size"
msgstr "A {file} fájl mérete meghaladja a megengedett maximum méretet"

#. Placeholder of the search field at the top of the user list panel: how many members the channel has while the list is being filtered. The singular shows with exactly one member, the plural otherwise.
#: client/components/ChatUserList.vue:13
msgctxt "userlist.count"
msgid "{count} user"
msgid_plural "{count} users"
msgstr[0] "{count} felhasználó"
msgstr[1] "{count} felhasználó"

#. Heading of the channel administrators group in the user list (channel mode +a, the & prefix).
#: client/components/ChatUserList.vue
msgctxt "userlist.mode.admins"
msgid "Administrators"
msgstr "Adminisztrátorok"

#. Heading of the half-operators group in the user list (channel mode +h, the % prefix).
#: client/components/ChatUserList.vue
msgctxt "userlist.mode.halfOperators"
msgid "Half-Operators"
msgstr "Félopok"

#. Heading of the channel operators group in the user list (channel mode +o, the @ prefix).
#: client/components/ChatUserList.vue
msgctxt "userlist.mode.operators"
msgid "Operators"
msgstr "Operátorok"

#. Heading of the channel owners group in the user list (channel mode +q, the ~ prefix).
#: client/components/ChatUserList.vue
msgctxt "userlist.mode.owners"
msgid "Owners"
msgstr "Tulajdonosok"

#. Heading of the group of users without a channel mode in the user list.
#: client/components/ChatUserList.vue
msgctxt "userlist.mode.users"
msgid "Users"
msgstr "Felhasználók"

#. Heading of the voiced users group in the user list (channel mode +v, the + prefix): users allowed to speak in a moderated channel.
#: client/components/ChatUserList.vue
msgctxt "userlist.mode.voiced"
msgid "Voiced"
msgstr "Voice-osok"

#. Visually hidden but screen-reader-spoken label of the search field at the top of the channel member panel, used to filter the member list by name.
#: client/components/ChatUserList.vue:17
msgctxt "userlist.searchLabel"
msgid "Search among the user list"
msgstr "Keresés a felhasználók listájában"

#. aria-label of the side panel listing a channel's members. {name} is the channel's name as shown in the header; it is a chat name and stays as written.
#: client/components/ChatUserList.vue:5
msgctxt "userlist.title"
msgid "User list for {name}"
msgstr "Felhasználólista: {name}"

#. The /who result table in the chat (IRC WHO reply). Column heading: the services account the user is logged in to.
#: client/components/MessageTypes/who.vue
msgctxt "who.account"
msgid "Account"
msgstr "Fiók"

#. The /who result table in the chat (IRC WHO reply). How many users matched, after the title.
#: client/components/MessageTypes/who.vue
msgctxt "who.count"
msgid "{count} user"
msgid_plural "{count} users"
msgstr[0] "{count} felhasználó"
msgstr[1] "{count} felhasználó"

#. The /who result table in the chat (IRC WHO reply). A tag in the Status column: the user is away. One short word.
#: client/components/MessageTypes/who.vue
msgctxt "who.flagAway"
msgid "away"
msgstr "távol"

#. The /who result table in the chat (IRC WHO reply). A tag in the Status column: the user is a bot. One short word.
#: client/components/MessageTypes/who.vue
msgctxt "who.flagBot"
msgid "bot"
msgstr ""

#. The /who result table in the chat (IRC WHO reply). A tag in the Status column: the user is an IRC operator. One short word; 'oper' is IRC jargon.
#: client/components/MessageTypes/who.vue
msgctxt "who.flagOper"
msgid "oper"
msgstr "oper"

#. The /who result table in the chat (IRC WHO reply). Column heading: the IRC user name and host, written user@host.
#: client/components/MessageTypes/who.vue
msgctxt "who.host"
msgid "User@host"
msgstr "Felhasználó@hoszt"

#. The /who result table in the chat (IRC WHO reply). Column heading: nickname.
#: client/components/MessageTypes/who.vue
msgctxt "who.nick"
msgid "Nick"
msgstr "Becenév"

#. Error line in the chat after /who found nobody; {mask} is what was queried. 'WHO' is the IRC command name; keep it.
#: client/js/irc/handlers/who.ts
msgctxt "who.noMatch"
msgid "No one matched WHO {mask}"
msgstr "Senki sem illeszkedett: WHO {mask}"

#. The /who result table in the chat (IRC WHO reply). Tooltip on a host: the IRC server the user is connected to; {server} is its name.
#: client/components/MessageTypes/who.vue
msgctxt "who.onServer"
msgid "on {server}"
msgstr "szerver: {server}"

#. The /who result table in the chat (IRC WHO reply). Column heading: the user's real name (gecos).
#: client/components/MessageTypes/who.vue
msgctxt "who.realName"
msgid "Real name"
msgstr "Valódi név"

#. The /who result table in the chat (IRC WHO reply). Column heading: channel prefix (@, +) and flags (oper, away, bot).
#: client/components/MessageTypes/who.vue
msgctxt "who.status"
msgid "Status"
msgstr "Állapot"

#. The /who result table in the chat (IRC WHO reply). Title line; {target} is the channel, nick or wildcard mask queried.
#: client/components/MessageTypes/who.vue
msgctxt "who.title"
msgid "Who is on {target}"
msgstr "Kik vannak itt: {target}"

#. Whois row: the user's real IP and hostname, verbatim server data.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.actualHost"
msgid "Actual host:"
msgstr "Valódi hoszt:"

#. Whois row: the user's real username (ident), verbatim server data.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.actualUsername"
msgid "Actual username:"
msgstr "Valódi felhasználónév:"

#. Whois row: the user's away reason, verbatim server content.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.awayLabel"
msgid "Away:"
msgstr "Távol:"

#. Whois row value when the user is away but gave no away message (draft/pre-away). Shown in parentheses, italic.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.awayNoMessage"
msgid "(no message)"
msgstr "(nincs üzenet)"

#. Fallback away reason for a query contact whose RPL_AWAY carries no text; it lands in the reason slot of the away system message ('<name> is away (<reason>)') and in the query's away state. Lowercase mid-sentence by position.
#: client/js/irc/handlers/whois.ts
msgctxt "whois.awayNoReason"
msgid "is away"
msgstr "távol van"

#. Whois row naming a user marked as a bot; the value is a Yes.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.bot"
msgid "Is a bot:"
msgstr "Bot:"

#. Row label of a WHOIS result card in the chat (a definition list: label, then value). The user's bouncer session (the server keeping their connection).
#: client/components/MessageTypes/whois.vue
msgctxt "whois.bouncer"
msgid "Bouncer:"
msgstr ""

#. Whois row: a TLS client certificate fingerprint, verbatim hex data.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.cert"
msgid "Certificate:"
msgstr "Tanúsítvány:"

#. Whois row: the channels the user is in, verbatim server data.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.channels"
msgid "Channels:"
msgstr "Csatornák:"

#. Button under a WHOIS result, for IRC operators: runs the server's CHECK command on the user. {nick} is the nickname. 'CHECK' is the command name.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.checkNick"
msgid "Check {nick}"
msgstr "{nick} ellenőrzése"

#. Whois row: when the user connected, locale-formatted.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.connectedAt"
msgid "Connected at:"
msgstr "Kapcsolódás ideje:"

#. Whois row: the server the user is on and its info line, verbatim server data.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.connectedTo"
msgid "Connected to:"
msgstr "Kapcsolódva ehhez:"

#. Whois row naming a user marked as a help operator; the value is a Yes.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.helpop"
msgid "Available for help:"
msgstr "Segítségnyújtásra elérhető:"

#. Whois row: the user's ident and hostmask, verbatim server data.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.hostmask"
msgid "Host mask:"
msgstr "Hosztmaszk:"

#. Whois row: when the user was last active, locale-formatted.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.idleSince"
msgid "Idle since:"
msgstr "Tétlenség kezdete:"

#. Row label of a WHOIS result card in the chat (a definition list: label, then value). The kill list (K-line style ban list) the user is on. Shown to IRC operators.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.killListed"
msgid "Kill listed:"
msgstr "Kill-listán:"

#. Whois row: the services account the user is logged into; the value is account data, verbatim.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.loggedAs"
msgid "Logged in as:"
msgstr "Bejelentkezett mint:"

#. Row label of a WHOIS result card in the chat (a definition list: label, then value). Marks the server set on the user (DNSBL, IAuth).
#: client/components/MessageTypes/whois.vue
msgctxt "whois.marks"
msgid "Marks:"
msgstr "Jelölések:"

#. Whois row: the user's modes, verbatim protocol text.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.modes"
msgid "Modes:"
msgstr "Módok:"

#. Shown after the nick of a user who left the network (WHOWAS), leading the last recorded whois data; the nick renders direction-isolated in <bdi>.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.offline"
msgid "is offline, last information:"
msgstr "offline, utolsó információ:"

#. Whois row: the user's IRC-operator status, verbatim server data.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.operator"
msgid "Operator:"
msgstr "Operátor:"

#. Whois row: the user's realname field, user content, verbatim.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.realName"
msgid "Real name:"
msgstr "Valódi név:"

#. Whois row: the user's services-registered nick, verbatim.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.registeredNick"
msgid "Registered nick:"
msgstr "Regisztrált becenév:"

#. Whois row naming a user connected over TLS; the value is a Yes.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.secure"
msgid "Secure connection:"
msgstr "Biztonságos kapcsolat:"

#. Whois row: extra server-specific whois lines, verbatim server data.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.special"
msgid "Special:"
msgstr "Különleges:"

#. Row label of a WHOIS result card in the chat (a definition list: label, then value). The WebIRC gateway the user connected through.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.webirc"
msgid "Via gateway:"
msgstr "Átjárón keresztül:"

#. Row label of a WHOIS result card in the chat (a definition list: label, then value). The address a WebSocket connection came from. 'WebSocket' is a protocol name.
#: client/components/MessageTypes/whois.vue
msgctxt "whois.websocket"
msgid "WebSocket from:"
msgstr "WebSocket innen:"

#. The value of whois rows whose answer is affirmative (help operator, bot, secure connection).
#: client/components/MessageTypes/whois.vue
msgctxt "whois.yes"
msgid "Yes"
msgstr "Igen"

#. Text of the link in the changelog window that opens the list of every release.
#: client/components/Windows/Changelog.vue
msgctxt "windows.changelog.allReleasesLink"
msgid "see all releases"
msgstr "az összes kiadás megtekintése"

#. aria-label of the changelog window, which shows the app's release notes.
#: client/components/Windows/Changelog.vue
msgctxt "windows.changelog.aria"
msgid "Changelog"
msgstr "Verziójegyzék"

#. Link at the top of the changelog window that goes back to the help page; the left double angle quote is part of the copy.
#: client/components/Windows/Changelog.vue
msgctxt "windows.changelog.back"
msgid "« Help"
msgstr "« Súgó"

#. Changelog window paragraph. {readNotes} is a link whose text is windows.changelog.readNotesLink ('Read the notes for v5.2.0') and {allReleases} a link whose text is windows.changelog.allReleasesLink ('see all releases').
#: client/components/Windows/Changelog.vue
msgctxt "windows.changelog.notBundledLine"
msgid "Release notes are not bundled with the build. {readNotes} or {allReleases}."
msgstr "A kiadási megjegyzések nincsenek a buildben. {readNotes} vagy {allReleases}."

#. Changelog window sentence shown when the running build is newer than its release. {commit} is a link whose text is help.commitHash ('commit 1a2b3c4'); {version} is the release number, kept after its v; {since} is a link whose text is windows.changelog.sinceReleaseLink ('what changed since the release').
#: client/components/Windows/Changelog.vue
msgctxt "windows.changelog.pastReleaseLine"
msgid "This build is {commit}, after v{version}: {since}."
msgstr "Ez a build: {commit}, a v{version} után: {since}."

#. Text of the link in the changelog window that opens the release notes for this release. {version} is the release number, with the v as in the source.
#: client/components/Windows/Changelog.vue
msgctxt "windows.changelog.readNotesLink"
msgid "Read the notes for v{version}"
msgstr "A v{version} kiadási jegyzeteinek elolvasása"

#. Text of the link in the changelog's past-release sentence that opens the list of changes between the release and this build. Mid-sentence.
#: client/components/Windows/Changelog.vue
msgctxt "windows.changelog.sinceReleaseLink"
msgid "what changed since the release"
msgstr "mi változott a kiadás óta"

#. Heading of the changelog window. {version} is the release version number, kept as written (a v followed by the number).
#: client/components/Windows/Changelog.vue
msgctxt "windows.changelog.title"
msgid "Release notes for v{version}"
msgstr "A v{version} kiadási jegyzetei"

#. Link at the top of the network-editing form that goes back to the list of saved networks; the left arrow is part of the copy.
#: client/components/Windows/NetworkEdit.vue
msgctxt "windows.networkEdit.back"
msgid "← Networks"
msgstr "← Hálózatok"

#. aria-label of the ✕ button at the top right of the settings window; clicking closes the settings and returns to the chat.
#: client/components/Windows/Settings.vue
msgctxt "windows.settings.close"
msgid "Close settings"
msgstr "Beállítások bezárása"

#. Button in the footer of the settings window; clicking closes the settings and returns to the chat.
#: client/components/Windows/Settings.vue
msgctxt "windows.settings.done"
msgid "Done"
msgstr "Kész"

#. Line in the footer of the settings window, beside the Done button; explains that settings apply instantly and nothing needs saving.
#: client/components/Windows/Settings.vue
msgctxt "windows.settings.note"
msgid "Changes are saved as you make them."
msgstr "A módosítások azonnal mentésre kerülnek."

#. Title of the settings window: the heading of the modal, its dialog aria-label, and the accessible name of the whole settings pane.
#: client/components/Windows/Settings.vue
msgctxt "windows.settings.title"
msgid "Settings"
msgstr "Beállítások"
