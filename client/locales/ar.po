#. About line at the top of the Help window, before the app name.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.about"
msgid "About"
msgstr "حول"

#. Description of the # autocompletion trigger in the help window: typing # suggests channel names.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.channel"
msgid "Channel"
msgstr "القناة"

#. Description of the / autocompletion trigger in the help window: typing / suggests slash commands; the parenthesized phrase points at the command list further down this page.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.commands"
msgid "Commands (see list of commands below)"
msgstr "الأوامر (انظر قائمة الأوامر أدناه)"

#. Line after the autocompletion intro in the help window; points at the app's settings.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.disabled"
msgid "Autocompletion can be disabled in settings."
msgstr "يمكن تعطيل الإكمال التلقائي في الإعدادات."

#. Description of the : autocompletion trigger in the help window. {example} is a smiley shown as a code fragment (:) ), kept verbatim.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.emoji"
msgid "Emoji (note: requires two search characters, to avoid conflicting with common emoticons like {example})"
msgstr "الرموز التعبيرية (ملاحظة: يتطلب حرفَي بحث، لتجنّب التعارض مع الوجوه التعبيرية الشائعة مثل {example})"

#. Heading of the autocompletion section of the help window; explains the prefix characters that open suggestion lists.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.heading"
msgid "Autocompletion"
msgstr "الإكمال التلقائي"

#. Autocompletion intro in the help window, one paragraph. {up} and {down} are the arrow-key keycaps (↑ ↓), {tab} and {enter} the Tab and Enter keycaps, each rendered as a keycap element where its placeholder stands; order them as your language needs.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.intro"
msgid "To auto-complete nicknames, channels, commands, and emoji, type one of the characters below to open a suggestion list. Use the {up} and {down} keys to highlight an item, and insert it by pressing {tab} or {enter} (or by clicking the desired item)."
msgstr "لإكمال الأسماء المستعارة والقنوات والأوامر والرموز التعبيرية تلقائيًا، اكتب أحد الأحرف أدناه لفتح قائمة اقتراحات. استخدم المفتاحين {up} و{down} لتحديد عنصر، وأدرجه بالضغط على {tab} أو {enter} (أو بالنقر على العنصر المطلوب)."

#. Description of the @ autocompletion trigger in the help window: typing @ suggests user names.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.nick"
msgid "Nickname"
msgstr "الاسم المستعار"

#. Help window sentence shown when the running build is newer than its release. {app} is the app's name (verbatim); {commit} is a link whose text is help.commitHash ('commit 1a2b3c4'); {version} is the release number, kept after its v.
#: client/components/Windows/Help.vue
msgctxt "help.builtFromCommit"
msgid "{app} is built from {commit}, after v{version}."
msgstr "بُني {app} من {commit}، بعد v{version}."

#. aria-label of the ✕ button at the top right of the Help window (a modal over the app); clicking closes Help and returns to the chat.
#: client/components/Windows/Help.vue
msgctxt "help.close"
msgid "Close help"
msgstr "إغلاق المساعدة"

#. Lead-in of the alias line under a command description in the help window; the alternative command follows it as a code fragment. Keep the trailing colon.
#: client/components/Windows/Help.vue
msgctxt "help.commands.alias"
msgid "Alias:"
msgstr "الاسم البديل:"

#. Lead-in of the alias line under a command description in the help window when the command has several alternative names; the alternatives follow as code fragments. Keep the trailing colon.
#: client/components/Windows/Help.vue
msgctxt "help.commands.aliases"
msgid "Aliases:"
msgstr "الأسماء البديلة:"

#. Description of the /away command in the help window; the command syntax (/away [message]) is shown beside it and stays untranslated.
#: client/components/Windows/Help.vue
msgctxt "help.commands.away"
msgid "Mark yourself as away with an optional message."
msgstr "يعيّنك غائبًا مع رسالة اختيارية."

#. Description of the /back command in the help window. {command} is the /away command, shown as a code fragment and never translated.
#: client/components/Windows/Help.vue
msgctxt "help.commands.back"
msgid "Remove your away status (set with {command})."
msgstr "يزيل حالة الغياب الخاصة بك (المعيَّنة بـ {command})."

#. Description of the /ban command in the help window. {mode} is the channel mode +b, rendered as a code element; the parentheses are part of the copy.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ban"
msgid "Ban ({mode}) a user from the current channel. This can be a nickname or a hostmask."
msgstr "يحظر ({mode}) مستخدمًا من القناة الحالية. يمكن أن يكون اسمًا مستعارًا أو قناع مضيف."

#. Description of the /banlist command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.banlist"
msgid "Load the banlist for the current channel."
msgstr "يحمّل قائمة الحظر للقناة الحالية."

#. Description of the /cleartopic command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.cleartopic"
msgid "Clear the topic in the current channel."
msgstr "يمسح موضوع القناة الحالية."

#. Description of the /collapse command in the help window. {command} is the /expand command, shown as a code fragment and never translated.
#: client/components/Windows/Help.vue
msgctxt "help.commands.collapse"
msgid "Collapse all previews in the current channel (opposite of {command})"
msgstr "يطوي كل المعاينات في القناة الحالية (عكس {command})"

#. Description of the /connect command in the help window. {port} is the command's port parameter (the word 'port' as a code element) and {plus} the plus sign '+' as a code element; TLS stays verbatim.
#: client/components/Windows/Help.vue
msgctxt "help.commands.connect"
msgid "Connect to a new IRC network. If {port} starts with a {plus} sign, the connection will be made secure using TLS."
msgstr "يتصل بشبكة IRC جديدة. إذا بدأ {port} بالعلامة {plus}، فسيُؤمَّن الاتصال بـ TLS."

#. Description of the /ctcp command in the help window. {ctcp} is the abbreviation CTCP (never translated, an element with its expansion as tooltip); {link} is a link whose text is help.commands.ctcpLink ('the dedicated Wikipedia article') — write this frame so that phrase fits where {link} stands.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ctcp"
msgid "Send a {ctcp} request. Read more about this on {link}."
msgstr "يرسل طلب {ctcp}. اقرأ المزيد في {link}."

#. Text of the link at the end of the /ctcp command description in the help window (help.commands.ctcp, where it stands for {link}); it opens the Wikipedia article on CTCP. Use the form that fits that frame in your language.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ctcpLink"
msgid "the dedicated Wikipedia article"
msgstr "مقالة ويكيبيديا المخصصة له"

#. Expansion of the acronym CTCP, shown as the abbreviation's hover tooltip in the help window's /ctcp command description.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ctcpTitle"
msgid "Client-to-client protocol"
msgstr "بروتوكول العميل إلى العميل"

#. Description of the /deop command in the help window. {mode} is the channel mode -o, rendered as a code element; 'op' is IRC channel-operator status (keep the catalog's usual term).
#: client/components/Windows/Help.vue
msgctxt "help.commands.deop"
msgid "Remove op ({mode}) from one or several users in the current channel."
msgstr "يسحب صلاحية المشرف ({mode}) من مستخدم أو أكثر في القناة الحالية."

#. Description of the /devoice command in the help window. {mode} is the channel mode -v, rendered as a code element; 'voice' is the IRC right to speak in a moderated channel.
#: client/components/Windows/Help.vue
msgctxt "help.commands.devoice"
msgid "Remove voice ({mode}) from one or several users in the current channel."
msgstr "يسحب حق الكلام ({mode}) من مستخدم أو أكثر في القناة الحالية."

#. Description of the /disconnect command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.disconnectLong"
msgid "Disconnect from the current network with an optionally-provided message."
msgstr "يقطع الاتصال بالشبكة الحالية مع رسالة اختيارية."

#. Description of the /expand command in the help window. {command} is the /collapse command, shown as a code fragment and never translated.
#: client/components/Windows/Help.vue
msgctxt "help.commands.expand"
msgid "Expand all previews in the current channel (opposite of {command})"
msgstr "يوسّع كل المعاينات في القناة الحالية (عكس {command})"

#. Heading of the commands section of the help window; one row per slash command with its syntax and description.
#: client/components/Windows/Help.vue
msgctxt "help.commands.heading"
msgid "Commands"
msgstr "أوامر"

#. Description of the /ignore command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ignore"
msgid "Block any messages from the specified user on the current network. This can be a nickname or a hostmask."
msgstr "يحجب كل الرسائل من المستخدم المحدد على الشبكة الحالية. يمكن أن يكون اسمًا مستعارًا أو قناع مضيف."

#. Description of the /ignorelist command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ignorelist"
msgid "Load the list of ignored users for the current network."
msgstr "يحمّل قائمة المستخدمين المتجاهَلين للشبكة الحالية."

#. Description of the /invite command in the help window. {channel} is the command's channel parameter (the word 'channel' as a code element).
#: client/components/Windows/Help.vue
msgctxt "help.commands.invite"
msgid "Invite a user to the specified channel. If {channel} is omitted, user will be invited to the current channel."
msgstr "يدعو مستخدمًا إلى القناة المحددة. إذا حُذف {channel}، فستتم دعوته إلى القناة الحالية."

#. Description of the /join command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.join"
msgid "Join a channel. Password is only needed in protected channels and can usually be omitted."
msgstr "ينضم إلى قناة. لا تلزم كلمة المرور إلا في القنوات المحمية، ويمكن عادةً حذفها."

#. Description of the /kick command in the help window; it removes the user from the channel (they may rejoin).
#: client/components/Windows/Help.vue
msgctxt "help.commands.kick"
msgid "Kick a user from the current channel."
msgstr "يطرد مستخدمًا من القناة الحالية."

#. Description of the /kickban command in the help window. {mode} is the channel mode +b and {ban} the command /ban, each rendered as a code element.
#: client/components/Windows/Help.vue
msgctxt "help.commands.kickban"
msgid "Kick and ban ({mode}) a user from the current channel. Unlike {ban}, only nicknames (and not host masks) can be used."
msgstr "يطرد مستخدمًا من القناة الحالية ويحظره ({mode}). بخلاف {ban}، لا يمكن استخدام إلا الأسماء المستعارة (لا أقنعة المضيف)."

#. Description of the /list command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.list"
msgid "Retrieve a list of available channels on this network."
msgstr "يسترجع قائمة القنوات المتاحة في هذه الشبكة."

#. Description of the /me command in the help window. {appName} is the chat app's display name.
#: client/components/Windows/Help.vue
msgctxt "help.commands.me"
msgid "Send an action message to the current channel. {appName} will display it inline, as if the message was posted in the third person."
msgstr "يرسل رسالة فعل إلى القناة الحالية. سيعرضها {appName} ضمن السطر، كأن الرسالة كُتبت بصيغة الغائب."

#. Description of the /mode command in the help window; explains whose modes the flags apply to depending on the active window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.mode"
msgid "Set the given flags to the current channel if the active window is a channel, another user if the active window is a private message window, or yourself if the current window is a server window."
msgstr "يضبط الأعلام المحددة: للقناة الحالية إذا كانت النافذة النشطة قناة، أو لمستخدم آخر إذا كانت نافذة محادثة خاصة، أو لنفسك إذا كانت النافذة الحالية نافذة خادم."

#. Description of the /msg command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.msg"
msgid "Send a message to the specified channel."
msgstr "يرسل رسالة إلى القناة المحددة."

#. Description of the /mute command in the help window. {command} is the /unmute command, shown as a code fragment and never translated.
#: client/components/Windows/Help.vue
msgctxt "help.commands.mute"
msgid "Prevent messages from generating any feedback for a channel. This turns off the highlight indicator, hides mentions and inhibits push notifications. Muting a network lobby mutes the entire network. Not specifying any channel target mutes the current channel. Revert with {command}."
msgstr "يمنع رسائل القناة من إصدار أي تنبيه. يوقف مؤشر الإبراز، ويخفي الإشارات، ويحجب الإشعارات الفورية. كتم نافذة الشبكة يكتم الشبكة بأكملها. إذا لم تُحدَّد قناة، تُكتم القناة الحالية. يُلغى ذلك بـ {command}."

#. Description of the /nick command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.nick"
msgid "Change your nickname on the current network."
msgstr "يغيّر اسمك المستعار في الشبكة الحالية."

#. Description of the /notice command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.notice"
msgid "Sends a notice message to the specified channel."
msgstr "يرسل رسالة إشعار (notice) إلى القناة المحددة."

#. Description of the /op command in the help window. {mode} is the channel mode +o, rendered as a code element; 'op' is IRC channel-operator status (keep the catalog's usual term).
#: client/components/Windows/Help.vue
msgctxt "help.commands.op"
msgid "Give op ({mode}) to one or several users in the current channel."
msgstr "يمنح صلاحية المشرف ({mode}) لمستخدم أو أكثر في القناة الحالية."

#. Description of the /part command in the help window. {channel} is the command's channel parameter (the word 'channel' as a code element).
#: client/components/Windows/Help.vue
msgctxt "help.commands.part"
msgid "Close the specified channel or private message window, or the current channel if {channel} is omitted."
msgstr "يغلق القناة أو المحادثة الخاصة المحددة، أو القناة الحالية إذا حُذف {channel}."

#. Description of the /query command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.query"
msgid "Send a private message to the specified user."
msgstr "يرسل رسالة خاصة إلى المستخدم المحدد."

#. Description of the /quit command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.quit"
msgid "Disconnect from the current network with an optional message."
msgstr "يقطع الاتصال بالشبكة الحالية مع رسالة اختيارية."

#. Description of the /raw command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.raw"
msgid "Send a raw message to the current IRC network."
msgstr "يرسل رسالة خام إلى شبكة IRC الحالية."

#. Description of the /rejoin command in the help window; ChanServ (the IRC channel service) stays verbatim.
#: client/components/Windows/Help.vue
msgctxt "help.commands.rejoin"
msgid "Leave and immediately rejoin the current channel. Useful to quickly get op from ChanServ in an empty channel, for example."
msgstr "يغادر القناة الحالية ويعود إليها فورًا. مفيد مثلًا للحصول سريعًا على صلاحية المشرف من ChanServ في قناة فارغة."

#. Description of the /search command in the help window. No trailing period in the source; keep it as is.
#: client/components/Windows/Help.vue
msgctxt "help.commands.search"
msgid "Search for messages in the current channel / user"
msgstr "يبحث عن الرسائل في القناة أو المحادثة الحالية"

#. Description of the /slap command in the help window; a playful IRC tradition. Keep the exclamation mark.
#: client/components/Windows/Help.vue
msgctxt "help.commands.slap"
msgid "Slap someone in the current channel with a trout!"
msgstr "اصفع أحدهم في القناة الحالية بسمكة سلمون مرقّط!"

#. Description of the /topic command in the help window. {newtopic} is the command's parameter (the word 'newtopic' as a code element).
#: client/components/Windows/Help.vue
msgctxt "help.commands.topic"
msgid "Get the topic in the current channel. If {newtopic} is specified, sets the topic in the current channel."
msgstr "يعرض موضوع القناة الحالية. إذا حُدِّد {newtopic}، فإنه يعيّن موضوع القناة الحالية."

#. Description of the /unban command in the help window. {mode} is the channel mode -b, rendered as a code element; the parentheses are part of the copy.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unban"
msgid "Unban ({mode}) a user from the current channel. This can be a nickname or a hostmask."
msgstr "يرفع الحظر ({mode}) عن مستخدم في القناة الحالية. يمكن أن يكون اسمًا مستعارًا أو قناع مضيف."

#. Description of the /unignore command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unignore"
msgid "Unblock messages from the specified user on the current network. This can be a nickname or a hostmask."
msgstr "يرفع الحجب عن رسائل المستخدم المحدد في الشبكة الحالية. يمكن أن يكون اسمًا مستعارًا أو قناع مضيف."

#. Description of the /unmute command in the help window. {mute} is the command /mute as a code element.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unmute"
msgid "Un-mutes the given channel(s) or the current channel if no channel is provided. See {mute} for more information."
msgstr "يلغي كتم القنوات المحددة، أو القناة الحالية إذا لم تُحدَّد قناة. راجع {mute} لمزيد من المعلومات."

#. Description of the /ver command in the help window. {ctcp} is the abbreviation CTCP (never translated) and {command} the literal command /ctcp nick version as a code element; VERSION stays verbatim.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ver"
msgid "Ask a user which client they run: a {ctcp} VERSION request, the same as {command}. The answer shows where you asked."
msgstr "يسأل مستخدمًا عن العميل الذي يستخدمه: طلب {ctcp} VERSION، وهو نفسه {command}. يظهر الرد حيث سألت."

#. Description of the /voice command in the help window. {mode} is the channel mode +v, rendered as a code element; 'voice' is the IRC right to speak in a moderated channel.
#: client/components/Windows/Help.vue
msgctxt "help.commands.voice"
msgid "Give voice ({mode}) to one or several users in the current channel."
msgstr "يمنح حق الكلام ({mode}) لمستخدم أو أكثر في القناة الحالية."

#. Help page, description of the /who command. {mask} is an example wildcard mask shown as code (nick!user@host); keep it.
#: client/components/Windows/Help.vue
msgctxt "help.commands.who"
msgid "List who matches the mask (a channel, a nick or a wildcard {mask}), as a table. Without a mask, the users of the current channel."
msgstr "يعرض في جدول من يطابق القناع (قناة أو اسم مستعار أو قناع {mask}). من دون قناع: مستخدمو القناة الحالية."

#. Description of the /whois command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.whois"
msgid "Retrieve information about the given user on the current network."
msgstr "يسترجع معلومات عن المستخدم المحدد في الشبكة الحالية."

#. Text of the link naming the source commit a build was made from, in the help and changelog windows. {hash} is the commit hash (verbatim, a code element).
#: client/components/Windows/Help.vue
msgctxt "help.commitHash"
msgid "commit {hash}"
msgstr "الإيداع {hash}"

#. Second item of the help window's past-release list (comparing the running build with the development branch). {range} is a link whose text is help.range ('between 1a2b3c4 and develop').
#: client/components/Windows/Help.vue
msgctxt "help.compareBehind"
msgid "Compare {range} to see what you are missing"
msgstr "قارن {range} لترى ما ينقصك"

#. First item of the help window's past-release list. {range} is a link whose text is help.range ('between v5.2.0 and 1a2b3c4').
#: client/components/Windows/Help.vue
msgctxt "help.compareSince"
msgid "Compare {range} to see what changed since the release"
msgstr "قارن {range} لترى ما تغيّر منذ الإصدار"

#. Label of the documentation link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.documentation"
msgid "Documentation"
msgstr "الوثائق"

#. The example word shown in bold lettering in the help window's Ctrl+B formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.bold"
msgid "bold"
msgstr "غامق"

#. Text of the link at the end of the Ctrl+K description in the help window's formatting section; it opens an external IRC color reference. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorHere"
msgid "here"
msgstr "هنا"

#. First paragraph of the Ctrl+K (color) description in the help window. {range} is the range 0—15 as a code element.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP1"
msgid "Mark any text typed after this shortcut to be colored. After hitting this shortcut, enter an integer in the range {range} to select the desired color, or use the autocompletion menu to choose a color name (see below)."
msgstr "يلوّن كل النص المكتوب بعد هذا الاختصار. بعد الضغط عليه، أدخل عددًا صحيحًا في النطاق {range} لاختيار اللون، أو استخدم قائمة الإكمال التلقائي لاختيار اسم لون (انظر أدناه)."

#. Second paragraph of the Ctrl+K (color) description in the help window. {range} is the range 0—15 as a code element.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP2"
msgid "Background color can be specified by putting a comma and another integer in the range {range} after the foreground color number (autocompletion works too)."
msgstr "يُحدَّد لون الخلفية بوضع فاصلة وعدد صحيح آخر في النطاق {range} بعد رقم لون النص (الإكمال التلقائي يعمل أيضًا)."

#. Last paragraph of the Ctrl+K description in the help window. {link} is a link to an external IRC color reference whose text is help.formatting.colorHere ('here'); write the frame so that word fits it.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorReference"
msgid "A color reference can be found {link}."
msgstr "تجد مرجعًا للألوان {link}."

#. Heading of the formatting-shortcuts section of the help window; each row shows a key combination and the message formatting it inserts.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.heading"
msgid "Formatting Shortcuts"
msgstr "اختصارات التنسيق"

#. The example word shown in italics in the help window's Ctrl+I formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.italic"
msgid "italics"
msgstr "مائل"

#. Description of a text-formatting shortcut in the help window. {style} is the style's name (help.formatting.bold, italic, underline, strikethrough or monospace: 'bold', 'italics', 'underlined', 'struck through', 'monospaced'), shown in that style where the placeholder stands; write the frame so those words fit it.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.markAs"
msgid "Mark all text typed after this shortcut as {style}."
msgstr "ينسّق كل النص المكتوب بعد هذا الاختصار هكذا: {style}."

#. The example word shown in a monospaced font in the help window's Ctrl+M formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.monospace"
msgid "monospaced"
msgstr "ثابت العرض"

#. Description of the Ctrl+O formatting shortcut in the help window; it removes any formatting applied so far in the message.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.reset"
msgid "Mark all text typed after this shortcut to be reset to its original formatting."
msgstr "يعيد كل النص المكتوب بعد هذا الاختصار إلى تنسيقه الأصلي."

#. The example word shown with a line through it in the help window's Ctrl+S formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.strikethrough"
msgid "struck through"
msgstr "مشطوب"

#. The example word shown underlined in the help window's Ctrl+U formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.underline"
msgid "underlined"
msgstr "مسطّر"

#. Heading of the touch-gestures section of the help window; lists what swiping on the sidebar does.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.heading"
msgid "Gestures"
msgstr "الإيماءات"

#. Description of the single-finger swipe-left gesture in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.hideSidebar"
msgid "Hide sidebar."
msgstr "إخفاء الشريط الجانبي."

#. Description of the single-finger swipe-right gesture in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.showSidebar"
msgid "Show sidebar."
msgstr "إظهار الشريط الجانبي."

#. Name of the touch gesture in the help window's gestures section: swiping the sidebar left with one finger. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.swipeLeft"
msgid "Single-Finger Swipe Left"
msgstr "السحب بإصبع واحدة إلى اليسار"

#. Name of the touch gesture in the help window's gestures section: swiping the sidebar right with one finger. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.swipeRight"
msgid "Single-Finger Swipe Right"
msgstr "السحب بإصبع واحدة إلى اليمين"

#. Label of the privacy policy link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.privacy"
msgid "Privacy policy"
msgstr "سياسة الخصوصية"

#. Text of a link in the help window's past-release list that compares two versions on the source host. {from} and {to} are version names or commit hashes (verbatim, code elements). It fills {range} in help.compareSince and help.compareBehind.
#: client/components/Windows/Help.vue
msgctxt "help.range"
msgid "between {from} and {to}"
msgstr "بين {from} و{to}"

#. Link beside the version number in the help window's title line; opens the changelog window. Mid-sentence between parentheses.
#: client/components/Windows/Help.vue
msgctxt "help.releaseNotesLink"
msgid "release notes"
msgstr "ملاحظات الإصدار"

#. Button of the update banner in the help window; clicking reloads the app to pick up the new build.
#: client/components/Windows/Help.vue
msgctxt "help.reload"
msgid "Reload"
msgstr "إعادة التحميل"

#. Link in the help window's about section; opens the bug-report page of the app's source repository. Ellipsis is part of the copy.
#: client/components/Windows/Help.vue
msgctxt "help.reportIssue"
msgid "Report an issue…"
msgstr "الإبلاغ عن مشكلة…"

#. Description of the Alt+Shift+Left keyboard shortcut in the help window; it folds the current network's channel list in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.collapseNetwork"
msgid "Collapse current network."
msgstr "طيّ الشبكة الحالية."

#. Description of the Escape key in the help window; it dismisses whatever popup or editor is open, or leaves the input field.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.escape"
msgid "Close current contextual window (context menu, image viewer, topic edit, etc) and remove focus from input."
msgstr "إغلاق النافذة السياقية الحالية (قائمة السياق، عارض الصور، تعديل الموضوع، إلخ) وإزالة التركيز من حقل الإدخال."

#. Description of the Alt+Shift+Right keyboard shortcut in the help window; it unfolds the current network's channel list in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.expandNetwork"
msgid "Expand current network."
msgstr "توسيع الشبكة الحالية."

#. Description of the Alt+A keyboard shortcut in the help window; it jumps to the earliest conversation with unread messages.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.firstUnread"
msgid "Switch to the first window with unread messages."
msgstr "انتقل إلى النافذة الأولى التي تحتوي على رسائل غير مقروءة."

#. Heading of the keyboard shortcuts section of the help window; each row shows the key combination and what it does.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.heading"
msgid "Keyboard Shortcuts"
msgstr "اختصارات لوحة المفاتيح"

#. Description of the Alt+/ keyboard shortcut in the help window; it opens this help page.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.helpMenu"
msgid "Switch to the help menu."
msgstr "انتقل إلى قائمة المساعدة."

#. Help page, keyboard shortcuts table: what the Backspace key does while the popup listing the messages that mention you is open.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.mentionsDismiss"
msgid "In the mentions popup: dismiss the mention."
msgstr ""

#. Help page, keyboard shortcuts table: what the up and down arrow keys do while the popup listing the messages that mention you is open.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.mentionsMove"
msgid "In the mentions popup: move between mentions."
msgstr ""

#. Help page, keyboard shortcuts table: what the Enter key does while the popup listing the messages that mention you is open.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.mentionsOpen"
msgid "In the mentions popup: open the mention."
msgstr ""

#. Description of the Alt+Shift+Down keyboard shortcut in the help window; it moves to the next network's home view in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.nextLobby"
msgid "Switch to the next lobby in the channel list."
msgstr "الانتقال إلى الشبكة التالية في قائمة القنوات."

#. Description of the Alt+Ctrl+Down keyboard shortcut in the help window; it jumps to the next conversation that has unread messages.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.nextUnread"
msgid "Switch to the next window with unread messages in the channel list."
msgstr "انتقل إلى النافذة التالية التي تحتوي على رسائل غير مقروءة في قائمة القنوات."

#. Description of the Alt+Down keyboard shortcut and of the two-finger swipe-left gesture in the help window; both move to the conversation after the current one in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.nextWindow"
msgid "Switch to the next window in the channel list."
msgstr "انتقل إلى النافذة التالية في قائمة القنوات."

#. Description of the modifier+1 to 9 keyboard shortcut in the help window (⌘ in the macOS app, Ctrl in the app elsewhere, Alt in a browser on Windows); each digit jumps to the channel or private chat at that position in the sidebar, network entries not counted.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.nthWindow"
msgid "Switch to that channel in the channel list: 1 is the first channel, 9 the ninth. Networks are not counted."
msgstr ""

#. Description of the Alt+Shift+Up keyboard shortcut in the help window; it moves to the previous network's home view in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.prevLobby"
msgid "Switch to the previous lobby in the channel list."
msgstr "الانتقال إلى الشبكة السابقة في قائمة القنوات."

#. Description of the Alt+Ctrl+Up keyboard shortcut in the help window; it jumps to the previous conversation that has unread messages.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.prevUnread"
msgid "Switch to the previous window with unread messages in the channel list."
msgstr "انتقل إلى النافذة السابقة التي تحتوي على رسائل غير مقروءة في قائمة القنوات."

#. Description of the Alt+Up keyboard shortcut and of the two-finger swipe-right gesture in the help window; both move to the conversation before the current one in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.prevWindow"
msgid "Switch to the previous window in the channel list."
msgstr "انتقل إلى النافذة السابقة في قائمة القنوات."

#. Description of the Ctrl+F (Cmd+F on Apple) keyboard shortcut in the help window; it opens the search page for the current channel or private conversation.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.search"
msgid "Search the open conversation."
msgstr ""

#. Description of the Alt+J keyboard shortcut in the help window; it opens or closes the search field for jumping to a conversation.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleJump"
msgid "Toggle jump to channel switcher."
msgstr "فتح أو إغلاق الانتقال السريع إلى قناة."

#. Description of the Alt+K keyboard shortcut in the help window; it switches message formatting (bold, code, spoilers) on or off.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleMarkdown"
msgid "Toggle Markdown rendering."
msgstr "تشغيل عرض تنسيق Markdown أو إيقافه."

#. Help page, keyboard shortcuts table: what the shortcut does — opens or closes the popup listing the unread messages that mention you.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleMentions"
msgid "Toggle unread mentions popup."
msgstr "فتح نافذة الإشارات غير المقروءة أو إغلاقها."

#. Description of the Alt+S keyboard shortcut in the help window; it shows or hides the sidebar network list.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleSidebar"
msgid "Toggle sidebar."
msgstr "إظهار الشريط الجانبي أو إخفاؤه."

#. Description of the Alt+U keyboard shortcut in the help window; it shows or hides the panel listing the channel's members.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleUserlist"
msgid "Toggle channel user list."
msgstr "إظهار قائمة مستخدمي القناة أو إخفاؤها."

#. Title of the help window: its heading, its dialog aria-label, and the accessible name of the whole page.
#: client/components/Windows/Help.vue
msgctxt "help.title"
msgid "Help"
msgstr "المساعدة"

#. Help > About: the sentence saying which build is running, for the build of the project's development branch. {branch} is the git branch name develop (verbatim, a code element).
#: client/components/Windows/Help.vue
msgctxt "help.track.develop"
msgid "This is the build of the {branch} branch."
msgstr "هذا هو إصدار البناء من الفرع {branch}."

#. Help > About: the sentence saying which build is running, for a build someone made themselves from a git branch. {branch} is the branch name (verbatim, a code element).
#: client/components/Windows/Help.vue
msgctxt "help.track.local"
msgid "This is a local build of the {branch} branch."
msgstr "هذا بناء محلي من الفرع {branch}."

#. Help > About: the sentence saying which build is running, for the preview build of a pull request on the project's website. {pr} is a link whose text is help.track.prLink ('pull request #142').
#: client/components/Windows/Help.vue
msgctxt "help.track.pr"
msgid "This is a preview of {pr}."
msgstr "هذه معاينة لـ{pr}."

#. Text of the link in help.track.pr that opens the pull request on the source host. Mid-sentence. {number} is the pull request's number; keep the # before it.
#: client/components/Windows/Help.vue
msgctxt "help.track.prLink"
msgid "pull request #{number}"
msgstr "طلب الدمج رقم {number}"

#. Help > About: the sentence saying which build is running, for a release build. {version} is the release number, kept after its v (e.g. 5.2.0).
#: client/components/Windows/Help.vue
msgctxt "help.track.release"
msgid "This is the v{version} release."
msgstr "هذا هو الإصدار v{version}."

#. Help > About: sentence after help.track.* (which says which build this is), shown when the build is newer than its release. 'It' is that build. {commit} is a link whose text is help.commitHash ('commit 1a2b3c4'); {version} is the release number, kept after its v.
#: client/components/Windows/Help.vue
msgctxt "help.trackBuiltFromCommit"
msgid "It is built from {commit}, after v{version}."
msgstr "بُني من {commit}، بعد v{version}."

#. Text of the banner at the top of the help window shown when a newer build of the app was published; a Reload button follows it.
#: client/components/Windows/Help.vue
msgctxt "help.updateAvailable"
msgid "New version available"
msgstr "يتوفر إصدار جديد"

#. Label of the network's website link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.website"
msgid "Website"
msgstr "الموقع"

#. aria-label of the ✕ control of the image viewer that fills the screen; clicking closes it.
#: client/components/ImageViewer.vue
msgctxt "image.close"
msgid "Close"
msgstr "إغلاق"

#. aria-label of the forward arrow of the image viewer; clicking shows the next image from the conversation.
#: client/components/ImageViewer.vue
msgctxt "image.next"
msgid "Next image"
