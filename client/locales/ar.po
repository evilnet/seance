msgstr[0] "رفع {count} ملف"
msgstr[1] "رفع {count} ملف"
msgstr[2] "رفع {count} ملفين"
msgstr[3] "رفع {count} ملفات"
msgstr[4] "رفع {count} ملفًا"
msgstr[5] "رفع {count} ملف"

