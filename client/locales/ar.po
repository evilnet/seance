#. Preview-bar hint in the emoji picker for a typed reaction (a word or several emoji): pressing Enter sends it.
#: client/components/ReactionPicker.vue
msgctxt "reactions.hintSend"
msgid "Enter to send"
msgstr "Enter للإرسال"

#. Button in the emoji picker that puts the emoji built so far into the message being written. Emoji picker opened from the message composer by typing a colon and a name; what is picked goes into the message being written, not onto a message as a reaction.
#: client/components/ReactionPicker.vue
msgctxt "reactions.insert"
msgid "Insert"
msgstr "إدراج"

#. Accessible name of the emoji picker dialog when it inserts into the message being written. Emoji picker opened from the message composer by typing a colon and a name; what is picked goes into the message being written, not onto a message as a reaction.
#: client/components/ReactionPicker.vue
msgctxt "reactions.insertDialogAria"
msgid "Insert an emoji"
msgstr "إدراج رمز تعبيري"

#. Hint at the bottom of the emoji picker when nothing is highlighted and it inserts into the message being written. Emoji picker opened from the message composer by typing a colon and a name; what is picked goes into the message being written, not onto a message as a reaction.
#: client/components/ReactionPicker.vue
msgctxt "reactions.insertEmptyHint"
msgid "Pick an emoji to put it in your message."
msgstr "اختر رمزًا تعبيريًا لإضافته إلى رسالتك."

#. Placeholder and accessible name of the emoji picker's search field when it inserts into the message being written. Emoji picker opened from the message composer by typing a colon and a name; what is picked goes into the message being written, not onto a message as a reaction.
#: client/components/ReactionPicker.vue
msgctxt "reactions.insertSearchPlaceholder"
msgid "Search emoji"
msgstr "ابحث عن رمز تعبيري"

#. aria-label of the emoji picker's scrollable grid of emoji to pick from.
#: client/components/ReactionPicker.vue
msgctxt "reactions.listAria"
msgid "Emoji"
msgstr "الرموز التعبيرية"

#. Error note shown inside the emoji picker when the emoji catalog failed to download; the search field above still accepts any reaction as text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.loadFailed"
msgid "The emoji list could not be loaded. You can still type a reaction above."
msgstr "تعذّر تحميل قائمة الرموز التعبيرية. لا يزال بإمكانك كتابة تفاعل في الأعلى."

#. Note shown inside the emoji picker while its catalog is being fetched. Ellipsis is part of the copy.
#: client/components/ReactionPicker.vue
msgctxt "reactions.loading"
msgid "Loading emoji…"
msgstr "جارٍ تحميل الرموز التعبيرية…"

#. Heading of the emoji picker's list while a search matched nothing (what was typed can still be sent as a reaction).
#: client/components/ReactionPicker.vue
msgctxt "reactions.noMatch"
msgid "No emoji match"
msgstr "لا رموز تعبيرية مطابقة"

#. Heading of the emoji picker's section of suggested starter reactions, shown when nothing has been used recently, and the label of its tab.
#: client/components/ReactionPicker.vue
msgctxt "reactions.quickReactions"
msgid "Quick reactions"
msgstr "تفاعلات سريعة"

#. Heading of the emoji picker's section of recently sent reactions, and the label of its tab.
#: client/components/ReactionPicker.vue
msgctxt "reactions.recentlyUsed"
msgid "Recently used"
msgstr "المستخدمة مؤخرًا"

#. Placeholder and aria-label of the emoji picker's search field; the same field doubles as the entry for a custom reaction (any text or emoji).
#: client/components/ReactionPicker.vue
msgctxt "reactions.searchPlaceholder"
msgid "Search emoji, or type any reaction"
msgstr "ابحث عن رمز تعبيري أو اكتب أي تفاعل"

#. Heading of the emoji picker's list while a search is showing matches.
#: client/components/ReactionPicker.vue
msgctxt "reactions.searchResults"
msgid "Search results"
msgstr "نتائج البحث"

#. Button in the emoji picker's preview bar; clicking sends the reaction being composed.
#: client/components/ReactionPicker.vue
msgctxt "reactions.send"
msgid "Send"
msgstr "إرسال"

#. Preview-bar note in the emoji picker for a remembered reaction that is not an emoji, saying it will be sent as words. Starts lowercase because it follows other text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.sentAsText"
msgid "sent as text"
msgstr "يُرسل كنص"

#. aria-label of the row of tab buttons in the emoji picker that jumps to a group of emoji (smileys, animals, food…).
#: client/components/ReactionPicker.vue
msgctxt "reactions.tabsAria"
msgid "Emoji groups"
msgstr "مجموعات الرموز التعبيرية"

#. Tooltip of the emoji picker's free-text row and its spoken form, offering to send what was typed as the reaction. {reaction} is that text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.titleTemplate"
msgid "React with {reaction}"
msgstr "التفاعل بـ {reaction}"

#. Lua script error (shown after '[Lua error] ' in the conversation and in the script editor's error banner): a slash command defined by a script failed. {command} is the command's name (verbatim), after its slash; {error} is the Lua interpreter's error text (verbatim, mostly English).
#: client/js/irc/scripting/engine.ts
msgctxt "scripting.commandFailed"
msgid "Error in /{command} command: {error}"
msgstr "خطأ في الأمر /{command}: {error}"

#. Error shown when /lua or a script reload is tried while Lua scripting is switched off. 'Settings → Scripts' names the place in the app (the Settings window's Scripts tab).
#: client/js/irc/scripting/manager.ts
msgctxt "scripting.disabled"
msgid "Scripting is disabled. Turn it on in Settings → Scripts."
msgstr "النصوص البرمجية معطّلة. فعّلها من الإعدادات ← النصوص البرمجية."

#. Local line shown in the conversation when a Lua script fails. '[Lua error]' is the prefix every scripting error line has: keep the brackets. {error} is the error text from the Lua interpreter (verbatim, mostly English).
#: client/js/irc/scripting/manager.ts
msgctxt "scripting.errorLine"
msgid "[Lua error] {error}"
msgstr "[خطأ في Lua] {error}"

#. Lua script error (shown after '[Lua error] ' in the conversation and in the script editor's error banner): the scripts' handlers for one event used up their instruction budget, so the remaining handlers were not run. {event} is the event's name as scripts use it (verbatim, e.g. message, join, kick).
#: client/js/irc/scripting/engine.ts
msgctxt "scripting.eventSkipped"
msgid "Skipped the rest of this {event} event: its handlers ran out of instructions"
msgstr "تم تخطي بقية هذا الحدث {event}: نفدت التعليمات المتاحة لمعالجاته"

#. Lua script error (shown after '[Lua error] ' in the conversation and in the script editor's error banner): a script's handler for an event failed. {event} is the event's name as scripts use it (verbatim, e.g. message, join); {error} is the Lua interpreter's error text (verbatim, mostly English).
#: client/js/irc/scripting/engine.ts
msgctxt "scripting.handlerFailed"
msgid "Error in {event} handler: {error}"
msgstr "خطأ في معالج الحدث {event}: {error}"

#. Error under the Name field of the Lua script editor when it is empty.
#: client/js/irc/scripting/library.ts
msgctxt "scripting.nameEmpty"
msgid "A script needs a name."
msgstr "يحتاج النص البرمجي إلى اسم."

#. Error under the Name field of the Lua script editor when the name has other characters. '_' and '-' are the underscore and hyphen characters themselves; 'letters' means a-z (Latin, unaccented). {max} is the most characters a name may have, a number.
#: client/js/irc/scripting/library.ts
msgctxt "scripting.nameInvalid"
msgid "Letters, digits, _ and - only, starting with a letter or digit, at most {max}."
msgstr "أحرف وأرقام و_ و- فقط، يبدأ بحرف أو رقم، وبحد أقصى {max}."

#. Error under the Name field of the Lua script editor when another script has that name. {name} is the name typed (verbatim).
#: client/js/irc/scripting/library.ts
msgctxt "scripting.nameTaken"
msgid "Another script is already called {name}."
msgstr "يوجد نص برمجي آخر باسم {name}."

#. Local line shown in the conversation when a Lua script tries to send another IRC line while too many of its lines wait to be sent. '[Lua error]' is the prefix every scripting error line has: keep the brackets. {count} is the limit, a number.
#: client/js/irc/scripting/manager.ts
msgctxt "scripting.queueFull"
msgid "[Lua error] Not sent: {count} script line is already waiting to go out"
msgid_plural "[Lua error] Not sent: {count} script lines are already waiting to go out"
msgstr[0] "[خطأ في Lua] لم يُرسَل: ينتظر الإرسال بالفعل {count} سطر من النص البرمجي"
msgstr[1] "[خطأ في Lua] لم يُرسَل: ينتظر الإرسال بالفعل {count} سطر من النص البرمجي"
msgstr[2] "[خطأ في Lua] لم يُرسَل: ينتظر الإرسال بالفعل {count} سطران من النص البرمجي"
msgstr[3] "[خطأ في Lua] لم يُرسَل: ينتظر الإرسال بالفعل {count} أسطر من النص البرمجي"
msgstr[4] "[خطأ في Lua] لم يُرسَل: ينتظر الإرسال بالفعل {count} سطرًا من النص البرمجي"
msgstr[5] "[خطأ في Lua] لم يُرسَل: ينتظر الإرسال بالفعل {count} سطر من النص البرمجي"

#. Error when a Lua script's code is too long to save. {name} is the script's name (verbatim); {max} the limit, a number. Use the language's quotation marks.
#: client/js/irc/scripting/storage.ts
msgctxt "scripting.storage.codeTooLong"
msgid "“{name}” is over {max} characters."
msgstr "يتجاوز «{name}» ‏{max} حرف."

#. Error raised inside a Lua script when what it saved through seance.storage (verbatim, the API's name) is too long. {max} is the limit, a number.
#: client/js/irc/scripting/storage.ts
msgctxt "scripting.storage.dataTooLong"
msgid "seance.storage is over {max} characters for this script."
msgstr "يتجاوز seance.storage ‏{max} حرف لهذا النص البرمجي."

#. Error when all the user's Lua scripts together are too long to save. {max} is the limit, a number.
#: client/js/irc/scripting/storage.ts
msgctxt "scripting.storage.libraryTooLong"
msgid "Your scripts are over {max} characters together."
msgstr "تتجاوز نصوصك البرمجية مجتمعةً {max} حرف."

#. Error when a Lua script or its saved data could not be saved because the browser's storage is full. Shown in the script editor, or as the script's error.
#: client/js/irc/scripting/storage.ts
msgctxt "scripting.storage.noRoom"
msgid "There isn't room on this device to save that."
msgstr "لا توجد مساحة كافية على هذا الجهاز لحفظ ذلك."

#. Error raised inside a Lua script when what all scripts saved through seance.storage (verbatim, the API's name) is too long together. {max} is the limit, a number.
#: client/js/irc/scripting/storage.ts
msgctxt "scripting.storage.totalDataTooLong"
msgid "seance.storage is over {max} characters for all scripts together."
msgstr "يتجاوز seance.storage ‏{max} حرف لكل النصوص البرمجية مجتمعةً."

#. Description given to the Auto-responder example Lua script when it is added. 'pong!' and '!ping' are the literal chat text it answers and sends: keep them verbatim.
#: client/js/irc/scripting/library.ts
msgctxt "scripting.template.responderDescription"
msgid "Replies pong! to !ping"
msgstr "يردّ بـ pong! على !ping"

#. Folder name given to the Auto-responder example script when it is added (stored with the script; the user can rename it). Short, a label.
#: client/js/irc/scripting/library.ts
msgctxt "scripting.template.responderFolder"
msgid "Automation"
msgstr "الأتمتة"

#. Description given to the /slap example Lua script when it is added. Keep '/slap' verbatim (the command's name).
#: client/js/irc/scripting/library.ts
msgctxt "scripting.template.slapDescription"
msgid "Adds a /slap command"
msgstr "يضيف الأمر /slap"

#. Folder name given to the /slap example script when it is added (stored with the script; the user can rename it). Short, a label: slash commands.
#: client/js/irc/scripting/library.ts
msgctxt "scripting.template.slapFolder"
msgid "Commands"
msgstr "الأوامر"

#. Search window, the filters sheet (narrows a history search): placeholder of the Account field: an account is one person whatever nick they use.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.accountPlaceholder"
msgid "One identity, across nicks"
msgstr "هوية واحدة، أيًّا كان الاسم المستعار"

#. Search window, the filters sheet (narrows a history search): the first option of the 'In' select: search every channel and conversation on the network.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.allChannels"
msgid "All my channels"
msgstr "كل قنواتي"

#. Search window, the filters sheet (narrows a history search): button that closes the sheet without applying it.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.cancel"
msgid "Cancel"
msgstr "إلغاء"

#. Search window, the filters sheet (narrows a history search): button that empties every filter.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.clearAll"
msgid "Clear all"
msgstr "مسح الكل"

#. Search window, the filters sheet (narrows a history search): Date choice: no date limit. One short word.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.dateAny"
msgid "Any"
msgstr "أي وقت"

#. Search window, the filters sheet (narrows a history search): Date choice: the last 30 days. Short.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.dateMonth"
msgid "30 days"
msgstr "30 يومًا"

#. Search window, the filters sheet (narrows a history search): Date choice: pick the first and the last day. One short word; keep the ellipsis.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.dateRange"
msgid "Range…"
msgstr "نطاق…"

#. Search window, the filters sheet (narrows a history search): Date choice: the last 7 days. Short.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.dateWeek"
msgid "7 days"
msgstr "7 أيام"

#. Search window, the filters sheet (narrows a history search): label of the first date field of a range.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.fromDay"
msgid "From this day"
msgstr "من هذا اليوم"

#. Search window, the filters sheet (narrows a history search): placeholder of the From field: the nick the sender used when they wrote it.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.fromPlaceholder"
msgid "Nick at the time of the message"
msgstr "الاسم المستعار وقت الرسالة"

#. Search window, the filters sheet (narrows a history search): 'Has' choice (and the Has chip's value): messages with an image. One word.
#: client/js/helpers/searchLabels.ts
msgctxt "search.filters.hasImage"
msgid "Image"
msgstr "صورة"

#. Search window, the filters sheet (narrows a history search): 'Has' choice (and the Has chip's value): messages with a link. One word.
#: client/js/helpers/searchLabels.ts
msgctxt "search.filters.hasLink"
msgid "Link"
msgstr "رابط"

#. Search window, the filters sheet (narrows a history search): label of the select that picks where to search (one channel, or all of them). One short word.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.in"
msgid "In"
msgstr "في"

#. Search window, the filters sheet (narrows a history search): error under a date range whose first day is after its last.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.rangeError"
msgid "The first day has to come before the last."
msgstr "يجب أن يأتي اليوم الأول قبل الأخير."

#. Search window, the filters sheet (narrows a history search): button that applies the filters and closes the sheet.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.show"
msgid "Show results"
msgstr "عرض النتائج"

#. Search window, the filters sheet (narrows a history search): label of the second date field of a range (that day included).
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.toDay"
msgid "Up to this day"
msgstr "حتى هذا اليوم"

#. Search window, the filters sheet (narrows a history search): label of the field for words the messages must not contain.
#: client/components/SearchFilterSheet.vue
msgctxt "search.filters.without"
msgid "Without these words"
msgstr "دون هذه الكلمات"

#. aria-label of the magnifier button in a chat window's header; clicking it opens the message-search field for the conversation.
#: client/components/MessageSearchForm.vue:19
msgctxt "search.openForm"
msgid "Search messages in this channel"
msgstr "البحث عن رسائل في هذه القناة"

#. aria-label of the search-results view of the chat window, which lists the messages matching a search.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.aria"
msgid "Search results"
msgstr "نتائج البحث"

#. Search window: the search scope when it covers every channel and conversation on the network, used inside sentences ('Search all my channels', 'No matches in all my channels'). Lower case.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.allChannels"
msgid "all my channels"
msgstr "كل قنواتي"

#. Search window (searching the chat history of the server, or of what is loaded on this device): the server found matches, but the filters set in the sheet hide them all. {count} is a number.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.allHidden"
msgid "{count} match, all hidden by your filters"
msgid_plural "{count} matches, all hidden by your filters"
msgstr[0] "{count} نتيجة، كلها مخفية بعوامل التصفية"
msgstr[1] "{count} نتيجة، مخفية بعوامل التصفية"
msgstr[2] "{count} نتيجتان، كلتاهما مخفية بعوامل التصفية"
msgstr[3] "{count} نتائج، كلها مخفية بعوامل التصفية"
msgstr[4] "{count} نتيجة، كلها مخفية بعوامل التصفية"
msgstr[5] "{count} نتيجة، كلها مخفية بعوامل التصفية"

#. Search window (searching the chat history of the server, or of what is loaded on this device): under the 'all hidden by your filters' heading: how far back the search went. {when} is a day and a time, already formatted.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.allHiddenNote"
msgid "Older messages may still match. Searched back to {when}."
msgstr "قد تطابق رسائل أقدم. جرى البحث حتى {when}."

#. Search window (searching the chat history of the server, or of what is loaded on this device): shown while the server runs the search.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.asking"
msgid "Asking the server…"
msgstr "جارٍ سؤال الخادم…"

#. Search window (searching the chat history of the server, or of what is loaded on this device): in the status line under the results, after the count: how far back the search went. {when} is a day and a time, already formatted. Lower case.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.backTo"
msgid "back to {when}"
msgstr "حتى {when}"

#. Search panel (searching the chat history of the server, or of what is loaded on this device), beside the chat on a wide screen and over it on a phone: on a phone, the text button beside the search field that closes the search and returns to the chat.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.cancel"
msgid "Cancel"
msgstr ""

#. Search window (searching the chat history of the server, or of what is loaded on this device): name of a filter: messages from one services account (the identity a user is logged in as, whatever their nick). Also the field's label in the filters sheet. One word.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.chip.account"
msgid "Account"
msgstr "الحساب"

#. Search window (searching the chat history of the server, or of what is loaded on this device): name of a filter: messages from a range of days. Also the field's label in the filters sheet. One word.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.chip.date"
msgid "Date"
msgstr "التاريخ"

#. Search window (searching the chat history of the server, or of what is loaded on this device): the value of the Date filter's chip: the first day searched. {day} is a short date ('4 Nov'). Lower case; the two parts are joined with a comma.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.chip.dateFrom"
msgid "from {day}"
msgstr "من {day}"

#. Search window (searching the chat history of the server, or of what is loaded on this device): the value of the Date filter's chip: the last day searched. {day} is a short date ('4 Nov'). Lower case; the two parts are joined with a comma.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.chip.dateTo"
msgid "to {day}"
msgstr "إلى {day}"

#. Search window (searching the chat history of the server, or of what is loaded on this device): name of a filter: messages from one nick. Also the field's label in the filters sheet. One word.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.chip.from"
msgid "From"
msgstr "من"

#. Search window (searching the chat history of the server, or of what is loaded on this device): name of a filter: messages that contain a link or an image. Also the field's label in the filters sheet. One short word.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.chip.has"
msgid "Has"
msgstr "يحتوي"

#. Search window (searching the chat history of the server, or of what is loaded on this device): name of a filter: messages without certain words. One word.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.chip.without"
msgid "Without"
msgstr "دون"

#. Search panel (searching the chat history of the server, or of what is loaded on this device), beside the chat on a wide screen and over it on a phone: button beside the Recent searches heading that forgets that list on this device.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.clearRecent"
msgid "Clear"
msgstr ""

#. Search panel (searching the chat history of the server, or of what is loaded on this device), beside the chat on a wide screen and over it on a phone: label and tooltip of the ✕ button that closes the panel; also the label of the header's magnifier while the panel is open.
#: client/components/Windows/SearchResults.vue
#: client/components/MessageSearchForm.vue
msgctxt "search.window.close"
msgid "Close search"
msgstr ""

#. Search window (searching the chat history of the server, or of what is loaded on this device): a day and a time together, in the status line (how far back the search went) and beside each result older than yesterday. {day} is a short date ('Nov 4' in English, 'Nov 4, 2025' in another year) or, for a result from the last week, a short weekday ('Tue'); {time} a clock time. Order and punctuation are your language's.
#: client/components/Windows/SearchResults.vue
#: client/js/helpers/messageTime.ts
msgctxt "search.window.dayAndTime"
msgid "{day}, {time}"
msgstr "{day}، {time}"

#. Search window (searching the chat history of the server, or of what is loaded on this device): button that opens the filters sheet. Two words.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.editFilters"
msgid "Edit filters"
msgstr "تعديل عوامل التصفية"

#. Search window (searching the chat history of the server, or of what is loaded on this device): error when the server refused or failed the search and said nothing more.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.errorFailed"
msgid "The server could not run this search."
msgstr "تعذّر على الخادم إجراء هذا البحث."

#. Search window (searching the chat history of the server, or of what is loaded on this device): error when the query cannot be put into a command the server accepts (too long, or empty after the filters).
#: client/components/Windows/SearchResults.vue
#: client/js/irc/historysearch.ts
msgctxt "search.window.errorInvalid"
msgid "That search can't be sent."
msgstr "لا يمكن إرسال هذا البحث."

#. Search window (searching the chat history of the server, or of what is loaded on this device): error under the results when older results were asked for but the network is not connected.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.errorOffline"
msgid "Not connected."
msgstr "غير متصل."

#. Search window (searching the chat history of the server, or of what is loaded on this device): error when the server refused the search with its own explanation. {text} is the server's message, verbatim (never translated).
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.errorServer"
msgid "The server says: {text}"
msgstr "يقول الخادم: {text}"

#. Search window (searching the chat history of the server, or of what is loaded on this device): error when the server never answered the search.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.errorTimeout"
msgid "The server did not answer."
msgstr "لم يُجب الخادم."

#. Search window (searching the chat history of the server, or of what is loaded on this device): button under 'No matches': runs the same search over every channel and conversation on the network.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.everywhere"
msgid "Search all my channels"
msgstr "البحث في كل قنواتي"

#. Search window (searching the chat history of the server, or of what is loaded on this device): heading over the error when the search went wrong. A few words.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.failed"
msgid "Search failed"
msgstr "فشل البحث"

#. Search window (searching the chat history of the server, or of what is loaded on this device): aria-label of the search field at the top.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.field"
msgid "Search messages"
msgstr "البحث في الرسائل"

#. Search window (searching the chat history of the server, or of what is loaded on this device): button that opens the filters sheet, and the sheet's title. One word.
#: client/components/Windows/SearchResults.vue
#: client/components/SearchFilterSheet.vue
msgctxt "search.window.filters"
msgid "Filters"
msgstr "عوامل التصفية"

#. Search window (searching the chat history of the server, or of what is loaded on this device): in the status line under the results: how many matches the filters hide. {count} is a number. Lower case.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.hiddenCount"
msgid "{count} hidden by filters"
msgid_plural "{count} hidden by filters"
msgstr[0] "{count} مخفية بعوامل التصفية"
msgstr[1] "{count} مخفية بعوامل التصفية"
msgstr[2] "{count} مخفيتان بعوامل التصفية"
msgstr[3] "{count} مخفية بعوامل التصفية"
msgstr[4] "{count} مخفية بعوامل التصفية"
msgstr[5] "{count} مخفية بعوامل التصفية"

#. Search window (searching the chat history of the server, or of what is loaded on this device): the first chip under the field: where the search looks; tapping it opens the filters. {scope} is a channel name or 'all my channels', shown bold.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.inScope"
msgid "In {scope}"
msgstr "في {scope}"

#. Note on the search results when a hit's channel is not joined. {target} is the channel name, verbatim.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.joinToRead"
msgid "Join {target} to read this message."
msgstr ""

#. Search window (searching the chat history of the server, or of what is loaded on this device): under a warning that the server cannot search (or is not connected): the search runs over what this device has loaded. {count} is a number.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.loadedInstead"
msgid "Searching the {count} message loaded on this device instead. Filters still work."
msgid_plural "Searching the {count} messages loaded on this device instead. Filters still work."
msgstr[0] "يجري البحث بدلًا من ذلك في الرسائل المحمّلة على هذا الجهاز ({count}). لا تزال عوامل التصفية تعمل."
msgstr[1] "يجري البحث بدلًا من ذلك في الرسائل المحمّلة على هذا الجهاز ({count}). لا تزال عوامل التصفية تعمل."
msgstr[2] "يجري البحث بدلًا من ذلك في الرسائل المحمّلة على هذا الجهاز ({count}). لا تزال عوامل التصفية تعمل."
msgstr[3] "يجري البحث بدلًا من ذلك في الرسائل المحمّلة على هذا الجهاز ({count}). لا تزال عوامل التصفية تعمل."
msgstr[4] "يجري البحث بدلًا من ذلك في الرسائل المحمّلة على هذا الجهاز ({count}). لا تزال عوامل التصفية تعمل."
msgstr[5] "يجري البحث بدلًا من ذلك في الرسائل المحمّلة على هذا الجهاز ({count}). لا تزال عوامل التصفية تعمل."

#. Beside a search result that comes from messages loaded on this device, not from the server.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.loadedRow"
msgid "on this device"
msgstr ""

#. Search window (searching the chat history of the server, or of what is loaded on this device): in the status line under the results: how many matches are shown. {count} is a number. Lower case.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.matchCount"
msgid "{count} match"
msgid_plural "{count} matches"
msgstr[0] "{count} نتيجة"
msgstr[1] "{count} نتيجة"
msgstr[2] "{count} نتيجتان"
msgstr[3] "{count} نتائج"
msgstr[4] "{count} نتيجة"
msgstr[5] "{count} نتيجة"

#. Search window (searching the chat history of the server, or of what is loaded on this device): heading when nothing matched. {scope} is a channel name (verbatim) or 'all my channels' (search.window.allChannels).
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.noMatches"
msgid "No matches in {scope}"
msgstr "لا نتائج في {scope}"

#. Search window (searching the chat history of the server, or of what is loaded on this device): under 'No matches': the server only searches what this account could see.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.noMatchesNote"
msgid "You may not see messages from times you were not in the channel."
msgstr "قد لا ترى رسائل من أوقات لم تكن فيها في القناة."

#. Search window (searching the chat history of the server, or of what is loaded on this device): in the status line under the results when the server has no older matches.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.nothingOlder"
msgid "Nothing older found"
msgstr "لا يوجد شيء أقدم"

#. Search window (searching the chat history of the server, or of what is loaded on this device): warning heading when the network is not connected, so the server cannot be asked.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.offline"
msgid "Not connected"
msgstr "غير متصل"

#. Search window (searching the chat history of the server, or of what is loaded on this device): button that asks the server for older matches. Two words.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.older"
msgid "Search older"
msgstr "البحث في الأقدم"

#. Note on the search results when a hit's private conversation is not open. {target} is the person's nick, verbatim.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.openToRead"
msgid "Open a conversation with {target} to read this message."
msgstr ""

#. Search window (searching the chat history of the server, or of what is loaded on this device): placeholder of the search field. {scope} is a channel name (verbatim) or 'all my channels' (search.window.allChannels).
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.placeholder"
msgid "Search {scope}"
msgstr "البحث في {scope}"

#. Search panel (searching the chat history of the server, or of what is loaded on this device), beside the chat on a wide screen and over it on a phone: placeholder of the search field where there is a keyboard; says the Escape key closes the panel. {scope} is a channel name (verbatim) or 'all my channels' (search.window.allChannels). Esc is the key's name as printed on keyboards.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.placeholderEsc"
msgid "Search {scope} (Esc to close)"
msgstr ""

#. Search panel (searching the chat history of the server, or of what is loaded on this device), beside the chat on a wide screen and over it on a phone: heading of the list of searches run lately on this device, shown under the empty field.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.recent"
msgid "Recent searches"
msgstr ""

#. Search window (searching the chat history of the server, or of what is loaded on this device): aria-label of the × on a filter chip. {filter} is the filter's name (From, Account, Date, Has, Without).
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.removeFilter"
msgid "Remove {filter} filter"
msgstr "إزالة عامل التصفية {filter}"

#. Search window (searching the chat history of the server, or of what is loaded on this device): button that runs the search again after it failed or could not reach the server.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.retry"
msgid "Try again"
msgstr "أعد المحاولة"

#. Banner above loaded messages when a search came back empty. {scope} is a conversation's name, or the label for all channels.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.scopeEmpty"
msgid "The server found nothing in {scope}."
msgstr ""

#. Search window (searching the chat history of the server, or of what is loaded on this device): the 'Search older' button's label while older matches are being asked for.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.searching"
msgid "Searching…"
msgstr "جارٍ البحث…"

#. Search window (searching the chat history of the server, or of what is loaded on this device): note when the field was edited but not run yet: the results below are still those of the old query.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.stale"
msgid "These are the results of the previous search. Press Search to update them."
msgstr "هذه نتائج البحث السابق. اضغط «بحث» لتحديثها."

#. Search window (searching the chat history of the server, or of what is loaded on this device): before any search: an invitation, followed by example query words (from:nick, in:#channel, has:link…) that are not translated.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.start"
msgid "Type something to search for, or use these in the field above:"
msgstr "اكتب شيئًا للبحث عنه، أو استخدم هذه في الحقل أعلاه:"

#. Search window (searching the chat history of the server, or of what is loaded on this device): button that runs the search. One word.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.submit"
msgid "Search"
msgstr "بحث"

#. Search window (searching the chat history of the server, or of what is loaded on this device): warning heading when the chat server offers no history search.
#: client/components/Windows/SearchResults.vue
msgctxt "search.window.unsupported"
msgid "This server can't search its history"
msgstr "لا يستطيع هذا الخادم البحث في سجله"

#. Lobby error when the server never answered the redaction an edit depends on.
#: client/js/irc/client.ts
msgctxt "send.editNoReply"
msgid "Edit not sent: no reply from the server."
msgstr "لم يُرسل التعديل: لا رد من الخادم."

#. Lobby error when a second edit of the same message was sent before the first one settled.
#: client/js/irc/client.ts
msgctxt "send.editWaiting"
msgid "Edit not sent: an edit of that message is already waiting for the server."
msgstr "لم يُرسل التعديل: تعديل لهذه الرسالة ينتظر الخادم بالفعل."

#. Lobby error when a command or message was typed while the network is down; nothing was sent.
#: client/js/irc/client.ts
#: client/js/irc/commands/index.ts:215
#: client/js/irc/commands/index.ts:224
msgctxt "send.notConnected"
msgid "You are not connected to the IRC network, unable to send your command."
msgstr "لست متصلًا بشبكة IRC، تعذّر إرسال الأمر."

#. Lobby error when an IRC line could not be written to the socket. {message} is a technical transport error, left verbatim.
#: client/js/irc/client.ts
msgctxt "send.notSent"
msgid "Not sent: {message}"
msgstr "لم يُرسل: {message}"

#. Lobby error when the server's push-subscription registration line exceeds the IRC line limit; nothing was sent.
#: client/js/irc/client.ts
msgctxt "send.pushTooLong"
msgid "Not sent: the push subscription does not fit on one line"
msgstr "لم يُرسل: اشتراك الإشعارات الفورية لا يتسع في سطر واحد"

#. Lobby error when a reaction was sent on a server without message-tags.
#: client/js/irc/client.ts
msgctxt "send.reactNeedsTags"
msgid "Reactions need the message-tags capability, which this server did not enable."
msgstr "تحتاج التفاعلات إلى إمكانية message-tags، التي لم يفعّلها هذا الخادم."

#. Lobby error when a reaction was sent in a window that carries no messages.
#: client/js/irc/client.ts
msgctxt "send.reactTargets"
msgid "Reactions can only be sent in channels and queries."
msgstr "لا يمكن إرسال التفاعلات إلا في القنوات والمحادثات الخاصة."

#. Lobby error when deletion was tried outside a channel.
#: client/js/irc/client.ts
msgctxt "send.redactChannels"
msgid "Messages can only be deleted in channels."
msgstr "لا يمكن حذف الرسائل إلا في القنوات."

#. Lobby error when deletion was tried on a server without the redaction capability.
#: client/js/irc/client.ts
msgctxt "send.redactUnavailable"
msgid "Deleting messages is not available: the server did not enable draft/message-redaction."
msgstr "حذف الرسائل غير متاح: لم يفعّل الخادم draft/message-redaction."

#. Lobby error when a message's client tags exceed the IRC line limit; nothing was sent.
#: client/js/irc/client.ts
msgctxt "send.tagsTooLong"
msgid "Not sent: the tags do not fit on one line"
msgstr "لم يُرسل: الوسوم لا تتسع في سطر واحد"

#. Button on the Account settings page while the chat network is connected or connecting; clicking hangs up the connection, which stays in the sidebar to connect again.
#: client/components/Settings/Account.vue
msgctxt "settings.account.disconnect"
msgid "Disconnect"
msgstr ""

#. Line on the Account settings page under the network's name, when the user came in as a guest without an account. {nick} is the chat nickname the guest uses.
#: client/components/Settings/Account.vue
msgctxt "settings.account.guest"
msgid "Guest: {nick}"
msgstr ""

#. Heading of the Account page in the settings: the one chat network this app is for, who this device signs in to it as, and its connect and sign-in buttons.
#: client/components/Settings/Account.vue
msgctxt "settings.account.heading"
msgid "Account"
msgstr ""

#. Button on the Account settings page for a guest or a signed-out user; opens the sign-in screen, where an account name and password are entered.
#: client/components/Settings/Account.vue
msgctxt "settings.account.signIn"
msgid "Sign in"
msgstr ""

#. Button on the Account settings page while the device signs in with an account; opens a confirmation before signing out.
#: client/components/Settings/Account.vue
msgctxt "settings.account.signOut"
msgid "Sign out"
msgstr ""

#. Confirmation button of the dialog that signs the user out of the chat network.
#: client/components/Settings/Account.vue
msgctxt "settings.account.signOutButton"
msgid "Sign out"
msgstr ""

#. Body of the confirmation dialog before signing out of the chat network; says what signing out does on this device.
#: client/components/Settings/Account.vue
msgctxt "settings.account.signOutText"
msgid "This disconnects you, and this device forgets your sign-in and its private messages."
msgstr ""

#. Title of the confirmation dialog before signing out of the chat network. {name} is the network's display name.
#: client/components/Settings/Account.vue
msgctxt "settings.account.signOutTitle"
msgid "Sign out of {name}?"
msgstr ""

#. Line on the Account settings page under the network's name. {account} is the user's account name on the chat network, which this device signs in with.
#: client/components/Settings/Account.vue
msgctxt "settings.account.signedIn"
msgid "Signed in as {account}"
msgstr ""

#. Line on the Account settings page under the network's name, when this device has no account and no guest session on the chat network.
#: client/components/Settings/Account.vue
msgctxt "settings.account.signedOut"
msgid "Not signed in"
msgstr ""

#. Button under the alias table: appends a new, empty alias row to edit.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.add"
msgid "Add alias"
msgstr "إضافة اسم بديل"

#. aria-label of an alias row's commands (body) input. {name} is the alias's name — or, while the name is empty, the row's number; verbatim user content either way, never translated.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.bodyAria"
msgid "Commands for alias {name}"
msgstr "أوامر الاسم البديل {name}"

#. Example body shown in the alias-body input: an IRC action waving at the first argument. Keep the /me command and the $1 token verbatim; the action wording is an example and may be adapted.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.bodyPlaceholder"
msgid "/me waves at $1"
msgstr "/me يلوّح لـ $1"

#. Shown in place of the alias table when no aliases are defined.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.empty"
msgid "No aliases yet."
msgstr "لا أسماء بديلة بعد."

#. Row error: the alias has a name but no commands.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorBody"
msgid "Say what the alias runs."
msgstr "حدّد ما ينفّذه الاسم البديل."

#. Row error: another row already defines this alias. {name} is the other alias's name, verbatim user content; the slash before it is the command prefix.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorDuplicate"
msgid "There is already a /{name}."
msgstr "يوجد بالفعل /{name}."

#. Row error under an alias row: the alias has no name.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorName"
msgid "Give the alias a name."
msgstr "أعطِ الاسم البديل اسمًا."

#. Row error: the alias name contains characters other than letters, digits, hyphen and underscore. The - and _ are literal characters, keep them.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorNameChars"
msgid "Names are letters, digits, - and _ — no spaces or slashes."
msgstr "تتكون الأسماء من الحروف والأرقام و- و_ — دون مسافات أو شرطات مائلة."

#. Row error: the body exceeds the length limit. {limit} is the maximum number of characters (a number).
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorTooLong"
msgid "The body is too long (over {limit} characters)."
msgstr "النص طويل جدًا (أكثر من {limit} حرفًا)."

#. Column heading of the alias editor table: the name of the slash command being defined. The header row is aria-hidden; each input's own aria-label carries this meaning to screen readers.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.headName"
msgid "Alias"
msgstr "الاسم البديل"

#. Column heading of the alias editor table: the command lines the alias runs (its body). The header row is aria-hidden; the body input's own aria-label carries this meaning to screen readers.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.headRuns"
msgid "Runs"
msgstr "ينفّذ"

#. Intro paragraph of Settings → Aliases. {example} is an example alias invocation such as /wave (a code element); {first}, {rest} and {all} are the argument tokens $1, $2- and $*, each a code element.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.intro"
msgid "An alias is a slash command of your own. Typing {example} runs what you define here — one command per line, with the arguments filled in where the body says {first}, {rest} or {all}."
msgstr "الاسم البديل أمر مائل خاص بك. كتابة {example} تشغّل ما تحدده هنا — أمر واحد في كل سطر، وتوضع المعاملات حيث يذكر النص {first} أو {rest} أو {all}."

#. aria-label of an alias row's name input. {number} is the row's position, counting from 1.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nameAria"
msgid "Alias name {number}"
msgstr "اسم الاسم البديل {number}"

#. Placeholder of the alias-name input: the alias's name goes here.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.namePlaceholder"
msgid "name"
msgstr "الاسم"

#. Paragraph of Settings → Aliases on nested aliases. {command} is the example /join and {expansion} the example /join #lobby $*, each a code element: an alias named join can expand to the built-in /join without calling itself again.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nested"
msgid "A body line can invoke another alias, and an alias named after a built-in command replaces it — {command} can become {expansion} without looping."
msgstr "يمكن لسطر أن يستدعي اسمًا بديلًا آخر، والاسم البديل الذي يحمل اسم أمر مدمج يحل محله — يمكن أن يصبح {command} هو {expansion} دون أن يدخل في حلقة."

#. aria-label of the whole aliases pane (a role=group in Settings); heard by screen readers when they enter the pane.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.paneAria"
msgid "Command aliases"
msgstr "الأسماء البديلة للأوامر"

#. Live preview: the typed text matched no alias, so it would go to the server exactly as typed.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.previewMiss"
msgid "Not an alias — this would be sent as typed."
msgstr "ليس اسمًا بديلًا — سيُرسل هذا كما كُتب."

#. aria-label of an alias row's remove button (trash icon; no visible text). {name} is the alias's name — or the row's number while the name is empty; verbatim user content.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.removeAria"
msgid "Remove alias {name}"
msgstr "حذف الاسم البديل {name}"

#. Status line when some rows have errors and are not saved yet. {count} is the number of saved aliases; gettext plural, English index 0 is the singular.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.statusBroken"
msgid "{count} alias saved — rows with errors are not saved."
msgid_plural "{count} aliases saved — rows with errors are not saved."
msgstr[0] "الأسماء البديلة المحفوظة: {count} — الصفوف التي فيها أخطاء لا تُحفظ."
msgstr[1] "الأسماء البديلة المحفوظة: {count} — الصفوف التي فيها أخطاء لا تُحفظ."
msgstr[2] "الأسماء البديلة المحفوظة: {count} — الصفوف التي فيها أخطاء لا تُحفظ."
msgstr[3] "الأسماء البديلة المحفوظة: {count} — الصفوف التي فيها أخطاء لا تُحفظ."
msgstr[4] "الأسماء البديلة المحفوظة: {count} — الصفوف التي فيها أخطاء لا تُحفظ."
msgstr[5] "الأسماء البديلة المحفوظة: {count} — الصفوف التي فيها أخطاء لا تُحفظ."

#. Status line under the alias table: how many aliases are saved. {count} is the number; gettext plural, English index 0 is the singular.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.statusSaved"
msgid "{count} alias saved."
msgid_plural "{count} aliases saved."
msgstr[0] "الأسماء البديلة المحفوظة: {count}."
msgstr[1] "الأسماء البديلة المحفوظة: {count}."
msgstr[2] "الأسماء البديلة المحفوظة: {count}."
msgstr[3] "الأسماء البديلة المحفوظة: {count}."
msgstr[4] "الأسماء البديلة المحفوظة: {count}."
msgstr[5] "الأسماء البديلة المحفوظة: {count}."

#. Heading of the command-aliases pane in Settings, where the user defines their own slash commands.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.titleHeading"
msgid "Command aliases"
msgstr "الأسماء البديلة"

#. aria-label of the try-it input: type an alias invocation to preview its expansion.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryAria"
msgid "Try an alias"
msgstr "تجربة اسم بديل"

#. Try-it placeholder when at least one valid alias exists: an example invocation of that alias. {name} is the alias's name, verbatim; the rest is example prose.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryExample"
msgid "/{name} some arguments"
msgstr "/{name} بعض الوسائط"

#. Heading of the live preview: type an alias invocation and see the commands it expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryHeading"
msgid "Try it"
msgstr "جرّبه"

#. Variable reference: what $chan expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varChan"
msgid "the current channel or query"
msgstr "القناة أو المحادثة الخاصة الحالية"

#. Settings > Aliases variable reference, describing the $$ escape: it expands to a single dollar sign. {character} is that dollar sign, shown in code style.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varLiteral"
msgid "a literal {character}"
msgstr "العلامة {character} نفسها"

#. Variable reference: what $me expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varMe"
msgid "your nick on that network"
msgstr "اسمك المستعار على تلك الشبكة"

#. Variable reference: what $1 expands to in an alias body.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varOne"
msgid "one argument (empty when not given)"
msgstr "وسيط واحد (فارغ إن لم يُعطَ)"

#. Variable reference: what $2- expands to (everything from the second argument on).
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varRest"
msgid "arguments from the 2nd to the last"
msgstr "الوسائط من الثاني إلى الأخير"

#. Variable reference: what $* expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varStar"
msgid "everything after the alias name"
msgstr "كل ما يلي اسم الاسم البديل"

#. Heading of the variables reference: the dollar placeholders an alias body can use.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.variablesHeading"
msgid "Variables"
msgstr "المتغيرات"

#. Checkbox in Settings > Appearance; when ticked, typing in the message input suggests completions for names, emoji and commands.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.autocomplete"
msgid "Enable autocomplete"
msgstr "تفعيل الإكمال التلقائي"

#. Checkbox in Settings > Appearance; when ticked, each user's name in chat is drawn in its own consistent color.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.coloredNicks"
msgid "Enable colored nicknames"
msgstr "تفعيل تلوين الأسماء المستعارة"

#. Heading of the section in Settings > Appearance holding the user's own CSS. Keep the capitalization style of the source if possible.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheet"
msgid "Custom Stylesheet"
msgstr "ورقة الأنماط المخصصة"

#. Visually hidden label of the custom stylesheet text area in Settings > Appearance, where CSS rules overriding the app's own styles can be entered.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheetHelp"
msgid "Custom stylesheet. You can override any style with CSS here."
msgstr "ورقة الأنماط المخصصة. يمكنك هنا تجاوز أي نمط باستخدام CSS."

#. Placeholder of the custom stylesheet text area in Settings > Appearance, written as a CSS comment. Keep the /* */ comment markers.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheetPlaceholder"
msgid "/* You can override any style with CSS here */"
msgstr "/* يمكنك تجاوز أي أسلوب هنا باستخدام CSS */"

#. aria-label of the slider in Settings > Appearance that changes the size of chat text and the interface with it.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.fontSizeAria"
msgid "Message font size"
msgstr "حجم خط الرسائل"

#. Heading of the text size control in Settings > Appearance; a slider that scales the whole interface.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.fontSizeHeading"
msgid "Font size"
msgstr "حجم الخط"

#. Label of the largest step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:458
msgctxt "settings.appearance.fontSizeHuge"
msgid "Huge"
msgstr "ضخم"

#. Label of the default step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:456
msgctxt "settings.appearance.fontSizeLarge"
msgid "Large"
msgstr "كبير"

#. Label of the middle step of the font-size slider in Settings → Appearance: the browser's default size. One word.
#: client/components/Settings/Appearance.vue:455
msgctxt "settings.appearance.fontSizeMedium"
msgid "Medium"
msgstr "متوسط"

#. Label of the second step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:454
msgctxt "settings.appearance.fontSizeSmall"
msgid "Small"
msgstr "صغير"

#. Label of the smallest step of the font-size slider in Settings → Appearance: the datalist stop and the value shown while dragging. One word.
#: client/components/Settings/Appearance.vue:453
msgctxt "settings.appearance.fontSizeTiny"
msgid "Tiny"
msgstr "صغير جدًا"

#. Label of the second-largest step of the font-size slider in Settings → Appearance.
#: client/components/Settings/Appearance.vue:457
msgctxt "settings.appearance.fontSizeXlarge"
msgid "Extra large"
msgstr "كبير جدًا"

#. Checkbox in Settings > Appearance; when ticked, chat messages are rendered with Markdown styling such as bold text, code blocks and spoiler marks. Ellipsis is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.markdown"
msgid "Render Markdown formatting (bold, code, spoilers…)"
msgstr "عرض تنسيق Markdown (الغامق، الشيفرة، المحتوى المخفي…)"

#. Settings → Appearance, switch above the theme picker: when on, a theme that has a light and a dark version shows the one matching the device's light or dark mode.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.matchSystemAppearance"
msgid "Match the system's light or dark mode"
msgstr "مطابقة الوضع الفاتح أو الداكن للنظام"

#. Settings → Appearance, switch under the Font size heading, in the native apps only: when on, the app's text size follows the phone's own text-size setting and the slider is hidden.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.matchSystemTextSize"
msgid "Match the system text size"
msgstr "مطابقة حجم نص النظام"

#. Checkbox in Settings > Appearance; when ticked, links to media are shown as an inline playable preview inside the chat instead of a plain link.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.media"
msgid "Preview images, video and audio links inline"
msgstr "معاينة روابط الصور والفيديو والصوت ضمن المحادثة"

#. Radio option in Settings > Appearance; media previews load on their own as soon as a message contains one, which exposes your address to the media site. Em dash is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaAlways"
msgid "Show automatically — the media site sees your address as soon as a link appears"
msgstr "الإظهار تلقائيًا — يرى موقع الوسائط عنوانك فور ظهور الرابط"

#. Radio option in Settings > Appearance; media previews stay behind a placeholder until you click them, so nothing is loaded from the media site before that. Em dash is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaClick"
msgid "Click to reveal — nothing is fetched from the media site until you ask to see it"
msgstr "الإظهار بالنقر — لا يُجلب شيء من موقع الوسائط حتى تطلب رؤيته"

#. Heading of the media preview section in Settings > Appearance, which controls how links to images, video and audio are shown in chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaHeading"
msgid "Media previews"
msgstr "معاينات الوسائط"

#. Visually hidden group label of the two radio choices in Settings > Appearance that decide when media previews are fetched from their site.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaRevealGroup"
msgid "When to load previews"
msgstr "متى تُحمَّل المعاينات"

#. Heading of the message display section in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.messagesHeading"
msgid "Messages"
msgstr "الرسائل"

#. Expansion of the acronym MOTD, shown as the abbreviation's hover tooltip on the Message Of The Day checkbox in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.motdTitle"
msgid "Message Of The Day"
msgstr "رسالة اليوم"

#. Label of the text field in Settings > Appearance that sets the character(s) inserted after a completed user's name, for example a comma.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfix"
msgid "Nick autocomplete postfix"
msgstr "لاحقة الإكمال التلقائي للاسم المستعار"

#. Tooltip on the nick autocomplete postfix field in Settings > Appearance; explains what the field sets.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfixHelp"
msgid "Nick autocomplete postfix (for example a comma)"
msgstr "لاحقة الإكمال التلقائي للاسم المستعار (مثلًا فاصلة)"

#. Placeholder of the nick autocomplete postfix field in Settings > Appearance; keep the example punctuation (the quoted comma) as it shows what would be typed.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfixPlaceholder"
msgid "Nick autocomplete postfix (e.g. ', ')"
msgstr "لاحقة الإكمال التلقائي للاسم المستعار (مثلًا ', ')"

#. Settings → Appearance → Your own messages, radio option: your own messages sit on a lighter or darker background band.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesBand"
msgid "Highlighted row"
msgstr "صف مميَّز"

#. Settings → Appearance → Your own messages, lowercase hint after the 'Highlighted row' option (a dash is drawn before it).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesBandHint"
msgid "the row on a lighter or darker band, the text like everyone else's"
msgstr "الصف على شريط أفتح أو أغمق، والنص كنص الآخرين"

#. Settings → Appearance, heading of the radio group choosing how the user's own chat messages are told apart from everyone else's.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesHeading"
msgid "Your own messages"
msgstr "رسائلك"

#. Settings → Appearance → Your own messages, radio option: your own messages' text is drawn in the muted grey colour.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesMuted"
msgid "Greyed text"
msgstr "نص رمادي"

#. Settings → Appearance → Your own messages, lowercase hint after the 'Greyed text' option (a dash is drawn before it). 'as before' = this is how the app always looked.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesMutedHint"
msgid "the text in the muted colour, as before"
msgstr "النص باللون الخافت، كما كان من قبل"

#. Settings → Appearance → Your own messages, radio option: your own messages look exactly like other people's.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesPlain"
msgid "Same as everyone else's"
msgstr "مثل رسائل الآخرين"

#. Settings → Appearance → Your own messages, lowercase hint after the 'Same as everyone else's' option (a dash is drawn before it); 'them' = your own messages.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesPlainHint"
msgid "nothing marks them"
msgstr "لا شيء يميّزها"

#. Heading in Settings > Appearance, shown only under the ps theme: how much the live landscape behind the chat (sky, clouds, birds, rain) moves.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psAnimationHeading"
msgid "Scene animation"
msgstr "حركة المشهد"

#. Checkbox under Message layout (ps theme): consecutive messages from one sender share one name and time.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psGroupMessages"
msgid "Combine messages from the same person"
msgstr "دمج رسائل الشخص نفسه"

#. Hint after the Combine messages checkbox (ps theme).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psGroupMessagesHint"
msgid "their name and time once, for lines sent within ten minutes of each other"
msgstr "الاسم والوقت مرة واحدة للأسطر المرسلة بفارق عشر دقائق أو أقل"

#. Heading in Settings > Appearance, shown only under the ps theme: how chat messages are laid out.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psLayoutHeading"
msgid "Message layout"
msgstr "تخطيط الرسائل"

#. Radio option under Scene animation (ps theme): the scene's motion follows the device.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionAuto"
msgid "Auto"
msgstr "تلقائي"

#. Hint after the Auto option under Scene animation (ps theme); lowercase, it continues the option's label.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionAutoHint"
msgid "follows your device: Full on a computer or tablet, Calm on a phone, one step less on low power"
msgstr "يتبع جهازك: كاملة على الحاسوب أو اللوحي، هادئة على الهاتف، ودرجة أقل عند توفير الطاقة"

#. Radio option under Scene animation (ps theme): only the clouds move.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionCalm"
msgid "Calm"
msgstr "هادئة"

#. Hint after the Calm option under Scene animation (ps theme); lowercase, it continues the option's label.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionCalmHint"
msgid "the clouds drift; the rest holds still"
msgstr "تنساب الغيوم؛ والباقي ساكن"

#. Radio option under Scene animation (ps theme): everything in the landscape moves.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionFull"
msgid "Full"
msgstr "كاملة"

#. Hint after the Full option under Scene animation (ps theme); lowercase, it continues the option's label.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionFullHint"
msgid "everything moves, at your screen's rate"
msgstr "كل شيء يتحرك، بمعدل شاشتك"

#. Radio option under Scene animation (ps theme): the landscape does not move.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionStill"
msgid "Still"
msgstr "ساكنة"

#. Hint after the Still option under Scene animation (ps theme); lowercase, it continues the option's label.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psMotionStillHint"
msgid "a still picture; the sky still follows the time of day"
msgstr "صورة ساكنة؛ والسماء ما زالت تتبع وقت النهار"

#. Checkbox under Scene animation (ps theme): stop the landscape moving when the user is not looking at the app.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psPauseWhenAway"
msgid "Pause the scene when the window isn't in use"
msgstr "إيقاف المشهد مؤقتًا حين لا تُستخدم النافذة"

#. Hint after the Pause the scene checkbox (ps theme); a hidden browser tab stops the landscape whatever this says.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psPauseWhenAwayHint"
msgid "after 15 seconds without the focus, or 2 minutes without input; a hidden tab never moves it"
msgstr "بعد 15 ثانية دون تركيز، أو دقيقتين دون إدخال؛ اللسان المخفي لا يحرّكه أبدًا"

#. Radio label under Words over the plains (ps theme): every message on a translucent card.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsBubbles"
msgid "Bubbles"
msgstr "فقاعات"

#. Hint after the Bubbles radio (ps theme).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsBubblesHint"
msgid "each message on a translucent card: paper by day, dark at night"
msgstr "كل رسالة على بطاقة شفافة: ورقية نهارًا، داكنة ليلًا"

#. Radio label under Words over the plains (ps theme): the whole message column on frosted glass.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsGlass"
msgid "Glass"
msgstr "زجاج"

#. Hint after the Glass radio (ps theme).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsGlassHint"
msgid "the whole column on frosted glass, the plains a wash behind it"
msgstr "العمود كله على زجاج مصنفر، والسهول خلفه باهتة"

#. Radio label under Words over the plains (ps theme): a soft dark glow and no outline.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsGlow"
msgid "Soft glow"
msgstr "توهّج ناعم"

#. Hint after the Soft glow radio (ps theme); 'floor' is the theme's legibility floor (a contrast ratio).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsGlowHint"
msgid "a soft dark glow and nothing else; by day it reads well under the usual floor"
msgstr "توهّج داكن ناعم ولا شيء آخر؛ نهارًا يُقرأ دون الحد المعتاد بكثير"

#. Heading in Settings > Appearance, shown only under the ps theme: how the chat text is drawn over the live scene (six treatments).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsHeading"
msgid "Words over the plains"
msgstr "الكلمات فوق السهول"

#. Radio label under Words over the plains (ps theme): white words in a dark outline, the look before the setting existed.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsOutline"
msgid "Outline"
msgstr "حدّ"

#. Hint after the Outline radio (ps theme).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsOutlineHint"
msgid "white words in a dark outline; ink on snowy days"
msgstr "كلمات بيضاء بحدّ داكن؛ حبر في الأيام الثلجية"

#. Radio label under Words over the plains (ps theme): a thinner outline in the sky's colour.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsRim"
msgid "Tinted rim"
msgstr "حافة ملوّنة"

#. Hint after the Tinted rim radio (ps theme); 'floor' is the theme's legibility floor (a contrast ratio).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsRimHint"
msgid "a thinner rim in the sky's own colour; by day it reads under the usual floor"
msgstr "حافة أرقّ بلون السماء نفسها؛ نهارًا تُقرأ دون الحد المعتاد"

#. Radio label under Words over the plains (ps theme): a graded wash across the column.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsScrim"
msgid "Scrim"
msgstr "تظليل"

#. Hint after the Scrim radio (ps theme).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.psWordsScrimHint"
msgid "a soft wash across the column, stronger near the edge, no blur"
msgstr "طبقة لونية ناعمة على العمود، أقوى قرب الحافة، دون تمويه"

#. Third line of the sample chat under the font-size slider in Settings → Appearance: the extreme steps are intentionally unusable.
#: client/components/Settings/Appearance.vue:486
msgctxt "settings.appearance.sampleEnds"
msgid "The ends are meant to be too small and too big."
msgstr "الحدّان الأقصيان صغيران جدًا وكبيران جدًا عن قصد."

#. First line of the sample chat under the font-size slider in Settings → Appearance, written by the sample nick grandma: it asks whether the text is comfortable to read.
#: client/components/Settings/Appearance.vue:474
msgctxt "settings.appearance.sampleGlasses"
msgid "Can you read this without your glasses?"
msgstr "هل يمكنك قراءة هذا دون نظارتك؟"

#. Second line of the sample chat under the font-size slider in Settings → Appearance, the reply telling the reader to drag the slider until the text is comfortable.
#: client/components/Settings/Appearance.vue:480
msgctxt "settings.appearance.sampleSlide"
msgid "Yes! Slide it until this is comfortable."
msgstr "نعم! حرّك المنزلق حتى يصبح مريحًا."

#. Checkbox label in Settings > Appearance that displays the server's Message Of The Day when connecting. {motd} is the untranslated acronym 'MOTD', rendered as a marked abbreviation with a tooltip: put it where your grammar needs the object (for example 'MOTD anzeigen', 'MOTD を表示').
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.showMotd"
msgid "Show {motd}"
msgstr "إظهار {motd}"

#. Checkbox in Settings > Appearance; when ticked, message timestamps include the seconds as well as hours and minutes.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.showSeconds"
msgid "Include seconds in timestamp"
msgstr "إظهار الثواني في توقيت الرسائل"

#. Radio option in Settings > Appearance; joins and parts are compressed into one summary line to keep the chat short.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusCondensed"
msgid "Condense status messages together"
msgstr "دمج رسائل الحالة معًا"

#. Heading of the section in Settings > Appearance that controls how join, part and similar service notices are shown in chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHeading"
msgid "Status messages"
msgstr "رسائل الحالة"

#. Tooltip on the status messages heading in Settings > Appearance; lists the kinds of notices meant (people joining or leaving, being removed, renaming, and permission changes).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHelp"
msgid "Joins, parts, quits, kicks, nick changes, and mode changes"
msgstr "الانضمام والمغادرة والخروج والطرد وتغيير الأسماء المستعارة والأوضاع"

#. Radio option in Settings > Appearance; joins, parts and similar service notices are not shown at all.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHidden"
msgid "Hide all status messages"
msgstr "إخفاء جميع رسائل الحالة"

#. Radio option in Settings > Appearance; every join, part or similar notice appears as its own line in the chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusShown"
msgid "Show all status messages individually"
msgstr "إظهار كل رسالة حالة على حدة"

#. Hint in Settings → Appearance (Android app) while the text size follows the system: where Android sets it. Use the names Android's own Settings app shows in this language.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.systemTextSizeAndroid"
msgid "Set it in Android Settings → Display → Display size and text."
msgstr "اضبطه في إعدادات Android ← الشاشة ← حجم الشاشة والنص."

#. Hint in Settings → Appearance (iOS app) while the text size follows the system: where iOS sets it. Use the names iOS's own Settings app shows in this language.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.systemTextSizeIos"
msgid "Set it in iOS Settings → Display & Brightness → Text Size, or Accessibility → Display & Text Size for larger sizes."
msgstr "اضبطه في إعدادات iOS ← شاشة العرض والإضاءة ← حجم النص، أو تسهيلات الاستخدام ← شاشة العرض وحجم النص للأحجام الأكبر."

#. Heading of the theme section in Settings > Appearance, and the visually hidden label of the theme dropdown beneath it; picks the color scheme of the app.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.theme"
msgid "Theme"
msgstr "السمة"

#. Hint under the theme picker in Settings → Appearance, about the 'match the system's light/dark mode' switch. Theme names stay as they are. {dark} and {light} are the names of the pair's two themes.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.themePairHalves"
msgid "{dark} in dark mode, {light} in light mode."
msgstr "{dark} في الوضع الداكن، و {light} في الوضع الفاتح."

#. Hint under the theme picker in Settings → Appearance, about the 'match the system's light/dark mode' switch. Theme names stay as they are. The chosen theme has no light/dark partner: {theme} is its name, {pairs} a list of the paired themes ('Coffee / Creama, Cobalt / Frost, and Morning / Day').
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.themePairNone"
msgid "{theme} looks the same in light and dark mode; {pairs} follow the system."
msgstr "يبدو {theme} متماثلًا في الوضعين الفاتح والداكن؛ أما {pairs} فتتبع النظام."

#. Hint under the theme picker in Settings → Appearance, about the 'match the system's light/dark mode' switch. Theme names stay as they are. Shown while the switch is off.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.themePairOff"
msgid "When on, each light/dark pair is one entry that shows the half matching the system."
msgstr "عند التفعيل، يصبح كل زوج فاتح/داكن خيارًا واحدًا يُظهر النصف المطابق للنظام."

#. The name of the button on a media preview that marks its site, sender or channel as always allowed to load; the words appear quoted inside the always-shown list's help sentence in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedButtonName"
msgid "Always show"
msgstr "إظهار دائمًا"

#. Subheading in the always-shown media list of Settings > Appearance above the chat channel entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedChannels"
msgid "Channels"
msgstr "القنوات"

#. Button in Settings > Appearance beside the always-shown list heading; clicking removes every entry from that list.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedClear"
msgid "Clear all"
msgstr "مسح الكل"

#. Shown under the always-shown media list in Settings > Appearance when it has no entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedEmpty"
msgid "Nothing yet."
msgstr "لا شيء بعد."

#. Heading of the list in Settings > Appearance of sites, people and channels whose media always loads without asking.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedHeading"
msgid "Always shown"
msgstr "تُعرض دائمًا"

#. Help line under the always-shown list in Settings > Appearance. {button} is the name of the preview button (settings.appearance.trustedButtonName, 'Always show'), rendered emphasized where the placeholder stands.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedHelp"
msgid "Media in these scopes loads without asking. Add one with {button} on any preview."
msgstr "تُحمَّل الوسائط من هذه المصادر دون سؤال. أضف مصدرًا بزر {button} في أي معاينة."

#. Subheading in the always-shown media list of Settings > Appearance above the user account entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedPeople"
msgid "People"
msgstr "الأشخاص"

#. Subheading in the always-shown media list of Settings > Appearance above the website entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedSites"
msgid "Sites"
msgstr "المواقع"

#. Tooltip and aria-label of the remove button on an entry of the always-shown media list in Settings > Appearance, for a website or a person. {name} is that site's host or the person's name. Clicking stops their media from loading automatically.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.untrustFrom"
msgid "Stop always showing from {name}"
msgstr "إيقاف إظهار الوسائط دائمًا من {name}"

#. Tooltip and aria-label of the remove button on an entry of the always-shown media list in Settings > Appearance, for a chat channel. {name} is that channel's name.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.untrustIn"
msgid "Stop always showing in {name}"
msgstr "إيقاف إظهار الوسائط دائمًا في {name}"

#. Checkbox in Settings > Appearance; when ticked, message timestamps use a 12-hour clock (am/pm) instead of a 24-hour clock.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.use12hClock"
msgid "Use 12-hour timestamps"
msgstr "استخدام نظام 12 ساعة للتوقيت"

#. Heading of the section in Settings > Appearance holding readability helpers such as nickname colors and autocomplete. Keep the capitalization style of the source if possible.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.visualAids"
msgid "Visual Aids"
msgstr "مساعدات بصرية"

#. Heading of the away section in Settings > General, and the visually hidden label of the away-message input beneath it; names the setting that marks you away with a message when the app is closed.
#: client/components/Settings/General.vue
msgctxt "settings.general.awayHeading"
msgid "Automatic away message"
msgstr "رسالة الغياب التلقائية"

#. Placeholder of the away-message field in Settings > General; shows the message that is sent automatically while the app is not open. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.awayPlaceholder"
msgid "Away message if {appName} is not open"
msgstr "رسالة الغياب عندما لا يكون {appName} مفتوحًا"

#. Sentence shown in the restore-confirmation dialog in Settings > General, saying when the backup file was made. {date} is that day written out in the reader's language (e.g. 9 September 2026). A whole sentence: the dialog puts the separating space in.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupExported"
msgid "Exported {date}."
msgstr "صُدّر في {date}."

#. Body of the confirmation dialog before restoring a settings backup in Settings > General. {parts} is a comma-joined list ('your settings, 1 network, mutes and ignore lists'), {file} the chosen backup file's name.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupFrame"
msgid "This replaces {parts} with the contents of {file}, then reloads."
msgstr "سيستبدل هذا {parts} بمحتوى {file}، ثم تُعاد تحميل الصفحة."

#. Heading of the settings backup section in Settings > General, which exports preferences to a file and restores them.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupHeading"
msgid "Backup and restore"
msgstr "النسخ الاحتياطي والاستعادة"

#. Intro under the Backup and restore heading in Settings > General; says what exporting does, and that Lua scripts in a restored file come back switched off, as does the Enable scripting switch.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupIntro"
msgid "Save your settings to a file. You can restore here or on another device. Scripts in an imported file arrive switched off, and so does scripting itself."
msgstr "احفظ إعداداتك في ملف. يمكنك استعادتها هنا أو على جهاز آخر. تصل النصوص البرمجية في الملف المستورد معطّلة، وكذلك ميزة النصوص البرمجية نفسها."

#. Part of the restore-confirmation sentence in Settings > General: fills the list of what the file replaces for muted users and ignored users. Comma-joined by position.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupMutes"
msgid "mutes and ignore lists"
msgstr "الكتم وقوائم التجاهل"

#. Part of the settings-restore confirmation in Settings > General; fills the list of what a restore replaces with how many saved chat networks the file carries. The singular shows with exactly one network, the plural otherwise.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupNetworks"
msgid "{count} network"
msgid_plural "{count} networks"
msgstr[0] "{count} شبكة"
msgstr[1] "{count} شبكة"
msgstr[2] "{count} شبكتان"
msgstr[3] "{count} شبكات"
msgstr[4] "{count} شبكة"
msgstr[5] "{count} شبكة"

#. Part of the restore-confirmation sentence in Settings > General: fills the list of what the file replaces for the app's own preferences. Comma-joined with the other parts by position.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupPartSettings"
msgid "your settings"
msgstr "إعداداتك"

#. Sentence shown in the restore-confirmation dialog in Settings > General when the backup file contains saved network passwords. It is a whole sentence: the dialog puts the separating space in, so the translation needs no padding of its own.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupPasswords"
msgid "The file includes network passwords."
msgstr "يتضمن الملف كلمات مرور الشبكات."

#. Button in Settings > General; downloads the settings backup file to the device. Ellipsis is part of the copy.
#: client/components/Settings/General.vue
msgctxt "settings.general.export"
msgid "Export settings…"
msgstr "تصدير الإعدادات…"

#. Error message in Settings > General shown when exporting the settings backup failed and no file was produced.
#: client/components/Settings/General.vue
msgctxt "settings.general.exportFailed"
msgid "Couldn't create the file."
msgstr "تعذّر إنشاء الملف."

#. Visually hidden but screen-reader-spoken label of the hidden file picker behind the Import settings button; it accepts a previously exported settings file.
#: client/components/Settings/General.vue
msgctxt "settings.general.fileAria"
msgid "Settings file to restore"
msgstr "ملف الإعدادات المراد استعادته"

#. Button in Settings > General; opens a file picker to restore a previously exported settings backup file. Ellipsis is part of the copy.
#: client/components/Settings/General.vue
msgctxt "settings.general.import"
msgid "Import settings…"
msgstr "استيراد الإعدادات…"

#. Confirmation button of the settings-restore dialog in Settings > General; clicking restores the file and reloads the app.
#: client/components/Settings/General.vue
msgctxt "settings.general.importButton"
msgid "Import and reload"
msgstr "استيراد وإعادة التحميل"

#. Error notice under the import control in Settings → General when the backup file is corrupt or truncated. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importDamaged"
msgid "This file is damaged."
msgstr "هذا الملف تالف."

#. Error message in Settings > General shown when the chosen file could not be read as a settings backup.
#: client/components/Settings/General.vue
msgctxt "settings.general.importFailed"
msgid "Couldn't read the file."
msgstr "تعذّرت قراءة الملف."

#. Error notice under the import control in Settings → General when the backup was written by a newer build of the app that this one cannot read. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNewer"
msgid "This file was made by a newer version."
msgstr "أُنشئ هذا الملف بإصدار أحدث."

#. Error notice under the import control in Settings → General when the browser lacks the DecompressionStream API the compressed backup needs. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNoDecompression"
msgid "This browser can't read compressed files."
msgstr "هذا المتصفح لا يمكنه قراءة الملفات المُضغوطة."

#. Settings → General → Backup and restore: the error shown when restoring a settings file fails because the device's storage is full; the restore was undone, so the device keeps its old settings.
#: client/components/Settings/General.vue
msgctxt "settings.general.importNoRoom"
msgid "There isn't room on this device to import that file. Nothing was changed."
msgstr "لا توجد مساحة كافية على هذا الجهاز لاستيراد ذلك الملف. لم يتغير شيء."

#. Error notice under the import control in Settings → General when the chosen file is not a settings backup (wrong shape, unparseable). Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNotSettings"
msgid "This isn't a settings file."
msgstr "هذا ليس ملف إعدادات."

#. Title of the confirmation dialog shown before a settings backup file is restored from Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.importTitle"
msgid "Import settings?"
msgstr "استيراد الإعدادات؟"

#. Checkbox in Settings > General's backup section; when ticked, the exported settings file also contains the saved chat network passwords.
#: client/components/Settings/General.vue
msgctxt "settings.general.includePasswords"
msgid "Include network passwords"
msgstr "تضمين كلمات مرور الشبكات"

#. Tooltip on the include-network-passwords checkbox in Settings > General; warns that the export keeps passwords in plain text.
#: client/components/Settings/General.vue
msgctxt "settings.general.includePasswordsHelp"
msgid "Passwords are stored in the file unencrypted."
msgstr "تُخزَّن كلمات المرور في الملف دون تشفير."

#. Button in Settings > General; clicking shows the browser's prompt that installs this web app to the device's home screen or app list. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.installApp"
msgid "Install {appName} as an app"
msgstr "تثبيت {appName} كتطبيق"

#. Button in Settings → General: reopens the step-by-step guide to installing the app on this device. {appName} is the app's name.
#: client/components/Settings/General.vue
msgctxt "settings.general.installGuide"
msgid "How to install {appName}"
msgstr "كيفية تثبيت {appName}"

#. Switch in Settings, General, in the Windows and Linux apps: make this app the system's handler for irc:// and ircs:// links (taking them from any other IRC client). {appName} is the app's name.
#: client/components/Settings/General.vue:31
msgctxt "settings.general.ircLinks"
msgid "Open irc:// and ircs:// links in {appName}"
msgstr ""

#. Switch label in Settings → General (Android app only).
#: client/components/Settings/General.vue
msgctxt "settings.general.keepAlive"
msgid "Stay connected in the background"
msgstr "البقاء متصلًا في الخلفية"

#. Heading in Settings → General (Android app only): keeping the connections open while the app is in the background.
#: client/components/Settings/General.vue
msgctxt "settings.general.keepAliveHeading"
msgid "Background connection"
msgstr "الاتصال في الخلفية"

#. Tooltip help of the 'Stay connected in the background' switch (Android app).
#: client/components/Settings/General.vue
msgctxt "settings.general.keepAliveHelp"
msgid "Keeps your connections open while the app is not on screen, with a notification Android shows the whole time. Uses more battery."
msgstr "يُبقي اتصالاتك مفتوحة حين لا يكون التطبيق على الشاشة، مع إشعار يعرضه Android طوال الوقت. يستهلك بطارية أكثر."

#. Hint under the 'Stay connected in the background' switch when Android notifications are off for the app. {appName} is the app's name.
#: client/components/Settings/General.vue
msgctxt "settings.general.keepAliveNotificationsOff"
msgid "Notifications are off for {appName} in Android's settings, so the connection notification is hidden. Android may still stop the app."
msgstr "الإشعارات متوقفة لـ {appName} في إعدادات Android، لذا إشعار الاتصال مخفي. قد يوقف Android التطبيق مع ذلك."

#. Checkbox in Settings > General; when ticked, the recent lines of private (one-to-one) conversations are stored in this browser so they come back after the page is reloaded.
#: client/components/Settings/General.vue
msgctxt "settings.general.keepPrivate"
msgid "Keep private conversations on this device"
msgstr "الاحتفاظ بالمحادثات الخاصة على هذا الجهاز"

#. Tooltip on the keep-private-conversations checkbox in Settings > General. {lines} and {queries} are numbers (200 and 30 today). Make clear that turning the setting off deletes what is stored.
#: client/components/Settings/General.vue
msgctxt "settings.general.keepPrivateHelp"
msgid "Private conversations come back after a reload: the newest {lines} lines of your {queries} most recent ones, stored in this browser. Turning this off deletes them from this device."
msgstr "تعود المحادثات الخاصة بعد إعادة التحميل: أحدث {lines} سطر من أحدث {queries} محادثة لك، محفوظة في هذا المتصفح. إيقاف هذا الخيار يحذفها من هذا الجهاز."

#. Heading of the Native app section in Settings > General; groups the install and link-handler options for using the chat app as an installed application.
#: client/components/Settings/General.vue
msgctxt "settings.general.nativeApp"
msgid "Native app"
msgstr "التطبيق"

#. Button in Settings > General; registers this web app as the handler for web+irc:// chat links so clicking one anywhere opens it in the app. Keep the web+irc:// scheme verbatim. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.openLinks"
msgid "Open web+irc:// links with {appName}"
msgstr "فتح روابط web+irc:// باستخدام {appName}"

#. Section heading in Settings > General for whether private (one-to-one) conversations are kept in this browser between visits.
#: client/components/Settings/General.vue
msgctxt "settings.general.privateHeading"
msgid "Private conversations"
msgstr "المحادثات الخاصة"

#. Checkbox in Settings > General; when ticked, other people in the channel are told while you are typing a message.
#: client/components/Settings/General.vue
msgctxt "settings.general.sendTyping"
msgid "Send typing notifications"
msgstr "إرسال إشعارات الكتابة"

#. Tooltip on the send-typing-notifications checkbox in Settings > General; mentions the IRCv3 +typing tag in parentheses.
#: client/components/Settings/General.vue
msgctxt "settings.general.sendTypingHelp"
msgid "Lets people in the channel see when you are typing (IRCv3 +typing)."
msgstr "يتيح لمن في القناة رؤية أنك تكتب (IRCv3 +typing)."

#. Heading of the typing indicator section in Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.typingHeading"
msgid "Typing notifications"
msgstr "إشعارات الكتابة"

#. Checkbox in Settings > General. When ticked, images are re-drawn through a canvas before they are sent to the chat server, which strips photo metadata such as camera model and GPS location. Affects image uploads only.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadCanvas"
msgid "Attempt to remove metadata from images before uploading"
msgstr "محاولة إزالة البيانات الوصفية من الصور قبل الرفع"

#. Tooltip on the metadata-removal upload checkbox in Settings > General; explains how the option works and that it can mis-rotate photos in browsers without canvas orientation support.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadCanvasHelp"
msgid "This option renders the image into a canvas element to remove metadata from the image. This may break orientation if your browser does not support that."
msgstr "يرسم هذا الخيار الصورة في عنصر canvas لإزالة بياناتها الوصفية. قد يُفسد ذلك اتجاه الصورة إن لم يدعمه متصفحك."

#. Heading of the file upload options section in Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadsHeading"
msgid "File uploads"
msgstr "رفع الملفات"

#. The first option of the interface-language picker: the language the browser asks for is used. {language} is that language's name, written in itself.
#: client/components/LanguageSelect.vue
msgctxt "settings.locale.auto"
msgid "System default ({language})"
msgstr "افتراضي النظام ({language})"

#. Button on the networks settings page; opens the connect form to set up a new chat network connection.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.add"
msgid "Add network"
msgstr "إضافة شبكة"

#. Button on a saved network row in the networks settings page while that network is offline; clicking dials the chat network again.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connect"
msgid "Connect"
msgstr "اتصال"

#. Status label on a saved network row in the networks settings page; the connection to that chat network is up.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connected"
msgid "Connected"
msgstr "متصل"

#. Status label on a saved network row in the networks settings page, and the caption of the same row's button, while the connection to that chat network is being established. Ellipsis is part of the copy.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connecting"
msgid "Connecting…"
msgstr "جارٍ الاتصال…"

#. Button on a saved network row in the networks settings page; opens a confirmation before the saved network is removed.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.delete"
msgid "Delete"
msgstr "حذف"

#. Confirmation button of the dialog that removes a saved chat network.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteButton"
msgid "Delete network"
msgstr "حذف الشبكة"

#. Body of the confirmation dialog before removing a saved chat network; explains what the deletion does.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteText"
msgid "This removes the saved network and disconnects it if it is running."
msgstr "يحذف هذا الشبكة المحفوظة ويقطع اتصالها إن كانت متصلة."

#. Title of the confirmation dialog before removing a saved chat network. {name} is the network's display name.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteTitle"
msgid "Delete {name}?"
msgstr "حذف {name}؟"

#. Status label on a saved network row in the networks settings page; the connection to that chat network is down.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.disconnected"
msgid "Disconnected"
msgstr "غير متصل"

#. Button on a saved network row in the networks settings page; opens the form where that network's address and credentials are changed.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.edit"
msgid "Edit"
msgstr "تعديل"

#. Empty state of the networks settings page, shown when no chat network has been saved in this browser.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.empty"
msgid "No networks saved yet."
msgstr "لم يتم حفظ أي شبكات حتى الآن."

#. Heading of the networks page in the chat app's settings, which lists the IRC network connections saved in this browser.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.heading"
msgid "Networks"
msgstr "الشبكات"

#. Line under the Networks heading in the settings, saying what the page is for.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.intro"
msgid "Manage the IRC networks saved in this browser."
msgstr "إدارة شبكات IRC المحفوظة في هذا المتصفح."

#. Button on a saved network row in the networks settings page while that network is connected; clicking opens the network's chat view.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.open"
msgid "Open"
msgstr "فتح"

#. Warning line in Settings > Notifications when notification permission has been denied in the browser.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserBlocked"
msgid "Notifications are blocked by your browser."
msgstr "حظر متصفحك الإشعارات."

#. Heading of the section in Settings > Notifications about the browser's own notifications while the app is open.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserHeading"
msgid "Browser Notifications"
msgstr "إشعارات المتصفح"

#. Intro line of the browser notifications section in Settings > Notifications; the quoted phrase names the toggle in each network's edit form. Keep the curly quotes.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserPerNetwork"
msgid "Browser notifications are also per network — enabled by default, toggled in each network's settings (Edit network → “Browser notifications for this network”)."
msgstr "إشعارات المتصفح أيضًا لكل شبكة على حدة — مفعّلة افتراضيًا، وتُبدَّل في إعدادات كل شبكة (تعديل الشبكة ← «إشعارات المتصفح لهذه الشبكة»)."

#. Warning line in Settings > Notifications when the browser cannot show notifications at all.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserUnsupported"
msgid "Notifications are not supported by your browser."
msgstr "متصفحك لا يدعم الإشعارات."

#. Placeholder of the custom-highlights and highlight-exceptions fields in Settings > Notifications; shows the expected input format.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.commaList"
msgid "Comma-separated, e.g.: word, some more words, anotherword"
msgstr "مفصولة بفواصل، مثلًا: كلمة، عدة كلمات، كلمةأخرى"

#. The Copy button's label for a moment after the diagnostics report was copied to the clipboard.
#: client/components/Settings/Notifications.vue:130
msgctxt "settings.notifications.copied"
msgid "Copied"
msgstr ""

#. Button in the push diagnostics fold: copies the diagnostics report to the clipboard.
#: client/components/Settings/Notifications.vue:130
msgctxt "settings.notifications.copyDiagnostics"
msgid "Copy"
msgstr ""

#. Settings → Notifications, in the desktop app (the native shell for Windows, macOS, Linux): why the push options are missing there.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.desktopShellNote"
msgid "The desktop app shows notifications while it is running. Push notifications, which reach a closed app, are not available here."
msgstr "يعرض تطبيق سطح المكتب الإشعارات أثناء تشغيله. الإشعارات الفورية، التي تصل إلى تطبيق مغلق، غير متاحة هنا."

#. Heading of the fold at the end of Settings → Notifications → Push that holds the push diagnostics report (what this device knows about push) and its buttons.
#: client/components/Settings/Notifications.vue:130
msgctxt "settings.notifications.diagnosticsHeading"
msgid "Diagnostics"
msgstr ""

#. Help text under the Diagnostics heading in Settings → Notifications: what the report contains, that it is safe to paste, and what the Subscribe now button does. 'Subscribe now' names the button labelled settings.notifications.subscribeNow.
#: client/components/Settings/Notifications.vue:130
msgctxt "settings.notifications.diagnosticsHelp"
msgid "What this device knows about push: its permission, each network's subscription, and what the browser and the server answered. Copy it and paste it where someone can read it — nothing in it lets anyone push to this device. Subscribe now asks for this device's subscription again, on every connected network."
msgstr ""

#. Checkbox in Settings > Notifications; when ticked, messages mentioning you are drawn with a colored background and can notify.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlight"
msgid "Highlight messages that mention you"
msgstr "إبراز الرسائل التي تشير إليك"

#. Label of the text field in Settings > Notifications for words that suppress highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightExceptions"
msgid "Highlight exceptions"
msgstr "استثناءات الإبراز"

#. Tooltip on the highlight-exceptions field in Settings > Notifications; explains that these words suppress highlight treatment.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightExceptionsHelp"
msgid "If a message contains any of these comma-separated expressions, it will not trigger a highlight even if it contains your nickname or expressions defined in custom highlights."
msgstr "إذا احتوت الرسالة على أي من هذه التعابير المفصولة بفواصل، فلن تُبرَز حتى لو احتوت على اسمك المستعار أو على كلمات الإبراز المخصصة."

#. Tooltip on the highlight checkbox in Settings > Notifications; explains the visual effect of highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightHelp"
msgid "Messages that mention you or match a custom highlight get a colored background and border in the channel."
msgstr "الرسائل التي تذكرك أو تطابق إبرازًا مخصصًا تظهر بخلفية وحدّ ملوّنين في القناة."

#. Label of the text field in Settings > Notifications for extra words that count as mentions of you.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlights"
msgid "Custom highlights"
msgstr "كلمات الإبراز المخصصة"

#. Tooltip on the custom highlights field in Settings > Notifications; explains the field's comma-separated format.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightsHelp"
msgid "If a message contains any of these comma-separated expressions, it will trigger a highlight."
msgstr "إذا احتوت الرسالة على أي من هذه التعابير المفصولة بفواصل، فستُبرَز."

#. Warning line in Settings > Notifications, shown on an iPhone browsing the app without installing it; the parenthesized phrase is the iOS share menu's action.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.iosNotInstalled"
msgid "On iOS, push notifications are only available after installing the app to the Home Screen (Share → Add to Home Screen)."
msgstr "على iOS، لا تتوفر الإشعارات الفورية إلا بعد إضافة التطبيق إلى الشاشة الرئيسية («مشاركة» ← «إضافة إلى الشاشة الرئيسية»)."

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: show a confirmation prompt before the device re-subscribes. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeAsk"
msgid "Wary — ask before renewing the subscription"
msgstr "حذر — اسأل قبل تجديد الاشتراك"

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: do nothing, so push stays off for that server until renewed from its network settings. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeIgnore"
msgid "Suspicious — leave it alone; push from that server stays off until you renew from the network settings"
msgstr "مشبوه — لا تفعل شيئًا؛ تبقى الإشعارات الفورية من ذلك الخادم متوقفة حتى تجددها من إعدادات الشبكة"

#. Heading-like line in Settings > Notifications introducing the three radio choices for what to do when a chat server's push identity changes; the colon leads into the choices.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeIntro"
msgid "When a server's push identity (its key) changes, this device's subscription for it stops working. Then:"
msgstr "عندما تتغير هوية الإشعارات الفورية للخادم (مفتاحه)، يتوقف اشتراك هذا الجهاز فيه عن العمل. عندئذٍ:"

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: re-subscribe immediately and silently. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeTrust"
msgid "Naive — renew it on the spot, without asking"
msgstr "ساذج — جدّده فورًا دون سؤال"

#. Warning line in Settings > Notifications when the page is not served over a secure connection, which browsers require for notifications.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.noHttps"
msgid "Notifications are only supported over HTTPS connections."
msgstr "لا تُدعم الإشعارات إلا عبر اتصالات HTTPS."

#. Checkbox in Settings > Notifications; when ticked, every chat message notifies, not only mentions and highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.notifyAll"
msgid "Enable notification for all messages"
msgstr "تفعيل الإشعارات لجميع الرسائل"

#. Button in Settings > Notifications beside the notification-sound checkbox; clicking plays the notification sound once as a preview.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.playSound"
msgid "Play sound"
msgstr "تشغيل الصوت"

#. Warning line in Settings > Notifications when the chat server refused the push subscription; SASL (the IRC login mechanism) stays verbatim.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushBlocked"
msgid "The server refused the push subscription. It may require logging in (SASL) before subscribing."
msgstr "رفض الخادم اشتراك الإشعارات الفورية. قد يتطلب تسجيل الدخول (SASL) قبل الاشتراك."

#. Warning line in Settings > Notifications when notification permission was denied; points at the browser's site settings to re-enable.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushDenied"
msgid "Notifications are blocked by your browser. Allow them in the browser's site settings, then try again."
msgstr "الإشعارات محظورة من متصفحك. اسمح بها في إعدادات الموقع في المتصفح، ثم أعد المحاولة."

#. Settings → Notifications, after "Warning:", in the Android app when the system has notifications switched off for it. "Android's settings for the app" is the system's per-app settings page.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushDeniedAndroid"
msgid "Notifications are turned off for this app. Allow them in Android's settings for the app, then try again."
msgstr "الإشعارات متوقفة لهذا التطبيق. اسمح بها في إعدادات Android للتطبيق، ثم أعد المحاولة."

#. Heading of the push notification section in Settings > Notifications; push wakes the app on new messages while it is closed.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushHeading"
msgid "Push Notifications"
msgstr "الإشعارات الفورية"

#. Intro line of the push section in Settings > Notifications; explains that push is enabled per chat network from that network's edit form (the quoted phrase names that setting) and that each server decides whether to support it. Keep the curly quotes and the arrow.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushPerNetwork"
msgid "Push is set up per network — turn it on or off in each network's settings (Edit network → “Push notifications for this network”), where the enrollment status is also shown. The browser delivers the notifications; each push-capable server decides whether to wake this app."
msgstr "تُضبط الإشعارات الفورية لكل شبكة على حدة — شغّلها أو أوقفها في إعدادات كل شبكة (تعديل الشبكة ← «الإشعارات الفورية لهذه الشبكة»)، حيث تظهر حالة الاشتراك أيضًا. المتصفح هو من يوصل الإشعارات؛ وكل خادم يدعم الإشعارات الفورية يقرر ما إذا كان سيوقظ هذا التطبيق."

#. Button in the push diagnostics fold: builds the diagnostics report again.
#: client/components/Settings/Notifications.vue:130
msgctxt "settings.notifications.refreshDiagnostics"
msgid "Refresh"
msgstr ""

#. Warning line in Settings > Notifications when the chat server itself does not offer web push; names the IRCv3 draft/webpush capability, which stays verbatim.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.serverUnsupported"
msgid "Push notifications need a connected server that supports the draft/webpush capability and you to be logged in to an account."
msgstr "تحتاج الإشعارات الفورية إلى خادم متصل يدعم إمكانية draft/webpush وإلى تسجيل دخولك إلى حساب."

#. Checkbox in Settings > Notifications; when ticked, a sound plays alongside a notification.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.sound"
msgid "Enable notification sound"
msgstr "تفعيل صوت الإشعارات"

#. Warning line in Settings > Notifications shown after a chat server changed its push identity; tells the reader to re-subscribe from that network's edit form, whose control is named in the quoted phrase.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.stale"
msgid "A server's push identity (its key) changed, so this device's push subscription for it no longer works. Renew it from that network's settings (Edit network → “Renew push notifications”) to keep being notified while the app is closed."
msgstr "تغيّرت هوية الإشعارات الفورية لخادم ما (مفتاحه)، فلم يعد اشتراك هذا الجهاز فيه يعمل. جدّده من إعدادات تلك الشبكة (تعديل الشبكة ← «تجديد الإشعارات الفورية») لتظل تتلقى الإشعارات والتطبيق مغلق."

#. Button in the push diagnostics fold: subscribes this device to push on every connected chat network that announced a push key (a tap, which the browser may require).
#: client/components/Settings/Notifications.vue:130
msgctxt "settings.notifications.subscribeNow"
msgid "Subscribe now"
msgstr ""

#. Warning line in Settings > Notifications when the browser cannot do web push; the parentheses name the browser features push requires.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.unsupported"
msgid "Push notifications are not supported by this browser (they need the Push API, a service worker and a secure context)."
msgstr "لا يدعم هذا المتصفح الإشعارات الفورية (فهي تحتاج إلى Push API وعامل خدمة وسياق آمن)."

#. Word rendered bold at the start of several warning lines in Settings > Notifications (push and browser notification problems); a colon follows it.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.warning"
msgid "Warning"
msgstr "تحذير"

#. Lua API reference, the description of seance.current_channel, seance.current_network and seance.nick: the channel, network and nick of the conversation open now.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.api.context"
msgid "Context of the currently active chat tab."
msgstr "سياق تبويب الدردشة النشط حاليًا."

#. Lua API reference, the description of seance.on("message", …). {msg} is the handler's argument and {from}, {target}, {text}, {type}, {self} its fields (all verbatim code elements: msg, .from, .target, .text, .type, .self).
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.api.message"
msgid "Incoming messages. {msg} has {from}, {target}, {text}, {type} and {self}."
msgstr "الرسائل الواردة. لدى {msg} الحقول {from} و{target} و{text} و{type} و{self}."

#. Lua API reference, the description of seance.print("text"): a line shown only on this device, never sent.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.api.print"
msgid "Show a local line in the active conversation."
msgstr "يعرض سطرًا محليًا في المحادثة النشطة."

#. Lua API reference, the description of seance.register_command("name", …). {command} is the example command /name (verbatim, a code element).
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.api.registerCommand"
msgid "Registers a custom slash command {command}."
msgstr "يسجّل أمرًا مخصصًا يبدأ بشرطة مائلة: {command}."

#. Lua API reference, the description of seance.reply(msg, "text") and seance.send("RAW LINE").
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.api.replySend"
msgid "Reply to a message, or send a raw IRC line on the current network."
msgstr "الرد على رسالة، أو إرسال سطر IRC خام على الشبكة الحالية."

#. Lua API reference, the description of seance.storage.get/set: data each script keeps for itself that survives a reload.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.api.storage"
msgid "Persistent per-script data across restarts."
msgstr "بيانات دائمة لكل نص برمجي تبقى بعد إعادة التشغيل."

#. Summary line of the folded reference under the Lua script editor's code field, listing the functions a script can call.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.apiSummary"
msgid "Lua API reference"
msgstr "مرجع واجهة Lua البرمجية"

#. Accessible name of the Lua script editor dialog. {name} is the script's name (user data, verbatim).
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.ariaNamed"
msgid "Edit script {name}"
msgstr "تحرير النص البرمجي {name}"

#. Note in the footer of the Lua script editor, beside Done.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.autosave"
msgid "Changes are saved as you type."
msgstr "تُحفظ التغييرات أثناء الكتابة."

#. Number of characters of the Lua script, the {characters} in settings.scriptEdit.size ('12 lines · 340 characters'). {count} is the number of characters.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.charCount"
msgid "{count} character"
msgid_plural "{count} characters"
msgstr[0] "{count} حرف"
msgstr[1] "{count} حرف"
msgstr[2] "{count} حرفان"
msgstr[3] "{count} أحرف"
msgstr[4] "{count} حرفًا"
msgstr[5] "{count} حرف"

#. Button in the Lua script editor that compiles the code (without running it) and says whether it is valid Lua.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.checkSyntax"
msgid "Check syntax"
msgstr "التحقق من الصياغة"

#. Brief status in the footer of the Lua script editor while Check syntax compiles the code.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.checking"
msgid "Checking…"
msgstr "جارٍ التحقق…"

#. aria-label of the ✕ button at the top right of the Lua script editor; closes it back to the script list.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.close"
msgid "Close the editor"
msgstr "إغلاق المحرر"

#. Accessible name of the code field in the Lua script editor.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.codeAria"
msgid "Lua code"
msgstr "شيفرة Lua"

#. Placeholder of the empty code field in the Lua script editor. It is a Lua comment: keep the leading '-- '.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.codePlaceholder"
msgid "-- Write your Lua code here"
msgstr "-- اكتب شيفرة Lua هنا"

#. Button in the Lua script editor that deletes the script, and the confirm button of the dialog that asks first.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.delete"
msgid "Delete"
msgstr "حذف"

#. Text of the dialog asking to confirm deleting a Lua script; its saved data is what the script stored for itself.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.deleteText"
msgid "This deletes the script and its saved data. This cannot be undone."
msgstr "سيؤدي هذا إلى حذف النص البرمجي وبياناته المحفوظة. لا يمكن التراجع عن ذلك."

#. Title of the dialog asking to confirm deleting a Lua script. {name} is the script's name (user data, verbatim); use the language's quotation marks.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.deleteTitle"
msgid "Delete script “{name}”?"
msgstr "هل تريد حذف النص البرمجي «{name}»؟"

#. Label of the description field in the Lua script editor.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.description"
msgid "Description"
msgstr "الوصف"

#. Placeholder of the description field in the Lua script editor.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.descriptionPlaceholder"
msgid "What does this script do?"
msgstr "ماذا يفعل هذا النص البرمجي؟"

#. Button in the Lua script editor that makes a copy of the script and opens the copy.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.duplicate"
msgid "Duplicate"
msgstr "تكرار"

#. Bold label of the banner in the Lua script editor showing the script's last error; the error text (from the Lua interpreter, verbatim) follows it.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.errorLabel"
msgid "Error:"
msgstr "خطأ:"

#. Button in the Lua script editor that downloads the script's code as a .lua file; keep '.lua' (the file extension).
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.export"
msgid "Export .lua"
msgstr "تصدير ‎.lua"

#. Label of the folder field in the Lua script editor: a free-text label that groups scripts in the list.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.folder"
msgid "Folder"
msgstr "المجلد"

#. Number of lines of the Lua script, the {lines} in settings.scriptEdit.size ('12 lines · 340 characters'). {count} is the number of lines.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.lineCount"
msgid "{count} line"
msgid_plural "{count} lines"
msgstr[0] "{count} سطر"
msgstr[1] "{count} سطر"
msgstr[2] "{count} سطران"
msgstr[3] "{count} أسطر"
msgstr[4] "{count} سطرًا"
msgstr[5] "{count} سطر"

#. Shown in the Lua script editor when the script it was opened on no longer exists.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.missing"
msgid "This script is gone — deleted here or in another tab."
msgstr "لم يعد هذا النص البرمجي موجودًا — حُذف هنا أو في تبويب آخر."

#. Label of the script's name field in the Lua script editor.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.name"
msgid "Name"
msgstr "الاسم"

#. Bold label of the banner in the Lua script editor when a change could not be saved; the reason (scripting.storage.*) follows it.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.notSavedLabel"
msgid "Not saved:"
msgstr "لم يُحفظ:"

#. Label of the switch in the Lua script editor that turns this one script on or off.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.run"
msgid "Run this script"
msgstr "تشغيل هذا النص البرمجي"

#. Brief status in the footer of the Lua script editor after a change was saved.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.saved"
msgid "Saved"
msgstr "تم الحفظ"

#. Size line under the Lua script editor's code field, e.g. '12 lines · 340 characters'. {lines} is settings.scriptEdit.lineCount and {characters} settings.scriptEdit.charCount, already translated; keep the middle dot or use the language's list separator.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.size"
msgid "{lines} · {characters}"
msgstr "{lines} · {characters}"

#. Brief status in the footer of the Lua script editor: Check syntax found an error (shown in the error banner).
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.syntaxError"
msgid "Syntax error"
msgstr "خطأ في الصياغة"

#. Brief status in the footer of the Lua script editor: Check syntax found the code valid.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.syntaxOk"
msgid "Syntax OK"
msgstr "الصياغة سليمة"

#. Title of the Lua script editor (an overlay over Settings > Scripts), before the script's name; also its accessible name while the script is missing.
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scriptEdit.title"
msgid "Edit script"
msgstr "تحرير النص البرمجي"

#. Name of the folder scripts are filed under when they have none: a heading in the Settings > Scripts list, and the placeholder of the editor's Folder field.
#: client/components/Settings/Scripts.vue
#: client/components/Settings/ScriptEdit.vue
msgctxt "settings.scripts.defaultFolder"
msgid "Unsorted"
msgstr "غير مصنّف"

#. Shown in Settings > Scripts in place of the list while the user has no Lua scripts.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.empty"
msgid "No scripts yet."
msgstr "لا توجد نصوص برمجية بعد."

#. Label of the switch in Settings > Scripts that turns Lua scripting on for the whole app (off by default).
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.enable"
msgid "Enable scripting"
msgstr "تفعيل النصوص البرمجية"

#. Button after 'Or try an example:' in Settings > Scripts: adds an example script that answers a chat message automatically (it replies pong! to !ping).
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.exampleResponder"
msgid "Auto-responder"
msgstr "الرد التلقائي"

#. Button after 'Or try an example:' in Settings > Scripts: adds an example script that defines a /slap slash command. Keep '/slap' verbatim (the command's name).
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.exampleSlap"
msgid "/slap command"
msgstr "الأمر /slap"

#. Lead-in in Settings > Scripts before two buttons that each add a ready-made example script (settings.scripts.exampleResponder, settings.scripts.exampleSlap).
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.examples"
msgid "Or try an example:"
msgstr "أو جرّب مثالًا:"

#. Heading of the Settings > Scripts pane, and the accessible name of the pane. Lua scripts the user writes and runs in the app.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.heading"
msgid "Scripts"
msgstr "النصوص البرمجية"

#. Button in Settings > Scripts that opens a file picker to import a Lua script file; keep '.lua' (the file extension) and the ellipsis.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.import"
msgid "Import .lua…"
msgstr "استيراد ‎.lua…"

#. aria-label of the hidden file input behind the Import .lua… button in Settings > Scripts.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.importAria"
msgid "Lua file to import"
msgstr "ملف Lua للاستيراد"

#. Error in Settings > Scripts when an imported Lua file is too long. {file} is the file's name (verbatim); {max} is the limit, a number.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.importTooLong"
msgid "{file} is over {max} characters."
msgstr "يتجاوز {file} ‏{max} حرف."

#. Intro under the Settings > Scripts heading; says what Lua scripts are for and that they stay on this device. Keep 'Lua' (the programming language) as is.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.intro"
msgid "Lua scripts that run in this browser: auto-responders, slash commands of your own, small helpers. They are kept on this device only."
msgstr "نصوص Lua برمجية تعمل في هذا المتصفح: ردود تلقائية، وأوامر خاصة بك، وأدوات مساعدة صغيرة. تُحفظ على هذا الجهاز فقط."

#. Button in Settings > Scripts that creates an empty Lua script and opens it in the editor.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.new"
msgid "New script"
msgstr "نص برمجي جديد"

#. Shown in Settings > Scripts in place of the list when the search finds no script.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.noMatch"
msgid "No script matches."
msgstr "لا يطابق أي نص برمجي."

#. Note under the Enable scripting switch while it is off. {command} is the /lua command (verbatim, a code element). Keep 'Lua' as is.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.offNote"
msgid "While this is off the Lua interpreter is not loaded, no script runs and {command} is disabled. Your scripts are kept."
msgstr "ما دام هذا معطّلًا فلن يُحمَّل مفسّر Lua، ولن يعمل أي نص برمجي، ويكون {command} معطّلًا. تبقى نصوصك البرمجية محفوظة."

#. aria-label of the on/off switch on a script's row in Settings > Scripts; on means the script runs. {name} is the script's name (user data, verbatim).
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.runAria"
msgid "Run {name}"
msgstr "تشغيل {name}"

#. aria-label of the search field above the script list in Settings > Scripts.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.searchAria"
msgid "Search scripts"
msgstr "البحث في النصوص البرمجية"

#. Placeholder of the search field above the script list in Settings > Scripts (shown once there are many scripts); it searches the scripts' names, folders and code.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.searchPlaceholder"
msgid "Search name, folder, text…"
msgstr "ابحث في الاسم والمجلد والنص…"

#. State of a Lua script in the Settings > Scripts list: its last run failed with an error.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.stateError"
msgid "Error"
msgstr "خطأ"

#. State of a Lua script in the Settings > Scripts list (and the tooltip of its switch): it is switched off.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.stateOff"
msgid "Off"
msgstr "متوقف"

#. State of a Lua script in the Settings > Scripts list (and the tooltip of its switch): it is switched on and runs.
#: client/components/Settings/Scripts.vue
msgctxt "settings.scripts.stateRunning"
msgid "Running"
msgstr "يعمل"

#. Settings tab label on a deploy that is one network's own client and keeps that network as it set it; the tab shows who this device signs in as, with buttons to connect, disconnect, sign in and sign out. Replaces the Networks tab there.
#: client/components/Settings/Navigation.vue
msgctxt "settings.tabs.account"
msgid "Account"
msgstr ""

#. Label of the Settings modal's Aliases tab (tab strip); switching tabs navigates to the Aliases settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.aliases"
msgid "Aliases"
msgstr "الأسماء البديلة"

#. Label of the Settings modal's Appearance tab (tab strip); switching tabs navigates to the Appearance settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.appearance"
msgid "Appearance"
msgstr "المظهر"

#. aria-label of the row of tab buttons across the top of the settings window, used to switch between its pages.
#: client/components/Settings/Navigation.vue
msgctxt "settings.tabs.aria"
msgid "Settings tabs"
msgstr "علامات تبويب الإعدادات"

#. Label of the Settings modal's General tab (tab strip); switching tabs navigates to the General settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.general"
msgid "General"
msgstr "عام"

#. Name of the Translation tab in the Settings tab strip while translation is switched off: the tab then holds only the interface-language picker (and the switch that turns translation on). As short as the other tab labels.
#: client/components/Settings/Navigation.vue
