msgid "Not in {target} on {network}: join it to read these, or dismiss them."
msgstr "لست في {target} على {network}: انضم إليها لقراءة هذه الإشارات، أو تجاهلها."

#. Shown under a conversation in the mentions popup whose chat network is no longer set up in this client, so its mentions can only be dismissed.
#: client/components/Mentions.vue:502
msgctxt "mentions.missingNetwork"
msgid "Its network isn't on this page: dismiss these."
msgstr "شبكة هذه المحادثة ليست على هذه الصفحة: تجاهل هذه الإشارات."

#. Shown under a private conversation in the mentions popup that is not open in this client. {target} is the other person's nick, shown verbatim.
#: client/components/Mentions.vue:506
msgctxt "mentions.missingQuery"
msgid "No conversation with {target} open: open one to read these, or dismiss them."
msgstr "لا توجد محادثة مفتوحة مع {target}: افتح واحدة لقراءة هذه الإشارات، أو تجاهلها."

#. As mentions.missingQuery, when several chat networks are set up. {target} is the other person's nick, {network} the chat network's display name.
#: client/components/Mentions.vue:505
msgctxt "mentions.missingQueryOn"
msgid "No conversation with {target} on {network} open: open one to read these, or dismiss them."
msgstr "لا توجد محادثة مفتوحة مع {target} على {network}: افتح واحدة لقراءة هذه الإشارات، أو تجاهلها."

#. Shown under a private conversation in the mentions (inbox) popup when its chat network is not connected: clicking it will work again once the connection is back.
#: client/components/Mentions.vue
msgctxt "mentions.notConnected"
msgid "Not connected: this opens once you're back."
msgstr "غير متصل: سيُفتح هذا عند عودتك."

#. Shown under a channel's group in the mentions (inbox) popup when its chat network is not connected: clicking it will work again once the connection is back and the channel joined. {target} is the channel name, shown verbatim.
#: client/components/Mentions.vue
msgctxt "mentions.notConnectedIn"
msgid "Not connected: this opens once you're back in {target}."
msgstr "غير متصل: سيُفتح هذا عند عودتك إلى {target}."

#. Tooltip of a conversation's header in the mentions popup; clicking opens that conversation. {target} is a channel name or a nick, shown verbatim.
#: client/components/Mentions.vue:56
msgctxt "mentions.open"
msgid "Open {target}"
msgstr "فتح {target}"

#. Button above a conversation's rows in the mentions popup: shows the older mentions held back so one conversation cannot fill the pane. {count} is how many. The singular form shows for one, the plural for any other number.
#: client/components/Mentions.vue
msgctxt "mentions.showMore"
msgid "Show {count} more"
msgid_plural "Show {count} more"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""
msgstr[4] ""
msgstr[5] ""

#. The same button in the mentions popup when some of the held-back mentions are not read yet. {count} is how many are held back, {unread} how many of those are unread. The singular form shows for a {count} of one, the plural for any other number.
#: client/components/Mentions.vue
msgctxt "mentions.showMoreUnread"
msgid "Show {count} more · {unread} unread"
msgid_plural "Show {count} more · {unread} unread"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""
msgstr[4] ""
msgstr[5] ""

#. Accessible name of a conversation's section in the mentions popup when several chat networks are set up. {target} is a channel name or nick, {network} the chat network's display name.
#: client/components/Mentions.vue:517
msgctxt "mentions.targetOn"
msgid "{target} on {network}"
msgstr "{target} على {network}"

#. Heading of the popup (the inbox) that lists the unread messages mentioning you, grouped by conversation.
#: client/components/Mentions.vue:10
#: client/components/Mentions.vue:18
msgctxt "mentions.title"
msgid "Mentions"
msgstr "الإشارات"

#. Button on the strip after 'Dismiss all' in the mentions popup: brings the dismissed mentions back (until the popup closes). One short word.
#: client/components/Mentions.vue
msgctxt "mentions.undo"
msgid "Undo"
msgstr "تراجع"

#. Count of unread messages: the accessible name of the total beside the mentions popup's heading, and the label on a private conversation's row when more than one of its lines is unread. {count} is the number. The singular form shows for one, the plural for any other number.
#: client/components/Mentions.vue:522
msgctxt "mentions.unread"
msgid "{count} unread"
msgid_plural "{count} unread"
msgstr[0] "{count} غير مقروءة"
msgstr[1] "{count} رسالة غير مقروءة"
msgstr[2] "{count} رسالتان غير مقروءتين"
msgstr[3] "{count} رسائل غير مقروءة"
msgstr[4] "{count} رسالة غير مقروءة"
msgstr[5] "{count} رسالة غير مقروءة"

#. Menu on a nick in a channel: opens the ban dialog for that person.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.ban"
msgid "Ban…"
msgstr ""

#. Menu on a user@host address in a join, part or quit line: opens the ban dialog for that address. {channel} is the channel's name, verbatim.
#: client/js/helpers/banMenu.ts
msgctxt "menu.banFrom"
msgid "Ban from {channel}…"
msgstr ""

#. The word for a group chat room, filling {type} in the context-menu mute items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.chanTypeChannel"
msgid "channel"
msgstr "القناة"

#. Word for a whole chat server connection, filling {type} in the context-menu mute items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.chanTypeNetwork"
msgid "network"
msgstr "الشبكة"

#. The word for a private one-on-one chat, filling {type} in the context-menu mute items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.chanTypeQuery"
msgid "conversation"
msgstr "المحادثة"

#. Context-menu item on a conversation; deletes the locally loaded messages of that conversation after a confirmation. Also the title and confirmation button of that dialog.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.clearHistory"
msgid "Clear history"
msgstr "مسح السجل"

#. Body of the confirmation dialog before the locally loaded messages of a conversation are deleted. {channel} is the conversation's name.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.clearHistoryText"
msgid "Are you sure you want to clear history for {channel}? This cannot be undone."
msgstr "هل أنت متأكد من أنك تريد مسح سجل {channel}؟ لا يمكن التراجع عن هذا."

#. Context-menu item on a channel in the sidebar network list; clicking leaves the channel (the app stops showing it and tells the server so).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.closeChannel"
msgid "Leave"
msgstr "مغادرة"

#. Context-menu item on a chat network's home row in the sidebar network list; clicking forgets the saved network connection. Shown instead of 'Close' because a network cannot be merely closed.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.closeLobby"
msgid "Remove"
msgstr "حذف"

#. Context-menu item on a private one-on-one conversation or a list window in the sidebar; clicking closes the window without leaving anything on the server.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.closeQuery"
msgid "Close"
msgstr "إغلاق"

#. Context-menu item on a chat network's home row while the network is offline; clicking dials the network again.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.connect"
msgid "Connect"
msgstr "اتصال"

#. Context-menu item on a user; opens (or switches to) the private one-on-one conversation with that user.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.directMessages"
msgid "Direct messages"
msgstr "الرسائل الخاصة"

#. Context-menu item on a chat network's home row while the network is connected; clicking hangs up the connection to that network.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.disconnect"
msgid "Disconnect"
msgstr "قطع الاتصال"

#. Context-menu item on a chat network's home row; opens the form where the network's address and credentials are changed. Ellipsis is part of the copy.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.editNetwork"
msgid "Edit this network…"
msgstr "تعديل هذه الشبكة…"

#. Context-menu item on a chat channel in the sidebar; opens the editor for the channel's topic line.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.editTopic"
msgid "Edit topic"
msgstr "تعديل الموضوع"

#. Context-menu item that grants an IRC channel role to a user; {name} is the role's name ('operator'), {mode} the bare mode letter (e.g. o) — the + before it is part of the text, so the item reads (+o).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.giveMode"
msgid "Give {name} (+{mode})"
msgstr "منح صلاحية {name} (+{mode})"

#. Context-menu item that grants an IRC mode whose role name is unknown; {mode} is the bare mode letter (e.g. z) — the + before it is part of the text, so the item reads Mode +z.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.giveModeUnknown"
msgid "Mode +{mode}"
msgstr "الوضع +{mode}"

#. Context-menu item on a clickable channel name inside a chat message, when that channel is already open in this client; clicking switches to it.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.goToChannel"
msgid "Go to channel"
msgstr "الانتقال إلى القناة"

#. Context-menu item on a user; hides all further messages from that user on the network.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.ignore"
msgid "Ignore user"
msgstr "تجاهل المستخدم"

#. Context-menu item on a chat network's home row; opens the field to join a channel on that network. Ellipsis is part of the copy.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.joinChannel"
msgid "Join a channel…"
msgstr "الانضمام إلى قناة…"

#. Context-menu item on a clickable channel name inside a chat message, when that channel is not open yet; clicking joins it.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.joinInline"
msgid "Join channel"
msgstr "الانضمام إلى القناة"

#. Context-menu item on a user in a channel you have permission in; removes that user from the channel (they may rejoin).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.kick"
msgid "Kick"
msgstr "طرد"

#. Context-menu item on a chat channel in the sidebar; asks the server for the channel's ban list.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.listBanned"
msgid "List banned users"
msgstr "قائمة المستخدمين المحظورين"

#. Context-menu item on a chat network's home row; asks the server for the list of every public channel on that network.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.listChannels"
msgid "List all channels"
msgstr "قائمة جميع القنوات"

#. Context-menu item on a chat network's home row; shows the list of users whose messages are hidden on that network.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.listIgnored"
msgid "List ignored users"
msgstr "قائمة المستخدمين المتجاهلين"

#. Name of the IRC channel administrator role (the & prefix), filling {name} in the mode menu items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeAdmin"
msgid "admin"
msgstr "مدير"

#. Name of the IRC half-operator role (the % prefix), filling {name} in the mode menu items. Lowercase mid-sentence; keep the hyphen if natural.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeHalfOp"
msgid "half-op"
msgstr "نصف مشرف"

#. Name of the IRC channel operator role (the @ prefix), filling {name} in the mode menu items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeOperator"
msgid "operator"
msgstr "مشرف"

#. Name of the highest IRC channel role (the ~ prefix), filling {name} in the mode menu items such as 'Revoke {name} (-a)'. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeOwner"
msgid "owner"
msgstr "مالك"

#. Name of the IRC voiced role (the + prefix; may speak in a moderated channel), filling {name} in the mode menu items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeVoice"
msgid "voice"
msgstr "صوت"

#. Context-menu item on a conversation; clicking mutes it (no highlights, no notifications from it). {type} names the kind of conversation in lowercase: 'network', 'channel' or 'conversation'.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.muteType"
msgid "Mute {type}"
msgstr "كتم {type}"

#. Item of a network's context menu, shown while the user is an IRC operator: opens the oper panel. 'Oper' is IRC jargon (operator).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.operPanel"
msgid "Oper panel…"
msgstr "لوحة المشرف…"

#. Context-menu item that takes an IRC channel role away from a user; {name} is the role's name ('operator'), {mode} the bare mode letter (e.g. o) — the - before it is part of the text, so the item reads (-o).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.revokeMode"
msgid "Revoke {name} (-{mode})"
msgstr "سحب صلاحية {name} (-{mode})"

#. Context-menu item that removes an IRC mode whose role name is unknown; {mode} is the bare mode letter (e.g. z) — the - before it is part of the text, so the item reads Mode -z.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.revokeModeUnknown"
msgid "Mode -{mode}"
msgstr "الوضع -{mode}"

#. Context-menu item on a user who is on the ignore list; shows their messages again (runs /unignore <nick>).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.unignore"
msgid "Unignore user"
msgstr "إلغاء تجاهل المستخدم"

#. Context-menu item on a conversation whose messages are muted (not highlighted, not notified); clicking unmutes it. {type} names the kind of conversation in lowercase: 'network', 'channel' or 'conversation'.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.unmuteType"
msgid "Unmute {type}"
msgstr "إلغاء كتم {type}"

#. Context-menu item on a user (in the user list, a message or a conversation); asks the server for that user's details (real name, account, idle time).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.whois"
msgid "User information"
msgstr "معلومات المستخدم"

#. aria-label of the hover toolbar on a chat message holding the reply, react, copy, edit and delete buttons.
#: client/components/MessageActions.vue:6
msgctxt "message.actionsToolbar"
msgid "Message actions"
msgstr "إجراءات الرسالة"

#. Error toast: the reader activated a quoted reply whose original message is not loaded while the network is disconnected.
#: client/components/Message.vue
msgctxt "message.connectToLoad"
msgid "Connect to load that message."
msgstr ""

#. Short label shown for a moment over a chat message after its text or code was copied to the clipboard from the message toolbar.
#: client/components/MessageActions.vue:34
#: client/components/MessageActions.vue
msgctxt "message.copied"
msgid "Copied"
msgstr "تم النسخ"

#. Tooltip and aria-label of the copy button that a chat message shows when it contains code blocks; clicking copies the code to the clipboard.
#: client/components/MessageActions.vue:34
msgctxt "message.copyCode"
msgid "Copy code"
msgstr "نسخ الشيفرة"

#. Tooltip and aria-label of the message toolbar button that copies the whole message text; shown on touch devices, where the text cannot be selected. Toggles to 'Copied' after a copy.
#: client/components/MessageActions.vue
msgctxt "message.copyText"
msgid "Copy text"
msgstr "نسخ النص"

#. Label of the confirmation button in the dialog shown before a chat message is deleted.
#: client/components/MessageActions.vue:54
#: client/components/MessageActions.vue
msgctxt "message.delete"
msgid "Delete"
msgstr "حذف"

#. Body of the confirmation dialog shown before a chat message is deleted. {who} describes whose message it is ('your message', or another user's name in the possessive), {preview} is the beginning of the message text, quoted.
#: client/components/MessageActions.vue:196
msgctxt "message.deleteConfirm"
msgid "Delete {who}? \"{preview}\""
msgstr "حذف {who}؟ «{preview}»"

#. Title of the confirmation dialog shown before a chat message is deleted, and the tooltip and aria-label of the message toolbar's delete button (a trash can) that opens it.
#: client/components/MessageActions.vue:195
#: client/components/MessageActions.vue
msgctxt "message.deleteTitle"
msgid "Delete message"
msgstr "حذف الرسالة"

#. Part of the delete-confirmation dialog's body: fills the {who} placeholder when the message to be deleted was written by someone else. {nick} is that user's name.
#: client/components/MessageActions.vue:190
msgctxt "message.deleteWhoOther"
msgid "{nick}'s message"
msgstr "رسالة {nick}"

#. Part of the delete-confirmation dialog's body: fills the {who} placeholder when the message to be deleted is the reader's own.
#: client/components/MessageActions.vue:189
msgctxt "message.deleteWhoSelf"
msgid "your message"
msgstr "رسالتك"

#. Visible text standing in for a deleted chat message when the deletion gave no reason. {nick} is the name of the user who deleted it. Square brackets are part of the copy.
#: client/components/Message.vue:333
msgctxt "message.deleted"
msgid "[Message deleted by {nick}]"
msgstr "[حذف {nick} الرسالة]"

#. Visible text standing in for a deleted chat message when the deletion gave a reason. {nick} is the name of the user who deleted it, {reason} the reason they gave. Square brackets are part of the copy.
#: client/components/Message.vue:331
msgctxt "message.deletedWithReason"
msgid "[Message deleted by {nick}: {reason}]"
msgstr "[حذف {nick} الرسالة: {reason}]"

#. Tooltip and aria-label of the pencil button in a chat message's hover toolbar, shown on your own messages; clicking starts editing that message.
#: client/components/MessageActions.vue:44
msgctxt "message.edit"
msgid "Edit"
msgstr "تعديل"

#. Tooltip on the edited marker of a chat message when the time of the edit is unknown.
#: client/components/Message.vue:265
msgctxt "message.edited"
msgid "This message was edited"
msgstr "عُدّلت هذه الرسالة"

#. Tooltip on the edited marker of a chat message that was edited after being sent; {time} is the date and time the edit was made, already formatted in the reader's locale.
#: client/components/Message.vue:264
msgctxt "message.editedAt"
msgid "Edited {time}"
msgstr "عُدّلت {time}"

#. Small marker shown after a chat message that was edited after being sent. Parenthesized; keep the lowercase form.
#: client/components/Message.vue:77
msgctxt "message.editedBadge"
msgid "(edited)"
msgstr "(معدّلة)"

#. Tooltip of the "(machine translated)" note on a chat message. {language} is the language the message is in, e.g. "Spanish".
#: client/components/Message.vue
msgctxt "message.machineTranslated"
msgid "Machine translated into {language} by the sender's app"
msgstr ""

#. Small note after a chat message, beside "(edited)": the sender's app translated the message by machine before sending it. Keep it short.
#: client/components/Message.vue
msgctxt "message.machineTranslatedBadge"
msgid "(machine translated)"
msgstr ""

#. Drawn before the sender's nick of an IRC NOTICE message in the chat (a label, then the nick).
#: client/components/Message.vue
msgctxt "message.noticeFrom"
msgid "Notice:"
msgstr "إشعار:"

#. Tooltip and aria-label of a one-tap reaction button on a chat message's toolbar. {reaction} is the emoji (or word) it sends.
#: client/components/MessageActions.vue
msgctxt "message.quickReact"
msgid "React with {reaction}"
msgstr "التفاعل بـ {reaction}"

#. Tooltip and aria-label of a one-tap reaction button on a chat message's toolbar when you already reacted with it; tapping takes your reaction off. {reaction} is the emoji (or word).
#: client/components/MessageActions.vue
msgctxt "message.quickRemove"
msgid "Remove {reaction}"
msgstr "إزالة {reaction}"

#. Tooltip and aria-label of the smiley button in a chat message's hover toolbar; clicking opens the emoji picker to add a reaction to that message.
#: client/components/MessageActions.vue:21
msgctxt "message.react"
msgid "React"
msgstr "تفاعل"

#. Tooltip on the revealed text of a deleted chat message; clicking hides the text again.
#: client/components/Message.vue:72
msgctxt "message.redactedHide"
msgid "Click to hide again"
msgstr "انقر للإخفاء مجددًا"

#. aria-label of the placeholder button that replaces a deleted chat message; clicking shows the deleted text.
#: client/components/Message.vue:65
msgctxt "message.redactedReveal"
msgid "Deleted message, click to reveal"
msgstr "رسالة محذوفة، انقر للإظهار"

#. Tooltip and aria-label of the reply button in a chat message's hover toolbar; clicking starts a reply quoting that message.
#: client/components/MessageActions.vue:11
msgctxt "message.reply"
msgid "Reply"
msgstr "الرد"

#. Accessible name of a reply's quote when the original message is not loaded: activating it goes to that message.
#: client/components/Message.vue:294
#: client/components/Message.vue
#, fuzzy
msgctxt "message.replyMissing"
msgid "Replying to a message that is not loaded. Jump to it."
msgstr "الرد على رسالة لم تُحمَّل"

#. Visible text of the quoted-message button on a chat message when the message being replied to is not in the loaded scrollback; it stands in for the quoted text. Parenthesized.
#: client/components/Message.vue:53
msgctxt "message.replyUnknown"
msgid "(unknown message)"
msgstr "(رسالة غير معروفة)"

#. aria-label of the small quoted-message button on a chat message that is a reply; clicking scrolls to the message being replied to. {nick} is the name of the user who wrote the quoted message, {text} its content as plain text.
#: client/components/Message.vue:291
msgctxt "message.replyingTo"
msgid "Replying to {nick}: {text}. Jump to that message."
msgstr "الرد على {nick}: {text}. الانتقال إلى تلك الرسالة."

#. Tooltip of the small marker on a chat message that arrived while you had another channel open; the server delivered it to the active window only.
#: client/components/Message.vue:118
msgctxt "message.shownInActive"
msgid "This message was shown in your active channel"
msgstr "ظهرت هذه الرسالة في قناتك النشطة"

#. Tooltip of the small mode-prefix marker (a character such as + or @) shown before messages that the server delivered only to the part of the channel holding that status. {mode} is the mode character itself, inserted verbatim.
#: client/components/StatusmsgMarker.vue:4
msgctxt "message.statusmsg"
msgid "This message was only shown to users with {mode} mode"
msgstr "ظهرت هذه الرسالة فقط للمستخدمين ذوي الوضع {mode}"

#. Tooltip of the 'CTCP' abbreviation inside the CTCP-request system message; the abbreviation itself is the protocol's name and stays verbatim.
#: client/components/MessageTypes/ctcp_request.vue
msgctxt "msg.ctcpTitle"
msgid "Client-to-client protocol"
msgstr "بروتوكول العميل إلى العميل"

#. System message announcing a channel's modes (324). {modes} is the mode string (e.g. +nt), shown in bold; protocol text, kept verbatim.
#: client/components/MessageTypes/mode_channel.vue
msgctxt "msg.modeChannelIs"
msgid "Channel mode is {modes}"
msgstr "وضع القناة هو {modes}"

#. System message announcing the reader's own user modes (221). {modes} is the mode string (e.g. +iwx), shown in bold; protocol text, kept verbatim.
#: client/components/MessageTypes/mode_user.vue
msgctxt "msg.modeUserIs"
msgid "Your user mode is {modes}"
msgstr "وضع المستخدم الخاص بك هو {modes}"

#. Lobby error when the server refused a nick as taken (433) and gave no reason of its own; shown as '<nick>: <reason>'. Lowercase mid-sentence by position.
#: client/js/irc/handlers/numerics.ts
msgctxt "msg.nickInUse"
msgid "Nickname is already in use."
msgstr "الاسم المستعار مستخدم بالفعل."

#. Lobby error when the server refused a nick as malformed (432) and gave no reason of its own; shown as '<nick>: <reason>'. Lowercase mid-sentence by position.
#: client/js/irc/handlers/numerics.ts
msgctxt "msg.nickInvalid"
msgid "Nickname is invalid."
msgstr "الاسم المستعار غير صالح."

#. Lobby error when a whois/whowas named a nick the server does not know; {nick} is the nick as typed, user input.
#: client/js/irc/handlers/whois.ts
msgctxt "msg.noSuchNick"
msgid "No such nick: {nick}"
msgstr "لا يوجد اسم مستعار كهذا: {nick}"

#. Line in a conversation when someone deletes (redacts) a message that this device never loaded, so there is nothing to hide. {nick} is the user who deleted it, verbatim.
#: client/js/irc/handlers/redact.ts
msgctxt "msg.redactedUnloaded"
msgid "{nick} deleted a message"
msgstr ""

#. Line in a conversation when someone deletes (redacts) a message that this device never loaded, with the reason they gave. {nick} is the user who deleted it and {reason} their reason, both verbatim — never translate their content.
#: client/js/irc/handlers/redact.ts
msgctxt "msg.redactedUnloadedReason"
msgid "{nick} deleted a message ({reason})"
msgstr ""

#. Line in the server window after the server reports the IRC operator's server notice mask (snomask): {value} is the number, {hex} the same in hexadecimal. 'snomask' jargon.
#: client/js/irc/handlers/numerics.ts
msgctxt "msg.snomask"
msgid "Server notice mask: {value} (0x{hex})"
msgstr "قناع إشعارات الخادم: {value} (0x{hex})"

