#. Label of the services account password field on the network edit form, shown when SASL is on.
#: client/components/NetworkForm.vue:183
msgctxt "form.password"
msgid "Password"
msgstr "كلمة المرور"

#. Placeholder of the SASL password field on the network edit form: saving without typing keeps the stored password.
#: client/components/NetworkForm.vue:196
msgctxt "form.passwordPlaceholder"
msgid "Leave empty to keep the current password"
msgstr "اتركه فارغًا للاحتفاظ بكلمة المرور الحالية"

#. Label of the network form's presence mode select (Same as global, Online, Auto, Away, Do not disturb).
#: client/components/NetworkForm.vue
msgctxt "form.presence"
msgid "Presence"
msgstr "الحضور"

#. Hint under the network form's presence select: what the chosen mode means. Auto: away while the app is not being looked at.
#: client/components/NetworkForm.vue
msgctxt "form.presenceHintAuto"
msgid "Away when you're not looking."
msgstr "غائب حين لا تنظر."

#. Hint under the network form's presence select: what the chosen mode means. Away.
#: client/components/NetworkForm.vue
msgctxt "form.presenceHintAway"
msgid "Always away."
msgstr "غائب دائمًا."

#. Hint under the network form's presence select: what the chosen mode means. Do not disturb: away, and no notifications or sounds.
#: client/components/NetworkForm.vue
msgctxt "form.presenceHintDnd"
msgid "Away and silenced."
msgstr "غائب ومكتوم."

#. Hint under the network form's presence select: what the chosen mode means. Same as global, while the global mode (the pill under the logo) is Auto.
#: client/components/NetworkForm.vue
msgctxt "form.presenceHintGlobalAuto"
msgid "Follows the global mode under the logo, now Auto."
msgstr "يتبع الوضع العام أسفل الشعار، وهو الآن «تلقائي»."

#. Hint under the network form's presence select: what the chosen mode means. Same as global, while the global mode (the pill under the logo) is Away.
#: client/components/NetworkForm.vue
msgctxt "form.presenceHintGlobalAway"
msgid "Follows the global mode under the logo, now Away."
msgstr "يتبع الوضع العام أسفل الشعار، وهو الآن «غائب»."

#. Hint under the network form's presence select: what the chosen mode means. Same as global, while the global mode (the pill under the logo) is Online.
#: client/components/NetworkForm.vue
msgctxt "form.presenceHintGlobalOnline"
msgid "Follows the global mode under the logo, now Online."
msgstr "يتبع الوضع العام أسفل الشعار، وهو الآن «متصل»."

#. Hint under the network form's presence select: what the chosen mode means. Online.
#: client/components/NetworkForm.vue
msgctxt "form.presenceHintOnline"
msgid "Never away."
msgstr "لا يغيب أبدًا."

#. Tooltip of the question-mark icon next to the push notifications checkbox on the network edit form.
#: client/components/NetworkForm.vue:225
msgctxt "form.pushHelp"
msgid "Register this device for push notifications on this network. The server must support the draft/webpush capability. Push needs authentication, so this only appears with SASL configured. Each network is set up independently."
msgstr "سجّل هذا الجهاز لتلقي الإشعارات الفورية على هذه الشبكة. يجب أن يدعم الخادم قدرة draft/webpush. تتطلب الإشعارات الفورية مصادقة، لذا لا يظهر هذا الخيار إلا مع إعداد SASL. تُضبط كل شبكة على حدة."

#. Checkbox on the network edit form: register this device for this network's push notifications.
#: client/components/NetworkForm.vue:222
msgctxt "form.pushNotifications"
msgid "Push notifications for this network"
msgstr "الإشعارات الفورية لهذه الشبكة"

#. Button on the network edit form next to the stale-push warning: re-subscribes this device for the network.
#: client/components/NetworkForm.vue:244
msgctxt "form.pushRenew"
msgid "Renew push notifications"
msgstr "تجديد الإشعارات الفورية"

#. Warning on the network edit form when the server announced a new push key and this device's subscription must be renewed.
#: client/components/NetworkForm.vue:240
msgctxt "form.pushStaleHint"
msgid "This server's push identity (its key) changed, so this device's push subscription for it no longer works."
msgstr "تغيّرت هوية الإشعارات الفورية لهذا الخادم (مفتاحه)، لذلك لم يعد اشتراك هذا الجهاز فيها يعمل."

#. Checkbox on the network edit form: keep this network's SASL password in the browser's storage.
#: client/components/NetworkForm.vue:209
msgctxt "form.rememberPassword"
msgid "Remember password on this device"
msgstr "تذكر كلمة المرور على هذا الجهاز"

#. Radio option on the network edit form: authenticate with an account name and password (SASL PLAIN).
#: client/components/NetworkForm.vue:162
msgctxt "form.saslPlain"
msgid "Username + password (SASL PLAIN)"
msgstr "اسم المستخدم + كلمة المرور (SASL PLAIN)"

#. Submit button of the network edit form.
