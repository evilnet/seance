msgid "Automatic (recommended)"
msgstr ""

#. Hint under Automatic in the model-preference choice (Settings → Translation → Advanced).
#: client/components/Settings/TranslationOptions.vue
msgctxt "translate.prefer.autoHint"
msgid "Each language gets the smallest download that translates it well."
