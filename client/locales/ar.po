#. Button after 'Needs a {size} download' under a line in a channel: downloads the translation model and translates the line.
#: client/components/TranslationLine.vue
msgctxt "translate.line.download"
msgid "Download"
msgstr ""

#. Shown under a line in a channel whose translation needs a model that is not on this device yet, in place of a failure, followed by a Download button. The app did not download it by itself because it is large. {size} is its download size with its unit, e.g. '620 MiB'.
#: client/components/TranslationLine.vue
msgctxt "translate.line.needsDownload"
msgid "Needs a {size} download"
msgstr ""

#. Note shown in the composer's translation strip or under a message while the model it needs is being fetched for the first time. {model} is the model's name, {percent} a number from 0 to 100.
