#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeAdmin"
msgid "admin"
msgstr "管理员"

#. Name of the IRC half-operator role (the % prefix), filling {name} in the mode menu items. Lowercase mid-sentence; keep the hyphen if natural.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeHalfOp"
msgid "half-op"
msgstr "半操作员"

