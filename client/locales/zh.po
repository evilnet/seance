#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.expandNetwork"
msgid "Expand current network."
msgstr "展开当前网络。"

#. Description of the Alt+A keyboard shortcut in the help window; it jumps to the earliest conversation with unread messages.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.firstUnread"
msgid "Switch to the first window with unread messages."
msgstr "切换到第一个有未读消息的窗口。"

#. Heading of the keyboard shortcuts section of the help window; each row shows the key combination and what it does.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.heading"
msgid "Keyboard Shortcuts"
msgstr "键盘快捷键"

