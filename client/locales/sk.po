#. Body of the masked-link dialog. {shown} is the address the link's text displays and {host} the host name of the site the link really goes to — both verbatim user content, never translated.
#: client/js/helpers/openLink.ts:24
msgctxt "link.checkText"
msgid "The link text shows {shown}, but it goes to {host}."
msgstr "Text odkazu ukazuje {shown}, ale vedie na {host}."

#. Title of the dialog shown when the user clicks a link whose text names a different web address than the one it opens (a masked link).
#: client/js/helpers/openLink.ts:23
msgctxt "link.checkTitle"
