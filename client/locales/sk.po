msgid ""
msgstr ""
"Language: sk\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=((n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2);\n"

#. Tooltip and aria-label of the ✕ button on a private-conversation or list-window row in the sidebar network list; clicking closes that window (nothing is left on the server).
#: client/components/Channel.vue
msgctxt "channel.close"
msgid "Close"
msgstr "Zavrieť"

#. Tooltip and aria-label of the ✕ button on a channel row in the sidebar network list; clicking leaves the channel on the server and closes its window.
#: client/components/Channel.vue
msgctxt "channel.leave"
msgid "Leave"
msgstr "Opustiť"

#. Tooltip and aria-label of the small icon on a channel row in the sidebar network list while the client is not in that channel (it was left or the join failed); the row's history is still readable.
#: client/components/Channel.vue
msgctxt "channel.partedAria"
msgid "Not currently joined"
msgstr "Momentálne nie ste v kanáli"

#. aria-label of a row in the sidebar's network list. {type} is the kind of window (see the channel.type.* keys); {name} is the channel name or nickname.
#: client/components/ChannelWrapper.vue
msgctxt "channel.rowLabel"
msgid "{type}: {name}"
msgstr "{type}: {name}"

#. aria-label of a row in the sidebar's network list that has unread messages or mentions. {type} is the kind of window (see the channel.type.* keys), {name} is the channel name or nickname, {extra} is a count phrase such as '3 mentions'.
#: client/components/ChannelWrapper.vue
msgctxt "channel.rowLabelCount"
msgid "{type}: {name} ({extra})"
msgstr "{type}: {name} ({extra})"

#. Names the kind of window in a sidebar row's aria-label: a chat channel. Substituted as {type} in channel.rowLabel.
#: client/components/ChannelWrapper.vue
msgctxt "channel.type.channel"
msgid "Channel"
msgstr "Kanál"

#. Names the kind of window in a sidebar row's aria-label: the chat network's own window. Substituted as {type} in channel.rowLabel.
#: client/components/ChannelWrapper.vue
msgctxt "channel.type.lobby"
msgid "Network"
msgstr "Sieť"

#. Names the kind of window in a sidebar row's aria-label: a private conversation with one person. Substituted as {type} in channel.rowLabel.
#: client/components/ChannelWrapper.vue
msgctxt "channel.type.query"
msgid "Conversation"
msgstr "Konverzácia"

#. Names the kind of window in a sidebar row's aria-label: a results window such as a channel list or a ban list. Substituted as {type} in channel.rowLabel.
#: client/components/ChannelWrapper.vue
msgctxt "channel.type.special"
msgid "List"
msgstr "Zoznam"

#. Tooltip and aria-label of the spinner in a chat window's header while the connection is being established, when the network's display name is not known.
#: client/components/Chat.vue:186
msgctxt "chat.connecting"
msgid "Connecting…"
msgstr "Pripájanie…"

#. Tooltip and aria-label of the spinner in a chat window's header while that network's connection is being established. {network} is the display name of the chat network.
#: client/components/Chat.vue:186
msgctxt "chat.connectingTo"
msgid "Connecting to {network}…"
msgstr "Pripájanie k {network}…"

#. aria-label of the ☰ button in a chat window's header; clicking opens the menu of actions for the current conversation.
#: client/components/Chat.vue:72
msgctxt "chat.contextMenu"
msgid "Open the context menu"
msgstr "Otvoriť kontextovú ponuku"

#. aria-label of the conversation's name in the header of an open chat window (the visible text is the channel or conversation name itself). {type} is the kind of conversation, inserted as an English word by the app: 'channel' (a group chat), 'query' (a private one-on-one chat), 'lobby' (the network's home view) or 'special' (a list window such as the ban list).
#: client/components/Chat.vue:22
msgctxt "chat.currentlyOpen"
msgid "Currently open {type}"
msgstr "Práve otvorené: {type}"

#. Text of the 'load older messages' button at the top of the scrollback while earlier history is being fetched.
#: client/components/MessageList.vue:10
msgctxt "chat.historyLoading"
msgid "Loading…"
msgstr "Načítavam…"

#. aria-label of the downward-arrow button that appears above the message input when the scrollback is scrolled up; clicking scrolls down to the newest messages.
#: client/components/Chat.vue:106
msgctxt "chat.jumpToRecent"
msgid "Jump to recent messages"
msgstr "Prejsť na najnovšie správy"

#. aria-label of the @ button in a chat window's header; clicking opens the popup listing messages that mention you.
#: client/components/Chat.vue:67
msgctxt "chat.mentions"
msgid "Open your mentions"
msgstr "Otvoriť zmienky"

#. Badge on the @ button in the channel header when there are more unread mentions than it shows; {count} is the largest number shown (99), so it reads "99+".
#: client/components/Chat.vue:384
msgctxt "chat.mentionsBadgeOver"
msgid "{count}+"
msgstr ""

#. Accessible name of the @ button in the channel header while there are unread mentions; it opens the mentions popup. {count} is the number of unread mentions. The singular form shows for one, the plural for any other number.
#: client/components/Chat.vue:389
msgctxt "chat.mentionsUnread"
msgid "Open your mentions, {count} unread"
msgid_plural "Open your mentions, {count} unread"
msgstr[0] "Otvoriť zmienky, neprečítané: {count}"
msgstr[1] "Otvoriť zmienky, neprečítané: {count}"
msgstr[2] "Otvoriť zmienky, neprečítané: {count}"

#. aria-label of the save control at the right end of the topic editor, shown while the channel topic is being edited; clicking saves the new topic.
#: client/components/Chat.vue:35
msgctxt "chat.saveTopic"
msgid "Save topic"
msgstr "Uložiť tému"

#. Text of the button at the top of the scrollback that fetches and shows earlier history of the conversation.
#: client/components/MessageList.vue:11
msgctxt "chat.showOlder"
msgid "Show older messages"
msgstr "Zobraziť staršie správy"

#. Tooltip and aria-label of the button in a chat window's header that shows and hides the panel listing the channel's members.
#: client/components/Chat.vue:78
msgctxt "chat.toggleUserlist"
msgid "Toggle user list"
msgstr "Zobraziť alebo skryť zoznam používateľov"

#. Placeholder of the input field shown while the channel topic is being edited (double-click the topic line to open it); Enter saves.
#: client/components/Chat.vue:30
msgctxt "chat.topicPlaceholder"
msgid "Set channel topic"
msgstr "Nastaviť tému kanálu"

#. Label drawn on the divider line in a conversation above the first unread message. Short.
#: client/components/MessageList.vue
msgctxt "chat.unreadMarker"
msgid "New messages"
msgstr "Nové správy"

#. Confirmation after /alias <name> <commands> created a new alias. {name} is the alias name as typed, verbatim.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.added"
msgid "Alias /{name} added."
msgstr "Alias /{name} bol pridaný."

#. Error when an /alias name is invalid. {max} is the length limit, a number.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.badName"
msgid "Alias names are letters, digits, _ and - (up to {max} characters)."
msgstr "Názvy aliasov môžu obsahovať písmená, číslice, _ a - (najviac {max} znakov)."

#. Reply to /alias <name> when that alias does not exist. {name} is the name as typed, user input, verbatim; the second '/alias …' part is command syntax.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.missing"
msgid "No alias /{name}. /alias {name} <commands> creates it."
msgstr "Alias /{name} neexistuje. Vytvoríte ho príkazom /alias {name} <príkazy>."

#. Reply to a bare /alias when none are defined; the '/alias <name> <commands>' part is command syntax and stays verbatim.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.none"
msgid "No aliases defined. /alias <name> <commands> creates one."
msgstr "Nie sú definované žiadne aliasy. Vytvoríte ho príkazom /alias <názov> <príkazy>."

#. Error when an /alias body exceeds the size limit. {length} and {max} are byte counts.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.tooLong"
msgid "That alias is too long ({length} of at most {max} characters)."
msgstr "Tento alias je príliš dlhý ({length} z najviac {max} znakov)."

#. Error when a new alias would exceed the count limit. {max} is the limit, a number; 'Settings → Aliases' names the settings tab where aliases are edited.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.tooMany"
msgid "You already have {max} aliases; delete one in Settings → Aliases first."
msgstr "Už máte {max} aliasov; najprv jeden odstráňte v Nastavenia → Aliasy."

#. Confirmation after /alias <name> <commands> overwrote an existing alias. {name} is the alias name as typed, verbatim.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.updated"
msgid "Alias /{name} updated."
msgstr "Alias /{name} bol aktualizovaný."

#. Error when /connect is typed for a network that is already up.
#: client/js/irc/commands/connect.ts
msgctxt "cmd.alreadyConnected"
msgid "You are already connected."
msgstr "Už ste pripojený."

#. Error when a command that needs a conversation is typed in a network's lobby. {cmd} is the command as typed, user input, verbatim.
#: client/js/irc/commands/me.ts
#: client/js/irc/commands/react.ts
msgctxt "cmd.channelsAndQueriesOnly"
msgid "{cmd} command can only be used in channels and queries."
msgstr "Príkaz {cmd} sa dá použiť len v kanáloch a konverzáciách."

#. Error when a channel-only command is typed in another window. {cmd} is the command as typed (its canonical lowercase name, e.g. 'ban', 'kickban', 'op'), user input, verbatim.
#: client/js/irc/commands/ban.ts
#: client/js/irc/commands/kick.ts
#: client/js/irc/commands/mode.ts
#: client/js/irc/commands/topic.ts
#: client/js/irc/commands/invite.ts
msgctxt "cmd.channelsOnly"
msgid "{cmd} command can only be used in channels."
msgstr "Príkaz {cmd} sa dá použiť len v kanáloch."

#. Error when /invite is typed outside a channel without naming one. {cmd} is the command as typed, user input, verbatim.
#: client/js/irc/commands/invite.ts
msgctxt "cmd.channelsOrTargetOnly"
msgid "{cmd} command can only be used in channels or by specifying a target."
msgstr "Príkaz {cmd} sa dá použiť len v kanáloch alebo so zadaným cieľom."

#. Confirmation after /ignore. {mask} is the hostmask, user data, wrapped in bold formatting codes, verbatim.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.ignore.added"
msgid "{mask} added to ignorelist"
msgstr "{mask} bol pridaný do zoznamu ignorovaných"

#. Error when /ignore names a hostmask that is already on the ignore list.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.ignore.already"
msgid "The specified user/hostmask is already ignored"
msgstr "Tento používateľ/hostmask je už ignorovaný"

#. Error when /unignore names a hostmask that is not on the ignore list.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.ignore.notIgnored"
msgid "The specified user/hostmask is not ignored"
msgstr "Tento používateľ/hostmask nie je ignorovaný"

#. Confirmation after /unignore. {mask} is the hostmask, user data, wrapped in bold formatting codes, verbatim.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.ignore.removed"
msgid "Successfully removed {mask} from ignorelist"
msgstr "{mask} bol úspešne odstránený zo zoznamu ignorovaných"

#. Error when /ignore names the user's own nick.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.ignore.self"
msgid "You can't ignore yourself"
msgstr "Nemôžete ignorovať sami seba"

#. Error shown instead of the ignore-list window when nothing is ignored.
#: client/js/irc/commands/ignorelist.ts
msgctxt "cmd.ignorelistEmpty"
msgid "Ignorelist is empty"
msgstr "Zoznam ignorovaných je prázdny"

#. Title of the special window showing the network's ignore list, opened by /ignorelist. The name doubles as the window's lookup name, so it stays byte-stable per locale while the session lives.
#: client/js/irc/commands/ignorelist.ts
msgctxt "cmd.ignorelistTitle"
msgid "Ignored users"
msgstr "Ignorovaní používatelia"

#. Error when a plain message is typed in a network's lobby instead of a channel or query; the lobby's input is for commands.
#: client/js/irc/commands/index.ts
msgctxt "cmd.lobbySend"
msgid "Messages can not be sent to lobbies."
msgstr "Do lobby nemožno posielať správy."

#. Error when /mute or /unmute names several channels or users with no open window. {targets} is the comma-joined list of names as typed, user input, verbatim. Plural for more than one name.
#: client/js/irc/commands/mute.ts
msgctxt "cmd.mute.nonePlural"
msgid "No open channels or users found for {targets}"
msgstr "Pre {targets} sa nenašli žiadne otvorené kanály ani používatelia"

#. Error when /mute or /unmute names a channel or user that has no open window. {targets} is the comma-joined list of names as typed, user input, verbatim. Singular for one name.
#: client/js/irc/commands/mute.ts
msgctxt "cmd.mute.noneSingular"
msgid "No open channel or user found for {targets}"
msgstr "Pre {targets} sa nenašiel žiadny otvorený kanál ani používateľ"

#. Error when /nick is given a new nick containing spaces.
#: client/js/irc/commands/nick.ts
msgctxt "cmd.nickSpaces"
msgid "Nicknames may not contain spaces."
msgstr "Prezývky nesmú obsahovať medzery."

#. Error when /nick is given a new nick that exceeds the server's reported length limit.
#: client/js/irc/commands/nick.ts
msgctxt "cmd.nickTooLong"
msgid "Nicknames may not be this long."
msgstr "Prezývky nesmú byť také dlhé."

#. Error when /part is typed in a network's lobby; the '/quit' part is a command name, verbatim.
#: client/js/irc/commands/part.ts
msgctxt "cmd.partLobby"
msgid "You can not part from networks, use /quit instead."
msgstr "Zo siete nemožno odísť príkazom part, použite namiesto toho /quit."

#. Error when /query is given a channel name; the '/join' part is a command name, verbatim.
#: client/js/irc/commands/msg.ts
msgctxt "cmd.query.channel"
msgid "You can not open query windows for channels, use /join instead."
msgstr "Pre kanály nemožno otvoriť okno konverzácie, použite namiesto toho /join."

#. Error when /query is typed with no nick.
#: client/js/irc/commands/msg.ts
msgctxt "cmd.query.noArg"
msgid "You cannot open a query window without an argument."
msgstr "Okno konverzácie nemožno otvoriť bez argumentu."

#. Error when /query is given a name starting with a channel membership prefix (~&@%+); a prefixed nick needs the prefix dropped.
#: client/js/irc/commands/msg.ts
msgctxt "cmd.query.prefix"
msgid "You can not open query windows for names starting with a user prefix."
msgstr "Okno konverzácie nemožno otvoriť pre mená začínajúce predponou používateľa."

#. Error when /query is given a name with spaces; nicks cannot contain them.
#: client/js/irc/commands/msg.ts
msgctxt "cmd.query.spaces"
msgid "You can not open query windows for names containing spaces."
msgstr "Okno konverzácie nemožno otvoriť pre mená obsahujúce medzery."

#. Error when /react is typed where no recent message can carry a reaction (e.g. a window without message-tags history).
#: client/js/irc/commands/react.ts
msgctxt "cmd.reactNoTarget"
msgid "No message to react to: none here carries a msgid."
msgstr "Nie je na čo reagovať: žiadna správa tu nemá msgid."

#. Error when /rejoin is typed outside a channel window.
#: client/js/irc/commands/rejoin.ts
msgctxt "cmd.rejoinChannels"
msgid "You can only rejoin channels."
msgstr "Znova sa dá vstúpiť len do kanálov."

#. Usage line of /ctcp when arguments are missing; the placeholders are command syntax.
#: client/js/irc/commands/ctcp.ts
msgctxt "cmd.usageCtcp"
msgid "Usage: /ctcp <nick> <ctcp_type>"
msgstr "Použitie: /ctcp <nick> <ctcp_type>"

#. Usage line of /ignore and /unignore when no target is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.usageIgnore"
msgid "Usage: /{cmd} <nick>[!ident][@host]"
msgstr "Použitie: /{cmd} <nick>[!ident][@host]"

#. Usage line of /join when no channel is given; the placeholders are command syntax.
#: client/js/irc/commands/join.ts
msgctxt "cmd.usageJoin"
msgid "Usage: /join <channel> [key]"
msgstr "Použitie: /join <kanál> [kľúč]"

#. Usage line of the mode-list commands (/ban, /unban, …) when no nick is given. {cmd} is the command as typed, user input, verbatim; the '<nick>' placeholder is command syntax, not user data.
#: client/js/irc/commands/ban.ts
msgctxt "cmd.usageNick"
msgid "Usage: /{cmd} <nick>"
msgstr "Použitie: /{cmd} <nick>"

#. Usage line of /nick when no new nick is given; the placeholder is command syntax.
#: client/js/irc/commands/nick.ts
msgctxt "cmd.usageNickChange"
msgid "Usage: /nick <your new nick>"
msgstr "Použitie: /nick <vaša nová prezývka>"

#. Usage line of /op, /deop, /voice, /devoice when no nick is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
#: client/js/irc/commands/mode.ts
msgctxt "cmd.usageNickMulti"
msgid "Usage: /{cmd} <nick> [...nick]"
msgstr "Použitie: /{cmd} <nick> [...nick]"

#. Usage line of /react when no reaction text is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
#: client/js/irc/commands/react.ts
msgctxt "cmd.usageReact"
msgid "Usage: /{cmd} <text> [msgid]"
msgstr "Použitie: /{cmd} <text> [msgid]"

#. Usage line of /redact when no msgid is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
#: client/js/irc/commands/redact.ts
msgctxt "cmd.usageRedact"
msgid "Usage: /{cmd} <msgid> [reason]"
msgstr "Použitie: /{cmd} <msgid> [dôvod]"

#. Usage line of /ver (a CTCP VERSION request) when it is not given exactly one nick; the rest is command syntax.
#: client/js/irc/commands/ctcp.ts
msgctxt "cmd.usageVer"
msgid "Usage: /ver <nick>"
msgstr "Použitie: /ver <nick>"

#. Error shown when /who is typed without a mask outside a channel. '/who [mask] [flags]' is command syntax: keep it as is.
#: client/js/irc/commands/who.ts
msgctxt "cmd.usageWho"
msgid "Usage: /who [mask] [flags] (the current channel when no mask is given)"
msgstr "Použitie: /who [mask] [flags] (bez masky aktuálny kanál)"

#. Button under a long code block in a chat message that shows only its first lines; clicking reveals every line. {count} is the number of lines of code. The singular shows with exactly one line, the plural otherwise.
#: client/components/CodeBlock.vue
msgctxt "code.showAllLines"
msgid "Show all {count} line"
msgid_plural "Show all {count} lines"
msgstr[0] "Zobraziť {count} riadok"
msgstr[1] "Zobraziť všetky {count} riadky"
msgstr[2] "Zobraziť všetkých {count} riadkov"

#. Button under a long code block in a chat message while all of its lines are shown; clicking folds the block back to its first lines.
#: client/components/CodeBlock.vue
msgctxt "code.showLess"
msgid "Show less"
msgstr "Zobraziť menej"

#. aria-label of the ✕ button that leaves reply or edit mode in the compose bar above the message input; the keyboard key Escape does the same.
#: client/components/ChatInput.vue:67
msgctxt "composer.cancel"
msgid "Cancel"
msgstr "Zrušiť"

#. Tooltip of the ✕ button that leaves reply or edit mode in the compose bar; it names the keyboard key that does the same thing.
#: client/components/ChatInput.vue:68
msgctxt "composer.cancelEscape"
msgid "Cancel (Escape)"
msgstr "Zrušiť (Esc)"

#. Tooltip and aria-label of the ✕ button on the upload progress bar above the message input; clicking it aborts the upload in progress.
#: client/components/ChatInput.vue:45
msgctxt "composer.cancelUpload"
msgid "Cancel upload"
msgstr "Zrušiť nahrávanie"

#. Button in the connection bar shown above the message input when the connection to the chat network is down and no automatic retry is in progress; clicking it dials the network again.
#: client/components/ChatInput.vue:19
msgctxt "composer.connect"
msgid "Connect"
msgstr "Pripojiť"

#. Button in the connection bar shown above the message input while the app waits to retry a dropped connection to the chat network; clicking it skips the wait and dials the network immediately.
#: client/components/ChatInput.vue:19
msgctxt "composer.connectNow"
msgid "Connect now"
msgstr "Pripojiť teraz"

#. Text of the connection bar shown above the message input while the dial to the chat network is in flight (a spinner turns beside it). {network} is the display name of the chat network.
#: client/components/ChatInput.vue:344
msgctxt "composer.connectingTo"
msgid "Connecting to {network}…"
msgstr "Pripájanie k {network}…"

#. Text of the connection bar shown above the message input when the chat network is down and no reconnect attempt is running yet. {network} is the display name of the chat network.
#: client/components/ChatInput.vue:339
msgctxt "composer.disconnectedFrom"
msgid "Disconnected from {network}."
msgstr "Odpojené od {network}."

#. Label at the left of the compose bar shown while the user edits a message they already sent; the edited text follows it in the same line.
#: client/components/ChatInput.vue:55
msgctxt "composer.editing"
msgid "Editing message"
msgstr "Úprava správy"

#. Fallback name for a chat network whose configured name is empty; it is inserted into connection-bar sentences such as 'Connecting to {network}…' in place of the network name. Mid-sentence by position.
#: client/components/ChatInput.vue:336
msgctxt "composer.fallbackNetwork"
msgid "the network"
msgstr "sieti"

#. Visually hidden label of the message input field, read by screen readers; the field is where chat messages are typed.
#: client/components/ChatInput.vue:75
msgctxt "composer.inputLabel"
msgid "Message input"
msgstr "Pole pre správu"

#. Tooltip on the send button while the chat network is disconnected, explaining why messages cannot be sent right now.
#: client/components/ChatInput.vue:115
msgctxt "composer.notConnected"
msgid "Not connected"
msgstr "Nepripojené"

#. Placeholder of the message input shown while it is empty. {name} is the name of the conversation being typed into: a channel's name, or the person's nick in a private one-on-one conversation.
#: client/components/ChatInput.vue:293
msgctxt "composer.placeholder"
msgid "Write to {name}"
msgstr "Napísať do {name}"

#. Text of the connection bar shown above the message input while the client waits to reconnect to a chat network it lost. {network} is the display name of the chat network; {seconds} is the whole number of seconds until the retry starts, updating every half second. The singular form shows when one second remains, the plural for any other number.
#: client/components/ChatInput.vue:343
msgctxt "composer.reconnectIn"
msgid "Reconnecting to {network} in {seconds}s…"
msgid_plural "Reconnecting to {network} in {seconds}s…"
msgstr[0] "Opätovné pripojenie k {network} o {seconds} s…"
msgstr[1] "Opätovné pripojenie k {network} o {seconds} s…"
msgstr[2] "Opätovné pripojenie k {network} o {seconds} s…"

#. Text of the connection bar shown above the message input while the wait before the retry is the chat server's connection throttle (dialling sooner would be refused and prolong it). {network} is the display name of the chat network; {seconds} is the whole number of seconds until the retry starts, updating every half second. The singular form shows when one second remains, the plural for any other number.
#: client/components/ChatInput.vue:524
msgctxt "composer.reconnectInThrottled"
msgid "Reconnecting to {network} in {seconds}s: the server limits quick reconnects."
msgid_plural "Reconnecting to {network} in {seconds}s: the server limits quick reconnects."
msgstr[0] "Opätovné pripojenie k {network} o {seconds} s: server obmedzuje rýchle opätovné pripojenia."
msgstr[1] "Opätovné pripojenie k {network} o {seconds} s: server obmedzuje rýchle opätovné pripojenia."
msgstr[2] "Opätovné pripojenie k {network} o {seconds} s: server obmedzuje rýchle opätovné pripojenia."

#. Label at the left of the compose bar shown while a reply is being written. {nick} is the name of the user being replied to, shown emphasized; the quoted message preview follows it. Keep the trailing colon.
#: client/components/ChatInput.vue:60
msgctxt "composer.replyingTo"
msgid "Replying to {nick}:"
msgstr "Odpoveď pre {nick}:"

#. Tooltip and aria-label of the send button beside the message input.
#: client/components/ChatInput.vue:123
msgctxt "composer.send"
msgid "Send message"
msgstr "Odoslať správu"

#. Tooltip and aria-label of the paperclip button beside the message input; clicking it opens the file picker to send a file into the conversation.
#: client/components/ChatInput.vue:93
msgctxt "composer.uploadFile"
msgid "Upload file"
msgstr "Nahrať súbor"

#. Part of the upload progress bar, appended after the uploading text when several files are queued: it says which file of how many is being sent now. {index} is the number of the current file, {count} the total number queued.
#: client/components/ChatInput.vue:580
msgctxt "composer.uploadIndex"
msgid "{index} of {count}"
msgstr "{index} z {count}"

#. Part of the upload progress bar, appended after the uploading text while the file is being prepared (re-encoded or stripped of metadata) before it is sent. Starts lowercase because it is joined with the other parts into one line.
#: client/components/ChatInput.vue:584
msgctxt "composer.uploadPreparing"
msgid "preparing…"
msgstr "pripravujem…"

