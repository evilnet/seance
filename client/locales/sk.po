#: client/js/helpers/contextMenu.ts
msgctxt "menu.giveMode"
msgid "Give {name} (+{mode})"
msgstr "Udeliť: {name} (+{mode})"

#. Context-menu item that grants an IRC mode whose role name is unknown; {mode} is the bare mode letter (e.g. z) — the + before it is part of the text, so the item reads Mode +z.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.giveModeUnknown"
msgid "Mode +{mode}"
msgstr "Režim +{mode}"

