#. Item of a network's context menu, shown while the user is an IRC operator: opens the oper panel. 'Oper' is IRC jargon (operator).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.operPanel"
msgid "Oper panel…"
msgstr "Panel operátora…"

#. Context-menu item that takes an IRC channel role away from a user; {name} is the role's name ('operator'), {mode} the bare mode letter (e.g. o) — the - before it is part of the text, so the item reads (-o).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.revokeMode"
msgid "Revoke {name} (-{mode})"
msgstr "Odobrať: {name} (-{mode})"

#. Context-menu item that removes an IRC mode whose role name is unknown; {mode} is the bare mode letter (e.g. z) — the - before it is part of the text, so the item reads Mode -z.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.revokeModeUnknown"
msgid "Mode -{mode}"
msgstr "Režim -{mode}"

