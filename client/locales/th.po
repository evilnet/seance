msgctxt "help.title"
msgid "Help"
msgstr "ความช่วยเหลือ"

#. Text of the banner at the top of the help window shown when a newer build of the app was published; a Reload button follows it.
#: client/components/Windows/Help.vue
msgctxt "help.updateAvailable"
msgid "New version available"
msgstr "มีเวอร์ชันใหม่"

#. Label of the network's website link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.website"
msgid "Website"
msgstr "เว็บไซต์"

#. aria-label of the ✕ control of the image viewer that fills the screen; clicking closes it.
#: client/components/ImageViewer.vue
msgctxt "image.close"
msgid "Close"
msgstr "ปิด"

#. aria-label of the forward arrow of the image viewer; clicking shows the next image from the conversation.
