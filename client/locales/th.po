msgctxt "help.commands.collapse"
msgid "Collapse all previews in the current channel (opposite of {command})"
msgstr "ยุบตัวอย่างทั้งหมดในช่องปัจจุบัน (ตรงข้ามกับ {command})"

#. Description of the /connect command in the help window. {port} is the command's port parameter (the word 'port' as a code element) and {plus} the plus sign '+' as a code element; TLS stays verbatim.
#: client/components/Windows/Help.vue
msgctxt "help.commands.connect"
msgid "Connect to a new IRC network. If {port} starts with a {plus} sign, the connection will be made secure using TLS."
msgstr "เชื่อมต่อกับเครือข่าย IRC ใหม่ หาก {port} ขึ้นต้นด้วยเครื่องหมาย {plus} การเชื่อมต่อจะปลอดภัยด้วย TLS"

#. Description of the /ctcp command in the help window. {ctcp} is the abbreviation CTCP (never translated, an element with its expansion as tooltip); {link} is a link whose text is help.commands.ctcpLink ('the dedicated Wikipedia article') — write this frame so that phrase fits where {link} stands.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ctcp"
msgid "Send a {ctcp} request. Read more about this on {link}."
msgstr "ส่งคำขอ {ctcp} อ่านเพิ่มเติมได้ที่ {link}"

#. Text of the link at the end of the /ctcp command description in the help window (help.commands.ctcp, where it stands for {link}); it opens the Wikipedia article on CTCP. Use the form that fits that frame in your language.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ctcpLink"
msgid "the dedicated Wikipedia article"
msgstr "บทความวิกิพีเดียที่เกี่ยวข้อง"

#. Expansion of the acronym CTCP, shown as the abbreviation's hover tooltip in the help window's /ctcp command description.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ctcpTitle"
msgid "Client-to-client protocol"
msgstr "โปรโตคอลไคลเอนต์ถึงไคลเอนต์"

#. Description of the /deop command in the help window. {mode} is the channel mode -o, rendered as a code element; 'op' is IRC channel-operator status (keep the catalog's usual term).
#: client/components/Windows/Help.vue
msgctxt "help.commands.deop"
msgid "Remove op ({mode}) from one or several users in the current channel."
msgstr "ถอนสิทธิ์ op ({mode}) จากผู้ใช้หนึ่งคนหรือมากกว่าในช่องปัจจุบัน"

#. Description of the /devoice command in the help window. {mode} is the channel mode -v, rendered as a code element; 'voice' is the IRC right to speak in a moderated channel.
#: client/components/Windows/Help.vue
msgctxt "help.commands.devoice"
msgid "Remove voice ({mode}) from one or several users in the current channel."
msgstr "ถอนสิทธิ์ voice ({mode}) จากผู้ใช้หนึ่งคนหรือมากกว่าในช่องปัจจุบัน"

#. Description of the /disconnect command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.disconnectLong"
msgid "Disconnect from the current network with an optionally-provided message."
msgstr "ตัดการเชื่อมต่อจากเครือข่ายปัจจุบัน โดยระบุข้อความได้ (ไม่บังคับ)"

#. Description of the /expand command in the help window. {command} is the /collapse command, shown as a code fragment and never translated.
#: client/components/Windows/Help.vue
msgctxt "help.commands.expand"
msgid "Expand all previews in the current channel (opposite of {command})"
msgstr "ขยายตัวอย่างทั้งหมดในช่องปัจจุบัน (ตรงข้ามกับ {command})"

#. Heading of the commands section of the help window; one row per slash command with its syntax and description.
#: client/components/Windows/Help.vue
msgctxt "help.commands.heading"
msgid "Commands"
msgstr "คำสั่ง"

#. Description of the /ignore command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ignore"
msgid "Block any messages from the specified user on the current network. This can be a nickname or a hostmask."
msgstr "บล็อกข้อความทั้งหมดจากผู้ใช้ที่ระบุในเครือข่ายปัจจุบัน ใช้นิคหรือ hostmask ก็ได้"

#. Description of the /ignorelist command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ignorelist"
msgid "Load the list of ignored users for the current network."
msgstr "โหลดรายการผู้ใช้ที่ถูกละเว้นในเครือข่ายปัจจุบัน"

#. Description of the /invite command in the help window. {channel} is the command's channel parameter (the word 'channel' as a code element).
#: client/components/Windows/Help.vue
msgctxt "help.commands.invite"
msgid "Invite a user to the specified channel. If {channel} is omitted, user will be invited to the current channel."
msgstr "เชิญผู้ใช้เข้าช่องที่ระบุ หากละ {channel} ไว้ จะเชิญเข้าช่องปัจจุบัน"

#. Description of the /join command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.join"
msgid "Join a channel. Password is only needed in protected channels and can usually be omitted."
msgstr "เข้าร่วมช่อง รหัสผ่านจำเป็นเฉพาะช่องที่มีการป้องกัน และโดยทั่วไปละไว้ได้"

#. Description of the /kick command in the help window; it removes the user from the channel (they may rejoin).
#: client/components/Windows/Help.vue
msgctxt "help.commands.kick"
msgid "Kick a user from the current channel."
msgstr "เตะผู้ใช้ออกจากช่องปัจจุบัน"

#. Description of the /kickban command in the help window. {mode} is the channel mode +b and {ban} the command /ban, each rendered as a code element.
#: client/components/Windows/Help.vue
msgctxt "help.commands.kickban"
msgid "Kick and ban ({mode}) a user from the current channel. Unlike {ban}, only nicknames (and not host masks) can be used."
msgstr "เตะและแบน ({mode}) ผู้ใช้จากช่องปัจจุบัน ต่างจาก {ban} ตรงที่ใช้ได้เฉพาะนิค (ใช้ hostmask ไม่ได้)"

#. Description of the /list command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.list"
msgid "Retrieve a list of available channels on this network."
msgstr "ดึงรายการช่องที่มีอยู่ในเครือข่ายนี้"

#. Description of the /me command in the help window. {appName} is the chat app's display name.
#: client/components/Windows/Help.vue
msgctxt "help.commands.me"
msgid "Send an action message to the current channel. {appName} will display it inline, as if the message was posted in the third person."
msgstr "ส่งข้อความการกระทำไปยังช่องปัจจุบัน {appName} จะแสดงในบรรทัดเหมือนข้อความที่เขียนด้วยบุรุษที่สาม"

#. Description of the /mode command in the help window; explains whose modes the flags apply to depending on the active window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.mode"
msgid "Set the given flags to the current channel if the active window is a channel, another user if the active window is a private message window, or yourself if the current window is a server window."
msgstr "ตั้งแฟล็กที่ระบุให้กับช่องปัจจุบันหากหน้าต่างที่ใช้งานเป็นช่อง ให้กับผู้ใช้อื่นหากหน้าต่างที่ใช้งานเป็นหน้าต่างข้อความส่วนตัว หรือให้กับตัวคุณเองหากหน้าต่างปัจจุบันเป็นหน้าต่างเซิร์ฟเวอร์"

#. Description of the /msg command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.msg"
msgid "Send a message to the specified channel."
msgstr "ส่งข้อความไปยังช่องที่ระบุ"

#. Description of the /mute command in the help window. {command} is the /unmute command, shown as a code fragment and never translated.
#: client/components/Windows/Help.vue
msgctxt "help.commands.mute"
msgid "Prevent messages from generating any feedback for a channel. This turns off the highlight indicator, hides mentions and inhibits push notifications. Muting a network lobby mutes the entire network. Not specifying any channel target mutes the current channel. Revert with {command}."
msgstr "ทำให้ข้อความในช่องไม่ก่อการแจ้งเตือนใด ๆ ทั้งสิ้น จะปิดตัวบ่งชี้การไฮไลต์ ซ่อนการกล่าวถึง และระงับการแจ้งเตือนแบบพุช การปิดเสียงล็อบบี้ของเครือข่ายจะปิดเสียงทั้งเครือข่าย หากไม่ระบุช่อง จะปิดเสียงช่องปัจจุบัน ยกเลิกได้ด้วย {command}"

#. Description of the /nick command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.nick"
msgid "Change your nickname on the current network."
msgstr "เปลี่ยนนิคของคุณบนเครือข่ายปัจจุบัน"

#. Description of the /notice command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.notice"
msgid "Sends a notice message to the specified channel."
msgstr "ส่งข้อความ notice ไปยังช่องที่ระบุ"

#. Description of the /op command in the help window. {mode} is the channel mode +o, rendered as a code element; 'op' is IRC channel-operator status (keep the catalog's usual term).
#: client/components/Windows/Help.vue
msgctxt "help.commands.op"
msgid "Give op ({mode}) to one or several users in the current channel."
msgstr "ให้สิทธิ์ op ({mode}) แก่ผู้ใช้หนึ่งคนหรือมากกว่าในช่องปัจจุบัน"

#. Description of the /part command in the help window. {channel} is the command's channel parameter (the word 'channel' as a code element).
#: client/components/Windows/Help.vue
msgctxt "help.commands.part"
msgid "Close the specified channel or private message window, or the current channel if {channel} is omitted."
msgstr "ปิดช่องหรือหน้าต่างข้อความส่วนตัวที่ระบุ หรือช่องปัจจุบันหากละ {channel} ไว้"

#. Description of the /query command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.query"
msgid "Send a private message to the specified user."
msgstr "ส่งข้อความส่วนตัวไปยังผู้ใช้ที่ระบุ"

#. Description of the /quit command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.quit"
msgid "Disconnect from the current network with an optional message."
msgstr "ตัดการเชื่อมต่อจากเครือข่ายปัจจุบัน โดยระบุข้อความได้ (ไม่บังคับ)"

#. Description of the /raw command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.raw"
msgid "Send a raw message to the current IRC network."
msgstr "ส่งข้อความดิบไปยังเครือข่าย IRC ปัจจุบัน"

#. Description of the /rejoin command in the help window; ChanServ (the IRC channel service) stays verbatim.
#: client/components/Windows/Help.vue
msgctxt "help.commands.rejoin"
msgid "Leave and immediately rejoin the current channel. Useful to quickly get op from ChanServ in an empty channel, for example."
msgstr "ออกจากช่องปัจจุบันแล้วเข้าร่วมใหม่ทันที มีประโยชน์ เช่น เพื่อรับ op จาก ChanServ อย่างรวดเร็วในช่องที่ว่าง"

#. Description of the /search command in the help window. No trailing period in the source; keep it as is.
#: client/components/Windows/Help.vue
msgctxt "help.commands.search"
msgid "Search for messages in the current channel / user"
msgstr "ค้นหาข้อความในช่อง/ผู้ใช้ปัจจุบัน"

#. Description of the /slap command in the help window; a playful IRC tradition. Keep the exclamation mark.
#: client/components/Windows/Help.vue
msgctxt "help.commands.slap"
msgid "Slap someone in the current channel with a trout!"
msgstr "ตบใครสักคนในช่องปัจจุบันด้วยปลาเทราต์!"

#. Description of the /topic command in the help window. {newtopic} is the command's parameter (the word 'newtopic' as a code element).
#: client/components/Windows/Help.vue
msgctxt "help.commands.topic"
msgid "Get the topic in the current channel. If {newtopic} is specified, sets the topic in the current channel."
msgstr "แสดงหัวข้อของช่องปัจจุบัน หากระบุ {newtopic} จะตั้งหัวข้อของช่องปัจจุบัน"

#. Description of the /unban command in the help window. {mode} is the channel mode -b, rendered as a code element; the parentheses are part of the copy.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unban"
msgid "Unban ({mode}) a user from the current channel. This can be a nickname or a hostmask."
msgstr "ยกเลิกการแบน ({mode}) ผู้ใช้ในช่องปัจจุบัน ใช้นิคหรือ hostmask ก็ได้"

#. Description of the /unignore command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unignore"
msgid "Unblock messages from the specified user on the current network. This can be a nickname or a hostmask."
msgstr "เลิกบล็อกข้อความจากผู้ใช้ที่ระบุในเครือข่ายปัจจุบัน ใช้นิคหรือ hostmask ก็ได้"

#. Description of the /unmute command in the help window. {mute} is the command /mute as a code element.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unmute"
msgid "Un-mutes the given channel(s) or the current channel if no channel is provided. See {mute} for more information."
msgstr "เลิกปิดเสียงช่องที่ระบุ หรือช่องปัจจุบันหากไม่ได้ระบุช่อง ดูรายละเอียดที่ {mute}"

#. Description of the /ver command in the help window. {ctcp} is the abbreviation CTCP (never translated) and {command} the literal command /ctcp nick version as a code element; VERSION stays verbatim.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ver"
msgid "Ask a user which client they run: a {ctcp} VERSION request, the same as {command}. The answer shows where you asked."
msgstr "ถามผู้ใช้ว่าใช้ไคลเอนต์อะไร: คำขอ {ctcp} VERSION เหมือนกับ {command} คำตอบจะแสดงในที่ที่คุณถาม"

#. Description of the /voice command in the help window. {mode} is the channel mode +v, rendered as a code element; 'voice' is the IRC right to speak in a moderated channel.
#: client/components/Windows/Help.vue
msgctxt "help.commands.voice"
msgid "Give voice ({mode}) to one or several users in the current channel."
msgstr "ให้สิทธิ์ voice ({mode}) แก่ผู้ใช้หนึ่งคนหรือมากกว่าในช่องปัจจุบัน"

#. Help page, description of the /who command. {mask} is an example wildcard mask shown as code (nick!user@host); keep it.
#: client/components/Windows/Help.vue
msgctxt "help.commands.who"
msgid "List who matches the mask (a channel, a nick or a wildcard {mask}), as a table. Without a mask, the users of the current channel."
msgstr "แสดงผู้ที่ตรงกับ mask (ช่อง นิค หรือไวลด์การ์ด {mask}) เป็นตาราง หากไม่มี mask จะแสดงผู้ใช้ในช่องปัจจุบัน"

#. Description of the /whois command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.whois"
msgid "Retrieve information about the given user on the current network."
msgstr "ดึงข้อมูลของผู้ใช้ที่ระบุบนเครือข่ายปัจจุบัน"

#. Text of the link naming the source commit a build was made from, in the help and changelog windows. {hash} is the commit hash (verbatim, a code element).
#: client/components/Windows/Help.vue
msgctxt "help.commitHash"
msgid "commit {hash}"
msgstr "คอมมิต {hash}"

#. Second item of the help window's past-release list (comparing the running build with the development branch). {range} is a link whose text is help.range ('between 1a2b3c4 and develop').
#: client/components/Windows/Help.vue
msgctxt "help.compareBehind"
msgid "Compare {range} to see what you are missing"
msgstr "เปรียบเทียบ {range} เพื่อดูสิ่งที่คุณยังไม่มี"

#. First item of the help window's past-release list. {range} is a link whose text is help.range ('between v5.2.0 and 1a2b3c4').
#: client/components/Windows/Help.vue
msgctxt "help.compareSince"
msgid "Compare {range} to see what changed since the release"
msgstr "เปรียบเทียบ {range} เพื่อดูสิ่งที่เปลี่ยนไปตั้งแต่รุ่นที่ออก"

#. Label of the documentation link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.documentation"
msgid "Documentation"
msgstr "เอกสาร"

#. The example word shown in bold lettering in the help window's Ctrl+B formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.bold"
msgid "bold"
msgstr "ตัวหนา"

#. Text of the link at the end of the Ctrl+K description in the help window's formatting section; it opens an external IRC color reference. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorHere"
msgid "here"
msgstr "ที่นี่"

#. First paragraph of the Ctrl+K (color) description in the help window. {range} is the range 0—15 as a code element.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP1"
msgid "Mark any text typed after this shortcut to be colored. After hitting this shortcut, enter an integer in the range {range} to select the desired color, or use the autocompletion menu to choose a color name (see below)."
msgstr "ใส่สีให้ข้อความทั้งหมดที่พิมพ์หลังทางลัดนี้ หลังกดทางลัดแล้ว ให้ป้อนจำนวนเต็มในช่วง {range} เพื่อเลือกสี หรือใช้เมนูเติมอัตโนมัติเพื่อเลือกชื่อสี (ดูด้านล่าง)"

#. Second paragraph of the Ctrl+K (color) description in the help window. {range} is the range 0—15 as a code element.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP2"
msgid "Background color can be specified by putting a comma and another integer in the range {range} after the foreground color number (autocompletion works too)."
msgstr "กำหนดสีพื้นหลังได้โดยใส่จุลภาคและจำนวนเต็มอีกตัวในช่วง {range} ต่อจากหมายเลขสีตัวอักษร (ใช้การเติมอัตโนมัติได้เช่นกัน)"

#. Last paragraph of the Ctrl+K description in the help window. {link} is a link to an external IRC color reference whose text is help.formatting.colorHere ('here'); write the frame so that word fits it.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorReference"
msgid "A color reference can be found {link}."
msgstr "ดูตารางสีได้{link}"

#. Heading of the formatting-shortcuts section of the help window; each row shows a key combination and the message formatting it inserts.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.heading"
msgid "Formatting Shortcuts"
msgstr "ทางลัดการจัดรูปแบบ"

#. The example word shown in italics in the help window's Ctrl+I formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.italic"
msgid "italics"
msgstr "ตัวเอียง"

#. Description of a text-formatting shortcut in the help window. {style} is the style's name (help.formatting.bold, italic, underline, strikethrough or monospace: 'bold', 'italics', 'underlined', 'struck through', 'monospaced'), shown in that style where the placeholder stands; write the frame so those words fit it.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.markAs"
msgid "Mark all text typed after this shortcut as {style}."
msgstr "ทำให้ข้อความทั้งหมดที่พิมพ์หลังทางลัดนี้เป็น{style}"

#. The example word shown in a monospaced font in the help window's Ctrl+M formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.monospace"
msgid "monospaced"
msgstr "ความกว้างคงที่"

#. Description of the Ctrl+O formatting shortcut in the help window; it removes any formatting applied so far in the message.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.reset"
msgid "Mark all text typed after this shortcut to be reset to its original formatting."
msgstr "คืนค่ารูปแบบเดิมให้ข้อความทั้งหมดที่พิมพ์หลังทางลัดนี้"

#. The example word shown with a line through it in the help window's Ctrl+S formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.strikethrough"
msgid "struck through"
msgstr "ขีดฆ่า"

#. The example word shown underlined in the help window's Ctrl+U formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.underline"
msgid "underlined"
msgstr "ขีดเส้นใต้"

#. Heading of the touch-gestures section of the help window; lists what swiping on the sidebar does.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.heading"
msgid "Gestures"
msgstr "ท่าทางสัมผัส"

#. Description of the single-finger swipe-left gesture in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.hideSidebar"
msgid "Hide sidebar."
msgstr "ซ่อนแถบด้านข้าง"

#. Description of the single-finger swipe-right gesture in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.showSidebar"
msgid "Show sidebar."
msgstr "แสดงแถบด้านข้าง"

#. Name of the touch gesture in the help window's gestures section: swiping the sidebar left with one finger. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.swipeLeft"
msgid "Single-Finger Swipe Left"
msgstr "ปัดซ้ายด้วยนิ้วเดียว"

