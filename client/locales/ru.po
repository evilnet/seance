#. aria-label of the placeholder button standing in for a hidden media preview, when the hosting site is unknown. {kind} is 'image', 'video' or 'audio'.
#: client/components/LinkPreview.vue
msgctxt "link.showKind"
msgid "Show {kind}"
msgstr "Показать {kind}"

#. aria-label of the placeholder button standing in for a hidden media preview. {kind} is 'image', 'video' or 'audio', {host} the website the media comes from.
#: client/components/LinkPreview.vue
msgctxt "link.showKindFromHost"
msgid "Show {kind} from {host}"
msgstr "Показать {kind} с {host}"

#. Menu item on a media preview's trust menu (from the placeholder pill or the revealed toolbar): adds a rule that always loads this media for the named scope ('from example.com', 'in #chat', 'from alice').
#: client/js/helpers/mediaTrustMenu.ts
msgctxt "link.trustAdd"
msgid "Always show {scope}"
msgstr "Всегда показывать медиафайлы {scope}"

#. Text of the trust button on a media preview when nothing is trusted yet; clicking opens the menu that allows this media always. The caret follows it.
#: client/components/LinkPreview.vue
msgctxt "link.trustButtonShow"
msgid "Always show"
msgstr "Всегда показывать"

#. Text of the trust button on a media preview when at least one rule already always allows this media; clicking opens the menu of rules. The caret follows it.
#: client/components/LinkPreview.vue
msgctxt "link.trustButtonShown"
msgid "Always shown"
msgstr "Показывается всегда"

#. Name of a media-trust scope in the trust menu of a media preview and in the toolbar tooltip summarizing active rules: always allowing media from the website or from the person it was posted by. {name} is that site's host or the person's account name. Starts lowercase; it follows the words 'Always show' or 'Stop always showing'.
#: client/js/helpers/mediaTrustMenu.ts
#: client/components/LinkPreview.vue
msgctxt "link.trustFromHost"
msgid "from {name}"
msgstr "от {name}"

#. Name of a media-trust scope in the trust menu of a media preview and in the toolbar tooltip summarizing active rules: always allowing media posted in the chat channel. {name} is that channel's name. Starts lowercase; it follows the words 'Always show' or 'Stop always showing'.
#: client/js/helpers/mediaTrustMenu.ts
#: client/components/LinkPreview.vue
msgctxt "link.trustInChannel"
msgid "in {name}"
msgstr "в {name}"

#. Menu item on a media preview's trust menu: removes the existing rule that always loads this media for the named scope ('from example.com', 'in #chat', 'from alice').
#: client/js/helpers/mediaTrustMenu.ts
msgctxt "link.trustRemove"
msgid "Stop always showing {scope}"
msgstr "Перестать всегда показывать медиафайлы {scope}"

#. Tooltip of the trust button on a media preview when nothing is trusted yet; names the three scopes a rule can cover.
#: client/components/LinkPreview.vue
msgctxt "link.trustTitleEmpty"
msgid "Always show media from this site, this person or in this channel"
msgstr "Всегда показывать медиафайлы с этого сайта, от этого человека или в этом канале"

#. Tooltip of the trust button on a media preview when rules already allow it. {scopes} is a comma-joined list of what is trusted ('from example.com', 'in #chat'). Em dash is part of the copy.
#: client/components/LinkPreview.vue
msgctxt "link.trustTitleShown"
msgid "Always shown {scopes} — change"
msgstr "Всегда показываются медиафайлы {scopes} — изменить"

#. Hint on the placeholder of a media preview that failed to load; clicking loads it again.
#: client/components/LinkPreview.vue
msgctxt "link.tryAgain"
msgid "Click to try again"
msgstr "Нажмите, чтобы повторить"

#. Title of the special window the /list command fills with the server's channels. The name doubles as the window's lookup name, so it stays byte-stable per locale while the session lives.
#: client/js/irc/handlers/list.ts
msgctxt "list.channelList"
msgid "Channel List"
msgstr "Список каналов"

#. Status message when a mode list (bans, invites, exceptions) the user asked for came back with no entries. {kind} is the list's name as an English word inserted by the app ('Ban list', 'Invite list', 'Exception list'); the matching kind keys are list.kindBans/list.kindInvites/list.kindExcepts.
#: client/js/irc/handlers/lists.ts
msgctxt "list.isEmpty"
msgid "{kind} is empty"
msgstr "{kind} пуст"

#. Name of the channel-ban (+b) list, inserted into '{kind} is empty' and '{kind} for {channel}'.
#: client/js/irc/handlers/lists.ts
msgctxt "list.kindBans"
msgid "Ban list"
msgstr "Список банов"

#. Name of the ban-exception (+e) list, inserted into '{kind} is empty' and '{kind} for {channel}'.
#: client/js/irc/handlers/lists.ts
msgctxt "list.kindExcepts"
msgid "Exception list"
msgstr "Список исключений"

#. Name of the channel-invite (+I) list, inserted into '{kind} is empty' and '{kind} for {channel}'.
#: client/js/irc/handlers/lists.ts
msgctxt "list.kindInvites"
msgid "Invite list"
msgstr "Список приглашений"

#. Status line in the 'Channel List' window updated as each channel arrives; {count} is the number received so far.
#: client/js/irc/handlers/list.ts
msgctxt "list.loaded"
msgid "Loaded {count} channel..."
msgid_plural "Loaded {count} channels..."
msgstr[0] "Загружен {count} канал…"
msgstr[1] "Загружено {count} канала…"
msgstr[2] "Загружено {count} каналов…"

#. Status line in the 'Channel List' window while the server sends its channels.
#: client/js/irc/handlers/list.ts
msgctxt "list.loading"
msgid "Loading channel list, this can take a moment..."
msgstr "Загрузка списка каналов, это может занять некоторое время…"

#. Title of a special window showing one channel's mode list. {kind} is the list's name ('Ban list' etc.), {channel} the channel name. Byte-stable per locale while the session lives: the title doubles as the window's lookup name.
#: client/js/irc/handlers/lists.ts
msgctxt "list.windowTitle"
msgid "{kind} for {channel}"
msgstr "{kind} для {channel}"

#. Splash-screen status shown while the app loads its page (the chat header's spinner takes over once a chat window exists).
#: client/js/socket-events/connection.ts
msgctxt "loading.connecting"
msgid "Connecting…"
msgstr "Подключение…"

#. Message shown in the loading splash when a script failed hard enough that the application cannot start.
#: client/js/loading-error-handlers.js:38
msgctxt "loading.error"
msgid "An error has occurred that prevented the client from loading correctly."
msgstr "Произошла ошибка, из-за которой клиент не смог правильно загрузиться."

#. Disclosure heading of the box listing the error details on the loading-failure screen.
#: client/js/loading-error-handlers.js:41
msgctxt "loading.errorDetails"
msgid "More details"
msgstr "Подробнее"

#. Footer of the error details box on the loading-failure screen.
#: client/js/loading-error-handlers.js:47
msgctxt "loading.errorDevtools"
msgid "Open the developer tools of your browser for more information."
msgstr "Откройте инструменты разработчика в браузере, чтобы узнать больше."

#. Loading splash: button that reloads the page when the bundle never arrived.
#: client/index.html
#: client/js/i18n/index.ts
msgctxt "loading.reload"
msgid "Reload page"
msgstr "Перезагрузить страницу"

#. Loading splash: the message for a browser without JavaScript; the static HTML copy in index.html matches it, so the en boot-time swap is invisible.
#: client/index.html
#: client/js/i18n/index.ts
msgctxt "loading.requiresJs"
msgid "This application requires a modern browser with JavaScript enabled."
msgstr "Это приложение требует современного браузера с включённым JavaScript."

#. Loading splash: the bundle is taking unusually long to arrive.
#: client/index.html
#: client/js/i18n/index.ts
msgctxt "loading.slow"
msgid "This is taking longer than it should, there might be connectivity issues."
msgstr "Это занимает больше времени, чем должно, возможно, есть проблемы с подключением."

#. Shown in the loading splash while the application code is loading, replacing the static splash text in index.html as soon as the first script runs. Resolved in the locale the pre-paint script picked, before the app's catalogs are available.
#: client/js/loading-error-handlers.js:11
msgctxt "loading.starting"
msgid "Loading the app…"
msgstr "Загрузка приложения…"

#. aria-label of the plus button on a sidebar network row while the join-channel form is open: clicking closes it again.
#: client/components/NetworkLobby.vue:156
msgctxt "lobby.cancel"
msgid "Cancel"
msgstr "Отмена"

#. aria-label of the chevron that collapses a network's channel list in the sidebar.
#: client/components/NetworkLobby.vue:176
msgctxt "lobby.collapse"
msgid "Collapse"
msgstr "Свернуть"

#. Tooltip and aria-label of the connection-state dot on a sidebar network row while the network is online.
#: client/components/NetworkLobby.vue:138
msgctxt "lobby.connected"
msgid "Connected"
msgstr "Подключено"

#. Tooltip and aria-label of the connection-state dot on a sidebar network row while a connection is being dialled; clicking cancels it.
#: client/components/NetworkLobby.vue:140
msgctxt "lobby.connectingCancel"
msgid "Connecting… (click to cancel)"
msgstr "Подключение… (нажмите, чтобы отменить)"

#. Tooltip and aria-label of the connection-state dot on a sidebar network row when the network is down; clicking dials it again.
#: client/components/NetworkLobby.vue:141
msgctxt "lobby.disconnectedConnect"
msgid "Disconnected (click to connect)"
msgstr "Отключено (нажмите, чтобы подключиться)"

#. aria-label of the pencil button in the sidebar's network row (lobby): opens the network's edit form in Settings.
#: client/components/NetworkLobby.vue:44
#: client/components/NetworkLobby.vue:49
msgctxt "lobby.edit"
msgid "Edit this network…"
msgstr "Изменить эту сеть…"

#. aria-label of the chevron that expands a collapsed network's channel list in the sidebar.
#: client/components/NetworkLobby.vue:176
msgctxt "lobby.expand"
msgid "Expand"
msgstr "Развернуть"

#. aria-label of the plus button on a sidebar network row: opens the small join-channel form under the network.
#: client/components/NetworkLobby.vue:156
msgctxt "lobby.joinChannel"
msgid "Join a channel…"
msgstr "Войти в канал…"

#. Tooltip of the nick shown at the right of a sidebar network row before the network is connected; {network} is the network's display name.
#: client/components/NetworkLobby.vue:164
msgctxt "lobby.nickOffline"
msgid "Your nickname for {network} (not connected)"
msgstr "Ваш ник в {network} (не подключено)"

#. Tooltip of the nick shown at the right of a sidebar network row while the network is connected; {network} is the network's display name.
#: client/components/NetworkLobby.vue:163
msgctxt "lobby.nickOn"
msgid "Your nickname on {network}"
msgstr "Ваш ник в {network}"

#. Screen-reader-only prefix read before the current nick at the right of a sidebar network row (visually hidden).
#: client/components/NetworkLobby.vue:66
msgctxt "lobby.nickname"
msgid "Nickname: "
msgstr "Ник: "

#. Tooltip and aria-label of the crossed-out bell icon on a sidebar network row: push and browser notifications are switched off for this network.
#: client/components/NetworkLobby.vue:118
msgctxt "lobby.notificationsOff"
msgid "Notifications off for this network"
msgstr "Уведомления для этой сети выключены"

#. Tooltip and aria-label of the bell icon on a sidebar network row: notifications are enabled but this device is not yet registered for push.
#: client/components/NetworkLobby.vue:125
msgctxt "lobby.notificationsOn"
msgid "Notifications on"
msgstr "Уведомления включены"

#. Tooltip and aria-label of the bell icon on a sidebar network row when this device is subscribed to the network's push notifications.
#: client/components/NetworkLobby.vue:122
msgctxt "lobby.notificationsSubscribed"
msgid "Notifications: subscribed to push"
msgstr "Уведомления: подписка на push"

#. Tooltip and screen-reader label of the shield button by a network's name in the sidebar, shown while opered: opens the oper panel. 'Oper' is IRC jargon (operator).
#: client/components/NetworkLobby.vue
msgctxt "lobby.operPanel"
msgid "Oper panel…"
msgstr "Панель оператора…"

#. Tooltip and accessible name of the connection-state icon in a network's sidebar header while a reconnect is scheduled; clicking it connects at once.
#: client/components/NetworkLobby.vue:199
msgctxt "lobby.reconnectingSoon"
msgid "Reconnecting soon (click to connect now)"
msgstr "Скоро переподключение (нажмите, чтобы подключиться сейчас)"

#. Confirmation button of the remove-network dialog in the sidebar.
#: client/js/hooks/use-close-channel.ts:14
msgctxt "lobby.removeButton"
msgid "Remove network"
msgstr "Удалить сеть"

#. Body of the remove-network confirmation dialog in the sidebar. {name} is the display name of the chat network.
#: client/js/hooks/use-close-channel.ts:13
msgctxt "lobby.removeText"
msgid "Are you sure you want to quit and remove {name}? This cannot be undone."
msgstr "Вы уверены, что хотите выйти из {name} и удалить эту сеть? Это нельзя отменить."

#. Title of the confirmation dialog shown from the sidebar when removing a whole chat network: the connection quits and the saved network is deleted from this browser.
#: client/js/hooks/use-close-channel.ts:11
msgctxt "lobby.removeTitle"
msgid "Remove network"
msgstr "Удалить сеть"

#. Accessible name of the ✕ button in the mentions popup's title bar; it closes the popup (on a phone the popup fills the screen).
#: client/components/Mentions.vue:30
msgctxt "mentions.close"
msgid "Close mentions"
msgstr "Закрыть упоминания"

#. Button at the right of the mentions popup's title; clicking clears every entry from the list.
#: client/components/Mentions.vue:16
msgctxt "mentions.dismissAll"
msgid "Dismiss all"
msgstr "Убрать все"

#. Button beside a conversation in the mentions popup that this page no longer has (so reading it cannot clear its mentions); clicking removes that conversation's entries from the list.
#: client/components/Mentions.vue:76
msgctxt "mentions.dismissGroup"
msgid "Dismiss"
msgstr "Убрать"

#. Tooltip and accessible name of the × button on an entry of the mentions popup; clicking removes that entry from the list on this device only.
#: client/components/Mentions.vue:42
#: client/components/Mentions.vue:104
msgctxt "mentions.dismissOne"
msgid "Dismiss on this device"
msgstr "Убрать на этом устройстве"

#. Title shown in the mentions popup when no unread message mentions you.
#: client/components/Mentions.vue:21
#: client/components/Mentions.vue:39
msgctxt "mentions.empty"
msgid "You're all caught up"
msgstr "Всё прочитано"

#. Hint under the empty mentions popup's title, explaining what clears the list.
#: client/components/Mentions.vue:41
msgctxt "mentions.emptyHint"
msgid "A mention leaves this list once you read it, here or on any other device."
msgstr "Упоминание исчезает из списка, как только вы его прочтёте — здесь или на любом другом устройстве."

#. Shown under a channel in the mentions popup that you are no longer in. {target} is the channel name, shown verbatim.
#: client/components/Mentions.vue:509
msgctxt "mentions.missingChannel"
msgid "Not in {target}: join it to read these, or dismiss them."
msgstr "Вас нет в {target}: войдите в канал, чтобы прочитать их, или уберите их."

#. As mentions.missingChannel, when several chat networks are set up. {target} is the channel name, {network} the chat network's display name.
#: client/components/Mentions.vue:508
msgctxt "mentions.missingChannelOn"
msgid "Not in {target} on {network}: join it to read these, or dismiss them."
msgstr "Вас нет в {target} в сети {network}: войдите в канал, чтобы прочитать их, или уберите их."

#. Shown under a conversation in the mentions popup whose chat network is no longer set up in this client, so its mentions can only be dismissed.
#: client/components/Mentions.vue:502
msgctxt "mentions.missingNetwork"
msgid "Its network isn't on this page: dismiss these."
msgstr "Сети этой беседы нет на этой странице: уберите эти упоминания."

#. Shown under a private conversation in the mentions popup that is not open in this client. {target} is the other person's nick, shown verbatim.
#: client/components/Mentions.vue:506
msgctxt "mentions.missingQuery"
msgid "No conversation with {target} open: open one to read these, or dismiss them."
msgstr "Беседа с {target} не открыта: откройте её, чтобы прочитать их, или уберите их."

#. As mentions.missingQuery, when several chat networks are set up. {target} is the other person's nick, {network} the chat network's display name.
#: client/components/Mentions.vue:505
msgctxt "mentions.missingQueryOn"
msgid "No conversation with {target} on {network} open: open one to read these, or dismiss them."
msgstr "Беседа с {target} в сети {network} не открыта: откройте её, чтобы прочитать их, или уберите их."

#. Tooltip of a conversation's header in the mentions popup; clicking opens that conversation. {target} is a channel name or a nick, shown verbatim.
#: client/components/Mentions.vue:56
msgctxt "mentions.open"
msgid "Open {target}"
msgstr "Открыть {target}"

#. Accessible name of a conversation's section in the mentions popup when several chat networks are set up. {target} is a channel name or nick, {network} the chat network's display name.
#: client/components/Mentions.vue:517
msgctxt "mentions.targetOn"
msgid "{target} on {network}"
msgstr "{target} в сети {network}"

#. Heading of the popup (the inbox) that lists the unread messages mentioning you, grouped by conversation.
#: client/components/Mentions.vue:10
#: client/components/Mentions.vue:18
msgctxt "mentions.title"
msgid "Mentions"
msgstr "Упоминания"

#. Count of unread messages: the accessible name of the total beside the mentions popup's heading, and the label on a private conversation's row when more than one of its lines is unread. {count} is the number. The singular form shows for one, the plural for any other number.
#: client/components/Mentions.vue:522
msgctxt "mentions.unread"
msgid "{count} unread"
msgid_plural "{count} unread"
msgstr[0] "{count} непрочитанное"
msgstr[1] "{count} непрочитанных"
msgstr[2] "{count} непрочитанных"

#. The word for a group chat room, filling {type} in the context-menu mute items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.chanTypeChannel"
msgid "channel"
msgstr "канал"

#. Word for a whole chat server connection, filling {type} in the context-menu mute items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.chanTypeNetwork"
msgid "network"
msgstr "сеть"

#. The word for a private one-on-one chat, filling {type} in the context-menu mute items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.chanTypeQuery"
msgid "conversation"
msgstr "разговор"

#. Context-menu item on a conversation; deletes the locally loaded messages of that conversation after a confirmation. Also the title and confirmation button of that dialog.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.clearHistory"
msgid "Clear history"
msgstr "Очистить историю"

#. Body of the confirmation dialog before the locally loaded messages of a conversation are deleted. {channel} is the conversation's name.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.clearHistoryText"
msgid "Are you sure you want to clear history for {channel}? This cannot be undone."
msgstr "Вы уверены, что хотите очистить историю для {channel}? Это нельзя отменить."

#. Context-menu item on a channel in the sidebar network list; clicking leaves the channel (the app stops showing it and tells the server so).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.closeChannel"
msgid "Leave"
msgstr "Покинуть"

#. Context-menu item on a chat network's home row in the sidebar network list; clicking forgets the saved network connection. Shown instead of 'Close' because a network cannot be merely closed.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.closeLobby"
msgid "Remove"
msgstr "Удалить"

#. Context-menu item on a private one-on-one conversation or a list window in the sidebar; clicking closes the window without leaving anything on the server.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.closeQuery"
msgid "Close"
msgstr "Закрыть"

#. Context-menu item on a chat network's home row while the network is offline; clicking dials the network again.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.connect"
msgid "Connect"
msgstr "Подключиться"

#. Context-menu item on a user; opens (or switches to) the private one-on-one conversation with that user.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.directMessages"
msgid "Direct messages"
msgstr "Личные сообщения"

#. Context-menu item on a chat network's home row while the network is connected; clicking hangs up the connection to that network.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.disconnect"
msgid "Disconnect"
msgstr "Отключиться"

#. Context-menu item on a chat network's home row; opens the form where the network's address and credentials are changed. Ellipsis is part of the copy.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.editNetwork"
msgid "Edit this network…"
msgstr "Изменить эту сеть…"

#. Context-menu item on a chat channel in the sidebar; opens the editor for the channel's topic line.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.editTopic"
msgid "Edit topic"
msgstr "Изменить тему"

#. Context-menu item that grants an IRC channel role to a user; {name} is the role's name ('operator'), {mode} the bare mode letter (e.g. o) — the + before it is part of the text, so the item reads (+o).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.giveMode"
msgid "Give {name} (+{mode})"
msgstr "Выдать: {name} (+{mode})"

#. Context-menu item that grants an IRC mode whose role name is unknown; {mode} is the bare mode letter (e.g. z) — the + before it is part of the text, so the item reads Mode +z.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.giveModeUnknown"
msgid "Mode +{mode}"
msgstr "Режим +{mode}"

#. Context-menu item on a clickable channel name inside a chat message, when that channel is already open in this client; clicking switches to it.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.goToChannel"
msgid "Go to channel"
msgstr "Перейти в канал"

#. Context-menu item on a user; hides all further messages from that user on the network.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.ignore"
msgid "Ignore user"
msgstr "Игнорировать пользователя"

#. Context-menu item on a chat network's home row; opens the field to join a channel on that network. Ellipsis is part of the copy.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.joinChannel"
msgid "Join a channel…"
msgstr "Войти в канал…"

#. Context-menu item on a clickable channel name inside a chat message, when that channel is not open yet; clicking joins it.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.joinInline"
msgid "Join channel"
msgstr "Войти в канал"

#. Context-menu item on a user in a channel you have permission in; removes that user from the channel (they may rejoin).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.kick"
msgid "Kick"
msgstr "Выгнать"

#. Context-menu item on a chat channel in the sidebar; asks the server for the channel's ban list.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.listBanned"
msgid "List banned users"
msgstr "Список забаненных"

#. Context-menu item on a chat network's home row; asks the server for the list of every public channel on that network.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.listChannels"
msgid "List all channels"
msgstr "Список всех каналов"

#. Context-menu item on a chat network's home row; shows the list of users whose messages are hidden on that network.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.listIgnored"
msgid "List ignored users"
msgstr "Список игнорируемых"

#. Name of the IRC channel administrator role (the & prefix), filling {name} in the mode menu items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeAdmin"
msgid "admin"
msgstr "администратор"

#. Name of the IRC half-operator role (the % prefix), filling {name} in the mode menu items. Lowercase mid-sentence; keep the hyphen if natural.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeHalfOp"
msgid "half-op"
msgstr "полуоператор"

#. Name of the IRC channel operator role (the @ prefix), filling {name} in the mode menu items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeOperator"
msgid "operator"
msgstr "оператор"

#. Name of the highest IRC channel role (the ~ prefix), filling {name} in the mode menu items such as 'Revoke {name} (-a)'. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeOwner"
msgid "owner"
msgstr "владелец"

#. Name of the IRC voiced role (the + prefix; may speak in a moderated channel), filling {name} in the mode menu items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeVoice"
msgid "voice"
msgstr "голос"

#. Context-menu item on a conversation; clicking mutes it (no highlights, no notifications from it). {type} names the kind of conversation in lowercase: 'network', 'channel' or 'conversation'.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.muteType"
msgid "Mute {type}"
