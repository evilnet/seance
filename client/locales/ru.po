#: client/js/irc/profiles/nefarious/check.ts
msgctxt "oper.check.downlink.bursting"
msgid "bursting"
msgstr "идёт burst"

#. State chip of a linked server in a CHECK server card: a hub (links other servers). One word.
#: client/js/irc/profiles/nefarious/check.ts
msgctxt "oper.check.downlink.hub"
msgid "hub"
msgstr "хаб"

