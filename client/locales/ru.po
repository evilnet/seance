#: client/js/irc/profiles/nefarious/check.ts
msgctxt "oper.check.error.needsTarget"
msgid "CHECK needs a target: a nick, a channel, a server or a hostmask"
msgstr "CHECK нужна цель: ник, канал, сервер или маска хоста"

#. Error shown on a CHECK report card (and in the investigation card) when the server found nothing to check. One line.
#: client/js/irc/profiles/nefarious/check.ts
msgctxt "oper.check.error.noMatch"
msgid "No matching user, channel, server or host"
msgstr "Нет подходящего пользователя, канала, сервера или хоста"

#. Error shown on a CHECK report card when the server found nothing for {target} (what the oper typed: a nick, channel, server or hostmask; keep verbatim). One line.
#: client/js/irc/profiles/nefarious/check.ts
msgctxt "oper.check.error.noMatchFor"
msgid "No matching user, channel, server or host for {target}"
msgstr "Нет подходящего пользователя, канала, сервера или хоста для {target}"

#. Error on a CHECK report card when the oper lacks the CHECK privilege. Keep CHECK as is. One line.
