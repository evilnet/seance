# Generated by tools/i18n/compile.ts — the generator owns their formatting,
# so regeneration is byte-stable and prettier never fights it.
client/js/i18n/available.ts
client/js/i18n/targets.ts
client/locales/tags.json

# Gettext catalogs are tool-generated by scaffold/sync/fill (tools/i18n/); a
# po writer owns their formatting. `client/locales/**/*.po` is the narrowest
# correct entry: it covers the top-level catalogs and sync.ts's attic/
# archive, where `client/locales/*.po` would miss the archived files; a bare
# `*.po` would reach stray catalogs anywhere in the tree. The pot has no
# parser either and is maintained by add/merge, not a formatter.
client/locales/**/*.po
client/locales/messages.pot

# Generated by tools/generate-stopwords.py, minified on purpose (~19 KB of
# data tables); the generator owns its formatting.
client/js/translate/stopwords.json

# Generated by tools/generate-wordlist.py, minified on purpose (~390 KB of
# frequency data); the generator owns its formatting, and `--check` compares
# the committed bytes against it.
client/js/translate/wordlist.json

