{
  "name": "seance",
  "description": "Static, bouncer-less web IRC client: IRCv3 over WebSocket, no server of its own",
  "private": true,
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evilnet/seance.git"
  },
  "homepage": "https://github.com/evilnet/seance#readme",
  "bugs": {
    "url": "https://github.com/evilnet/seance/issues"
  },
  "scripts": {
    "build:client": "vite build",
    "build": "vite build",
    "coverage": "NODE_ENV=test TS_NODE_PROJECT='./test/tsconfig.json' nyc --nycrc-path=test/.nycrc-mocha.json mocha --config=test/.mocharc.yml 'test/**/*.ts' && nyc --nycrc-path=test/.nycrc-report.json report",
    "format:prettier": "prettier --write \"**/*.*\"",
    "lint:check-eslint": "eslint-config-prettier .eslintrc.cjs",
    "lint:eslint": "eslint . --report-unused-disable-directives --color",
    "lint:prettier": "prettier --list-different \"**/*.*\"",
    "lint:stylelint": "stylelint --color \"client/**/*.css\"",
    "lint": "run-p --aggregate-output --continue-on-error lint:*",
    "test": "run-p --aggregate-output --continue-on-error lint:* typecheck test:mocha",
    "test:e2e": "pnpm build && playwright test",
    "test:mocha": "pnpm build && NODE_ENV=test mocha --config=test/.mocharc.yml 'test/**/*.ts'",
    "test:nospec": "pnpm build && NODE_ENV=test mocha --config=test/.mocharc.yml",
    "watch": "vite build --watch",
    "githooks-install": "git config core.hooksPath scripts/git-hooks",
    "typecheck": "tsc --noEmit -p client/tsconfig.json"
  },
  "keywords": [
    "irc",
    "ircv3",
    "websocket",
    "client",
    "pwa",
    "seance"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "./client/index.html",
    "./public/**"
  ],
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "fengari": "0.1.5",
    "flourite": "1.3.0",
    "got": "11.8.6",
    "katex": "0.16.22",
    "linkify-it": "3.0.3",
    "lodash": "4.17.21",
    "prismjs": "1.30.0",
    "tlds": "1.228.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "5.15.4",
    "@istanbuljs/nyc-config-typescript": "1.0.2",
    "@playwright/test": "1.62.1",
    "@textcomplete/core": "0.1.10",
    "@textcomplete/textarea": "0.1.10",
    "@types/chai": "4.3.5",
    "@types/linkify-it": "3.0.5",
    "@types/lodash": "4.14.202",
    "@types/mocha": "9.1.1",
    "@types/mousetrap": "1.6.15",
    "@types/node": "22.19.17",
    "@types/prismjs": "1.26.6",
    "@types/sinon": "9.0.11",
    "@types/sortablejs": "1.15.8",
    "@types/textarea-caret": "3.0.4",
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "chai": "4.3.7",
    "dayjs": "1.10.8",
    "emoji-regex": "10.2.1",
    "eruda": "3.4.3",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-define-config": "2.1.0",
    "eslint-plugin-vue": "9.25.0",
    "fuzzy": "0.1.3",
    "gemoji": "8.1.0",
    "mocha": "11.7.5",
    "mousetrap": "1.6.5",
    "normalize.css": "8.0.1",
    "npm-run-all": "4.1.5",
    "nyc": "15.1.0",
    "paper": "0.12.18",
    "prettier": "2.5.1",
    "pretty-quick": "3.1.3",
    "primer-tooltips": "2.0.0",
    "sinon": "13.0.2",
    "sortablejs": "1.15.2",
    "stylelint": "14.3.0",
    "stylelint-config-standard": "24.0.0",
    "textarea-caret": "3.1.0",
    "ts-sinon": "2.0.2",
    "tsx": "4.21.0",
    "typescript": "5.4.5",
    "undate": "0.3.0",
    "vite": "8.3.5",
    "vue": "3.2.35",
    "vue-eslint-parser": "9.4.3",
    "vue-router": "4.0.15",
    "vuex": "4.0.2"
  },
  "packageManager": "pnpm@12.16.1"
}
