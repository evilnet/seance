{
  "name": "seance",
  "description": "Static, bouncer-less web IRC client: IRCv3 over WebSocket, no server of its own",
  "private": true,
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evilnet/seance.git"
  },
  "homepage": "https://github.com/evilnet/seance#readme",
  "bugs": {
    "url": "https://github.com/evilnet/seance/issues"
  },
  "scripts": {
    "build": "vite build",
    "coverage": "NODE_ENV=test nyc --nycrc-path=test/.nycrc-mocha.json mocha --config=test/.mocharc.yml 'test/**/*.ts' && nyc --nycrc-path=test/.nycrc-report.json report",
    "format:prettier": "prettier --write --ignore-unknown \"**/*.*\"",
    "lint:oxlint": "oxlint",
    "lint:prettier": "prettier --list-different --ignore-unknown \"**/*.*\"",
    "lint:stylelint": "stylelint --color \"client/**/*.css\"",
    "lint": "run-p --aggregate-output --continue-on-error lint:*",
    "test": "run-p --aggregate-output --continue-on-error lint:* typecheck test:mocha",
    "test:e2e": "pnpm build && playwright test",
    "test:mocha": "pnpm build && NODE_ENV=test mocha --config=test/.mocharc.yml 'test/**/*.ts'",
    "watch": "vite build --watch",
    "typecheck": "tsc -p . && tsc -p client --runExternalCode && tsc -p shared && tsc -p tools"
  },
  "keywords": [
    "irc",
    "ircv3",
    "websocket",
    "client",
    "pwa",
    "seance"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "./client/index.html",
    "./public/**"
  ],
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "fengari": "0.1.5",
    "flourite": "1.3.0",
    "katex": "0.19.1",
    "linkify-it": "6.1.0",
    "prismjs": "1.30.0",
    "tlds": "1.261.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "5.15.4",
    "@istanbuljs/nyc-config-typescript": "1.0.2",
    "@playwright/test": "1.64.1",
    "@textcomplete/core": "0.1.13",
    "@textcomplete/textarea": "0.1.13",
    "@types/chai": "5.2.3",
    "@types/mocha": "9.1.1",
    "@types/mousetrap": "1.6.15",
    "@types/node": "22.20.5",
    "@types/prismjs": "1.26.6",
    "@types/sinon": "22.0.2",
    "@types/sortablejs": "1.15.9",
    "@types/textarea-caret": "3.0.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/content-mapper": "4.0.0-alpha.3",
    "chai": "6.3.0",
    "dayjs": "1.11.23",
    "emoji-regex": "10.6.0",
    "eruda": "3.4.3",
    "fuzzy": "0.1.3",
    "gemoji": "8.1.0",
    "mocha": "11.8.0",
    "mousetrap": "1.6.5",
    "normalize.css": "8.0.1",
    "npm-run-all2": "9.0.4",
    "nyc": "15.1.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "paper": "0.16.0",
    "prettier": "2.8.8",
    "primer-tooltips": "2.0.0",
    "sinon": "22.1.0",
    "sortablejs": "1.15.7",
    "stylelint": "14.16.1",
    "stylelint-config-standard": "24.0.0",
    "textarea-caret": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "7.1.0-beta",
    "undate": "0.3.0",
    "vite": "8.3.5",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "vuex": "4.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
