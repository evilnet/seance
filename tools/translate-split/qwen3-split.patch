+class Qwen3SplitEmbedding(nn.Module):
+    """The vocabulary table as two halves by rows (Seance): every weight a
+    model binds on the GPU is one storage buffer, and a phone's WebGPU
+    may bind no more than 128 MiB at once while Qwen3's quantized table is
+    148 MiB (1.7B) or 186 MiB (4B). `part0` holds rows [0, split) and
+    `part1` rows [split, vocab): the published weights split at that row
+    are these two parameters byte for byte, so the runtime can read each
+    as a byte range of the published shard."""
+
+    def __init__(self, vocab_size: int, hidden_size: int, split: int):
+        self.split = split
+        self.hidden_size = hidden_size
+        self.part0 = Qwen3Embedding(split, hidden_size)
+        self.part1 = Qwen3Embedding(vocab_size - split, hidden_size)
+
+    def forward(self, x: Tensor):
+        # Integer arithmetic only: a boolean mask is stored as i8, which
+        # WGSL rejects without an experimental extension.
+        bound = op.full(x.shape, self.split, x.dtype)
+        zero = op.zeros(x.shape, x.dtype)
+        one = op.full(x.shape, 1, x.dtype)
+        idx0 = op.minimum(x, op.full(x.shape, self.split - 1, x.dtype))
+        idx1 = op.maximum(op.subtract(x, bound), zero)
+        # 1 for a row of part0, 0 for a row of part1.
+        first = op.minimum(op.maximum(op.subtract(bound, x), zero), one)
+        e0 = self.part0(idx0)
+        e1 = self.part1(idx1)
+        w0 = op.reshape(op.astype(first, e0.dtype), shape=[*x.shape, 1])
+        return op.add(op.multiply(e0, w0), op.multiply(e1, op.subtract(op.ones([1], e0.dtype), w0)))
+
+    def lm_head_forward(self, x: Tensor):
+        """The tied lm_head: each half's logits, joined in vocabulary order."""
+        return op.concat(
+            [self.part0.lm_head_forward(x), self.part1.lm_head_forward(x)], dim=-1
+        )
+
+
